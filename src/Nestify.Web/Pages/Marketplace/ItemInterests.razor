@page "/marketplace/items/{Id}/interests"
@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>Buyer interest — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap mk-wrap--narrow">

        @if (_loading)
        {
            <div class="mk-skeleton" style="height:20rem"></div>
        }
        else if (_item is null || !_item.IsMine)
        {
            <nav class="mk-crumbs">
                <a href="marketplace">Marketplace</a>
                <span class="mk-crumbs__sep">/</span>
                <span>Not available</span>
            </nav>
            <MarketplaceEmpty Title="This buyer list isn't available"
                              Message="Either the listing doesn't exist or it isn't one of yours.">
                <a class="nx-btn nx-btn--primary" href="marketplace/mine">My listings</a>
            </MarketplaceEmpty>
        }
        else
        {
            <nav class="mk-crumbs">
                <a href="marketplace">Marketplace</a>
                <span class="mk-crumbs__sep">/</span>
                <a href="marketplace/items/@Id">@_item.Title</a>
                <span class="mk-crumbs__sep">/</span>
                <span>Buyer interest</span>
            </nav>

            <header class="mk-head">
                <div class="mk-head__titles">
                    <p class="nx-eyebrow">Marketplace</p>
                    <h1>Buyer interest</h1>
                    <p class="mk-head__lead">
                        @_item.Title — @_pendingCount awaiting your reply.
                        Accepting one shares your contact details with that buyer.
                    </p>
                </div>
            </header>

            @if (_interests.Count == 0)
            {
                <MarketplaceEmpty Title="No requests yet"
                                  Message="When a buyer sends a request it shows up here with their message." />
            }
            else
            {
                <div class="mk-rows">
                    @foreach (var interest in _interests)
                    {
                        <article class="mk-row @(interest.Status is BuyInterestStatus.Declined ? "mk-row--muted" : null)">
                            <div class="mk-row__top">
                                <div class="mk-row__grow">
                                    <div class="mk-row__title">
                                        <span class="mk-ava">@MarketplaceView.Initials(interest.BuyerDisplayName)</span>
                                        @interest.BuyerDisplayName
                                    </div>
                                    <div class="mk-row__badges">
                                        <VerifiedBadge Verified="interest.BuyerVerified" ShowUnverified="true" />
                                        <InterestStatusBadge Status="interest.Status" />
                                        <span class="mk-muted">@MarketplaceView.RelativeTime(interest.CreatedAtUtc)</span>
                                    </div>
                                    <p class="mk-row__msg mk-plain">@interest.Message</p>

                                    @if (interest.Status == BuyInterestStatus.Accepted && interest.Contact is not null)
                                    {
                                        <ContactCard Contact="interest.Contact" Heading="Buyer contact — shared with you" />
                                    }
                                </div>
                            </div>

                            @if (interest.Status == BuyInterestStatus.Pending)
                            {
                                <div class="mk-row__actions">
                                    <span class="mk-row__actions-spacer"></span>
                                    <button class="nx-btn nx-btn--ghost mk-danger-btn" disabled="@_busy"
                                            @onclick="() => Respond(interest.Id, false)">Decline</button>
                                    <button class="nx-btn nx-btn--accent" disabled="@_busy"
                                            @onclick="() => Respond(interest.Id, true)">Accept &amp; share contact</button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MarketplaceItemDetailDto? _item;
    private List<BuyInterestDto> _interests = new();
    private bool _loading = true;
    private bool _busy;
    private int _pendingCount => _interests.Count(i => i.Status == BuyInterestStatus.Pending);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _item = await Marketplace.GetItemAsync(Id);
            if (_item is { IsMine: true })
            {
                _interests = (await Marketplace.GetItemInterestsAsync(Id)).ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Respond(string interestId, bool accept)
    {
        _busy = true;
        try
        {
            var ok = await Marketplace.RespondToInterestAsync(interestId, accept);
            if (ok)
            {
                _interests = (await Marketplace.GetItemInterestsAsync(Id)).ToList();
                Toast.ShowSuccess(
                    accept ? "Accepted. Your contact details are now visible to this buyer." : "Request declined.",
                    accept ? "Buyer accepted" : "Declined");
            }
            else
            {
                Toast.ShowWarning("That request has already been answered.", "No change");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
