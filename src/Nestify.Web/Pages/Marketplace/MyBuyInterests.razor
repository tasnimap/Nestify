@page "/buy-interests/mine"
@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>My buy requests — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap mk-wrap--narrow">
        <nav class="mk-crumbs">
            <a href="marketplace">Marketplace</a>
            <span class="mk-crumbs__sep">/</span>
            <span>My buy requests</span>
        </nav>

        <header class="mk-head">
            <div class="mk-head__titles">
                <p class="nx-eyebrow">Marketplace</p>
                <h1>My buy requests</h1>
                <p class="mk-head__lead">
                    Requests you've sent to sellers. Their contact details appear here once they accept.
                </p>
            </div>
        </header>

        @if (_loading)
        {
            <div class="mk-rows">
                <div class="mk-skeleton" style="height:8rem"></div>
                <div class="mk-skeleton" style="height:8rem"></div>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <MarketplaceEmpty Title="You haven't sent any buy requests"
                              Message="Find something in the marketplace and send the seller a message to get started.">
                <a class="nx-btn nx-btn--primary" href="marketplace">Browse the marketplace</a>
            </MarketplaceEmpty>
        }
        else
        {
            <div class="mk-rows">
                @foreach (var r in _rows)
                {
                    <article class="mk-row @(r.Status is BuyInterestStatus.Withdrawn or BuyInterestStatus.Declined ? "mk-row--muted" : null)">
                        <div class="mk-row__top">
                            <div class="mk-row__thumb">
                                <MediaTile Seed="@r.ItemCoverImage" Label="@r.ItemTitle" />
                            </div>
                            <div class="mk-row__grow">
                                <div class="mk-row__title">
                                    <a href="marketplace/items/@r.ItemId">@r.ItemTitle</a>
                                </div>
                                <div class="mk-row__badges">
                                    <span class="mk-price mk-price--sm">@Money.Format(r.ItemPriceBdt)</span>
                                    <InterestStatusBadge Status="r.Status" />
                                    <span class="mk-muted">to @r.SellerDisplayName · @MarketplaceView.RelativeTime(r.CreatedAtUtc)</span>
                                </div>
                                <p class="mk-row__msg mk-plain">@r.Message</p>

                                @if (r.Status == BuyInterestStatus.Accepted && r.Contact is not null)
                                {
                                    <ContactCard Contact="r.Contact" Heading="Seller contact — shared with you" />
                                }
                            </div>
                        </div>

                        @if (r.Status is BuyInterestStatus.Pending or BuyInterestStatus.Accepted)
                        {
                            <div class="mk-row__actions">
                                <span class="mk-row__actions-spacer"></span>
                                <button class="nx-btn nx-btn--ghost mk-danger-btn" disabled="@_busy"
                                        @onclick="() => Withdraw(r.Id)">Withdraw request</button>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<MyBuyInterestDto> _rows = new();
    private bool _loading = true;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Marketplace.GetMyBuyInterestsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Withdraw(string interestId)
    {
        _busy = true;
        try
        {
            if (await Marketplace.WithdrawInterestAsync(interestId))
            {
                Toast.ShowInfo("Request withdrawn.", "Done");
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
