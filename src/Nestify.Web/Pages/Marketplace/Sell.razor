@page "/marketplace/sell"
@inject IMarketplaceService Marketplace
@inject NavigationManager Nav
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>Post an item — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap mk-wrap--narrow">
        <nav class="mk-crumbs">
            <a href="marketplace">Marketplace</a>
            <span class="mk-crumbs__sep">/</span>
            <span>Post an item</span>
        </nav>

        <header class="mk-head">
            <div class="mk-head__titles">
                <p class="nx-eyebrow">Marketplace</p>
                <h1>Post an item for sale</h1>
                <p class="mk-head__lead">
                    Verified to verified. A couple of honest photos and a plain, specific description
                    is what gets a reply.
                </p>
            </div>
        </header>

        <div class="mk-panel">
            <ItemForm Model="_model" Busy="_busy" SubmitLabel="Publish listing"
                      OnValidSubmit="Submit" OnCancel="Cancel" />
        </div>
    </div>
</section>

@code {
    private readonly MarketplaceItemFormModel _model = new();
    private bool _busy;

    private async Task Submit()
    {
        _busy = true;
        try
        {
            var id = await Marketplace.CreateItemAsync(_model.ToCreateDto());
            Toast.ShowSuccess("Your item is live. Buyers can send you requests now.", "Listing published");
            Nav.NavigateTo($"marketplace/items/{id}");
        }
        catch
        {
            Toast.ShowError("Couldn't publish the listing. Please try again.", "Something went wrong");
            _busy = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("marketplace");
}
