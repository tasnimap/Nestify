@page "/auth"
@page "/login"
@page "/register"
@using System.ComponentModel.DataAnnotations
@using Nestify.Shared.Dtos.Auth
@using Nestify.Web.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_showRegister ? L["Create an account"] : L["Log in"]) — Nestify</PageTitle>

<div class="auth-wrap">
    <div class="auth-card @(_showRegister ? "auth-card--register" : "") @_animClass">

        <!-- ── Left: Login form ── -->
        <div class="auth-panel auth-panel--login">
            <header class="auth-panel__head">
                <h2>@L["Welcome back"]</h2>
                <p>@L["Log in to your Nestify account."]</p>
            </header>

            <EditForm Model="_login" OnValidSubmit="HandleLoginAsync" class="auth-form" novalidate>
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="l-email">@L["Email address"]</label>
                    <div class="field__control">
                        <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
                        <InputText id="l-email" @bind-Value="_login.Email" class="field__input field__input--icon"
                                   type="email" autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <ValidationMessage For="@(() => _login.Email)" class="field__error" />
                </div>

                <div class="field">
                    <div class="field__label-row">
                    <label for="l-password">@L["Password"]</label>
                        <a class="field__link" href="#" @onclick:preventDefault @onclick="ShowForgotHint">@L["Forgot password?"]</a>
                    </div>
                    <div class="field__control">
                        <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <InputText id="l-password" @bind-Value="_login.Password" class="field__input field__input--icon"
                                   type="@(_showLoginPwd ? "text" : "password")"
                                   autocomplete="current-password" placeholder='@L["Your password"]' />
                        <button type="button" class="field__toggle"
                                aria-label="@(_showLoginPwd ? L["Hide"] : L["Show"]) password"
                                @onclick="() => _showLoginPwd = !_showLoginPwd">
                            @(_showLoginPwd ? L["Hide"] : L["Show"])
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _login.Password)" class="field__error" />
                </div>

                <label class="field__check">
                    <input type="checkbox" @bind="_rememberMe" />
                    <span>@L["Keep me signed in"]</span>
                </label>

                @if (!string.IsNullOrEmpty(_loginMsg))
                {
                    <p class="auth-alert" role="alert">@_loginMsg</p>
                }

                <button class="nx-btn nx-btn--primary nx-btn--lg nx-btn--block" type="submit" disabled="@_loginBusy">
                    @if (_loginBusy)
                    {
                        <span class="auth-spinner" aria-hidden="true"></span>
                        <span>@L["Signing in..."]</span>
                    }
                    else { <span>@L["Log in"]</span> }
                </button>

                <p class="auth-switch-inline">
                    @L["New to Nestify?"]
                    <button type="button" class="auth-switch-inline__btn" @onclick="SwitchToRegister">@L["Create an account"]</button>
                </p>
            </EditForm>
        </div>

        <!-- ── Right: Register form ── -->
        <div class="auth-panel auth-panel--register">
            <header class="auth-panel__head">
                <h2>@L["Create account"]</h2>
                <p>@L["It takes about a minute."]</p>
            </header>

            <EditForm Model="_register" OnValidSubmit="HandleRegisterAsync" class="auth-form" novalidate>
                <DataAnnotationsValidator />


                <div class="field">
                    <label for="r-name">@L["Full name"]</label>
                    <div class="field__control">
                        <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <InputText id="r-name" @bind-Value="_register.Name" class="field__input field__input--icon"
                                   autocomplete="name" placeholder="e.g. Rafiul Karim" />
                    </div>
                    <ValidationMessage For="@(() => _register.Name)" class="field__error" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="r-email">@L["Email"]</label>
                        <div class="field__control">
                            <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
                            <InputText id="r-email" @bind-Value="_register.Email" class="field__input field__input--icon"
                                       type="email" autocomplete="email" placeholder="you@example.com" />
                        </div>
                        <ValidationMessage For="@(() => _register.Email)" class="field__error" />
                    </div>

                    <div class="field">
                        <label for="r-phone">@L["Phone"]</label>
                        <div class="field__control">
                            <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                            <InputText id="r-phone" @bind-Value="_register.Phone" class="field__input field__input--icon"
                                       type="tel" autocomplete="tel" placeholder="01XXXXXXXXX" />
                        </div>
                        <ValidationMessage For="@(() => _register.Phone)" class="field__error" />
                    </div>
                </div>

                <div class="field">
                    <label for="r-role">@L["Register as"]</label>
                    <InputSelect id="r-role" @bind-Value="_register.AccountType" class="field__input">
                        <option value="@RegisterRole.User">@L["User"]</option>
                        <option value="@RegisterRole.DomesticHelp">@L["Domestic Help"]</option>
                    </InputSelect>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="r-pwd">@L["Password"]</label>
                        <div class="field__control">
                            <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <InputText id="r-pwd" @bind-Value="_register.Password" class="field__input field__input--icon"
                                       type="@(_showRegPwd ? "text" : "password")"
                                       autocomplete="new-password" placeholder='@L["Min 8 characters"]' />
                            <button type="button" class="field__toggle" @onclick="() => _showRegPwd = !_showRegPwd"
                                    aria-label="@(_showRegPwd ? L["Hide"] : L["Show"]) password">
                                @(_showRegPwd ? L["Hide"] : L["Show"])
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _register.Password)" class="field__error" />
                    </div>

                    <div class="field">
                        <label for="r-confirm">@L["Confirm password"]</label>
                        <div class="field__control">
                            <svg class="field__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <InputText id="r-confirm" @bind-Value="_register.ConfirmPassword" class="field__input field__input--icon"
                                       type="@(_showRegConfirm ? "text" : "password")"
                                       autocomplete="new-password" placeholder='@L["Re-enter password"]' />
                            <button type="button" class="field__toggle" @onclick="() => _showRegConfirm = !_showRegConfirm"
                                    aria-label="@(_showRegConfirm ? L["Hide"] : L["Show"]) password">
                                @(_showRegConfirm ? L["Hide"] : L["Show"])
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _register.ConfirmPassword)" class="field__error" />
                    </div>
                </div>

                <div class="field__check">
                    <input id="r-terms" type="checkbox" @bind="_register.AcceptTerms" />
                    <span>
                        <label for="r-terms">@L["I agree to the Nestify"] </label>
                        <button type="button" class="legal-trigger" @onclick="() => OpenLegal(LegalDocument.Terms)">@L["Terms of Use"]</button>
                        <span>@L[" and "]</span>
                        <button type="button" class="legal-trigger" @onclick="() => OpenLegal(LegalDocument.Privacy)">@L["Privacy Policy"]</button><span>@L["."]</span>
                    </span>
                </div>
                <ValidationMessage For="@(() => _register.AcceptTerms)" class="field__error" />

                @if (!string.IsNullOrEmpty(_registerMsg))
                {
                    <p class="auth-alert @(_registerError ? "" : "auth-alert--ok")" role="alert">@_registerMsg</p>
                }

                <button class="nx-btn nx-btn--primary nx-btn--lg nx-btn--block" type="submit" disabled="@_registerBusy">
                    @if (_registerBusy)
                    {
                        <span class="auth-spinner" aria-hidden="true"></span>
                        <span>@L["Creating account..."]</span>
                    }
                    else { <span>@L["Create account"]</span> }
                </button>

                <p class="auth-switch-inline">
                    @L["Already have an account?"]
                    <button type="button" class="auth-switch-inline__btn" @onclick="SwitchToLogin">@L["Log in"]</button>
                </p>
            </EditForm>
        </div>

        <!-- ── Sliding overlay panel ── -->
        <div class="auth-overlay">
            <!-- Shows when register mode is active (slides to the left) -->
            <div class="auth-overlay__half auth-overlay__half--left">
                <div class="auth-overlay__content">
                    <div class="auth-overlay__logo">
                        <span class="auth-mark" aria-hidden="true">N</span>
                        <span>Nestify</span>
                    </div>
                    <h2>@L["Already have an account?"]</h2>
                    <p>@L["Log in and pick up where you left off — your seat, your khala, your settlements."]</p>
                    <button class="auth-overlay__btn" type="button" @onclick="SwitchToLogin">
                        @L["Sign in"]
                    </button>
                </div>
            </div>
            <!-- Shows when login mode is active (slides to the right) -->
            <div class="auth-overlay__half auth-overlay__half--right">
                <div class="auth-overlay__content">
                    <div class="auth-overlay__logo">
                        <span class="auth-mark" aria-hidden="true">N</span>
                        <span>Nestify</span>
                    </div>
                    <h2>@L["New here?"]</h2>
                    <p>@L["One verified account for housing, domestic help, shared expenses, and the marketplace."]</p>
                    <button class="auth-overlay__btn" type="button" @onclick="SwitchToRegister">
                        @L["Create account"]
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<LegalModal Document="_openLegal" OnClose="CloseLegal" />

@code {
    // ── Toggle ───────────────────────────────────────────────────────────────────
    // _animClass drives the full-cover curtain wipe. The two class names alternate
    // on every switch (you can only ever move to the opposite mode), so the CSS
    // animation re-triggers each time without needing a timer to clear it.
    private bool _showRegister;
    private string _animClass = "";
    private LegalDocument? _openLegal;

    protected override void OnInitialized()
    {
        _showRegister = Navigation.ToBaseRelativePath(Navigation.Uri)
            .TrimEnd('/')
            .Equals("register", StringComparison.OrdinalIgnoreCase);
    }

    private void SwitchToLogin()
    {
        if (!_showRegister) return;
        _showRegister = false;
        _animClass    = "auth-card--anim-to-login";
        _loginMsg     = null;
    }

    private void OpenLegal(LegalDocument document) => _openLegal = document;
    private void CloseLegal() => _openLegal = null;

    private void SwitchToRegister()
    {
        if (_showRegister) return;
        _showRegister = true;
        _animClass    = "auth-card--anim-to-register";
        _registerMsg  = null;
    }

    // ── Login ────────────────────────────────────────────────────────────────────
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "That does not look like a valid email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }

    private readonly LoginModel _login = new();
    private bool _showLoginPwd;
    private bool _rememberMe = true;
    private bool _loginBusy;
    private string? _loginMsg;

    private void ShowForgotHint()
        => _loginMsg = "Password reset is not wired up yet — this is a preview build.";

    private async Task HandleLoginAsync()
    {
        _loginBusy = true;
        _loginMsg  = null;
        try
        {
            var result = await AuthService.LoginAsync(new LoginRequestDto
            {
                Email    = _login.Email,
                Password = _login.Password,
            });
            if (result is null) { _loginMsg = "We could not sign you in with those details."; return; }
            Navigation.NavigateTo("/" + RoleRoutes.HomeFor(result.Role), forceLoad: true);
        }
        catch (Exception ex) { _loginMsg = ex.Message; }
        finally { _loginBusy = false; }
    }

    // ── Register ─────────────────────────────────────────────────────────────────
    public enum RegisterRole { User, DomesticHelp }

    private sealed class RegisterModel
    {
        public RegisterRole AccountType { get; set; } = RegisterRole.User;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterNameRequired))]
        [StringLength(120, MinimumLength = 2, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterNameLength))]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterEmailRequired))]
        [RegularExpression(@"^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$",
            ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterEmailFormat))]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterPhoneRequired))]
        [RegularExpression(@"^01[0-9]{9}$", ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterPhoneFormat))]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterPasswordRequired))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterPasswordLength))]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterConfirmRequired))]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterConfirmMatch))]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.RegisterTermsRequired))]
        public bool AcceptTerms { get; set; }
    }

    private readonly RegisterModel _register = new();
    private bool _showRegPwd;
    private bool _showRegConfirm;
    private bool _registerBusy;
    private bool _registerError = true;
    private string? _registerMsg;

    private async Task HandleRegisterAsync()
    {
        _registerBusy  = true;
        _registerMsg   = null;
        _registerError = true;
        try
        {
            var result = await AuthService.RegisterAsync(new RegisterRequestDto
            {
                Name        = _register.Name,
                Email       = _register.Email,
                Phone       = _register.Phone,
                Password    = _register.Password,
                AccountType = _register.AccountType == RegisterRole.DomesticHelp ? "DomesticHelp" : "User",
            });
            if (result is null) { _registerMsg = "We could not create your account with those details."; return; }
            _registerError = false;
            _registerMsg   = "Account created! Taking you in...";
            Navigation.NavigateTo("/" + RoleRoutes.HomeFor(result.Role), forceLoad: true);
        }
        catch (Exception ex) { _registerError = true; _registerMsg = ex.Message; }
        finally { _registerBusy = false; }
    }
}
