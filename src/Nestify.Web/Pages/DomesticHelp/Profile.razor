@page "/helpers/profile"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Shared.Dtos.Profile
@using Nestify.Web.Components
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.Interfaces.IAuthService AuthService
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Nestify.Shared.Dtos.Area
@implements IAsyncDisposable

<PageTitle>My profile — Nestify</PageTitle>

<div class="dh md">
    <div class="dh__inner">
        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar dh-skeleton__bar--tall"></div>
                <div class="dh-skeleton__bar"></div>
            </div>
        }
        else if (P is null)
        {
            <div class="dh-panel dh-rise">
                <div class="dh-empty">
                    <h2>Your profile could not be loaded</h2>
                    <p>@(_loadError ?? "Try again in a moment.")</p>
                    <button class="nx-btn nx-btn--accent" type="button" @onclick="Load">Try again</button>
                </div>
            </div>
        }
        else
        {
            @if (!P.IsComplete)
            {
                <div class="md-callout dh-rise">
                    <div>
                        <strong>Finish your profile so bachelors can find you</strong>
                        <span>Sign-up only asked for your name, phone and email. Still missing: @string.Join(", ", Missing). Use the Edit links on each card.</span>
                    </div>
                    <button class="nx-btn nx-btn--accent" type="button" @onclick="() => OpenEdit(FirstMissing)">Fill in @FirstMissingLabel</button>
                </div>
            }
            else if (!P.IsAcceptingBookings)
            {
                <div class="md-callout md-callout--ok dh-rise">
                    <div>
                        <strong>Your profile is complete</strong>
                        <span>You are still hidden from bachelors. Turn on accepting bookings whenever you are ready for requests.</span>
                    </div>
                    <button class="nx-btn nx-btn--accent" type="button" disabled="@_goingLive" @onclick="GoLive">@(_goingLive ? "Turning on…" : "Accept bookings")</button>
                </div>
            }

            <header class="md-profile dh-rise">
                <div class="md-profile__glow" aria-hidden="true"></div>

                <div class="md-profile__ring">
                    <button type="button" class="md-photo" @onclick="OpenPhoto" title="View photo" aria-label="View profile photo">
                        <img src="@P.PhotoUrl" alt="Profile photo of @P.FullName" />
                        <span class="md-photo__hint">View</span>
                    </button>
                    <span class="md-profile__status @(P.IsAcceptingBookings ? "md-profile__status--on" : null)" title="@(P.IsAcceptingBookings ? "Accepting bookings" : "Paused")"></span>
                    <label class="md-photo__change">
                        <InputFile OnChange="PickPhoto" accept="image/*" class="md-photo__file" disabled="@_uploading" />
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z" /><circle cx="12" cy="13" r="4" /></svg>
                        <span>@(_uploading ? "Uploading…" : "Change")</span>
                    </label>
                </div>

                <div class="md-profile__body">
                    <p class="dh-kicker">Domestic Helper</p>
                    <h1>
                        @P.FullName
                        @if (P.IsVerified)
                        {
                            <span class="md-verified" title="Verified by Nestify">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                            </span>
                        }
                    </h1>
                    <p class="md-profile__headline">@(string.IsNullOrWhiteSpace(P.Headline) ? "Add a headline so bachelors know what you do best." : P.Headline)</p>
                    <div class="md-profile__meta">
                        <RatingStars Value="P.RatingAverage" Count="P.RatingCount" />
                        <span class="dh-profile__dot" aria-hidden="true"></span>
                        <span class="dh-profile__where">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                            @P.AreaName
                        </span>
                    </div>
                    <div class="dh-badges">
                        <span>@(P.IsAcceptingBookings ? "Accepting bookings" : "Paused")</span>
                        <span>Member since @P.JoinedAtUtc.ToLocalTime().ToString("MMM yyyy")</span>
                        @switch (P.Verification.State)
                        {
                            case HelperVerificationState.Verified:
                                <span>Verified</span>
                                break;
                            case HelperVerificationState.Pending:
                                <span>Verification pending</span>
                                break;
                            default:
                                if (P.IsComplete)
                                {
                                    <button type="button" class="dh-chip dh-chip--on" @onclick="OpenVerification">Apply for verification</button>
                                }
                                break;
                        }
                    </div>
                </div>

                <div class="md-profile__actions">
                    <button class="nx-btn nx-btn--light" type="button" @onclick="() => OpenEdit(EditSection.Account)">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                        Edit profile
                    </button>
                    <button class="nx-btn nx-btn--ghost" type="button" @onclick="OpenPassword">Change password</button>
                    <button class="nx-btn nx-btn--ghost" type="button" @onclick="SignOut">Log out</button>
                </div>
            </header>

            <div class="md-stats dh-rise" style="--d:60ms">
                <div class="md-stat">
                    <span class="md-stat__value">@P.RatingAverage.ToString("0.0")</span>
                    <span class="md-stat__label">rating</span>
                </div>
                <div class="md-stat">
                    <span class="md-stat__value">@P.CompletedCount</span>
                    <span class="md-stat__label">completed</span>
                </div>
                <div class="md-stat">
                    <span class="md-stat__value">@P.ActiveCount</span>
                    <span class="md-stat__label">active</span>
                </div>
                <div class="md-stat md-stat--soft">
                    <span class="md-stat__value">@P.ExperienceYears<small> yrs</small></span>
                    <span class="md-stat__label">experience</span>
                </div>
            </div>

            <div class="dh-grid md-profile-grid">
                <section class="dh-panel dh-rise" style="--d:120ms">
                    <div class="dh-panel__head">
                        <h2>Account</h2>
                        <button type="button" class="md-link" @onclick="() => OpenEdit(EditSection.Account)">Edit</button>
                    </div>
                    <div class="dh-facts">
                        <div class="dh-fact"><span>Full name</span><strong>@P.FullName</strong></div>
                        <div class="dh-fact"><span>Email</span><strong>@P.Email</strong></div>
                        <div class="dh-fact"><span>Phone</span><strong>@P.PhoneNumber</strong></div>
                        <div class="dh-fact"><span>Joined</span><strong>@P.JoinedAtUtc.ToLocalTime().ToString("d MMMM yyyy")</strong></div>
                    </div>
                </section>

                <section class="dh-panel dh-rise" style="--d:180ms">
                    <div class="dh-panel__head">
                        <h2>About me</h2>
                        <button type="button" class="md-link" @onclick="() => OpenEdit(EditSection.About)">Edit</button>
                    </div>
                    <p class="md-bio">@(string.IsNullOrWhiteSpace(P.Bio) ? "Nothing written yet. A few lines about your work help bachelors pick you." : P.Bio)</p>
                    <div class="dh-facts">
                        <div class="dh-fact"><span>Languages</span><strong>@P.Languages</strong></div>
                        <div class="dh-fact"><span>Experience</span><strong>@P.ExperienceYears year(s)</strong></div>
                    </div>
                </section>

                <section class="dh-panel dh-rise" style="--d:240ms">
                    <div class="dh-panel__head">
                        <h2>Services and rate</h2>
                        <button type="button" class="md-link" @onclick="() => OpenEdit(EditSection.Services)">Edit</button>
                    </div>
                    <div class="dh-tags">
                        @foreach (var s in P.Services)
                        {
                            <span class="dh-tag">@ServiceTypes.Label(s)</span>
                        }
                        @if (P.Services.Count == 0)
                        {
                            <span class="dh-muted">No services picked yet.</span>
                        }
                    </div>
                    <p class="md-rate">@(P.MonthlyRate > 0 ? Money.Format(P.MonthlyRate) : "Rate not set")<span>@(P.MonthlyRate > 0 ? "/month" : "")</span></p>
                    <div class="dh-facts">
                        <div class="dh-fact"><span>Open hours per week</span><strong>@P.OpenHoursPerWeek h</strong></div>
                    </div>
                    <a class="md-link" href="helpers/availability">Change my hours</a>
                </section>

                <section class="dh-panel dh-rise" style="--d:300ms">
                    <div class="dh-panel__head">
                        <h2>Where I live</h2>
                        <button type="button" class="md-link" @onclick="() => OpenEdit(EditSection.Address)">Edit</button>
                    </div>
                    <div class="dh-facts">
                        <div class="dh-fact"><span>Area</span><strong>@(string.IsNullOrWhiteSpace(P.AreaName) ? "Not set" : P.AreaName)</strong></div>
                        <div class="dh-fact"><span>Address</span><strong>@(string.IsNullOrWhiteSpace(P.AddressLine) ? "Not set" : P.AddressLine)</strong></div>
                        <div class="dh-fact"><span>Pin</span><strong>@P.Latitude.ToString("0.0000"), @P.Longitude.ToString("0.0000")</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(P.AddressLine))
                    {
                        <a class="md-link" target="_blank" rel="noopener"
                           href="@($"https://www.openstreetmap.org/?mlat={P.Latitude}&mlon={P.Longitude}#map=17/{P.Latitude}/{P.Longitude}")">Open on map →</a>
                    }
                    <p class="dh-muted">Only the area is shown to bachelors. The address and pin stay private.</p>
                </section>

                <section class="dh-panel dh-rise" style="--d:360ms">
                    <div class="dh-panel__head">
                        <h2>Verification</h2>
                    </div>
                    <div class="md-verify">
                        <span class="md-verify__icon @(P.Verification.State == HelperVerificationState.Pending ? "md-verify__icon--pending" : null) @(P.Verification.State == HelperVerificationState.Verified ? "md-verify__icon--ok" : null)" aria-hidden="true">
                            <svg class="nx-icon" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg>
                        </span>
                        <div>
                            @switch (P.Verification.State)
                            {
                                case HelperVerificationState.Verified:
                                    <strong>Verified</strong>
                                    <p class="dh-muted">An admin checked your photo and NID. Bachelors see the verified badge on your profile.</p>
                                    break;
                                case HelperVerificationState.Pending:
                                    <strong>Under review</strong>
                                    <p class="dh-muted">Your photo and NID were sent @P.Verification.SubmittedAtUtc?.ToLocalTime().ToString("d MMM"). An admin will look at them soon.</p>
                                    break;
                                case HelperVerificationState.Rejected:
                                    <strong>Not approved</strong>
                                    <p class="dh-muted">@(P.Verification.RejectionReason ?? "The admin could not approve your documents.") You can apply again with better photos.</p>
                                    break;
                                default:
                                    <strong>Not applied yet</strong>
                                    <p class="dh-muted">Verified helpers are shown first and get more requests. Pay the fee through bKash, then send a photo of yourself and your NID.</p>
                                    break;
                            }
                        </div>
                    </div>
                    @if (P.Verification.State == HelperVerificationState.Pending)
                    {
                        <button class="nx-btn nx-btn--ghost" type="button" disabled="@_cancellingVerification" @onclick="CancelVerification">@(_cancellingVerification ? "Withdrawing…" : "Withdraw application")</button>
                    }
                    else if (P.Verification.State != HelperVerificationState.Verified)
                    {
                        if (P.IsComplete)
                        {
                            <button class="nx-btn nx-btn--accent" type="button" @onclick="OpenVerification">@(P.Verification.State == HelperVerificationState.Rejected ? "Apply again" : "Apply for verification")</button>
                        }
                        else
                        {
                            <p class="dh-muted">Complete your profile first — services, rate and address — then you can apply.</p>
                            <button class="nx-btn nx-btn--ghost" type="button" @onclick="() => OpenEdit(FirstMissing)">Fill in @FirstMissingLabel</button>
                        }
                    }
                </section>
            </div>
        }
    </div>
</div>

@* ---------- photo lightbox ---------- *@
@if (_showPhoto && P is not null)
{
    <div class="md-overlay md-overlay--dark" @onclick="ClosePhoto">
        <figure class="md-lightbox" @onclick:stopPropagation="true">
            <img src="@P.PhotoUrl" alt="Profile photo of @P.FullName" />
            <figcaption>@P.FullName</figcaption>
            <button type="button" class="md-modal__close md-lightbox__close" @onclick="ClosePhoto" aria-label="Close">&times;</button>
        </figure>
    </div>
}

@* ---------- edit: one small dialog per card ---------- *@
@if (_edit != EditSection.None && _draft is not null)
{
    <div class="md-overlay" @onclick="CloseEdit">
        <div class="md-modal @(_edit == EditSection.Address ? null : "md-modal--sm")" role="dialog" aria-modal="true" aria-labelledby="edit-title" @onclick:stopPropagation="true">
            <header class="md-modal__head">
                <h2 id="edit-title">@EditTitle</h2>
                <button type="button" class="md-modal__close" @onclick="CloseEdit" aria-label="Close">&times;</button>
            </header>

            <div class="md-modal__body md-modal__body--stack">
                @switch (_edit)
                {
                    case EditSection.Account:
                        <div class="md-form">
                            <div class="md-field md-field--wide">
                                <label for="ed-name">Full name</label>
                                <input id="ed-name" maxlength="120" @bind="_draft.FullName" />
                            </div>
                            <div class="md-field md-field--wide">
                                <label for="ed-phone">Phone</label>
                                <input id="ed-phone" type="tel" maxlength="20" @bind="_draft.PhoneNumber" />
                            </div>
                            <div class="md-field md-field--wide">
                                <label for="ed-email">Email</label>
                                <input id="ed-email" value="@P?.Email" disabled />
                                <small>Email can't be changed here.</small>
                            </div>
                        </div>
                        break;

                    case EditSection.About:
                        <div class="md-form">
                            <div class="md-field md-field--wide">
                                <label for="ed-headline">Headline</label>
                                <input id="ed-headline" maxlength="120" @bind="_draft.Headline" placeholder="One line about what you do best, e.g. Cooking and cleaning for bachelor flats" />
                            </div>
                            <div class="md-field md-field--wide">
                                <label for="ed-bio">About me</label>
                                <textarea id="ed-bio" rows="5" maxlength="1000" @bind="_draft.Bio" placeholder="Where you have worked, what you cook, how you like to work."></textarea>
                            </div>
                            <div class="md-field">
                                <label for="ed-lang">Languages</label>
                                <input id="ed-lang" maxlength="120" @bind="_draft.Languages" placeholder="Bangla, basic English" />
                            </div>
                            <div class="md-field">
                                <label for="ed-exp">Years of experience</label>
                                <input id="ed-exp" type="number" min="0" max="60" @bind="_draft.ExperienceYears" />
                            </div>
                        </div>
                        break;

                    case EditSection.Services:
                        <div class="md-field">
                            <span class="md-field__label">Services you offer</span>
                            <div class="dh-chips">
                                @foreach (var type in Enum.GetValues<ServiceType>())
                                {
                                    var t = type;
                                    var on = _draft.Services.Contains(t);
                                    <button type="button" class="dh-chip @(on ? "dh-chip--on" : null)" aria-pressed="@on.ToString().ToLowerInvariant()" @onclick="() => ToggleService(t)">
                                        @ServiceTypes.Label(t)
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="md-form">
                            <div class="md-field md-field--wide">
                                <label for="ed-rate">Monthly rate (৳)</label>
                                <input id="ed-rate" type="number" min="0" step="100" @bind="_draft.MonthlyRate" />
                                <small>What you charge one home for a month of the hours they book.</small>
                            </div>
                        </div>
                        break;

                    case EditSection.Address:
                        <div class="md-form">
                            <div class="md-field md-field--wide">
                                <span class="md-field__label">Area</span>
                                <AreaCascade Selection="_area" SelectionChanged="OnAreaChanged" />
                            </div>
                            <div class="md-field md-field--wide">
                                <label for="ed-address">Address</label>
                                <input id="ed-address" maxlength="300" @bind="_draft.AddressLine" placeholder="House, road, block — the way you would tell a rickshaw puller" />
                            </div>
                            <div class="md-field md-field--wide">
                                <span class="md-field__label">Your home on the map</span>
                                <div id="edit-map" class="md-map"></div>
                                <small>Click the map or drag the pin to where you live. (@_draft.Latitude.ToString("0.0000"), @_draft.Longitude.ToString("0.0000"))</small>
                            </div>
                        </div>
                        break;
                }

                @if (_editError is not null)
                {
                    <p class="md-msg md-msg--bad">@_editError</p>
                }
            </div>

            <footer class="md-modal__foot">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseEdit" disabled="@_saving">Cancel</button>
                <button type="button" class="nx-btn nx-btn--accent" @onclick="SaveEdit" disabled="@_saving">@(_saving ? "Saving…" : "Save changes")</button>
            </footer>
        </div>
    </div>
}

@* ---------- change password ---------- *@
@if (_showPassword)
{
    <div class="md-overlay" @onclick="ClosePassword">
        <div class="md-modal md-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="md-modal__head">
                <h2>Change password</h2>
                <button type="button" class="md-modal__close" @onclick="ClosePassword" aria-label="Close">&times;</button>
            </header>
            <div class="md-modal__body md-modal__body--stack">
                <div class="md-field">
                    <label for="pw-current">Current password</label>
                    <div class="md-pw">
                        <input id="pw-current" type="@(_showCurrent ? "text" : "password")" @bind="_currentPassword" />
                        <button type="button" class="md-pw__toggle" @onclick="() => _showCurrent = !_showCurrent">@(_showCurrent ? "Hide" : "Show")</button>
                    </div>
                </div>
                <div class="md-field">
                    <label for="pw-new">New password</label>
                    <div class="md-pw">
                        <input id="pw-new" type="@(_showNew ? "text" : "password")" @bind="_newPassword" />
                        <button type="button" class="md-pw__toggle" @onclick="() => _showNew = !_showNew">@(_showNew ? "Hide" : "Show")</button>
                    </div>
                </div>
                <div class="md-field">
                    <label for="pw-confirm">Confirm new password</label>
                    <div class="md-pw">
                        <input id="pw-confirm" type="@(_showConfirm ? "text" : "password")" @bind="_confirmPassword" />
                        <button type="button" class="md-pw__toggle" @onclick="() => _showConfirm = !_showConfirm">@(_showConfirm ? "Hide" : "Show")</button>
                    </div>
                </div>
                @if (_passwordError is not null)
                {
                    <p class="md-msg md-msg--bad">@_passwordError</p>
                }
            </div>
            <footer class="md-modal__foot">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="ClosePassword" disabled="@_savingPassword">Cancel</button>
                <button type="button" class="nx-btn nx-btn--accent" @onclick="SavePassword" disabled="@_savingPassword">@(_savingPassword ? "Updating…" : "Update password")</button>
            </footer>
        </div>
    </div>
}

@* ---------- verification: documents, bKash, done ---------- *@
@if (_showVerification)
{
    <div class="md-overlay" @onclick="CloseVerification">
        <div class="md-modal md-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            @if (_verificationStep == VerificationStep.Documents)
            {
                <header class="md-modal__head">
                    <h2>Verify your profile</h2>
                    <button type="button" class="md-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button>
                </header>
                <div class="md-modal__body md-modal__body--stack">
                    <p class="dh-muted">Upload a clear photo of yourself and a photo of your NID. An admin compares them with your profile before the verified badge is added.</p>

                    <div class="md-field">
                        <label for="vf-photo">Your photo</label>
                        <label class="md-picker @(_photoPreview is not null ? "md-picker--has" : null)" for="vf-photo">
                            <InputFile id="vf-photo" OnChange="PickPhotoDocument" accept="image/*" class="md-photo__file" />
                            @if (_photoPreview is not null)
                            {
                                <img src="@_photoPreview" alt="Your photo preview" />
                                <span class="md-picker__label">Replace photo</span>
                            }
                            else
                            {
                                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 4-6 8-6s8 2 8 6" /></svg>
                                <span class="md-picker__label">Choose a clear photo of your face</span>
                            }
                        </label>
                    </div>

                    <div class="md-field">
                        <label for="vf-nid">National ID (NID)</label>
                        <label class="md-picker @(_nidPreview is not null ? "md-picker--has" : null)" for="vf-nid">
                            <InputFile id="vf-nid" OnChange="PickNidDocument" accept="image/*" class="md-photo__file" />
                            @if (_nidPreview is not null)
                            {
                                <img src="@_nidPreview" alt="NID preview" />
                                <span class="md-picker__label">Replace photo</span>
                            }
                            else
                            {
                                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2.5" /><path d="M14 10h4M14 14h4" /></svg>
                                <span class="md-picker__label">Choose a clear photo of your NID</span>
                            }
                        </label>
                    </div>

                    @if (_verificationError is not null)
                    {
                        <p class="md-msg md-msg--bad">@_verificationError</p>
                    }
                </div>
                <footer class="md-modal__foot">
                    <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseVerification">Cancel</button>
                    <button type="button" class="nx-btn nx-btn--accent" @onclick="GoToPayment">Continue to payment</button>
                </footer>
            }
            else if (_verificationStep == VerificationStep.Payment)
            {
                <header class="md-modal__head md-bkash__head">
                    <div class="md-bkash__brand"><span class="md-bkash__logo">bKash</span><span>Payment</span></div>
                    <button type="button" class="md-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button>
                </header>
                <div class="md-modal__body md-modal__body--stack">
                    <div class="md-bkash__summary">
                        <div><span>Merchant</span><b>Nestify</b></div>
                        <div><span>Purpose</span><b>Helper verification fee</b></div>
                        <div><span>Amount</span><b class="md-bkash__amount">৳@_verificationFee.ToString("N0")</b></div>
                    </div>
                    <div class="md-field">
                        <label for="bkash-number">Your bKash account number</label>
                        <input id="bkash-number" inputmode="numeric" placeholder="01XXXXXXXXX" maxlength="14" @bind="_bkashNumber" />
                    </div>
                    <div class="md-field">
                        <label for="bkash-pin">bKash PIN</label>
                        <input id="bkash-pin" type="password" inputmode="numeric" placeholder="4 or 5 digits" maxlength="5" @bind="_bkashPin" />
                    </div>
                    <p class="dh-muted">This is a practice payment portal. Any Bangladeshi mobile number and any 4-5 digit PIN will be accepted.</p>
                    @if (_verificationError is not null)
                    {
                        <p class="md-msg md-msg--bad">@_verificationError</p>
                    }
                </div>
                <footer class="md-modal__foot">
                    <button type="button" class="nx-btn nx-btn--ghost" disabled="@_paying" @onclick="BackToDocuments">Back</button>
                    <button type="button" class="nx-btn md-btn--bkash" disabled="@_paying" @onclick="PayAndSubmit">@(_paying ? "Processing…" : $"Pay ৳{_verificationFee:N0}")</button>
                </footer>
            }
            else
            {
                var payment = _payment!;
                <header class="md-modal__head">
                    <h2>Payment successful</h2>
                    <button type="button" class="md-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button>
                </header>
                <div class="md-modal__body md-modal__body--stack">
                    <div class="md-bkash__done">
                        <span class="md-bkash__tick" aria-hidden="true">&#10003;</span>
                        <p class="md-bkash__done-title">৳@payment.AmountBdt.ToString("N0") paid from @payment.BkashNumber</p>
                        <p class="dh-muted">Transaction ID <b>@payment.TransactionId</b> &middot; @payment.PaidAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p>
                    </div>
                    @if (_applicationSent)
                    {
                        <p class="md-msg md-msg--good">Your photo and NID have been sent. An admin will review them soon.</p>
                    }
                    else if (_submittingVerification)
                    {
                        <p class="dh-muted">Sending your application…</p>
                    }
                    else if (_verificationError is not null)
                    {
                        <p class="md-msg md-msg--bad">@_verificationError</p>
                    }
                </div>
                <footer class="md-modal__foot">
                    @if (_applicationSent)
                    {
                        <button type="button" class="nx-btn nx-btn--accent" @onclick="CloseVerification">Done</button>
                    }
                    else
                    {
                        <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseVerification">Close</button>
                        <button type="button" class="nx-btn nx-btn--accent" disabled="@_submittingVerification" @onclick="SendApplication">@(_submittingVerification ? "Sending…" : "Send application again")</button>
                    }
                </footer>
            }
        </div>
    </div>
}

@code {
    private const long MaxPhotoBytes = 10 * 1024 * 1024;

    private HelperProfileDto? P;
    private bool _loading = true;
    private string? _loadError;

    private bool _showPhoto;
    private bool _uploading;

    private enum EditSection { None, Account, About, Services, Address }

    private EditSection _edit = EditSection.None;
    private HelperProfileFormDto? _draft;
    private AreaSelectionDto _area = new();
    private string? _editError;
    private bool _saving;
    private bool _goingLive;
    private bool _mapPending;
    private bool _mapShown;
    private DotNetObjectReference<Profile>? _selfRef;

    private bool _showPassword;
    private bool _showCurrent, _showNew, _showConfirm;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private bool _savingPassword;

    // What is still empty, in the order the cards appear.
    private List<EditSection> MissingSections
    {
        get
        {
            var list = new List<EditSection>();
            if (P is null) return list;
            if (P.Services.Count == 0 || P.MonthlyRate <= 0) list.Add(EditSection.Services);
            if (string.IsNullOrWhiteSpace(P.AddressLine)) list.Add(EditSection.Address);
            return list;
        }
    }

    private IEnumerable<string> Missing => MissingSections.Select(SectionLabel);
    private EditSection FirstMissing => MissingSections.FirstOrDefault(EditSection.Services);
    private string FirstMissingLabel => SectionLabel(FirstMissing).ToLowerInvariant();

    private static string SectionLabel(EditSection section) => section switch
    {
        EditSection.Account => "Account",
        EditSection.About => "About me",
        EditSection.Services => "Services and rate",
        EditSection.Address => "Where you live",
        _ => "Profile"
    };

    private string EditTitle => _edit switch
    {
        EditSection.Account => "Edit account",
        EditSection.About => "Edit about me",
        EditSection.Services => "Edit services and rate",
        EditSection.Address => "Edit where you live",
        _ => "Edit"
    };

    private enum VerificationStep { Documents, Payment, Done }

    private bool _showVerification;
    private VerificationStep _verificationStep;
    private IBrowserFile? _photoFile;
    private IBrowserFile? _nidFile;
    // Byte buffers read BEFORE the InputFile elements are unmounted on step change
    private byte[]? _photoBytes;
    private string? _photoContentType;
    private string? _photoName;
    private byte[]? _nidBytes;
    private string? _nidContentType;
    private string? _nidName;
    private string? _photoPreview;
    private string? _nidPreview;
    private string? _verificationError;
    private decimal _verificationFee;
    private string _bkashNumber = string.Empty;
    private string _bkashPin = string.Empty;
    private bool _paying;
    private VerificationPaymentDto? _payment;
    private bool _submittingVerification;
    private bool _applicationSent;
    private bool _cancellingVerification;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _loadError = null;
        try
        {
            P = await Helpers.GetMyProfileAsync();
        }
        catch (Exception ex)
        {
            P = null;
            _loadError = ex.Message;
        }
        _loading = false;
    }

    // ---------- photo ----------

    private void OpenPhoto() => _showPhoto = true;
    private void ClosePhoto() => _showPhoto = false;

    private async Task PickPhoto(InputFileChangeEventArgs e)
    {
        if (e.File.Size > 5 * 1024 * 1024)
        {
            Toast.ShowWarning("The picture must be 5 MB or smaller.", "Photo");
            return;
        }

        _uploading = true;
        try
        {
            P = await Helpers.UploadPhotoAsync(e.File);
            Toast.ShowSuccess("Profile photo updated.", "Photo");
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Photo");
        }
        finally
        {
            _uploading = false;
        }
    }

    // ---------- edit ----------

    // Each card opens its own small dialog, but they all edit one draft that
    // is sent whole, so the other cards keep their values.
    private void OpenEdit(EditSection section)
    {
        if (P is null) return;
        _draft = new HelperProfileFormDto
        {
            FullName = P.FullName,
            PhoneNumber = P.PhoneNumber,
            Headline = P.Headline,
            Bio = P.Bio,
            Languages = P.Languages,
            Services = P.Services.ToList(),
            MonthlyRate = P.MonthlyRate,
            ExperienceYears = P.ExperienceYears,
            DivisionId = P.DivisionId,
            DistrictId = P.DistrictId,
            UpazilaId = P.UpazilaId,
            AddressLine = P.AddressLine,
            Latitude = P.Latitude,
            Longitude = P.Longitude
        };
        _area = new AreaSelectionDto { DivisionId = P.DivisionId, DistrictId = P.DistrictId, UpazilaId = P.UpazilaId };
        _editError = null;
        _edit = section;
        _mapPending = section == EditSection.Address;
    }

    // The map lives inside the address dialog, so it is drawn after that
    // dialog renders and removed when it closes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapPending || _draft is null) return;
        _mapPending = false;
        _mapShown = true;
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("nestifyMapPicker.init", "edit-map", _draft.Latitude, _draft.Longitude, _selfRef);
    }

    [JSInvokable]
    public void OnMapPicked(double latitude, double longitude)
    {
        if (_draft is null) return;
        _draft.Latitude = Math.Round(latitude, 6);
        _draft.Longitude = Math.Round(longitude, 6);
        StateHasChanged();
    }

    private async Task CloseEdit()
    {
        if (_saving) return;
        if (_mapShown)
        {
            _mapShown = false;
            try { await JS.InvokeVoidAsync("nestifyMapPicker.destroy", "edit-map"); } catch { }
        }
        _edit = EditSection.None;
    }

    private void ToggleService(ServiceType type)
    {
        if (_draft is null) return;
        if (!_draft.Services.Remove(type)) _draft.Services.Add(type);
    }

    private void OnAreaChanged(AreaSelectionDto selection)
    {
        if (_draft is null) return;
        _area = selection;
        _draft.DivisionId = selection.DivisionId;
        _draft.DistrictId = selection.DistrictId;
        _draft.UpazilaId = selection.UpazilaId;
    }

    private async Task SaveEdit()
    {
        if (_draft is null) return;

        _editError = _edit switch
        {
            EditSection.Services when _draft.Services.Count == 0 => "Pick at least one service.",
            EditSection.Services when _draft.MonthlyRate <= 0 => "Set a monthly rate.",
            EditSection.Address when _draft.UpazilaId is null => "Pick the area where you live.",
            EditSection.Address when string.IsNullOrWhiteSpace(_draft.AddressLine) => "Write your address.",
            _ => null
        };
        if (_editError is not null) return;

        var section = _edit;
        _saving = true;
        try
        {
            P = await Helpers.UpdateProfileAsync(_draft);
            _saving = false;
            await CloseEdit();
            Toast.ShowSuccess($"{SectionLabel(section)} saved.", "Profile");
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // Switches the "accepting bookings" flag on without touching the board.
    private async Task GoLive()
    {
        var availability = await Helpers.GetAvailabilityAsync();
        if (availability is null) return;
        _goingLive = true;
        try
        {
            availability.IsAvailable = true;
            await Helpers.SaveAvailabilityAsync(availability);
            P = await Helpers.GetMyProfileAsync();
            Toast.ShowSuccess("Bachelors can now find and book you.", "Accepting bookings");
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Accepting bookings");
        }
        finally
        {
            _goingLive = false;
        }
    }

    // ---------- password ----------

    private void OpenPassword()
    {
        _currentPassword = _newPassword = _confirmPassword = string.Empty;
        _showCurrent = _showNew = _showConfirm = false;
        _passwordError = null;
        _showPassword = true;
    }

    private void ClosePassword()
    {
        if (_savingPassword) return;
        _showPassword = false;
    }

    private async Task SavePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword)) { _passwordError = "Enter your current password."; return; }
        if (_newPassword.Length < 8) { _passwordError = "The new password needs at least 8 characters."; return; }
        if (_newPassword != _confirmPassword) { _passwordError = "The two new passwords don't match."; return; }
        if (_newPassword == _currentPassword) { _passwordError = "The new password must be different from the current one."; return; }

        _passwordError = null;
        _savingPassword = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
            _showPassword = false;
            Toast.ShowSuccess("Password updated.", "Security");
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _savingPassword = false;
        }
    }

    // ---------- verification ----------

    private void OpenVerification()
    {
        _verificationStep = VerificationStep.Documents;
        _photoFile = _nidFile = null;
        _photoBytes = _nidBytes = null;
        _photoContentType = _photoName = _nidContentType = _nidName = null;
        _photoPreview = _nidPreview = null;
        _verificationError = null;
        _bkashNumber = _bkashPin = string.Empty;
        _payment = null;
        _applicationSent = false;
        _showVerification = true;
    }

    private void CloseVerification()
    {
        if (_paying || _submittingVerification) return;
        _showVerification = false;
    }

    private async Task PickPhotoDocument(InputFileChangeEventArgs e)
    {
        _photoFile = e.File;
        _verificationError = null;
        _photoPreview = await PreviewOf(e.File);
    }

    private async Task PickNidDocument(InputFileChangeEventArgs e)
    {
        _nidFile = e.File;
        _verificationError = null;
        _nidPreview = await PreviewOf(e.File);
    }

    private static async Task<string?> PreviewOf(IBrowserFile file)
    {
        try
        {
            var preview = await file.RequestImageFileAsync("image/jpeg", 480, 480);
            await using var stream = preview.OpenReadStream(MaxPhotoBytes);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            return $"data:image/jpeg;base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch
        {
            return null;
        }
    }

    private async Task GoToPayment()
    {
        if (_photoFile is null || _nidFile is null)
        {
            _verificationError = "Add both photos to continue.";
            return;
        }

        _verificationError = null;
        try
        {
            _verificationFee = await Helpers.GetVerificationFeeAsync();

            // Read both files into memory NOW while the <InputFile> elements are
            // still mounted. Once _verificationStep changes Blazor will unmount
            // those elements and the IBrowserFile references become invalid.
            await using (var ms = new MemoryStream())
            {
                await using var s = _photoFile.OpenReadStream(MaxPhotoBytes);
                await s.CopyToAsync(ms);
                _photoBytes = ms.ToArray();
            }
            _photoContentType = _photoFile.ContentType;
            _photoName = _photoFile.Name;

            await using (var ms = new MemoryStream())
            {
                await using var s = _nidFile.OpenReadStream(MaxPhotoBytes);
                await s.CopyToAsync(ms);
                _nidBytes = ms.ToArray();
            }
            _nidContentType = _nidFile.ContentType;
            _nidName = _nidFile.Name;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            return;
        }

        _verificationStep = VerificationStep.Payment;
    }

    private void BackToDocuments()
    {
        _verificationError = null;
        _verificationStep = VerificationStep.Documents;
    }

    private static bool LooksLikeBangladeshiNumber(string number)
    {
        var digits = new string(number.Where(char.IsDigit).ToArray());
        if (digits.Length == 13 && digits.StartsWith("88")) digits = digits[2..];
        return digits.Length == 11 && digits.StartsWith("01") && digits[2] is >= '3' and <= '9';
    }

    // The payment is recorded first; the application follows with the payment
    // id so the receipt and the request stay linked.
    private async Task PayAndSubmit()
    {
        var number = _bkashNumber.Trim();
        if (!LooksLikeBangladeshiNumber(number))
        {
            _verificationError = "Enter a valid number like 01712345678.";
            return;
        }
        if (_bkashPin.Length is < 4 or > 5 || !_bkashPin.All(char.IsDigit))
        {
            _verificationError = "The bKash PIN must be 4 or 5 digits.";
            return;
        }

        _verificationError = null;
        _paying = true;
        try
        {
            _payment = await Helpers.PayVerificationFeeAsync(number, _bkashPin);
            _bkashPin = string.Empty;
            _verificationStep = VerificationStep.Done;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            return;
        }
        finally
        {
            _paying = false;
        }

        await SendApplication();
    }

    private async Task SendApplication()
    {
        // Use the byte buffers captured in GoToPayment — the IBrowserFile
        // references are invalid after the InputFile elements were unmounted.
        if (_payment is null || _photoBytes is null || _nidBytes is null) return;

        _verificationError = null;
        _submittingVerification = true;
        try
        {
            await Helpers.SubmitVerificationAsync(
                _photoBytes, _photoContentType ?? "image/jpeg", _photoName ?? "photo.jpg",
                _nidBytes, _nidContentType ?? "image/jpeg", _nidName ?? "nid.jpg",
                _payment.PaymentId);
            _applicationSent = true;
            P = await Helpers.GetMyProfileAsync();
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
        }
        finally
        {
            _submittingVerification = false;
        }
    }

    private async Task CancelVerification()
    {
        _cancellingVerification = true;
        try
        {
            await Helpers.CancelVerificationAsync();
            P = await Helpers.GetMyProfileAsync();
            Toast.ShowInfo("Your verification application was withdrawn.", "Verification");
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Verification");
        }
        finally
        {
            _cancellingVerification = false;
        }
    }

    // ---------- misc ----------

    private async Task SignOut()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapShown)
        {
            try { await JS.InvokeVoidAsync("nestifyMapPicker.destroy", "edit-map"); } catch { }
        }
        _selfRef?.Dispose();
    }
}
