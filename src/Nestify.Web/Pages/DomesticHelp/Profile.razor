@page "/helpers/profile"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Nestify.Shared.Dtos.Profile
@using Nestify.Web.Components
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserProfileService ProfileService
@inject IHelperService Helpers

<PageTitle>Maid Profile - Nestify</PageTitle>

@if (_loading)
{
    <div class="dh"><div class="dh__inner"><p class="dh-muted">Loading profile...</p></div></div>
}
else
{
    <div class="dh">
        <div class="dh__inner">
            <header class="dh-head dh-rise">
                <p class="dh-kicker">My profile</p>
                <h1>Maid Profile</h1>
                <p>
                    A domestic helper profile with service area, availability, monthly rates,
                    verification status, and engagement history.
                </p>
            </header>

            <div class="dh-hero dh-rise" style="--d:80ms">
                <div class="dh-identity">
                    <div class="dh-avatar">@DisplayInitials</div>
                    <div>
                        <p class="dh-kicker">DomesticHelper</p>
                        <h2>@DisplayName</h2>
                        <p>@(_helper?.AreaName ?? "Area not set")</p>
                    </div>
                </div>
                <div class="dh-badges" aria-label="Status">
                    @if (_profile?.VerificationState == VerificationState.Verified)
                    {
                        <span>Verified</span>
                    }
                    else if (_profile?.VerificationState == VerificationState.Pending)
                    {
                        <span>Verification pending</span>
                    }
                    else
                    {
                        <button type="button" class="dh-chip dh-chip--on" @onclick="OpenVerification">Apply for verification</button>
                    }
                    <span>@(_helper is null ? "No profile yet" : "Active")</span>
                    <span>@(_helper?.RatingAverage.ToString("0.0") ?? "0.0") rating</span>
                </div>
            </div>

            <div class="dh-grid dh-grid--profile">
                <section class="dh-panel dh-panel--span2 dh-rise" style="--d:140ms">
                    <div class="dh-panel__head"><h2>Helper Details</h2></div>
                    @if (_helper is null)
                    {
                        <p class="dh-muted">You haven't registered as a helper yet. <a href="helpers/register">Register now</a>.</p>
                    }
                    else
                    {
                        <div class="dh-facts">
                            <div class="dh-fact"><span>Display name</span><strong>@DisplayName</strong></div>
                            <div class="dh-fact"><span>Services</span><strong>@string.Join(", ", _helper.Services)</strong></div>
                            <div class="dh-fact"><span>Monthly rate</span><strong>BDT @_helper.MonthlyRate.ToString("N0")</strong></div>
                            <div class="dh-fact"><span>Availability</span><strong>@_helper.AvailabilityWindow</strong></div>
                        </div>
                    }
                </section>

                <section class="dh-panel dh-rise" style="--d:200ms">
                    <div class="dh-panel__head"><h2>Contact</h2></div>
                    <div class="dh-facts">
                        <div class="dh-fact"><span>Phone</span><strong>Hidden until engagement confirmation</strong></div>
                        <div class="dh-fact"><span>WhatsApp</span><strong>Hidden until engagement confirmation</strong></div>
                        <div class="dh-fact"><span>Messenger</span><strong>Hidden until engagement confirmation</strong></div>
                    </div>
                </section>

                <section class="dh-panel dh-rise" style="--d:260ms">
                    <div class="dh-panel__head"><h2>Permissions</h2></div>
                    <ul class="dh-bullets">
                        <li>Edit only her own helper profile</li>
                        <li>Confirm or cancel assigned engagements</li>
                        <li>Receive reviews only from completed engagements</li>
                        <li>Remain a normal User in addition to DomesticHelper</li>
                    </ul>
                </section>

                <section class="dh-panel dh-panel--span2 dh-rise" style="--d:320ms">
                    <div class="dh-panel__head"><h2>Activity</h2></div>
                    <div class="dh-metrics">
                        <div class="dh-metric"><strong>@_completedCount</strong><span>Completed jobs</span></div>
                        <div class="dh-metric"><strong>@(_helper?.RatingCount ?? 0)</strong><span>Reviews</span></div>
                        <div class="dh-metric"><strong>@(_helper?.RatingAverage.ToString("0.0") ?? "0.0")</strong><span>Average rating</span></div>
                        <div class="dh-metric"><strong>@_openCount</strong><span>Open requests</span></div>
                    </div>
                </section>

                <section class="dh-panel dh-rise" style="--d:380ms">
                    <div class="dh-panel__head"><h2>Plan Guardrails</h2></div>
                    <ul class="dh-bullets">
                        <li>One helper profile is allowed per account.</li>
                        <li>Helper edit routes are addressed as /helpers/me to avoid IDOR.</li>
                        <li>Reviews are tied to engagements, so anonymous review bombing is blocked.</li>
                    </ul>
                </section>
            </div>
        </div>
    </div>

    @if (_showVerification)
    {
        <div class="up-overlay" @onclick="CloseVerification">
            <div class="up-modal up-modal--sm" @onclick:stopPropagation="true">
                <header class="up-modal__head">
                    <h2>Verify your account</h2>
                    <button type="button" class="up-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button>
                </header>
                <div class="up-modal__body up-modal__body--stack">
                    <p class="up-verification-copy">Choose one document and upload a clear photo. An admin will review it before the verified badge is added to your account.</p>
                    <div class="up-field">
                        <label for="dh-verification-document">Verification document</label>
                        <select id="dh-verification-document" @bind="_verificationDocumentType">
                            <option value="">Choose a document</option>
                            <option value="Student ID">Student ID</option>
                            <option value="Birth Certificate">Birth certificate</option>
                            <option value="National ID (NID)">National ID (NID)</option>
                            <option value="Employee ID / Workplace ID">Employee ID / workplace ID</option>
                        </select>
                    </div>
                    <div class="up-field">
                        <label for="dh-verification-file">Document photo</label>
                        <InputFile id="dh-verification-file" OnChange="PickVerificationDocument" accept="image/*" />
                    </div>
                    @if (_verificationError is not null)
                    {
                        <p class="up-msg up-msg--bad">@_verificationError</p>
                    }
                </div>
                <footer class="up-modal__foot">
                    <button type="button" class="up-btn" @onclick="CloseVerification">Cancel</button>
                    <button type="button" class="up-btn up-btn--solid" disabled="@_submittingVerification" @onclick="SubmitVerification">
                        @(_submittingVerification ? "Submitting..." : "Submit for review")
                    </button>
                </footer>
            </div>
        </div>
    }
}

@code {
    private const long MaxFileBytes = 5 * 1024 * 1024;

    private bool _loading = true;
    private ClaimsPrincipal? _user;
    private UserProfileDto? _profile;
    private Nestify.Shared.Dtos.Helpers.HelperDetailDto? _helper;
    private int _completedCount;
    private int _openCount;

    private bool _showVerification;
    private bool _submittingVerification;
    private string _verificationDocumentType = string.Empty;
    private IBrowserFile? _verificationFile;
    private string? _verificationError;

    private string DisplayName => GetClaimValue(ClaimTypes.Name, "name") ?? _profile?.FullName ?? "Helper";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        _profile = await ProfileService.GetMyProfileAsync();
        _helper = await Helpers.GetMyProfileAsync();

        if (_helper is not null)
        {
            var engagements = await Helpers.GetMyEngagementsAsync();
            var mine = engagements.Where(e => e.MyRole == Nestify.Shared.Dtos.Helpers.EngagementRole.Helper).ToList();
            _completedCount = mine.Count(e => e.Status == Nestify.Shared.Dtos.Helpers.EngagementStatus.Completed);
            _openCount = mine.Count(e => e.Status == Nestify.Shared.Dtos.Helpers.EngagementStatus.Requested);
        }

        _loading = false;
    }

    private string DisplayInitials => CreateInitials(DisplayName);

    private string? GetClaimValue(params string[] claimTypes) =>
        _user?.Claims.FirstOrDefault(c => claimTypes.Any(t => string.Equals(c.Type, t, StringComparison.OrdinalIgnoreCase)))?.Value;

    private static string CreateInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 0 ? "U" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private void OpenVerification()
    {
        _verificationDocumentType = string.Empty;
        _verificationFile = null;
        _verificationError = null;
        _showVerification = true;
    }

    private void CloseVerification() => _showVerification = false;

    private Task PickVerificationDocument(InputFileChangeEventArgs e)
    {
        _verificationFile = e.File;
        return Task.CompletedTask;
    }

    private async Task SubmitVerification()
    {
        if (string.IsNullOrWhiteSpace(_verificationDocumentType) || _verificationFile is null)
        {
            _verificationError = "Choose a document type and a photo to continue.";
            return;
        }

        _verificationError = null;
        _submittingVerification = true;
        try
        {
            using var stream = _verificationFile.OpenReadStream(MaxFileBytes);
            var updated = await ProfileService.SubmitVerificationAsync(_verificationDocumentType, stream, _verificationFile.Name, _verificationFile.ContentType);
            if (updated is not null) _profile = updated;
            _showVerification = false;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
        }
        finally
        {
            _submittingVerification = false;
        }
    }
}