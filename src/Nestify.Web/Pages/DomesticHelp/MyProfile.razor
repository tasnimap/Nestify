@page "/helpers/me"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>My Helper Profile — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner dh__inner--narrow">
        <header class="dh-head dh-rise">
            <p class="dh-kicker">Helper workspace</p>
            <h1>My helper profile</h1>
            <p>Keep your services, availability and rate up to date so the right families reach you.</p>
        </header>

        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar dh-skeleton__bar--tall"></div>
            </div>
        }
        else if (_model is null)
        {
            <div class="dh-panel dh-rise" style="--d:80ms">
                <div class="dh-empty">
                    <span class="dh-empty__art" aria-hidden="true">
                        <svg class="nx-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </span>
                    <h2>You haven't registered as a helper yet</h2>
                    <p>Set up a profile once and families in your area can start sending you requests.</p>
                    <a class="nx-btn nx-btn--accent" href="helpers/register">Become a helper</a>
                </div>
            </div>
        }
        else
        {
            <section class="dh-panel dh-rise" style="--d:80ms">
                <HelperForm Model="_model" SubmitLabel="Save changes" OnSubmit="HandleSubmit" />
            </section>
        }
    </div>
</div>

@code {
    private HelperRegistrationDto? _model;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var profile = await Helpers.GetMyProfileAsync();
        if (profile is not null)
        {
            _model = new HelperRegistrationDto
            {
                Services = profile.Services,
                AvailabilityWindow = profile.AvailabilityWindow,
                MonthlyRate = profile.MonthlyRate
            };
        }
        _loading = false;
    }

    private async Task HandleSubmit()
    {
        if (_model is null) return;
        await Helpers.UpdateProfileAsync(_model);
        Toast.ShowInfo("Profile updated.", "Saved");
    }
}
