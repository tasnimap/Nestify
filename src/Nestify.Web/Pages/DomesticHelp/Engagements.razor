@page "/helpers/engagements"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Web.Components.Helper
@using Nestify.Shared.Dtos.Helpers
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject NavigationManager Nav

<PageTitle>Engagements — Nestify</PageTitle>

<div class="dh md">
    <div class="dh__inner">
        <header class="dh-head md-head dh-rise">
            <div>
                <p class="dh-kicker">Helper workspace</p>
                <h1>Engagements</h1>
                <p>New requests wait for your answer here. Accepting one books the hours on your board and adds the visits to your schedule.</p>
            </div>
            <div class="md-stats md-stats--inhead">
                <div class="md-stat md-stat--glass">
                    <span class="md-stat__value">@Pending.Count</span>
                    <span class="md-stat__label">waiting</span>
                </div>
                <div class="md-stat md-stat--glass">
                    <span class="md-stat__value">@Current.Count</span>
                    <span class="md-stat__label">active</span>
                </div>
                <div class="md-stat md-stat--glass">
                    <span class="md-stat__value">@Money.Format(MonthlyIncome)</span>
                    <span class="md-stat__label">per month</span>
                </div>
            </div>
        </header>

        <div class="md-tabs dh-rise" role="tablist" style="--d:60ms">
            <button type="button" role="tab" class="md-tab @(_tab == "requests" ? "md-tab--on" : null)" aria-selected="@((_tab == "requests").ToString().ToLowerInvariant())" @onclick='() => SwitchTab("requests")'>
                Requests
                @if (Pending.Count > 0)
                {
                    <span class="md-tab__count md-tab__count--warn">@Pending.Count</span>
                }
            </button>
            <button type="button" role="tab" class="md-tab @(_tab == "current" ? "md-tab--on" : null)" aria-selected="@((_tab == "current").ToString().ToLowerInvariant())" @onclick='() => SwitchTab("current")'>
                Current
                <span class="md-tab__count">@Current.Count</span>
            </button>
            <button type="button" role="tab" class="md-tab @(_tab == "past" ? "md-tab--on" : null)" aria-selected="@((_tab == "past").ToString().ToLowerInvariant())" @onclick='() => SwitchTab("past")'>
                Past
                <span class="md-tab__count">@Past.Count</span>
            </button>
        </div>

        @if (_tab == "requests")
        {
            <div class="md-cards" @key="_tab">
                @if (Pending.Count == 0)
                {
                    <div class="dh-panel dh-rise">
                        <div class="dh-empty">
                            <span class="dh-empty__art" aria-hidden="true">
                                <svg class="nx-icon" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                            </span>
                            <h3>Inbox is clear</h3>
                            <p>New requests from bachelors will show up here. Keep your hours open to get more.</p>
                            <a class="nx-btn nx-btn--accent" href="helpers/availability">Update availability</a>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var r in PendingPage)
                    {
                        var i = PendingPage.IndexOf(r);
                        <article class="dh-panel md-request dh-rise" style="--d:@(80 + i * 70)ms" @key="r.Id">
                            <div class="md-request__head">
                                @if (!string.IsNullOrWhiteSpace(r.ClientPhotoUrl))
                                {
                                    <img class="dh-item__avatar dh-item__avatar--img md-avatar--lg" src="@r.ClientPhotoUrl" alt="" />
                                }
                                else
                                {
                                    <span class="dh-item__avatar md-avatar--lg" aria-hidden="true">@Initials(r.ClientName)</span>
                                }
                                <div class="md-request__who">
                                    <strong>
                                        @r.ClientName
                                        @if (r.ClientVerified)
                                        {
                                            <span class="md-verified" title="Verified client">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                                            </span>
                                        }
                                    </strong>
                                    <span>@HomeLine(r.HomeName, r.Area) · @Ago(r.RequestedAtUtc)</span>
                                </div>
                                <span class="md-request__rate">@Money.Format(r.OfferedRate)<small>/month</small></span>
                            </div>

                            <div class="dh-tags">
                                @foreach (var s in r.Services)
                                {
                                    <span class="dh-tag">@s</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(r.Message))
                            {
                                <blockquote class="md-quote">@r.Message</blockquote>
                            }

                            @if (r.Slots.Count > 0)
                            {
                                <div class="md-slots">
                                    <span class="md-slots__label">Weekly hours · @r.Slots.Count</span>
                                    <ul class="md-slots__list">
                                        @foreach (var g in r.Slots.GroupBy(s => s.DayOfWeek).OrderBy(g => WeekOrder(g.Key)))
                                        {
                                            <li>
                                                <span class="md-slots__day">@((DayOfWeek)g.Key)</span>
                                                @foreach (var s in g.OrderBy(s => s.Hour))
                                                {
                                                    var clash = IsBooked(s.DayOfWeek, s.Hour);
                                                    <span class="md-slots__chip @(clash ? "md-slots__chip--clash" : null)" title="@(clash ? "Already booked by another home" : "")">@HourLabel(s.Hour)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    @if (HasClash(r))
                                    {
                                        <p class="md-warn">Some of these hours are already booked. Accepting will double book you.</p>
                                    }
                                </div>
                            }

                            @if (_declining == r.Id)
                            {
                                <div class="md-decline">
                                    <label for="decline-@r.Id">Tell @FirstName(r.ClientName) why (optional)</label>
                                    <textarea id="decline-@r.Id" rows="3" placeholder="e.g. Those hours are already taken, or the area is too far for me."
                                              @bind="_declineNote" @bind:event="oninput"></textarea>
                                    <div class="md-request__actions">
                                        <button type="button" class="nx-btn nx-btn--ghost" @onclick="CancelDecline">Keep request</button>
                                        <button type="button" class="nx-btn nx-btn--danger" @onclick="() => Decline(r)">Send decline</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="md-request__actions">
                                    <button type="button" class="nx-btn nx-btn--ghost" @onclick="() => StartDecline(r)">Decline</button>
                                    <button type="button" class="nx-btn nx-btn--accent" @onclick="() => Accept(r)">Accept request</button>
                                </div>
                            }
                        </article>
                    }
                    <MaidPager Page="_page" PageSize="PageSize" Total="Pending.Count" PageChanged="GoPage" />
                }
            </div>
        }
        else if (_tab == "current")
        {
            <div class="md-cards" @key="_tab">
                @if (Current.Count == 0)
                {
                    <div class="dh-panel dh-rise">
                        <div class="dh-empty">
                            <h3>No active engagements</h3>
                            <p>Accept a request and it will appear here.</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var e in CurrentPage)
                    {
                        var i = CurrentPage.IndexOf(e);
                        var pct = e.VisitsPlanned == 0 ? 0 : Math.Min(100, e.VisitsDone * 100 / e.VisitsPlanned);
                        <article class="dh-panel md-eng md-eng--@e.Status.ToString().ToLowerInvariant() dh-rise" style="--d:@(80 + i * 70)ms" @key="e.Id">
                            <div class="md-request__head">
                                @if (!string.IsNullOrWhiteSpace(e.ClientPhotoUrl))
                                {
                                    <img class="dh-item__avatar dh-item__avatar--img md-avatar--lg" src="@e.ClientPhotoUrl" alt="" />
                                }
                                else
                                {
                                    <span class="dh-item__avatar md-avatar--lg" aria-hidden="true">@Initials(e.ClientName)</span>
                                }
                                <div class="md-request__who">
                                    <strong>@e.ClientName</strong>
                                    <span>@(string.IsNullOrWhiteSpace(e.Address) ? HomeLine(e.HomeName, e.Area) : e.Address)</span>
                                </div>
                                <span class="md-status md-status--@e.Status.ToString().ToLowerInvariant()">@e.Status</span>
                            </div>

                            <div class="dh-tags">
                                @foreach (var s in e.Services)
                                {
                                    <span class="dh-tag">@s</span>
                                }
                            </div>

                            <dl class="md-facts">
                                <div><dt>Rate</dt><dd>@Money.Format(e.MonthlyRate)<small>/mo</small></dd></div>
                                <div><dt>Hours</dt><dd>@e.WeeklyHours<small>/week</small></dd></div>
                                <div><dt>Since</dt><dd>@e.StartedOn.ToString("d MMM")</dd></div>
                                <div><dt>Phone</dt><dd><a href="tel:@e.Phone">@e.Phone</a></dd></div>
                            </dl>

                            <div class="md-slots">
                                <ul class="md-slots__list">
                                    @foreach (var g in e.Slots.GroupBy(s => s.DayOfWeek).OrderBy(g => WeekOrder(g.Key)))
                                    {
                                        <li>
                                            <span class="md-slots__day">@((DayOfWeek)g.Key)</span>
                                            @foreach (var s in g.OrderBy(s => s.Hour))
                                            {
                                                <span class="md-slots__chip">@HourLabel(s.Hour)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="md-progress">
                                <div class="md-progress__head">
                                    <span>@e.VisitsDone of @e.VisitsPlanned visits</span>
                                    <strong>@pct%</strong>
                                </div>
                                <div class="md-progress__track"><span class="md-progress__fill" style="--w:@pct%"></span></div>
                            </div>

                            <div class="md-request__actions">
                                <a class="nx-btn nx-btn--ghost" href="helpers/schedule">See visits</a>
                                @if (e.HelperMarkedComplete)
                                {
                                    <span class="dh-pill">Waiting for the client to confirm</span>
                                }
                                else
                                {
                                    <button type="button" class="nx-btn nx-btn--accent" @onclick="() => Complete(e)">Mark complete</button>
                                }
                            </div>
                        </article>
                    }
                    <MaidPager Page="_page" PageSize="PageSize" Total="Current.Count" PageChanged="GoPage" />
                }
            </div>
        }
        else
        {
            <div class="md-cards" @key="_tab">
                @if (Past.Count == 0)
                {
                    <div class="dh-panel dh-rise"><div class="dh-empty"><h3>Nothing completed yet</h3></div></div>
                }
                else
                {
                    <section class="dh-panel dh-rise" style="--d:80ms">
                        <ul class="dh-list">
                            @foreach (var e in PastPage)
                            {
                                <li class="dh-item md-past">
                                    <span class="dh-item__avatar" aria-hidden="true">@Initials(e.ClientName)</span>
                                    <div class="dh-item__main">
                                        <p class="dh-item__title">@e.ClientName</p>
                                        <p class="dh-item__meta">@string.Join(", ", e.Services) · @e.Area · @e.VisitsDone visits</p>
                                    </div>
                                    <div class="md-past__side">
                                        <strong>@Money.Format(e.MonthlyRate)</strong>
                                        <span>@e.StartedOn.ToString("MMM yyyy")</span>
                                    </div>
                                </li>
                            }
                        </ul>
                        <MaidPager Page="_page" PageSize="PageSize" Total="Past.Count" PageChanged="GoPage" />
                    </section>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 6;

    private string _tab = "requests";
    private int _page = 1;
    private string? _declining;
    private string _declineNote = string.Empty;

    private HelperWorkspaceEngagementsDto _workspace = new();
    private HelperAvailabilityDto? _availability;
    private List<HelperWorkspaceRequestDto> Pending => _workspace.Requests.OrderByDescending(r => r.RequestedAtUtc).ToList();
    private List<HelperWorkspaceEngagementDto> Current => _workspace.Current;
    private List<HelperWorkspaceEngagementDto> Past => _workspace.Past.OrderByDescending(e => e.StartedOn).ToList();

    private List<HelperWorkspaceRequestDto> PendingPage => Pending.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private List<HelperWorkspaceEngagementDto> CurrentPage => Current.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private List<HelperWorkspaceEngagementDto> PastPage => Past.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private decimal MonthlyIncome => Current.Sum(e => e.MonthlyRate);

    protected override async Task OnInitializedAsync()
    {
        var workspace = await Helpers.GetWorkspaceEngagementsAsync();
        if (workspace is null)
        {
            Nav.NavigateTo("helpers/register", replace: true);
            return;
        }
        _workspace = workspace;
        _availability = await Helpers.GetAvailabilityAsync();
    }

    private async Task Reload()
    {
        _workspace = await Helpers.GetWorkspaceEngagementsAsync() ?? new();
        _availability = await Helpers.GetAvailabilityAsync();
    }

    private static string HomeLine(string home, string area)
    {
        if (string.IsNullOrWhiteSpace(home) && string.IsNullOrWhiteSpace(area)) return "No home on file";
        if (string.IsNullOrWhiteSpace(area)) return home;
        if (string.IsNullOrWhiteSpace(home)) return area;
        return $"{home} · {area}";
    }

    // Saturday first, the way the week is read here.
    private static int WeekOrder(int dayOfWeek) => (dayOfWeek - (int)DayOfWeek.Saturday + 7) % 7;

    private void SwitchTab(string tab)
    {
        _tab = tab;
        _page = 1;
        CancelDecline();
    }

    private void GoPage(int page)
    {
        _page = page;
        CancelDecline();
    }

    // Accepting or declining can empty the current page, so step back if needed.
    private void ClampPage(int total)
    {
        var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        if (_page > pages) _page = pages;
    }

    private bool HasClash(HelperWorkspaceRequestDto r) => r.Slots.Any(s => IsBooked(s.DayOfWeek, s.Hour));

    private async Task Accept(HelperWorkspaceRequestDto r)
    {
        try
        {
            await Helpers.AcceptWorkspaceEngagementAsync(r.Id);
            await Reload();
            ClampPage(Pending.Count);
            Toast.ShowSuccess($"{r.ClientName} is now a current engagement. {r.Slots.Count} hour(s) a week added to your schedule.", "Accepted");
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Accept");
        }
    }

    private void StartDecline(HelperWorkspaceRequestDto r)
    {
        _declining = r.Id;
        _declineNote = string.Empty;
    }

    private void CancelDecline()
    {
        _declining = null;
        _declineNote = string.Empty;
    }

    private async Task Decline(HelperWorkspaceRequestDto r)
    {
        try
        {
            await Helpers.DeclineWorkspaceEngagementAsync(r.Id, _declineNote);
            await Reload();
            ClampPage(Pending.Count);
            Toast.ShowInfo(string.IsNullOrWhiteSpace(_declineNote)
                ? $"{r.ClientName} will be told you are not available."
                : $"{r.ClientName} will see your note.", "Declined");
            CancelDecline();
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Decline");
        }
    }

    private static string FirstName(string name) =>
        name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "them";

    private async Task Complete(HelperWorkspaceEngagementDto e)
    {
        try
        {
            await Helpers.MarkCompleteAsync(e.Id);
            await Reload();
            Toast.ShowInfo($"We've asked {e.ClientName} to confirm. You can be reviewed once they do.", "Marked complete");
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Complete");
        }
    }

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d ago";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h ago";
        return "just now";
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private bool IsBooked(int dayOfWeek, int hour) => _availability?.Slots.Any(s => s.DayOfWeek == dayOfWeek && s.Hour == hour && s.IsBooked) == true;
    private static string HourLabel(int hour) => DateTime.Today.AddHours(hour).ToString("h tt");
}
