@page "/helpers/dashboard"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@implements IDisposable
@using Nestify.Web.Components
@inject MaidWorkspaceService Workspace
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>Helper dashboard — Nestify</PageTitle>

<div class="dh md">
    <div class="dh__inner">
        <header class="dh-head md-head dh-rise">
            <div>
                <p class="dh-kicker">Helper workspace</p>
                <h1>@Greeting, @FirstName</h1>
                <p>@Summary</p>
            </div>
            <div class="md-switch-card">
                <div class="md-switch-card__text">
                    <strong>@(Workspace.IsAvailable ? "Accepting bookings" : "Paused")</strong>
                    <span>@(Workspace.IsAvailable ? "Bachelors can find and book you." : "Hidden from search for now.")</span>
                </div>
                <button type="button" class="md-switch @(Workspace.IsAvailable ? "md-switch--on" : null)"
                        role="switch" aria-checked="@Workspace.IsAvailable.ToString().ToLowerInvariant()"
                        aria-label="Available for new bookings" @onclick="ToggleAvailable">
                    <span class="md-switch__knob"></span>
                </button>
            </div>
        </header>

        <div class="dh-stats">
            <a class="dh-stat dh-stat--warn dh-rise" style="--d:60ms" href="helpers/engagements">
                <p class="dh-stat__label">Requests</p>
                <p class="dh-stat__value">@Workspace.PendingRequestCount</p>
                <p class="dh-stat__hint">Waiting for your answer</p>
            </a>
            <a class="dh-stat dh-stat--accent dh-rise" style="--d:120ms" href="helpers/engagements">
                <p class="dh-stat__label">Active jobs</p>
                <p class="dh-stat__value">@Workspace.ActiveEngagementCount</p>
                <p class="dh-stat__hint">@Money.Format(MonthlyIncome) per month</p>
            </a>
            <a class="dh-stat dh-stat--ok dh-rise" style="--d:180ms" href="helpers/schedule">
                <p class="dh-stat__label">This week</p>
                <p class="dh-stat__value">@WeekHours<small class="md-unit">h</small></p>
                <p class="dh-stat__hint">@WeekVisits.Count visits booked</p>
            </a>
            <a class="dh-stat dh-stat--star dh-rise" style="--d:240ms" href="helpers/reviews">
                <p class="dh-stat__label">Rating</p>
                <p class="dh-stat__value">@Workspace.RatingAverage.ToString("0.0")</p>
                <p class="dh-stat__hint">@Workspace.RatingCount reviews</p>
            </a>
        </div>

        <div class="dh-grid">
            <section class="dh-panel dh-rise" style="--d:300ms">
                <div class="dh-panel__head">
                    <h2>Today</h2>
                    <a class="md-link" href="helpers/schedule">Full schedule</a>
                </div>
                @if (TodayVisits.Count == 0)
                {
                    <p class="dh-muted">Nothing booked today. Enjoy the day off.</p>
                }
                else
                {
                    <ul class="dh-list">
                        @foreach (var v in TodayVisits)
                        {
                            var over = v.EndHour <= DateTime.Now.Hour;
                            <li class="dh-item @(over ? "md-item--dim" : null)">
                                <span class="md-time">
                                    <strong>@MaidWorkspaceService.HourLabel(v.StartHour)</strong>
                                    <span>@(v.EndHour - v.StartHour)h</span>
                                </span>
                                <div class="dh-item__main">
                                    <p class="dh-item__title">@v.ClientName</p>
                                    <p class="dh-item__meta">@v.Service · @v.Area</p>
                                </div>
                                <span class="md-status md-status--@(over ? "done" : "upcoming")">@(over ? "Done" : "Upcoming")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="dh-panel dh-rise" style="--d:360ms">
                <div class="dh-panel__head">
                    <h2>New requests</h2>
                    @if (Workspace.PendingRequestCount > 0)
                    {
                        <span class="dh-count">@Workspace.PendingRequestCount</span>
                    }
                </div>
                @if (Pending.Count == 0)
                {
                    <p class="dh-muted">No pending requests right now.</p>
                }
                else
                {
                    <ul class="dh-list">
                        @foreach (var r in Pending.Take(3))
                        {
                            <li class="dh-item">
                                <span class="dh-item__avatar" aria-hidden="true">@Initials(r.ClientName)</span>
                                <div class="dh-item__main">
                                    <p class="dh-item__title">@r.ClientName</p>
                                    <p class="dh-item__meta">@string.Join(", ", r.Services) · @Money.Format(r.OfferedRate)/mo</p>
                                </div>
                                <div class="dh-item__actions">
                                    <button class="nx-btn nx-btn--accent" @onclick="() => Accept(r)">Accept</button>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="md-link" href="helpers/engagements">Review all requests</a>
                }
            </section>

            <section class="dh-panel dh-rise" style="--d:420ms">
                <div class="dh-panel__head">
                    <h2>Open hours</h2>
                    <a class="md-link" href="helpers/availability">Edit</a>
                </div>
                <div class="md-mini-week">
                    @foreach (var day in MaidWorkspaceService.Week)
                    {
                        var open = 0; var booked = 0;
                        for (var h = MaidWorkspaceService.StartHour; h < MaidWorkspaceService.EndHour; h++)
                        {
                            var s = Workspace.GetSlot(day, h);
                            if (s == MaidSlotState.Open) open++;
                            else if (s == MaidSlotState.Booked) booked++;
                        }
                        var total = open + booked;
                        <div class="md-mini-week__day">
                            <div class="md-mini-week__bar" aria-hidden="true">
                                <span class="md-mini-week__booked" style="--h:@(booked * 100 / MaidWorkspaceService.HoursPerDay)%"></span>
                                <span class="md-mini-week__open" style="--h:@(open * 100 / MaidWorkspaceService.HoursPerDay)%"></span>
                            </div>
                            <span class="md-mini-week__label @(day == DateTime.Today.DayOfWeek ? "md-mini-week__label--today" : null)">@day.ToString()[..3]</span>
                            <span class="md-mini-week__num">@(total == 0 ? "—" : $"{total}h")</span>
                        </div>
                    }
                </div>
                <ul class="dh-legend">
                    <li><span class="dh-key dh-key--free"></span>Open</li>
                    <li><span class="dh-key dh-key--booked"></span>Booked</li>
                </ul>
            </section>

            <section class="dh-panel dh-rise" style="--d:480ms">
                <div class="dh-panel__head">
                    <h2>Latest review</h2>
                    <a class="md-link" href="helpers/reviews">All reviews</a>
                </div>
                @if (Latest is { } latest)
                {
                    <div class="md-review md-review--compact">
                        <div class="md-review__head">
                            <span class="dh-item__avatar" aria-hidden="true">@Initials(latest.ReviewerName)</span>
                            <div class="md-review__who">
                                <strong>@latest.ReviewerName</strong>
                                <span>@latest.Service · @latest.Area</span>
                            </div>
                            <RatingStars Value="latest.Rating" ShowCount="false" />
                        </div>
                        <p class="md-review__text">@latest.Comment</p>
                    </div>
                }
                else
                {
                    <p class="dh-muted">No reviews yet.</p>
                }
            </section>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _name = "there";

    private string FirstName => _name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    private List<MaidVisit> TodayVisits => Workspace.Visits
        .Where(v => v.Date == DateTime.Today && v.Status != MaidVisitStatus.Cancelled)
        .OrderBy(v => v.StartHour).ToList();

    private List<MaidVisit> WeekVisits => Workspace.Visits
        .Where(v => v.Date >= DateTime.Today && v.Date < DateTime.Today.AddDays(7) && v.Status != MaidVisitStatus.Cancelled)
        .ToList();

    private int WeekHours => WeekVisits.Sum(v => v.EndHour - v.StartHour);

    private List<MaidRequest> Pending => Workspace.Requests.Where(r => r.Status == MaidRequestStatus.Pending).OrderByDescending(r => r.RequestedAtUtc).ToList();

    private decimal MonthlyIncome => Workspace.Engagements.Where(e => e.Status == MaidEngagementStatus.Active).Sum(e => e.MonthlyRate);

    private MaidReview? Latest => Workspace.Reviews.OrderByDescending(r => r.CreatedAtUtc).FirstOrDefault();

    private string Summary
    {
        get
        {
            var today = TodayVisits.Count;
            var pending = Workspace.PendingRequestCount;
            var parts = new List<string>();
            parts.Add(today == 0 ? "no visits today" : $"{today} visit{(today == 1 ? "" : "s")} today");
            if (pending > 0) parts.Add($"{pending} request{(pending == 1 ? "" : "s")} waiting");
            return "You have " + string.Join(" and ", parts) + ".";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnWorkspaceChanged;
        if (AuthState is not null)
        {
            var state = await AuthState;
            _name = state.User.Identity?.Name ?? _name;
        }
    }

    private void ToggleAvailable()
    {
        Workspace.SetAvailable(!Workspace.IsAvailable);
        Toast.ShowInfo(Workspace.IsAvailable ? "You are visible to bachelors again." : "You are hidden from new bookings.",
            Workspace.IsAvailable ? "Accepting bookings" : "Paused");
    }

    private void Accept(MaidRequest r)
    {
        Workspace.AcceptRequest(r.Id);
        Toast.ShowSuccess($"{r.ClientName} is now a current engagement.", "Accepted");
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnWorkspaceChanged;
}
