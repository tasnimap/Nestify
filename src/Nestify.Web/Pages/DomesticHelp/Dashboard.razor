@page "/helpers/dashboard"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Web.Components
@using Nestify.Shared.Dtos.Helpers
@inject IHelperService Helpers
@inject IStringLocalizer<SharedResource> L
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>@L["Helper dashboard"] — Nestify</PageTitle>

<div class="dh md">
    <div class="dh__inner">
        <header class="dh-head md-head dh-rise">
            <div>
                <p class="dh-kicker">@L["HELPER WORKSPACE"]</p>
                <h1>@L[GreetingKey, FirstName]</h1>
                <p>@Summary</p>
            </div>
            <div class="md-switch-card">
                <div class="md-switch-card__text">
                    <strong>@L[_availability?.IsAvailable == true ? "Accepting bookings" : "Paused"]</strong>
                    <span>@L[_availability?.IsAvailable == true ? "Bachelors can find and book you." : "Hidden from search for now."]</span>
                </div>
                <button type="button" class="md-switch @(_availability?.IsAvailable == true ? "md-switch--on" : null)"
                        role="switch" aria-checked="@(_availability?.IsAvailable.ToString().ToLowerInvariant() ?? "false")"
                        aria-label='@L["Available for new bookings"]' @onclick="ToggleAvailable">
                    <span class="md-switch__knob"></span>
                </button>
            </div>
        </header>

        @if (!Model.IsProfileComplete)
        {
            <div class="md-callout dh-rise">
                <div>
                    <strong>@L["Finish your profile so clients can find you"]</strong>
                    <span>@L["Add your services, monthly rate and area to your profile. Then you can accept bookings and apply for verification."]</span>
                </div>
                <a class="nx-btn nx-btn--accent" href="helpers/profile">@L["Go to my profile"]</a>
            </div>
        }

        <div class="dh-stats">
            <a class="dh-stat dh-stat--warn dh-rise" style="--d:60ms" href="helpers/engagements">
                <p class="dh-stat__label">@L["Requests"]</p>
                <p class="dh-stat__value">@Model.PendingRequestCount</p>
                <p class="dh-stat__hint">@L["Waiting for your answer"]</p>
            </a>
            <a class="dh-stat dh-stat--accent dh-rise" style="--d:120ms" href="helpers/engagements">
                <p class="dh-stat__label">@L["Active jobs"]</p>
                <p class="dh-stat__value">@Model.ActiveJobCount</p>
                <p class="dh-stat__hint">@L["{0} per month", Money.Format(Model.MonthlyEarnings)]</p>
            </a>
            <a class="dh-stat dh-stat--ok dh-rise" style="--d:180ms" href="helpers/schedule">
                <p class="dh-stat__label">@L["This week"]</p>
                <p class="dh-stat__value">@WeekHours<small class="md-unit">@L["hours short"]</small></p>
                <p class="dh-stat__hint">@L["{0} visits booked", Model.VisitsThisWeek]</p>
            </a>
            <a class="dh-stat dh-stat--star dh-rise" style="--d:240ms" href="helpers/reviews">
                <p class="dh-stat__label">@L["Rating"]</p>
                <p class="dh-stat__value">@Model.RatingAverage.ToString("0.0")</p>
                <p class="dh-stat__hint">@L["{0} reviews", Model.ReviewCount]</p>
            </a>
        </div>

        <div class="dh-grid">
            <section class="dh-panel dh-rise" style="--d:300ms">
                <div class="dh-panel__head">
                    <h2>@L["Today"]</h2>
                    <a class="md-link" href="helpers/schedule">@L["Full schedule"]</a>
                </div>
                @if (TodayVisits.Count == 0)
                {
                    <p class="dh-muted">@L["Nothing booked today. Enjoy the day off."]</p>
                }
                else
                {
                    <ul class="dh-list">
                        @foreach (var v in TodayVisits)
                        {
                            var over = v.EndHour <= DateTime.Now.Hour;
                            <li class="dh-item @(over ? "md-item--dim" : null)">
                                <span class="md-time">
                                    <strong>@HourLabel(v.StartHour)</strong>
                                    <span>@(v.EndHour - v.StartHour)@L["hours short"]</span>
                                </span>
                                <div class="dh-item__main">
                                    <p class="dh-item__title">@v.ClientName</p>
                                    <p class="dh-item__meta">@v.Service · @v.Area</p>
                                </div>
                                <span class="md-status md-status--@(over ? "done" : "upcoming")">@L[over ? "Completed" : "Upcoming"]</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="dh-panel dh-rise" style="--d:360ms">
                <div class="dh-panel__head">
                    <h2>@L["New requests"]</h2>
                    @if (Model.PendingRequestCount > 0)
                    {
                        <span class="dh-count">@Model.PendingRequestCount</span>
                    }
                </div>
                @if (Pending.Count == 0)
                {
                    <p class="dh-muted">@L["No pending requests right now."]</p>
                }
                else
                {
                    <ul class="dh-list">
                        @foreach (var r in Pending.Take(3))
                        {
                            <li class="dh-item">
                                @if (!string.IsNullOrWhiteSpace(r.ClientPhotoUrl))
                                {
                                    <img class="dh-item__avatar dh-item__avatar--img" src="@r.ClientPhotoUrl" alt="" />
                                }
                                else
                                {
                                    <span class="dh-item__avatar" aria-hidden="true">@Initials(r.ClientName)</span>
                                }
                                <div class="dh-item__main">
                                    <p class="dh-item__title">@r.ClientName</p>
                                    <p class="dh-item__meta">@string.Join(", ", r.Services) · @L["{0} hours per week", r.Slots.Count] · @Money.Format(r.OfferedRate) / @L["month"]</p>
                                </div>
                                <div class="dh-item__actions">
                                    <button class="nx-btn nx-btn--accent" @onclick="() => Accept(r)">@L["Accept"]</button>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="md-link" href="helpers/engagements">@L["Review all requests"]</a>
                }
            </section>

            <section class="dh-panel dh-rise" style="--d:420ms">
                <div class="dh-panel__head">
                    <h2>@L["Open hours"]</h2>
                    <a class="md-link" href="helpers/availability">@L["Edit"]</a>
                </div>
                <div class="md-mini-week">
                    @foreach (var day in Week)
                    {
                        var open = 0; var booked = 0;
                        for (var h = StartHour; h < EndHour; h++)
                        {
                            var s = Slot(day, h);
                            if (s.IsOpen) open++;
                            if (s.IsBooked) booked++;
                        }
                        var total = open + booked;
                        <div class="md-mini-week__day">
                            <div class="md-mini-week__bar" aria-hidden="true">
                                <span class="md-mini-week__booked" style="--h:@(booked * 100 / HoursPerDay)%"></span>
                                <span class="md-mini-week__open" style="--h:@(open * 100 / HoursPerDay)%"></span>
                            </div>
                            <span class="md-mini-week__label @(day == DateTime.Today.DayOfWeek ? "md-mini-week__label--today" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day)</span>
                            <span class="md-mini-week__num">@(total == 0 ? "—" : $"{total}{L["hours short"]}")</span>
                        </div>
                    }
                </div>
                <ul class="dh-legend">
                    <li><span class="dh-key dh-key--free"></span>@L["Open"]</li>
                    <li><span class="dh-key dh-key--booked"></span>@L["Booked"]</li>
                </ul>
            </section>

            <section class="dh-panel dh-rise" style="--d:480ms"><div class="dh-panel__head"><h2>@L["Reviews"]</h2><a class="md-link" href="helpers/reviews">@L["All reviews"]</a></div><p class="dh-muted">@L["{0} reviews · {1} average rating", Model.ReviewCount, Model.RatingAverage.ToString("0.0")].</p></section>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _name = "there";

    private string FirstName => _name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? L["there"].Value;

    private string GreetingKey => DateTime.Now.Hour switch
    {
        < 12 => "Good morning, {0}",
        < 17 => "Good afternoon, {0}",
        _ => "Good evening, {0}"
    };

    private HelperWorkspaceDashboardDto Model { get; set; } = new();
    private HelperAvailabilityDto? _availability;
    private const int StartHour = 6, EndHour = 24, HoursPerDay = 18;
    private static readonly DayOfWeek[] Week = [DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
    private List<HelperWorkspaceVisitDto> TodayVisits => Model.TodayVisits.OrderBy(v => v.StartHour).ToList();

    private int WeekHours => Model.HoursThisWeek;

    private List<HelperWorkspaceRequestDto> Pending => Model.NewRequests.OrderByDescending(r => r.RequestedAtUtc).ToList();

    private string Summary
    {
        get
        {
            var today = TodayVisits.Count;
            var pending = Model.PendingRequestCount;
            var parts = new List<string>();
            if (today == 0 && pending == 0) return L["No visits or new requests today."].Value;
            if (today == 0) return L["You have {0} requests waiting.", pending];
            if (pending == 0) return L["You have {0} visits today.", today];
            return L["You have {0} visits today and {1} requests waiting.", today, pending];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Model = await Helpers.GetWorkspaceDashboardAsync() ?? new();
        _availability = await Helpers.GetAvailabilityAsync();
        if (AuthState is not null)
        {
            var state = await AuthState;
            _name = state.User.Identity?.Name ?? _name;
        }
    }

    private async Task ToggleAvailable()
    {
        if (_availability is null) return;
        _availability.IsAvailable = !_availability.IsAvailable;
        try
        {
            await Helpers.SaveAvailabilityAsync(_availability);
            Toast.ShowInfo(L[_availability.IsAvailable ? "You are visible to clients again." : "You are hidden from new bookings."], L[_availability.IsAvailable ? "Accepting bookings" : "Paused"]);
        }
        catch
        {
            _availability.IsAvailable = !_availability.IsAvailable;
            Toast.ShowWarning(L["Could not update your availability. Please try again."], L["Profile"]);
        }
    }

    private async Task Accept(HelperWorkspaceRequestDto r)
    {
        try
        {
            await Helpers.AcceptWorkspaceEngagementAsync(r.Id);
            Model = await Helpers.GetWorkspaceDashboardAsync() ?? new();
            _availability = await Helpers.GetAvailabilityAsync();
            Toast.ShowSuccess(L["{0} is now a current engagement.", r.ClientName], L["Accepted"]);
        }
        catch
        {
            Toast.ShowWarning(L["Could not accept this request. Please try again."], L["Accept"]);
        }
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private HelperAvailabilitySlotDto Slot(DayOfWeek day, int hour) => _availability?.Slots.FirstOrDefault(s => s.DayOfWeek == (int)day && s.Hour == hour) ?? new();
    private static string HourLabel(int hour) => DateTime.Today.AddHours(hour).ToString("h tt");
}
