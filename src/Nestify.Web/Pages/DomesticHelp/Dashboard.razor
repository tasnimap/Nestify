@page "/helpers/dashboard"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components
@inject IHelperService Helpers

<PageTitle>Helper dashboard — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner">
        <header class="dh-head dh-rise">
            <p class="dh-kicker">Helper workspace</p>
            <h1>Your work overview</h1>
            <p>Requests, active jobs and feedback from the families you work with.</p>
        </header>

        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar"></div>
                <div class="dh-skeleton__bar dh-skeleton__bar--tall"></div>
            </div>
        }
        else if (_profile is null)
        {
            <div class="dh-panel dh-rise" style="--d:80ms">
                <div class="dh-empty">
                    <span class="dh-empty__art" aria-hidden="true">
                        <svg class="nx-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </span>
                    <h3>Set up your helper profile</h3>
                    <p>Add your services, availability and rate so families in your area can find and book you.</p>
                    <a class="nx-btn nx-btn--accent" href="helpers/register">Create helper profile</a>
                </div>
            </div>
        }
        else
        {
            <div class="dh-stats">
                <div class="dh-stat dh-stat--warn dh-rise" style="--d:60ms">
                    <p class="dh-stat__label">Open requests</p>
                    <p class="dh-stat__value">@_incoming.Count</p>
                    <p class="dh-stat__hint">Waiting for you to confirm</p>
                </div>
                <div class="dh-stat dh-stat--accent dh-rise" style="--d:120ms">
                    <p class="dh-stat__label">Active jobs</p>
                    <p class="dh-stat__value">@_active.Count</p>
                    <p class="dh-stat__hint">Currently in progress</p>
                </div>
                <div class="dh-stat dh-stat--ok dh-rise" style="--d:180ms">
                    <p class="dh-stat__label">Completed</p>
                    <p class="dh-stat__value">@_completedCount</p>
                    <p class="dh-stat__hint">All time</p>
                </div>
                <div class="dh-stat dh-stat--star dh-rise" style="--d:240ms">
                    <p class="dh-stat__label">Rating</p>
                    <p class="dh-stat__value">@_profile.RatingAverage.ToString("0.0")</p>
                    <p class="dh-stat__hint">@_profile.RatingCount review(s)</p>
                </div>
            </div>

            <div class="dh-grid">
                <section class="dh-panel dh-rise" style="--d:300ms">
                    <div class="dh-panel__head">
                        <h2>Incoming requests</h2>
                        @if (_incoming.Count > 0)
                        {
                            <span class="dh-count">@_incoming.Count</span>
                        }
                    </div>
                    @if (_incoming.Count == 0)
                    {
                        <p class="dh-muted">No pending requests right now.</p>
                    }
                    else
                    {
                        <ul class="dh-list">
                            @foreach (var e in _incoming)
                            {
                                <li class="dh-item">
                                    <span class="dh-item__avatar" aria-hidden="true">@Initials(e.ClientName)</span>
                                    <div class="dh-item__main">
                                        <p class="dh-item__title">@e.ClientName</p>
                                        <p class="dh-item__meta">Requested @Ago(e.CreatedAtUtc)</p>
                                    </div>
                                    <div class="dh-item__actions">
                                        <button class="nx-btn nx-btn--accent" @onclick="() => Confirm(e.Id)">Confirm</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="dh-panel dh-rise" style="--d:360ms">
                    <div class="dh-panel__head">
                        <h2>Active jobs</h2>
                        @if (_active.Count > 0)
                        {
                            <span class="dh-count">@_active.Count</span>
                        }
                    </div>
                    @if (_active.Count == 0)
                    {
                        <p class="dh-muted">Nothing active at the moment.</p>
                    }
                    else
                    {
                        <ul class="dh-list">
                            @foreach (var e in _active)
                            {
                                <li class="dh-item">
                                    <span class="dh-item__avatar" aria-hidden="true">@Initials(e.ClientName)</span>
                                    <div class="dh-item__main">
                                        <p class="dh-item__title">@e.ClientName</p>
                                        <p class="dh-item__meta">@e.Status</p>
                                    </div>
                                    <div class="dh-item__actions">
                                        @if (!e.HelperMarkedComplete)
                                        {
                                            <button class="nx-btn nx-btn--ghost" @onclick="() => MarkComplete(e.Id)">Mark complete</button>
                                        }
                                        else
                                        {
                                            <span class="dh-pill">Waiting for client</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="dh-panel dh-panel--wide dh-rise" style="--d:420ms">
                    <div class="dh-panel__head">
                        <h2>Recent reviews</h2>
                    </div>
                    @if (_reviews is null || _reviews.Items.Count == 0)
                    {
                        <p class="dh-muted">No reviews yet.</p>
                    }
                    else
                    {
                        <ul class="dh-list">
                            @foreach (var r in _reviews.Items)
                            {
                                <li class="dh-item">
                                    <span class="dh-item__avatar" aria-hidden="true">@Initials(r.ReviewerName)</span>
                                    <div class="dh-item__main">
                                        <p class="dh-item__title">@r.ReviewerName</p>
                                        <p class="dh-item__meta">@r.Comment</p>
                                    </div>
                                    <RatingStars Value="r.Rating" ShowCount="false" />
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
        }
    </div>
</div>

@code {
    private HelperDetailDto? _profile;
    private HelperPageDto<ReviewDto>? _reviews;
    private List<EngagementDto> _incoming = new();
    private List<EngagementDto> _active = new();
    private int _completedCount;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _profile = await Helpers.GetMyProfileAsync();

        if (_profile is not null)
        {
            var mine = (await Helpers.GetMyEngagementsAsync())
                .Where(e => e.MyRole == EngagementRole.Helper)
                .ToList();

            _incoming = mine.Where(e => e.Status == EngagementStatus.Requested).ToList();
            _active = mine.Where(e => e.Status is EngagementStatus.HelperConfirmed or EngagementStatus.Active).ToList();
            _completedCount = mine.Count(e => e.Status == EngagementStatus.Completed);

            _reviews = await Helpers.GetReviewsAsync(_profile.Id);
        }

        _loading = false;
    }

    private async Task Confirm(string id)
    {
        await Helpers.ConfirmEngagementAsync(id);
        await LoadAsync();
    }

    private async Task MarkComplete(string id)
    {
        await Helpers.MarkCompleteAsync(id);
        await LoadAsync();
    }

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d ago";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h ago";
        return "just now";
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }
}
