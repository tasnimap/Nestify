@page "/helpers/register"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>Become a Helper — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner dh__inner--narrow">
        <header class="dh-head dh-rise">
            <p class="dh-kicker">Get started</p>
            <h1>Become a helper</h1>
            <p>Register your services, availability, and rate so clients can find you.</p>
        </header>

        <section class="dh-panel dh-rise" style="--d:80ms">
            <HelperForm Model="_model" SubmitLabel="Register" OnSubmit="HandleSubmit" />
        </section>
    </div>
</div>

@code {
    private readonly HelperRegistrationDto _model = new();

    private async Task HandleSubmit()
    {
        await Helpers.RegisterAsync(_model);
        Toast.ShowInfo("Your helper profile is live.", "Registered");
        Nav.NavigateTo("helpers/me");
    }
}
