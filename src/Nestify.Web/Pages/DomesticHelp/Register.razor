@page "/helpers/register"
@layout HelperLayout
@attribute [Authorize(Roles = "DomesticHelper,DomesticHelp,Maid,Helper")]
@using System.Security.Claims
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject AuthenticationStateProvider AuthProvider
@inject Nestify.Web.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>Set up your helper profile — Nestify</PageTitle>

<div class="dh md">
    <div class="dh__inner dh__inner--narrow">
        <header class="dh-head dh-rise">
            <p class="dh-kicker">Get started</p>
            <h1>Set up your helper profile</h1>
            <p>Tell bachelors what you do, what you charge and where you live. You can change all of this later from your profile.</p>
        </header>

        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar dh-skeleton__bar--tall"></div>
            </div>
        }
        else
        {
            <section class="dh-panel dh-rise" style="--d:80ms">
                <HelperForm Model="_model" SubmitLabel="Create my profile" Error="@_error" OnSubmit="HandleSubmit" MapId="register-map" />
            </section>
        }
    </div>
</div>

@code {
    private readonly HelperProfileFormDto _model = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Someone who already has a profile has nothing to do here.
        if (await Helpers.GetMyProfileAsync() is not null)
        {
            Nav.NavigateTo("helpers/profile", replace: true);
            return;
        }

        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _model.FullName = user.Identity?.Name
            ?? user.Claims.FirstOrDefault(c => c.Type is ClaimTypes.Name or "name")?.Value
            ?? string.Empty;
        _loading = false;
    }

    private async Task HandleSubmit()
    {
        _error = null;
        try
        {
            await Helpers.RegisterAsync(_model);
            Toast.ShowSuccess("Your profile is live. Set your open hours next.", "Welcome");
            Nav.NavigateTo("helpers/availability");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
