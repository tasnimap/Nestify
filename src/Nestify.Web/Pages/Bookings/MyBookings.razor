@page "/bookings/mine"
@using Nestify.Shared.Dtos.Housing
@inject IHousingService Housing
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>My bookings — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap">
        <header class="hs-head">
            <div class="hs-head__titles">
                <p class="nx-eyebrow">M1 · Housing</p>
                <h1>My bookings</h1>
                <p class="hs-head__lead">
                    Track your booking requests and manage your connections with listing managers.
                </p>
            </div>
            
            <div class="hs-head__actions">
                <a class="nx-btn nx-btn--ghost" href="housing">Browse listings</a>
                <a class="nx-btn nx-btn--ghost" href="housing/mine">My posts</a>
            </div>
        </header>

        @if (_loading)
        {
            <div style="padding: 2rem 0;">
                <p>Loading your bookings…</p>
            </div>
        }
        else if (_bookings.Count == 0)
        {
            <div class="hs-empty hs-empty--page">
                <h2>You haven't made any booking requests yet</h2>
                <p>Start by browsing available seats and houses to send booking requests to managers.</p>
                <a class="nx-btn nx-btn--primary" href="housing">Browse listings</a>
            </div>
        }
        else
        {
            <div class="hs-my-bookings">
                @foreach (var booking in _bookings)
                {
                    <article class="hs-booking-card nx-card">
                        <div class="hs-booking-card__head">
                            <div class="hs-booking-card__titles">
                                <h2>
                                    <a href="housing/@booking.Post.Id">@booking.Post.Title</a>
                                </h2>
                                <p class="hs-booking-card__meta">
                                    <span class="hs-booking-card__location">📍 @booking.Post.AreaName, @booking.Post.Division</span>
                                    <span class="hs-booking-card__type">@HousingView.Label(booking.Post.ListingType)</span>
                                </p>
                            </div>
                            <div class="hs-booking-card__price">
                                <span class="hs-booking-card__rent">৳@booking.Post.MonthlyRent/mo</span>
                            </div>
                        </div>

                        <div class="hs-booking-card__body">
                            <div class="hs-booking-card__info">
                                <div class="hs-booking-card__row">
                                    <span class="hs-booking-card__label">Status</span>
                                    <span class="hs-booking-card__badge @(GetStatusClass(booking.Status))">
                                        @booking.Status
                                    </span>
                                </div>
                                <div class="hs-booking-card__row">
                                    <span class="hs-booking-card__label">Requested</span>
                                    <span>@booking.RequestedAtUtc.ToString("g")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(booking.Message))
                                {
                                    <div class="hs-booking-card__row">
                                        <span class="hs-booking-card__label">Your message</span>
                                        <p class="hs-booking-card__message">@booking.Message</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="hs-booking-card__footer">
                            <div class="hs-booking-card__actions">
                                <a class="nx-btn nx-btn--ghost" href="housing/@booking.Post.Id">View listing</a>
                                @if (booking.Status == BookingStatus.Accepted)
                                {
                                    <button type="button" class="nx-btn nx-btn--ghost" 
                                            @onclick="() => ViewManagerContact(booking.BookingId)">
                                        View manager contact
                                    </button>
                                }
                                @if (booking.Status == BookingStatus.Pending)
                                {
                                    <button type="button" class="nx-btn nx-btn--ghost nx-btn--danger" 
                                            @onclick="() => WithdrawBooking(booking.BookingId)">
                                        Withdraw request
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<MyBookingDto> _bookings = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        _loading = true;
        try
        {
            _bookings = (await Housing.GetMyBookingsAsync()).ToList();
        }
        catch
        {
            Toast.ShowError($"Failed to load your bookings.", "Error");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ViewManagerContact(string bookingId)
    {
        try
        {
            var contact = await Housing.GetBookingContactAsync(bookingId);
            if (contact != null)
            {
                Toast.ShowInfo($"Name: {contact.Name}\nEmail: {contact.Email}\nPhone: {contact.Phone}", "Manager Contact");
            }
            else
            {
                Toast.ShowWarning("Contact information is not available.", "Not Available");
            }
        }
        catch
        {
            Toast.ShowError($"Failed to retrieve contact information.", "Error");
        }
    }

    private async Task WithdrawBooking(string bookingId)
    {
        // Placeholder for withdraw functionality (future implementation)
        Toast.ShowInfo("Withdraw functionality coming soon.", "Info");
    }

    private string GetStatusClass(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "hs-booking-card__badge--pending",
        BookingStatus.Accepted => "hs-booking-card__badge--accepted",
        BookingStatus.Rejected => "hs-booking-card__badge--rejected",
        BookingStatus.Withdrawn => "hs-booking-card__badge--withdrawn",
        _ => ""
    };
}
