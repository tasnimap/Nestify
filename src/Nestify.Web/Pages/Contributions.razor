@page "/contributions"
@using System.ComponentModel.DataAnnotations
@inject ToastService ToastService
@inject MoneyFormatterService MoneyFormatterService

<PageTitle>Contributions — Nestify</PageTitle>

<section class="nx-section contributions-page">
    <div class="nx-container contributions-page__wrap">
        <header class="contributions-page__header">
            <div>
                <p class="nx-eyebrow">Shared expenses</p>
                <h1>September 2026 contributions</h1>
                <p class="nx-lead">Track the money each house member has put toward this month's shared costs.</p>
            </div>
            <div class="contributions-page__actions">
                <button type="button" class="nx-btn nx-btn--ghost">Export CSV</button>
                @if (!_isFinalized)
                {
                    <a class="nx-btn nx-btn--primary" href="#contribution-form">Add contribution</a>
                }
            </div>
        </header>

        <div class="contributions-page__banner @(_isFinalized ? "contributions-page__banner--locked" : "")">
            @if (_isFinalized)
            {
                <strong>Finalized period</strong>
                <span>This month is locked. Contributions are read-only and correction controls are hidden.</span>
            }
            else
            {
                <strong>Append-only record</strong>
                <span>Payments derived from expenses are included automatically. Use a correction to preserve the history.</span>
            }
        </div>

        <div class="contributions-page__summary">
            @foreach (var member in MemberNames)
            {
                <article class="nx-card contributions-page__member-card">
                    <span class="contributions-page__avatar">@member[0]</span>
                    <div>
                        <span class="contributions-page__member-name">@member</span>
                        <strong><MoneyDisplay Amount="GetTotal(member)" /></strong>
                    </div>
                    <small>contributed</small>
                </article>
            }
        </div>

        <div class="contributions-page__grid">
            <section class="nx-card contributions-page__panel">
                <div class="contributions-page__panel-head">
                    <div>
                        <h2>Contribution ledger</h2>
                        <p>Every payment remains visible, including correcting entries.</p>
                    </div>
                    <span class="nx-tag">@_items.Count entries</span>
                </div>

                <div class="contributions-page__table-wrap">
                    <table class="contributions-page__table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Source</th>
                                <th>Note</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><DateDisplay DateTime="item.PaidOnUtc" Format="date" /></td>
                                    <td><strong>@item.Member</strong></td>
                                    <td><span class="contributions-page__chip">@item.Source</span></td>
                                    <td>@item.Note</td>
                                    <td class="@(item.Amount < 0 ? "contributions-page__amount--negative" : "")">
                                        <MoneyDisplay Amount="item.Amount" />
                                    </td>
                                    <td>
                                        @if (!_isFinalized)
                                        {
                                            <button type="button" class="nx-btn nx-btn--ghost contributions-page__correct-btn"
                                                    @onclick="() => HandleCorrect(item)">
                                                Correct
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="contributions-page__locked-label">Locked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4">Total contributions</th>
                                <th><MoneyDisplay Amount="TotalContributions" /></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>

            @if (!_isFinalized)
            {
                <aside class="nx-card contributions-page__panel contributions-page__panel--form" id="contribution-form">
                    <div class="contributions-page__panel-head">
                        <div>
                            <h2>Add contribution</h2>
                            <p>For direct cash payments not tied to an expense.</p>
                        </div>
                        <span class="nx-tag">Direct cash</span>
                    </div>

                    <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="contributions-page__form">
                        <DataAnnotationsValidator />
                        <div class="field">
                            <label for="contribution-member">Member</label>
                            <select id="contribution-member" @bind="_model.Member" class="field__input">
                                @foreach (var member in MemberNames)
                                {
                                    <option value="@member">@member</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => _model.Member)" />
                        </div>

                        <MoneyInput @bind-Value="_model.Amount"
                                    Label="Amount"
                                    For="@(() => _model.Amount)" />

                        <DateInput @bind-Value="_model.PaidOn"
                                   Label="Paid on"
                                   For="@(() => _model.PaidOn)" />

                        <TextInput @bind-Value="_model.Note"
                                   Label="Note"
                                   Placeholder="Cash top-up"
                                   For="@(() => _model.Note)" />

                        <button type="submit" class="nx-btn nx-btn--primary nx-btn--block">Save contribution</button>
                    </EditForm>
                </aside>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] MemberNames = ["Rafi", "Sadia", "Tanvir", "Nabil"];

    private sealed class ContributionEntry
    {
        public string Member { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string Source { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
        public DateTime PaidOnUtc { get; set; }
    }

    private sealed class ContributionFormModel
    {
        [Required]
        public string Member { get; set; } = "Rafi";

        [Range(0.01, 1000000, ErrorMessage = "Amount must be greater than ৳0.00.")]
        public decimal Amount { get; set; }

        [Required]
        public DateTime PaidOn { get; set; } = DateTime.UtcNow;

        [Required(ErrorMessage = "Add a short note for this payment.")]
        public string Note { get; set; } = string.Empty;
    }

    private readonly List<ContributionEntry> _items =
    [
        new() { Member = "Rafi", Amount = 1400.00m, Source = "Expense", Note = "Gas cylinder refill", PaidOnUtc = new(2026, 9, 3, 12, 0, 0, DateTimeKind.Utc) },
        new() { Member = "Sadia", Amount = 600.00m, Source = "Expense", Note = "Light bulbs + wiring", PaidOnUtc = new(2026, 9, 7, 12, 0, 0, DateTimeKind.Utc) },
        new() { Member = "Tanvir", Amount = 1150.00m, Source = "Expense", Note = "Internet bill", PaidOnUtc = new(2026, 9, 10, 12, 0, 0, DateTimeKind.Utc) },
        new() { Member = "Rafi", Amount = 4500.00m, Source = "Expense", Note = "Groceries (1–10 Sep)", PaidOnUtc = new(2026, 9, 12, 12, 0, 0, DateTimeKind.Utc) },
        new() { Member = "Sadia", Amount = 2800.00m, Source = "Expense", Note = "Groceries (11–20 Sep)", PaidOnUtc = new(2026, 9, 20, 12, 0, 0, DateTimeKind.Utc) },
        new() { Member = "Nabil", Amount = 2500.00m, Source = "Direct cash", Note = "September cash top-up", PaidOnUtc = new(2026, 9, 21, 12, 0, 0, DateTimeKind.Utc) }
    ];

    private readonly ContributionFormModel _model = new();
    private bool _isFinalized = false;
    private decimal TotalContributions => _items.Sum(item => item.Amount);

    private decimal GetTotal(string member) => _items
        .Where(item => item.Member == member)
        .Sum(item => item.Amount);

    private void HandleSubmit()
    {
        _items.Insert(0, new ContributionEntry
        {
            Member = _model.Member,
            Amount = _model.Amount,
            Source = "Direct cash",
            Note = _model.Note,
            PaidOnUtc = _model.PaidOn.ToUniversalTime()
        });

        ToastService.ShowSuccess(
            $"Saved {MoneyFormatterService.Format(_model.Amount)} for {_model.Member}.",
            "Contribution added");

        _model.Amount = 0m;
        _model.Note = string.Empty;
        _model.PaidOn = DateTime.UtcNow;
    }

    private void HandleCorrect(ContributionEntry item)
    {
        ToastService.ShowInfo(
            $"Correcting {item.Note}. This creates a new append-only contribution entry.",
            "Correcting contribution");
    }

}
