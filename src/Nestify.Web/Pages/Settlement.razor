@page "/settlement"

<PageTitle>Shared expense &amp; meal settlement — Nestify</PageTitle>

<section class="nx-section settlement-page">
    <div class="nx-container settlement-page__wrap">
        <header class="settlement-page__header">
            <div>
                <p class="nx-eyebrow">M3 workspace</p>
                <h1>Shared expense &amp; meal settlement</h1>
                <p class="nx-lead">Choose a September workspace to record costs, contributions, meals, and the final settlement.</p>
            </div>
            <span class="settlement-page__period">September 2026</span>
        </header>

        <div class="settlement-page__banner">
            <strong>Editing enabled</strong>
            <span>Finalize only after the meal sheet and contributions have been reviewed by the house.</span>
        </div>

        <div class="settlement-page__grid">
            <a class="nx-card settlement-page__card" href="expenses">
                <span class="settlement-page__icon settlement-page__icon--expenses">৳</span>
                <div>
                    <h2>Expenses</h2>
                    <p>Record shared costs and preserve corrections in the append-only ledger.</p>
                </div>
                <span class="settlement-page__open">Open expenses →</span>
            </a>

            <a class="nx-card settlement-page__card" href="contributions">
                <span class="settlement-page__icon settlement-page__icon--contributions">C</span>
                <div>
                    <h2>Contributions</h2>
                    <p>See who paid, add direct cash contributions, and review member totals.</p>
                </div>
                <span class="settlement-page__open">Open contributions →</span>
            </a>

            <a class="nx-card settlement-page__card" href="meals">
                <span class="settlement-page__icon settlement-page__icon--meals">M</span>
                <div>
                    <h2>Meal sheet</h2>
                    <p>Enter daily meal counts with per-cell concurrency protection.</p>
                </div>
                <span class="settlement-page__open">Open meal sheet →</span>
            </a>

            <div class="nx-card settlement-page__card settlement-page__card--coming">
                <span class="settlement-page__icon settlement-page__icon--settlement">S</span>
                <div>
                    <h2>Settlement preview</h2>
                    <p>Review per-meal cost, net positions, transfers, and the ৳0.01 residual.</p>
                </div>
                <span class="settlement-page__status">Coming next</span>
            </div>
        </div>
    </div>
</section>
