@page "/login"
@using System.ComponentModel.DataAnnotations
@using Nestify.Shared.Dtos.Auth
@using Nestify.Web.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Log in — Nestify</PageTitle>

<section class="auth">
    <aside class="auth__aside">
        <a class="auth__brand" href="">
            <span class="auth__mark" aria-hidden="true">N</span>
            <span>Nestify</span>
        </a>
        <div class="auth__aside-copy">
            <p class="nx-eyebrow auth__eyebrow">Welcome back</p>
            <h1>Your seat, your house, your settlements — all where you left them.</h1>
            <p class="auth__aside-lead">
                One account for housing, domestic help, shared expenses and the marketplace.
                Log in to pick up where you stopped.
            </p>
        </div>
        <ul class="auth__points">
            <li>
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Verified profiles on every side of a deal
            </li>
            <li>
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Contact details shared only on a real match
            </li>
        </ul>
    </aside>

    <div class="auth__main">
        <div class="auth__card">
            <header class="auth__head">
                <h2>Log in to Nestify</h2>
                <p>Enter your details to continue.</p>
            </header>

            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" class="auth__form" novalidate>
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="email">Email address</label>
                    <InputText id="email" @bind-Value="_model.Email" class="field__input"
                               type="email" autocomplete="email" placeholder="you@example.com" />
                    <ValidationMessage For="@(() => _model.Email)" class="field__error" />
                </div>

                <div class="field">
                    <div class="field__label-row">
                        <label for="password">Password</label>
                        <a class="field__link" href="#" @onclick:preventDefault @onclick="ShowForgotHint">Forgot password?</a>
                    </div>
                    <div class="field__control">
                        <InputText id="password" @bind-Value="_model.Password" class="field__input"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="current-password" placeholder="Enter your password" />
                        <button type="button" class="field__toggle"
                                aria-pressed="@_showPassword.ToString().ToLowerInvariant()"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                @onclick="() => _showPassword = !_showPassword">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _model.Password)" class="field__error" />
                </div>

                <label class="field__check">
                    <input type="checkbox" @bind="_rememberMe" />
                    <span>Keep me signed in on this device</span>
                </label>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="auth__alert" role="alert">@_message</p>
                }

                <button class="nx-btn nx-btn--primary nx-btn--lg nx-btn--block" type="submit" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="auth__spinner" aria-hidden="true"></span>
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Log in</span>
                    }
                </button>
            </EditForm>

            <p class="auth__switch">
                Don't have an account?
                <a href="register">Register here</a>
            </p>
        </div>
    </div>
</section>

@code {
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "That doesn't look like a valid email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }

    private readonly LoginModel _model = new();
    private bool _showPassword;
    private bool _rememberMe = true;
    private bool _isSubmitting;
    private string? _message;

    private void ShowForgotHint()
        => _message = "Password reset isn't wired up yet — this is a preview build.";

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _message = null;

        try
        {
            var request = new LoginRequestDto { Email = _model.Email, Password = _model.Password };
            var result = await AuthService.LoginAsync(request);

            if (result is null)
            {
                _message = "We couldn't sign you in with those details.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch
        {
            _message = "We couldn't reach Nestify right now. Please try again in a moment.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
