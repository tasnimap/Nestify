@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/marketplace/items/{Id}/edit"
@attribute [Authorize(Roles = "User")]
@inject IMarketplaceService Marketplace
@inject NavigationManager Nav
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>@L["Edit listing — Nestify"]</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap mk-wrap--narrow">

        @if (_loading)
        {
            <div class="mk-skeleton" style="height:30rem"></div>
        }
        else if (_model is null)
        {
            <nav class="mk-crumbs">
                <a href="marketplace">@L["Marketplace"]</a>
                <span class="mk-crumbs__sep">/</span>
                <span>@L["Not available"]</span>
            </nav>
            <MarketplaceEmpty Title="@L["You can't edit this listing"]"
                              Message="@L["It doesn't exist, or it isn't one of yours."]">
                <a class="nx-btn nx-btn--primary" href="marketplace/mine">@L["Go to my listings"]</a>
            </MarketplaceEmpty>
        }
        else
        {
            <nav class="mk-crumbs">
                <a href="marketplace">@L["Marketplace"]</a>
                <span class="mk-crumbs__sep">/</span>
                <a href="marketplace/items/@Id">@_title</a>
                <span class="mk-crumbs__sep">/</span>
                <span>@L["Edit"]</span>
            </nav>

            <header class="mk-head">
                <div class="mk-head__titles">
                    <p class="nx-eyebrow">@L["Marketplace"]</p>
                    <h1>@L["Edit listing"]</h1>
                    <p class="mk-head__lead">@L["Changes go live straight away. Price, condition and photos are the ones buyers act on."]</p>
                </div>
            </header>

            <div class="mk-panel">
                <ItemForm Model="_model" Busy="_busy" SubmitLabel="Save changes"
                          OnValidSubmit="Submit" OnCancel="Cancel" />
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MarketplaceItemFormModel? _model;
    private string _title = string.Empty;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _model = null;
        try
        {
            var item = await Marketplace.GetItemForEditAsync(Id);
            if (item is not null)
            {
                _model = MarketplaceItemFormModel.FromDetail(item);
                _title = item.Title;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Submit()
    {
        if (_model is null) return;
        _busy = true;
        try
        {
            var ok = await Marketplace.UpdateItemAsync(Id, _model.ToUpdateDto());
            if (ok)
            {
                Toast.ShowSuccess(L["Your listing has been updated."].Value, L["Changes saved"].Value);
                Nav.NavigateTo($"marketplace/items/{Id}");
            }
            else
            {
                Toast.ShowError(L["Couldn't save those changes."].Value, L["Something went wrong"].Value);
                _busy = false;
            }
        }
        catch
        {
            Toast.ShowError(L["Couldn't save those changes."].Value, L["Something went wrong"].Value);
            _busy = false;
        }
    }

    private void Cancel() => Nav.NavigateTo($"marketplace/items/{Id}");
}
