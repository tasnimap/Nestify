@page "/marketplace"
@attribute [Authorize(Roles = "User")]
@inject IMarketplaceService Marketplace
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using Nestify.Shared.Dtos.Area
@inject IAreaService Areas

<PageTitle>@L["Marketplace"] — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap">
        <header class="mk-head">
            <div class="mk-head__titles">
                <p class="nx-eyebrow">M4 · @L["Marketplace"]</p>
                <h1>@L["Second-hand things, between people you can place."]</h1>
                <p class="mk-head__lead">
                    @L["Furniture, books and appliances from other verified bachelors in your division. Every seller carries the same identity check you do."]
                </p>
            </div>
            <div class="mk-head__actions">
                <a class="nx-btn nx-btn--ghost" href="buy-interests/mine">@L["My buy requests"]</a>
                <a class="nx-btn nx-btn--ghost" href="marketplace/mine">@L["My listings"]</a>
                <button type="button" class="mk-credit" @onclick="OpenPackages">
                    <strong>@L["{0} posts", _postingBalance.PostsLeft]</strong>
                    <span>@(_postingBalance.NextExpiryUtc is { } expiry ? L["Expires {0}", expiry.ToLocalTime().ToString("d MMM")] : L["Buy posting tokens"])</span>
                </button>
                <button type="button" class="nx-btn nx-btn--primary" @onclick="OpenPostModal">
                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    @L["Post an item"]
                </button>
            </div>
        </header>

        @if (_showPackages)
        {
            <div class="mk-checkout-backdrop" role="presentation" @onclick="ClosePackages">
                <section class="mk-checkout" role="dialog" aria-modal="true" aria-labelledby="posting-package-title" @onclick:stopPropagation="true">
                    <button class="mk-checkout__close" type="button" aria-label="@L["Close"]" @onclick="ClosePackages">×</button>
                    <p class="nx-eyebrow">@L["Marketplace posting tokens"]</p>
                    <h2 id="posting-package-title">@L["Keep your listings moving"]</h2>
                    <p class="mk-checkout__intro">@L["Each published item uses one token. Buying any package renews every active marketplace token to one shared expiry date, just like a mobile recharge."]</p>

                    <div class="mk-checkout__balance">
                        <span>@L["Available to publish"]</span>
                        <strong>@_postingBalance.PostsLeft <small>@L["posts"]</small></strong>
                        <em>@(_postingBalance.NextExpiryUtc is { } nextExpiry ? L["Next expiry: {0}", nextExpiry.ToLocalTime().ToString("d MMM yyyy")] : L["Choose a package to get started"])</em>
                    </div>

                    <div class="mk-package-grid">
                        @foreach (var plan in _postingPlans)
                        {
                            <button type="button" aria-pressed="@(_selectedPlan?.Id == plan.Id)" class="mk-package @(_selectedPlan?.Id == plan.Id ? "mk-package--selected" : null)" @onclick="() => _selectedPlan = plan">
                                <strong>@plan.Name</strong><span>@L["{0} post tokens", plan.Posts]</span><small>@L["Expires after {0} days", plan.ValidDays]</small><b>৳@plan.PriceBdt.ToString("N0")</b>
                            </button>
                        }
                    </div>

                    @if (_selectedPlan is not null)
                    {
                        <div class="mk-pay-form">
                            <div class="mk-pay-form__brand"><b>bKash</b><span>@L["Secure practice checkout"]</span></div>
                            <input type="tel" placeholder="@L["bKash number (e.g. 01712345678)"]" @bind="_bkashNumber" />
                            <input type="password" inputmode="numeric" maxlength="5" placeholder="@L["bKash PIN"]" @bind="_bkashPin" />
                            @if (!string.IsNullOrWhiteSpace(_checkoutError)) { <p class="mk-checkout__error">@_checkoutError</p> }
                            <button type="button" class="nx-btn nx-btn--primary" disabled="@_checkingOut" @onclick="CheckoutAsync">
                                @(_checkingOut ? L["Processing…"] : L["Pay ৳{0} and add {1} posts", _selectedPlan.PriceBdt.ToString("N0"), _selectedPlan.Posts])
                            </button>
                        </div>
                    }
                </section>
            </div>
        }

        <div class="mk-browse">
            <aside class="mk-lens" aria-label="@L["Filter listings"]">
                <div class="mk-lens__row">
                    <label class="mk-lens__label" for="mk-search">@L["Search"]</label>
                    <div class="mk-lens__search">
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                        <input id="mk-search" type="search" placeholder="@L["table, cycle, Miyako…"]"
                               value="@_filter.Search"
                               @onchange="OnSearchChange" />
                    </div>
                </div>

                <div class="mk-lens__row">
                    <span class="mk-lens__label">@L["Category"]</span>
                    <div class="mk-chips">
                        <button type="button" class="mk-chip @(_filter.Category is null ? "mk-chip--active" : null)"
                                @onclick="() => SetCategory(null)">@L["All"]</button>
                        @foreach (var c in _categories)
                        {
                            <button type="button" class="mk-chip @(_filter.Category == c ? "mk-chip--active" : null)"
                                    @onclick="() => SetCategory(c)">@L[MarketplaceView.Label(c)]</button>
                        }
                    </div>
                </div>

                <div class="mk-lens__row">
                    <span class="mk-lens__label">@L["Condition"]</span>
                    <div class="mk-seg mk-seg--wrap">
                        <button type="button" class="mk-seg__opt @(_filter.Condition is null ? "mk-seg__opt--active" : null)"
                                @onclick="() => SetCondition(null)">@L["Any"]</button>
                        @foreach (var cond in _conditions)
                        {
                            <button type="button" class="mk-seg__opt @(_filter.Condition == cond ? "mk-seg__opt--active" : null)"
                                    @onclick="() => SetCondition(cond)">@L[MarketplaceView.Label(cond)]</button>
                        }
                    </div>
                </div>

                <div class="mk-lens__row">
                    <span class="mk-lens__label">@L["Price range (৳)"]</span>
                    <div class="mk-lens__price" @key="_priceBoxKey">
                        <input type="number" min="0" step="100" placeholder="@L["Min"]" inputmode="numeric"
                               value="@_filter.MinPrice" @onchange="OnMinPrice" aria-label="@L["Minimum price"]" />
                        <span class="mk-lens__dash">–</span>
                        <input type="number" min="0" step="100" placeholder="@L["Max"]" inputmode="numeric"
                               value="@_filter.MaxPrice" @onchange="OnMaxPrice" aria-label="@L["Maximum price"]" />
                    </div>
                </div>

                <div class="mk-lens__row">
                    <label class="mk-lens__label" for="mk-division">@L["Division"]</label>
                    <select id="mk-division" class="mk-lens__select"
                            value="@(_divisionId?.ToString() ?? string.Empty)" @onchange="OnDivision">
                        <option value="">@L["All Bangladesh"]</option>
                        @foreach (var d in _divisions)
                        {
                            <option value="@d.Id">@d.Label()</option>
                        }
                    </select>
                </div>

                @if (_divisionId is not null)
                {
                    <div class="mk-lens__row">
                        <label class="mk-lens__label" for="mk-district">@L["District"]</label>
                        <select id="mk-district" class="mk-lens__select"
                                value="@(_districtId?.ToString() ?? string.Empty)" @onchange="OnDistrict">
                            <option value="">@L["All districts"]</option>
                            @foreach (var d in _districts)
                            {
                                <option value="@d.Id">@d.Label()</option>
                            }
                        </select>
                    </div>
                }

                @if (_districtId is not null)
                {
                    <div class="mk-lens__row">
                        <label class="mk-lens__label" for="mk-upazila">@L["Upazila / thana"]</label>
                        <select id="mk-upazila" class="mk-lens__select"
                                value="@(_upazilaId?.ToString() ?? string.Empty)" @onchange="OnUpazila">
                            <option value="">@L["All upazilas"]</option>
                            @foreach (var u in _upazilas)
                            {
                                <option value="@u.Id">@u.Label()</option>
                            }
                        </select>
                    </div>
                }

                @if (HasActiveFilters)
                {
                    <button type="button" class="mk-lens__clear" @onclick="ClearFilters">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M6 18 18 6" /></svg>
                        @L["Clear all filters"]
                    </button>
                }
            </aside>

            <div class="mk-results">
                <div class="mk-results__bar">
                    <p class="mk-results__count">
                        @if (_loading)
                        {
                            <span>@L["Loading listings…"]</span>
                        }
                        else if (_page is not null)
                        {
                            <span><strong>@_page.TotalCount</strong> @(_page.TotalCount == 1 ? L["item"] : L["items"])</span>
                        }
                    </p>
                    <div class="mk-seg">
                        @foreach (var s in _sorts)
                        {
                            <button type="button" class="mk-seg__opt @(_filter.Sort == s ? "mk-seg__opt--active" : null)"
                                    @onclick="() => SetSort(s)">@L[MarketplaceView.ShortLabel(s)]</button>
                        }
                    </div>
                </div>

                @if (_loading)
                {
                    <div class="mk-grid">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="mk-skeleton mk-skeleton--card"></div>
                        }
                    </div>
                }
                else if (_error)
                {
                    <MarketplaceEmpty Title="@L["Couldn't load listings"]"
                                      Message="@L["Something went wrong reaching the marketplace. Try again in a moment."]">
                        <button class="nx-btn nx-btn--primary" @onclick="LoadAsync">@L["Retry"]</button>
                    </MarketplaceEmpty>
                }
                else if (_page is null || _page.Items.Count == 0)
                {
                    <MarketplaceEmpty Title="@L["Nothing matches those filters"]"
                                      Message="@L["No active listing fits this combination yet. Widen the price range or clear a filter."]">
                        @if (HasActiveFilters)
                        {
                            <button class="nx-btn nx-btn--ghost" @onclick="ClearFilters">@L["Clear filters"]</button>
                        }
                    </MarketplaceEmpty>
                }
                else
                {
                    <div class="mk-grid">
                        @foreach (var item in _page.Items)
                        {
                            <ItemCard Item="item" />
                        }
                    </div>

                    @if (_page.TotalPages > 1)
                    {
                        <nav class="mk-pager" aria-label="@L["Pagination"]">
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasPrevious)" @onclick="PrevPage">@L["Previous"]</button>
                            <span class="mk-pager__pages">@L["Page {0} of {1}", _page.Page, _page.TotalPages]</span>
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasNext)" @onclick="NextPage">@L["Next"]</button>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</section>

@if (_showPostModal)
{
    <ItemPostModal OnClose="ClosePostModal" OnCreated="OnItemCreated" />
}

@code {
    private bool _showPostModal;
    private bool _showPackages;
    private bool _checkingOut;
    private string _bkashNumber = string.Empty;
    private string _bkashPin = string.Empty;
    private string? _checkoutError;
    private IReadOnlyList<MarketplacePostingPlanDto> _postingPlans = Array.Empty<MarketplacePostingPlanDto>();
    private MarketplacePostingPlanDto? _selectedPlan;
    private MarketplacePostingBalanceDto _postingBalance = new();

    private void OpenPostModal() => _showPostModal = true;

    private void ClosePostModal() => _showPostModal = false;

    private async Task OpenPackages()
    {
        _showPackages = true;
        _checkoutError = null;
        try
        {
            _postingPlans = await Marketplace.GetPostingPlansAsync();
            _postingBalance = await Marketplace.GetPostingBalanceAsync();
            _selectedPlan ??= _postingPlans.FirstOrDefault();
        }
        catch { _checkoutError = L["Could not load posting packages. Please try again."].Value; }
    }

    private void ClosePackages() => _showPackages = false;

    private async Task CheckoutAsync()
    {
        if (_selectedPlan is null) return;
        _checkingOut = true;
        _checkoutError = null;
        try
        {
            var purchase = await Marketplace.BuyPostingPlanAsync(new BuyMarketplacePlanDto { PlanId = _selectedPlan.Id, BkashNumber = _bkashNumber, Pin = _bkashPin });
            _postingBalance.PostsLeft = purchase.PostsLeft;
            _postingBalance.NextExpiryUtc = purchase.ExpiresAtUtc;
            _showPackages = false;
        }
        catch { _checkoutError = L["Payment could not be completed. Please try again."].Value; }
        finally { _checkingOut = false; }
    }

    private Task OnItemCreated(string id)
    {
        _showPostModal = false;
        return LoadAsync();
    }

    private readonly MarketplaceCategory[] _categories = Enum.GetValues<MarketplaceCategory>();
    private readonly ItemCondition[] _conditions = Enum.GetValues<ItemCondition>();
    private readonly MarketplaceSort[] _sorts = Enum.GetValues<MarketplaceSort>();
    // Division, district and upazila all come from the seeded administrative tables
    // through the area service, so the names in these dropdowns are the same strings
    // the listings are stored with. Picking a division loads its districts, and a
    // district loads its upazilas and metropolitan thanas.
    private IReadOnlyList<DivisionDto> _divisions = Array.Empty<DivisionDto>();
    private IReadOnlyList<DistrictDto> _districts = Array.Empty<DistrictDto>();
    private IReadOnlyList<UpazilaDto> _upazilas = Array.Empty<UpazilaDto>();

    private int? _divisionId;
    private int? _districtId;
    private int? _upazilaId;

    private MarketplaceItemFilterDto _filter = new();
    private int _priceBoxKey;
    private MarketplacePageDto<MarketplaceItemSummaryDto>? _page;
    private bool _loading = true;
    private bool _error;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_filter.Search) || _filter.Category is not null ||
        _filter.Condition is not null || _filter.MinPrice is not null ||
        _filter.MaxPrice is not null || !string.IsNullOrWhiteSpace(_filter.Division) ||
        !string.IsNullOrWhiteSpace(_filter.District) || !string.IsNullOrWhiteSpace(_filter.Upazila);

    protected override async Task OnInitializedAsync()
    {
        _divisions = await Areas.GetDivisionsAsync();
        try { _postingBalance = await Marketplace.GetPostingBalanceAsync(); } catch { }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            _page = await Marketplace.BrowseAsync(_filter);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyAsync()
    {
        _filter.Page = 1;
        return LoadAsync();
    }

    private Task OnSearchChange(ChangeEventArgs e)
    {
        _filter.Search = e.Value?.ToString();
        return ApplyAsync();
    }

    private Task SetCategory(MarketplaceCategory? c)
    {
        _filter.Category = _filter.Category == c ? null : c;
        return ApplyAsync();
    }

    private Task SetCondition(ItemCondition? cond)
    {
        _filter.Condition = cond;
        return ApplyAsync();
    }

    private Task SetSort(MarketplaceSort s)
    {
        _filter.Sort = s;
        return ApplyAsync();
    }

    private Task OnMinPrice(ChangeEventArgs e)
    {
        _filter.MinPrice = ReadPrice(e.Value);
        return ApplyAsync();
    }

    private Task OnMaxPrice(ChangeEventArgs e)
    {
        _filter.MaxPrice = ReadPrice(e.Value);
        return ApplyAsync();
    }

    // Negative or unreadable input clears the box instead of filtering on it.
    // The key bump makes Blazor rebuild the inputs so the typed "-" disappears.
    private decimal? ReadPrice(object? value)
    {
        var text = value?.ToString();
        if (decimal.TryParse(text, out var v) && v > 0)
        {
            return v;
        }

        if (!string.IsNullOrWhiteSpace(text))
        {
            _priceBoxKey++;
        }

        return null;
    }

    private async Task OnDivision(ChangeEventArgs e)
    {
        _divisionId = ParseId(e.Value);
        _districtId = null;
        _upazilaId = null;
        _districts = _divisionId is int id ? await Areas.GetDistrictsAsync(id) : Array.Empty<DistrictDto>();
        _upazilas = Array.Empty<UpazilaDto>();

        _filter.Division = _divisions.FirstOrDefault(d => d.Id == _divisionId)?.Name;
        _filter.District = null;
        _filter.Upazila = null;
        await ApplyAsync();
    }

    private async Task OnDistrict(ChangeEventArgs e)
    {
        _districtId = ParseId(e.Value);
        _upazilaId = null;
        _upazilas = _districtId is int id ? await Areas.GetUpazilasAsync(id) : Array.Empty<UpazilaDto>();

        _filter.District = _districts.FirstOrDefault(d => d.Id == _districtId)?.Name;
        _filter.Upazila = null;
        await ApplyAsync();
    }

    private Task OnUpazila(ChangeEventArgs e)
    {
        _upazilaId = ParseId(e.Value);
        _filter.Upazila = _upazilas.FirstOrDefault(u => u.Id == _upazilaId)?.Name;
        return ApplyAsync();
    }

    private static int? ParseId(object? value) =>
        int.TryParse(value?.ToString(), out var id) ? id : null;

    private Task ClearFilters()
    {
        _filter = new MarketplaceItemFilterDto { Sort = _filter.Sort };
        _divisionId = _districtId = _upazilaId = null;
        _districts = Array.Empty<DistrictDto>();
        _upazilas = Array.Empty<UpazilaDto>();
        return LoadAsync();
    }

    private Task PrevPage()
    {
        if (_page?.HasPrevious == true) { _filter.Page--; return LoadAsync(); }
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        if (_page?.HasNext == true) { _filter.Page++; return LoadAsync(); }
        return Task.CompletedTask;
    }
}
