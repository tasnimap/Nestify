@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@page "/marketplace/items/{Id}"
@attribute [Authorize(Roles = "User")]
@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>@(_item?.Title ?? L["Listing"].Value) — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap">

        @if (_loading)
        {
            <div class="mk-detail">
                <div class="mk-skeleton" style="aspect-ratio:4/3"></div>
                <div class="mk-skeleton" style="height:22rem"></div>
            </div>
        }
        else if (_item is null)
        {
            <nav class="mk-crumbs">
                <a href="marketplace">@L["Marketplace"]</a>
                <span class="mk-crumbs__sep">/</span>
                <span>@L["Not available"]</span>
            </nav>
            <MarketplaceEmpty Title="@L["This listing isn't available"]"
                              Message="@L["It may have been sold, taken down, or the link is wrong."]">
                <a class="nx-btn nx-btn--primary" href="marketplace">@L["Back to marketplace"]</a>
            </MarketplaceEmpty>
        }
        else
        {
            <nav class="mk-crumbs">
                <a href="marketplace">@L["Marketplace"]</a>
                <span class="mk-crumbs__sep">/</span>
                <span>@L[MarketplaceView.Label(_item.Category)]</span>
                <span class="mk-crumbs__sep">/</span>
                <span>@_item.Title</span>
            </nav>

            <div class="mk-detail">
                <div class="mk-detail__main">
                    <ImageGallery Images="_item.Images" Title="@_item.Title" />

                    <section class="mk-panel mk-detail__about">
                        <div class="mk-detail__about-head">
                            <ConditionBadge Condition="_item.Condition" />
                            <span class="mk-badge mk-badge--good">@L[MarketplaceView.Label(_item.Category)]</span>
                            @if (_item.IsPinned)
                            {
                                <span class="mk-badge mk-badge--pinned">
                                    <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
                                        <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
                                    </svg>
                                    @L["Pinned Listing"]
                                </span>
                            }
                            @if (_item.Status == ListingStatus.Sold)
                            {
                                <ListingStatusBadge Status="_item.Status" />
                            }
                        </div>
                        <h2>@L["Description"]</h2>
                        <p class="mk-plain">@_item.Description</p>

                        <div class="mk-specs">
                            <div class="mk-specs__cell">
                                <div class="mk-specs__k">@L["Condition"]</div>
                                <div class="mk-specs__v">@L[MarketplaceView.Label(_item.Condition)]</div>
                            </div>
                            <div class="mk-specs__cell">
                                <div class="mk-specs__k">@L["Category"]</div>
                                <div class="mk-specs__v">@L[MarketplaceView.Label(_item.Category)]</div>
                            </div>
                            <div class="mk-specs__cell">
                                <div class="mk-specs__k">@L["Area"]</div>
                                <div class="mk-specs__v">@_item.AreaName</div>
                            </div>
                            <div class="mk-specs__cell">
                                <div class="mk-specs__k">@L["Listed"]</div>
                                <div class="mk-specs__v">@MarketplaceView.RelativeTime(_item.PostedAtUtc, L)</div>
                            </div>
                            @if (_item.IsPinned && _item.PinnedUntilUtc is { } pinExpiry)
                            {
                                <div class="mk-specs__cell mk-specs__cell--highlight">
                                    <div class="mk-specs__k">@L["Pinned Until"]</div>
                                    <div class="mk-specs__v">@pinExpiry.ToLocalTime().ToString("d MMM yyyy, h:mm tt", System.Globalization.CultureInfo.CurrentCulture)</div>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="mk-panel mk-seller">
                        <div class="mk-ava mk-ava--lg">@MarketplaceView.Initials(_item.SellerDisplayName)</div>
                        <div class="mk-seller__body">
                            <div class="mk-seller__name">
                                @_item.SellerDisplayName
                                <VerifiedBadge Verified="_item.SellerVerified" ShowUnverified="true" CssClass="mk-verified--lg" />
                            </div>
                            <p class="mk-muted">@MarketplaceView.MemberSince(_item.SellerJoinedUtc, L) · @_item.Division</p>
                        </div>
                    </section>
                </div>

                <aside class="mk-buybox">
                    <div class="mk-buybox__inner">
                        <p class="mk-price mk-price--lg">@Money.Format(_item.PriceBdt)</p>
                        <h1 class="mk-buybox__title">@_item.Title</h1>
                        <p class="mk-buybox__meta">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
                            </svg>
                            @_item.AreaName
                        </p>

                        @if (_item.Status == ListingStatus.Sold)
                        {
                            <div class="mk-buybox__notice">@L["This item has been marked sold."]</div>
                        }
                        else if (_item.IsMine)
                        {
                            <div class="mk-buybox__owner">
                                <p class="mk-muted">@L["This is your listing."]</p>
                                
                                @if (_item.IsPinned && _item.PinnedUntilUtc is { } expiry)
                                {
                                    <div class="mk-pin-status-pill">
                                        <span class="mk-pin-status-pill__icon">📌</span>
                                        <span>@L["Pinned to top until {0}", expiry.ToLocalTime().ToString("d MMM, h:mm tt", System.Globalization.CultureInfo.CurrentCulture)]</span>
                                    </div>
                                    <button type="button" class="nx-btn nx-btn--ghost nx-btn--block mk-btn--pin" @onclick="() => _showPinModal = true">
                                        @L["Extend Pin (৳50 with bKash)"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="nx-btn nx-btn--block mk-btn--pin-cta" @onclick="() => _showPinModal = true">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                                            <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
                                        </svg>
                                        @L["Pin to Top (৳50 with bKash)"]
                                    </button>
                                }

                                <a class="nx-btn nx-btn--primary nx-btn--block" href="marketplace/items/@_item.Id/interests">
                                    @L["See buyer interest"]
                                </a>
                                <a class="nx-btn nx-btn--ghost nx-btn--block" href="marketplace/items/@_item.Id/edit">@L["Edit listing"]</a>
                            </div>
                        }
                        else if (_item.HasActiveInterest)
                        {
                            <div class="mk-buybox__notice mk-buybox__notice--ok">
                                @L["You've sent the seller a buy request. Track it on"]
                                <a href="buy-interests/mine">@L["your buy requests"]</a>.
                            </div>
                        }
                        else if (_showInterestForm)
                        {
                            <div class="mk-buybox__form">
                                <label for="mk-interest-msg">@L["Message to the seller"]</label>
                                <textarea id="mk-interest-msg" rows="3" maxlength="400"
                                          placeholder="@L["Say when you can pick it up and ask anything you need to."]"
                                          @bind="_interestMessage" @bind:event="oninput"></textarea>
                                <div class="mk-buybox__form-actions">
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => _showInterestForm = false" disabled="@_sending">@L["Cancel"]</button>
                                    <button class="nx-btn nx-btn--accent" @onclick="SendInterest"
                                            disabled="@(_sending || string.IsNullOrWhiteSpace(_interestMessage))">
                                        @(_sending ? L["Sending…"] : L["Send request"])
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="nx-btn nx-btn--accent nx-btn--block nx-btn--lg" @onclick="() => _showInterestForm = true">
                                @L["Buy this item"]
                            </button>
                        }

                        <button class="mk-buybox__report" @onclick="() => _showReport = !_showReport">
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4 2 4H5" />
                            </svg>
                            @L["Report this listing"]
                        </button>

                        @if (_showReport)
                        {
                            <div class="mk-buybox__form">
                                <label for="mk-report-reason">@L["Reason"]</label>
                                <select id="mk-report-reason" @bind="_reportReason">
                                    <option value="Prohibited item">@L["Prohibited item"]</option>
                                    <option value="Misleading description">@L["Misleading description"]</option>
                                    <option value="Suspected scam">@L["Suspected scam"]</option>
                                    <option value="Wrong category">@L["Wrong category"]</option>
                                    <option value="Other">@L["Other"]</option>
                                </select>
                                <textarea rows="2" maxlength="300" placeholder="@L["Add any detail (optional)"]"
                                          @bind="_reportDetail"></textarea>
                                <div class="mk-buybox__form-actions">
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => _showReport = false">@L["Cancel"]</button>
                                    <button class="nx-btn nx-btn--primary" @onclick="SubmitReport">@L["Submit report"]</button>
                                </div>
                            </div>
                        }

                        <p class="mk-buybox__safe">
                            @L["Contact details are shared only after the seller accepts. Meet in a public place."]
                        </p>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

@if (_showPinModal && _item is not null)
{
    <PinListingModal ListingId="@_item.Id"
                     ListingTitle="@_item.Title"
                     PriceBdt="@_item.PriceBdt"
                     CoverImage="@(_item.Images.FirstOrDefault() ?? string.Empty)"
                     IsCurrentlyPinned="@_item.IsPinned"
                     CurrentPinnedUntilUtc="@_item.PinnedUntilUtc"
                     OnClose="() => _showPinModal = false"
                     OnPinned="OnPinnedSuccess" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MarketplaceItemDetailDto? _item;
    private bool _loading = true;

    private bool _showInterestForm;
    private string _interestMessage = string.Empty;
    private bool _sending;

    private bool _showReport;
    private string _reportReason = "Prohibited item";
    private string _reportDetail = string.Empty;

    private bool _showPinModal;

    protected override async Task OnParametersSetAsync()
    {
        await LoadItemAsync();
    }

    private async Task LoadItemAsync()
    {
        _loading = true;
        _item = null;
        try
        {
            _item = await Marketplace.GetItemAsync(Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPinnedSuccess(MarketplacePinResultDto receipt)
    {
        _showPinModal = false;
        if (_item is not null)
        {
            _item.IsPinned = true;
            _item.PinnedUntilUtc = receipt.PinnedUntilUtc;
        }
        await LoadItemAsync();
    }

    private async Task SendInterest()
    {
        if (_item is null || string.IsNullOrWhiteSpace(_interestMessage)) return;
        _sending = true;
        try
        {
            var ok = await Marketplace.ExpressInterestAsync(_item.Id, _interestMessage.Trim());
            if (ok)
            {
                _item.HasActiveInterest = true;
                _showInterestForm = false;
                _interestMessage = string.Empty;
                Toast.ShowSuccess(L["The seller can now see your request and message."].Value, L["Buy request sent"].Value);
            }
            else
            {
                Toast.ShowWarning(L["Couldn't send that request — you may already have one open."].Value, L["Not sent"].Value);
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task SubmitReport()
    {
        if (_item is null) return;
        var (ok, message) = await Marketplace.ReportItemAsync(_item.Id, _reportReason, _reportDetail);
        if (ok)
        {
            _showReport = false;
            _reportDetail = string.Empty;
            Toast.ShowInfo(L["Thanks — our team will review this listing."].Value, L["Report submitted"].Value);
        }
        else
        {
            Toast.ShowWarning(L["Could not submit your report. Please try again."].Value, L["Report not sent"].Value);
        }
    }
}
