@page "/marketplace/mine"
@attribute [Authorize(Roles = "User")]
@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast

<PageTitle>My listings — Nestify</PageTitle>

<section class="nx-section mk-page">
    <div class="nx-container mk-wrap mk-wrap--narrow">
        <nav class="mk-crumbs">
            <a href="marketplace">Marketplace</a>
            <span class="mk-crumbs__sep">/</span>
            <span>My listings</span>
        </nav>

        <header class="mk-head">
            <div class="mk-head__titles">
                <p class="nx-eyebrow">Marketplace</p>
                <h1>My listings</h1>
                <p class="mk-head__lead">Everything you've posted, including sold and removed items.</p>
            </div>
            <div class="mk-head__actions">
                <button type="button" class="nx-btn nx-btn--primary" @onclick="OpenPostModal">
                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    Post an item
                </button>
            </div>
        </header>

        @if (_loading)
        {
            <div class="mk-rows">
                <div class="mk-skeleton" style="height:9rem"></div>
                <div class="mk-skeleton" style="height:9rem"></div>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <MarketplaceEmpty Title="You haven't listed anything yet"
                              Message="Sell a piece of furniture, a book bundle or an appliance you've replaced.">
                <button type="button" class="nx-btn nx-btn--primary" @onclick="OpenPostModal">Post your first item</button>
            </MarketplaceEmpty>
        }
        else
        {
            <div class="mk-tabs" role="tablist">
                @foreach (var tab in _tabs)
                {
                    <button type="button" role="tab" class="mk-tab @(_tab == tab ? "mk-tab--active" : null)"
                            @onclick="() => _tab = tab">
                        @tab.Label <span class="mk-muted">@Count(tab.Status)</span>
                    </button>
                }
            </div>

            @if (Filtered.Count == 0)
            {
                <MarketplaceEmpty Title="@($"No {_tab.Label.ToLower()} listings")" />
            }
            else
            {
                <div class="mk-rows">
                    @foreach (var row in Filtered)
                    {
                        var it = row.Item;
                        <article class="mk-row @(it.Status == ListingStatus.Removed ? "mk-row--muted" : null)">
                            <div class="mk-row__top">
                                <div class="mk-row__thumb">
                                    <button type="button" class="mk-row__photo" @onclick="() => OpenPhotos(it)"
                                            aria-label="View photos of @it.Title">
                                        <MediaTile Seed="@it.CoverImage" Label="@it.Title" />
                                        @if (it.Images.Count > 1)
                                        {
                                            <span class="mk-row__photo-count">+@(it.Images.Count - 1)</span>
                                        }
                                    </button>
                                </div>
                                <div class="mk-row__grow">
                                    <div class="mk-row__title">
                                        <a href="marketplace/items/@it.Id">@it.Title</a>
                                    </div>
                                    <div class="mk-row__badges">
                                        <span class="mk-price mk-price--sm">@Money.Format(it.PriceBdt)</span>
                                        <ListingStatusBadge Status="it.Status" />
                                        <ConditionBadge Condition="it.Condition" />
                                    </div>
                                    <div class="mk-row__meta">
                                        <span>@it.AreaName</span>
                                        <span class="mk-dot"></span>
                                        <span>Listed @MarketplaceView.RelativeTime(it.PostedAtUtc)</span>
                                    </div>
                                    <div class="mk-row__stats">
                                        <span class="mk-stat">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                                            <strong>@row.ViewCount</strong> views
                                        </span>
                                        <span class="mk-stat">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" /></svg>
                                            <strong>@row.InterestCount</strong> interested
                                        </span>
                                        @if (row.PendingInterestCount > 0)
                                        {
                                            <span class="mk-stat"><strong>@row.PendingInterestCount</strong> awaiting reply</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="mk-row__actions">
                                <a class="nx-btn nx-btn--primary" href="marketplace/items/@it.Id/interests">
                                    Buyer interest
                                    @if (row.PendingInterestCount > 0)
                                    {
                                        <span class="mk-count-pill">@row.PendingInterestCount</span>
                                    }
                                </a>
                                @if (it.Status == ListingStatus.Active)
                                {
                                    <a class="nx-btn nx-btn--ghost" href="marketplace/items/@it.Id/edit">Edit</a>
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => OpenSoldPicker(it.Id)">Mark sold</button>
                                }
                                <span class="mk-row__actions-spacer"></span>
                                @if (it.Status != ListingStatus.Removed)
                                {
                                    @if (_confirmDelete == it.Id)
                                    {
                                        <span class="mk-muted mk-nowrap">Remove this listing?</span>
                                        <button class="nx-btn nx-btn--ghost" @onclick="() => _confirmDelete = null">Cancel</button>
                                        <button class="nx-btn nx-btn--ghost mk-danger-btn" @onclick="() => Delete(it.Id)">Remove</button>
                                    }
                                    else
                                    {
                                        <button class="nx-btn nx-btn--ghost mk-danger-btn" @onclick="() => _confirmDelete = it.Id">Remove</button>
                                    }
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>

@if (_showPostModal)
{
    <ItemPostModal OnClose="ClosePostModal" OnCreated="OnItemCreated" />
}

@if (_soldItemId is not null)
{
    <div class="mk-modal-overlay" @onclick="CloseSoldPicker">
        <div class="mk-modal" @onclick:stopPropagation="true">
            <header class="mk-modal__header">
                <h2>Who bought it?</h2>
                <button type="button" class="mk-modal__close" @onclick="CloseSoldPicker" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </header>

            <div class="mk-modal__body">
                @if (_soldLoading)
                {
                    <p class="mk-muted">Loading buy requests…</p>
                }
                else
                {
                    <p class="mk-muted">
                        Pick the accepted request you sold the item to. That buyer is told they got it;
                        every other request is closed and nobody can withdraw after this.
                    </p>

                    <div class="mk-sold-options">
                        @foreach (var interest in _soldOptions)
                        {
                            <label class="mk-sold-option @(_soldPick == interest.Id ? "is-picked" : null)">
                                <input type="radio" name="mk-sold-buyer" value="@interest.Id"
                                       checked="@(_soldPick == interest.Id)"
                                       @onchange="() => _soldPick = interest.Id" />
                                <span class="mk-sold-option__body">
                                    <strong>@interest.BuyerDisplayName</strong>
                                    <InterestStatusBadge Status="interest.Status" />
                                    <span class="mk-muted mk-plain">@interest.Message</span>
                                </span>
                            </label>
                        }

                        <label class="mk-sold-option @(_soldPick is null ? "is-picked" : null)">
                            <input type="radio" name="mk-sold-buyer" value=""
                                   checked="@(_soldPick is null)"
                                   @onchange="() => _soldPick = null" />
                            <span class="mk-sold-option__body">
                                <strong>Sold outside Nestify</strong>
                                <span class="mk-muted">@(_soldOptions.Count == 0 ? "You have not accepted any request on this listing." : "None of these buyers took it.")</span>
                            </span>
                        </label>
                    </div>

                    <div class="mk-row__actions">
                        <span class="mk-row__actions-spacer"></span>
                        <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseSoldPicker" disabled="@_soldBusy">Cancel</button>
                        <button type="button" class="nx-btn nx-btn--primary" @onclick="ConfirmSold" disabled="@_soldBusy">Mark as sold</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_photoItem is not null && _photoItem.Images.Count > 0)
{
    <PhotoLightbox Images="_photoItem.Images" Caption="@_photoItem.Title" OnClose="ClosePhotos" />
}

@code {
    private sealed record Tab(string Label, ListingStatus? Status);

    private readonly Tab[] _tabs =
    {
        new("All", null),
        new("Active", ListingStatus.Active),
        new("Sold", ListingStatus.Sold),
        new("Removed", ListingStatus.Removed)
    };

    private Tab _tab;
    private List<MyListingDto> _rows = new();
    private bool _loading = true;
    private string? _confirmDelete;
    private MarketplaceItemSummaryDto? _photoItem;
    private bool _showPostModal;

    private void OpenPostModal() => _showPostModal = true;

    private void ClosePostModal() => _showPostModal = false;

    private Task OnItemCreated(string id)
    {
        _showPostModal = false;
        return LoadAsync();
    }

    private void OpenPhotos(MarketplaceItemSummaryDto item) => _photoItem = item;

    private void ClosePhotos() => _photoItem = null;

    public MyListings() => _tab = _tabs[0];

    private IReadOnlyList<MyListingDto> Filtered =>
        _tab.Status is null ? _rows : _rows.Where(r => r.Item.Status == _tab.Status).ToList();

    private string Count(ListingStatus? status) =>
        (status is null ? _rows.Count : _rows.Count(r => r.Item.Status == status)).ToString();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Marketplace.GetMyListingsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private string? _soldItemId;
    private bool _soldLoading;
    private bool _soldBusy;
    private string? _soldPick;
    private List<BuyInterestDto> _soldOptions = new();

    private async Task OpenSoldPicker(string id)
    {
        _soldItemId = id;
        _soldPick = null;
        _soldLoading = true;
        try
        {
            _soldOptions = (await Marketplace.GetItemInterestsAsync(id))
                .Where(i => i.Status == BuyInterestStatus.Accepted)
                .ToList();
            _soldPick = _soldOptions.FirstOrDefault()?.Id;
        }
        finally
        {
            _soldLoading = false;
        }
    }

    private void CloseSoldPicker()
    {
        if (_soldBusy) return;
        _soldItemId = null;
    }

    private async Task ConfirmSold()
    {
        if (_soldItemId is null) return;
        _soldBusy = true;
        try
        {
            if (await Marketplace.MarkSoldAsync(_soldItemId, _soldPick))
            {
                Toast.ShowSuccess(_soldPick is null
                    ? "Listing marked as sold."
                    : "Listing marked as sold. The buyer has been told, and the other requests are closed.", "Updated");
                _soldItemId = null;
                await LoadAsync();
            }
            else
            {
                Toast.ShowWarning("Couldn't mark it sold. Reload and try again.", "Not updated");
            }
        }
        finally
        {
            _soldBusy = false;
        }
    }

    private async Task Delete(string id)
    {
        _confirmDelete = null;
        if (await Marketplace.DeleteItemAsync(id))
        {
            Toast.ShowInfo("Listing removed. It no longer appears in the marketplace.", "Removed");
            await LoadAsync();
        }
    }
}
