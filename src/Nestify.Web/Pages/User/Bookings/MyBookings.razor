@page "/bookings/mine"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Housing
@using Nestify.Web.Components.Housing
@inject IHousingService Housing
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>My bookings — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap">
        <header class="hs-head">
            <div class="hs-head__titles">
                <p class="nx-eyebrow">M1 · Housing</p>
                <h1>My bookings</h1>
                <p class="hs-head__lead">
                    Track your booking requests and manage your connections with listing managers.
                </p>
            </div>

            <div class="hs-head__actions">
                <a class="nx-btn nx-btn--ghost" href="housing">Browse listings</a>
                <a class="nx-btn nx-btn--ghost" href="housing/mine">My posts</a>
            </div>
        </header>

        @if (_loading)
        {
            <div class="hs-rows">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="hs-skeleton" style="height: 170px;"></div>
                }
            </div>
        }
        else if (_bookings.Count == 0)
        {
            <div class="hs-empty hs-empty--page">
                <div class="hs-empty__art">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9.5 21v-6h5v6" />
                    </svg>
                </div>
                <h2>You haven't made any booking requests yet</h2>
                <p>Start by browsing available seats and houses to send booking requests to managers.</p>
                <a class="nx-btn nx-btn--primary" href="housing">Browse listings</a>
            </div>
        }
        else
        {
            <div class="hs-rows">
                @foreach (var booking in _bookings)
                {
                    <article class="hs-row hs-row--booking hs-row--@HousingView.StatusModifier(booking.Status)">
                        <div class="hs-row__top">
                            <div class="hs-row__grow">
                                <h2 class="hs-row__title">
                                    <a href="housing/@booking.Post.Id">@booking.Post.Title</a>
                                </h2>
                                <div class="hs-row__badges">
                                    <span class="hs-chip hs-chip--type">@HousingView.Label(booking.Post.ListingType)</span>
                                    <span class="hs-badge @(GetStatusClass(booking.Status))">@HousingView.Label(booking)</span>
                                </div>
                                <div class="hs-row__meta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                          style="width:.95rem;height:.95rem;flex:none;">
                                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                        <circle cx="12" cy="10" r="3" />
                                    </svg>
                                    <span>@booking.Post.AreaName, @booking.Post.Division</span>
                                    <span class="hs-dot"></span>
                                    <span>Requested @booking.RequestedAtUtc.ToString("g")</span>
                                </div>
                            </div>
                            <div class="hs-price hs-price--sm">
                                ৳@booking.Post.MonthlyRent<span class="hs-price__unit">/mo</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(booking.Message))
                        {
                            <p class="hs-row__message">
                                <span class="hs-row__message-label">Your message</span>
                                @booking.Message
                            </p>
                        }

                        @if (booking.Status == BookingStatus.Accepted)
                        {
                            <p class="hs-booking-decision hs-booking-decision--accepted">
                                <span class="hs-booking-decision__label">Accepted by @booking.ManagerName</span>
                                Reach out to sort out moving in - they can give you the join code or add you by email.
                            </p>
                            <ContactDisclosureCard Contact="_contacts.GetValueOrDefault(booking.BookingId)" />
                        }

                        @if (booking.Status == BookingStatus.Rejected)
                        {
                            <p class="hs-booking-decision hs-booking-decision--rejected">
                                <span class="hs-booking-decision__label">Manager response</span>
                                @(string.IsNullOrWhiteSpace(booking.ReplyMessage)
                                    ? "The manager did not leave a note with this decision."
                                    : booking.ReplyMessage)
                            </p>
                        }

                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <p class="hs-booking-decision hs-booking-decision--pending">
                                <span class="hs-booking-decision__label">Waiting for review</span>
                                The listing manager will see your request and let you know when they have made a decision.
                            </p>
                        }

                        <div class="hs-row__actions">
                            <a class="nx-btn nx-btn--ghost" href="housing/@booking.Post.Id">View listing</a>
                            @if (booking.Status == BookingStatus.Pending)
                            {
                                <span class="hs-row__actions-spacer"></span>
                                <button type="button" class="nx-btn nx-btn--ghost hs-danger-btn"
                                        @onclick="() => WithdrawBooking(booking.BookingId)">
                                    Withdraw request
                                </button>
                            }
                            else if (booking.Status == BookingStatus.Accepted)
                            {
                                <span class="hs-row__actions-spacer"></span>
                                <button type="button" class="nx-btn nx-btn--ghost hs-danger-btn"
                                        @onclick="() => WithdrawBooking(booking.BookingId)">
                                    Cancel reservation
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<MyBookingDto> _bookings = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private Dictionary<string, ContactDisclosureDto?> _contacts = new();

    private async Task LoadBookings()
    {
        _loading = true;
        try
        {
            _bookings = (await Housing.GetMyBookingsAsync()).ToList();

            // The contact of whoever accepted is shown right on the card.
            foreach (var booking in _bookings.Where(b => b.Status == BookingStatus.Accepted))
            {
                _contacts[booking.BookingId] = await Housing.GetBookingContactAsync(booking.BookingId);
            }
        }
        catch
        {
            Toast.ShowError($"Failed to load your bookings.", "Error");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task WithdrawBooking(string bookingId)
    {
        var ok = await Housing.WithdrawBookingAsync(bookingId);
        if (!ok)
        {
            Toast.ShowError("That request can't be withdrawn any more.", "Error");
            return;
        }

        var booking = _bookings.FirstOrDefault(b => b.BookingId == bookingId);
        if (booking is not null)
        {
            booking.Status = BookingStatus.Withdrawn;
        }
        Toast.ShowSuccess("Booking withdrawn.", "Done");
    }

    private string GetStatusClass(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "hs-badge--pending",
        BookingStatus.Accepted => "hs-badge--accepted",
        BookingStatus.Rejected => "hs-badge--rejected",
        BookingStatus.Withdrawn => "hs-badge--withdrawn",
        BookingStatus.Joined => "hs-badge--joined",
        BookingStatus.HouseFull => "hs-badge--filled",
        _ => ""
    };
}
