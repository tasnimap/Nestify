    private string LocalizeMessage(string message) => message switch
    {
        "Could not reach the server." => L["Could not reach the server."],
        "Could not load your home." => L["Could not load your home."],
        "Could not create the home." => L["Could not create the home."],
        "Your session has ended. Please sign in again." => L["Your session has ended. Please sign in again."],
        "House name and address are required." => L["Home name and address are required."],
        "Max occupants must be at least 1." => L["Maximum occupants must be at least 1."],
        "Your account is no longer available. Please sign out and register again." => L["Your account is no longer available. Please sign out and register again."],
        "You are already in a home." => L["You are already in a home."],
        "Enter a join code." => L["Enter a join code."],
        "You already have a request waiting for an answer." => L["You already have a request waiting for an answer."],
        "No home uses that join code." => L["No home uses that join code."],
        "You have no request waiting." => L["You have no request waiting."],
        "Request cancelled." => L["Join request cancelled."],
        "The house is full. Raise max occupants first." => L["This home is full. Increase the maximum occupants first."],
        "Only the manager or a co-manager can edit house details." => L["Only a manager or co-manager can edit home details."],
        "Enter the email the person registered with." => L["Enter the email address used to register the person."],
        "Only the manager or a co-manager can add members." => L["Only a manager or co-manager can add members."],
        "No Nestify account uses that email." => L["No Nestify account uses that email."],
        "You cannot promote this member." => L["You cannot promote this member."],
        "You cannot demote this member." => L["You cannot change this member's role."],
        "You cannot remove this member." => L["You cannot remove this member."],
        "Only the manager can transfer the manager role." => L["Only the manager can transfer the manager role."],
        "Transfer the manager role before leaving." => L["Transfer the manager role to someone else first."],
        "You are not in a home." => L["You are not a member of a home."],
        "You left the home." => L["You left the home."],
        "House details updated." => L["Home details updated."],
        "Could not load your join request." => L["Could not load your join request."],
        "Only the manager or a co-manager can answer join requests." => L["Only the manager or a co-manager can answer join requests."],
        "Member not found." => L["Member not found."],
        "You cannot do that to yourself." => L["You cannot do that to yourself."],
        "That request is no longer waiting." => L["That request is no longer waiting."],
        "Done." => L["Done."],
        _ => LocalizeDynamicMessage(message)
    };

    private string LocalizeDynamicMessage(string message)
    {
        const string occupiedPrefix = "Max occupants cannot be lower than the ";
        const string occupiedSuffix = " occupied or reserved seats.";
        if (message.StartsWith(occupiedPrefix, StringComparison.Ordinal) && message.EndsWith(occupiedSuffix, StringComparison.Ordinal))
        {
            var count = message[occupiedPrefix.Length..^occupiedSuffix.Length];
            return L["Maximum occupants cannot be lower than the {0} occupied or reserved seats.", count];
        }

        const string requestSent = "Request sent to ";
        const string requestSentSuffix = ". A manager has to approve it.";
        if (message.StartsWith(requestSent, StringComparison.Ordinal) && message.EndsWith(requestSentSuffix, StringComparison.Ordinal))
        {
            var homeName = message[requestSent.Length..^requestSentSuffix.Length];
            return L["Request sent to {0}. A manager must approve it.", homeName];
        }

        const string joinedSuffix = " joined the house.";
        if (message.EndsWith(joinedSuffix, StringComparison.Ordinal))
            return L["{0} joined the home.", message[..^joinedSuffix.Length]];

        const string rejectedPrefix = "Request from ";
        const string rejectedSuffix = " was rejected.";
        if (message.StartsWith(rejectedPrefix, StringComparison.Ordinal) && message.EndsWith(rejectedSuffix, StringComparison.Ordinal))
            return L["The request from {0} was rejected.", message[rejectedPrefix.Length..^rejectedSuffix.Length]];

        const string addedSuffix = " was added.";
        if (message.EndsWith(addedSuffix, StringComparison.Ordinal))
            return L["{0} was added to the home.", message[..^addedSuffix.Length]];

        const string coManagerSuffix = " is now a co-manager.";
        if (message.EndsWith(coManagerSuffix, StringComparison.Ordinal))
            return L["{0} is now a co-manager.", message[..^coManagerSuffix.Length]];

        const string memberSuffix = " is now a member.";
        if (message.EndsWith(memberSuffix, StringComparison.Ordinal))
            return L["{0} is now a member.", message[..^memberSuffix.Length]];

        const string removedSuffix = " was removed.";
        if (message.EndsWith(removedSuffix, StringComparison.Ordinal))
            return L["{0} was removed from the home.", message[..^removedSuffix.Length]];

        const string managerSuffix = " is now the manager.";
        if (message.EndsWith(managerSuffix, StringComparison.Ordinal))
            return L["{0} is now the manager.", message[..^managerSuffix.Length]];

        return message;
    }

    private static string? Claim(ClaimsPrincipal user, params string[] types) =>
        user.Claims.FirstOrDefault(c => types.Any(t => string.Equals(c.Type, t, StringComparison.OrdinalIgnoreCase)))?.Value;
