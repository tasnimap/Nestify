@* Home module (M3, frontend phase).
   A user belongs to at most one home. With none, this page shows the two entry
   points: create a home (you become manager) or join one with a code.
   The join code is printed on the house card. Typing it on another user's /home
   page does not join them: it files a request that the manager or a co-manager
   approves or rejects from the "Join requests" panel.

   Role rules — enforced in HomeRules (Services/Interfaces/IHomeService.cs), which
   both this page and the service use, so the buttons and the service never disagree:
     Manager     add members, promote members to co-manager, remove anyone,
                 transfer the manager role. Cannot leave before transferring.
     Co-manager  add members, promote members to co-manager, remove plain
                 members, leave freely.
     Member      leave only.
   State lives in the homes / home_members tables (User_Home.sql) and is reached
   through IHomeService; nothing in this file talks to HTTP directly. *@
@page "/home"
@attribute [Authorize(Roles = "User")]
@using System.Security.Claims
@using Nestify.Web.Components.Home
@using Nestify.Web.Services.Interfaces
@inject IHomeService HomeService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<PageTitle>@L["My Home"] - Nestify</PageTitle>

<section class="hm">
    <div class="nx-container hm-wrap">
        <header class="hm-top">
            <div>
                <p class="hm-kicker">@L["Home"]</p>
                <h1>@(_home is null ? L["You have no home yet"].Value : _home.Name)</h1>
                <p class="hm-lead">
                    @(_home is null
                        ? L["A home is the shared house you run with your housemates — members, roles, and one place on the map."].Value
                        : $"{_home.AddressLine}, {_home.AreaName}, {_home.Division}")
                </p>
            </div>
            @if (_home is not null)
            {
                <span class="hm-rolebadge hm-role--@_home.MyRole.ToString().ToLowerInvariant()">
                    @L[RoleLabel(_home.MyRole)]
                </span>
            }
        </header>

        @if (_message is not null)
        {
            <p class="hm-msg @(_messageOk ? "hm-msg--good" : "hm-msg--bad")">@_message</p>
        }

        @if (_loading)
        {
            <p class="hm-loading">@L["Loading your home..."]</p>
        }
        else if (_loadError is not null)
        {
            <div class="hm-choices">
                <article class="hm-card hm-choice" style="--d: 60ms">
                    <span class="hm-choice__icon">!</span>
                    <h2>@L["Could not load your home"]</h2>
                    <p>@_loadError</p>
                    <button type="button" class="hm-btn hm-btn--solid" @onclick="Retry">@L["Try again"]</button>
                </article>
            </div>
        }
        else if (_home is null && _myRequest is not null)
        {
            <div class="hm-choices">
                <article class="hm-card hm-choice hm-choice--wait" style="--d: 60ms">
                    <span class="hm-choice__icon">...</span>
                    <h2>@L["Waiting for an answer"]</h2>
                    <p>
                        @L["You asked to join {0} on {1}. The manager or a co-manager must approve your request before you can join.", _myRequest.HomeName, _myRequest.RequestedAtUtc.ToLocalTime().ToString("d MMM yyyy")]
                    </p>
                    <button type="button" class="hm-btn" @onclick="CancelMyRequest">@L["Cancel request"]</button>
                </article>
            </div>
        }
        else if (_home is null)
        {
            <div class="hm-choices">
                <article class="hm-card hm-choice" style="--d: 60ms">
                    <span class="hm-choice__icon">+</span>
                    <h2>@L["Create a home"]</h2>
                    <p>@L["Set the name and location, then add your housemates. You will be the manager."]</p>
                    <button type="button" class="hm-btn hm-btn--solid" @onclick="OpenCreate">@L["Create a home"]</button>
                </article>

                <article class="hm-card hm-choice" style="--d: 140ms">
                    <span class="hm-choice__icon">#</span>
                    <h2>@L["Join a home"]</h2>
                    <p>@L["Have a join code? Enter it to ask the home manager to approve your request."]</p>
                    <button type="button" class="hm-btn" @onclick="OpenJoin">@L["Join a home"]</button>
                </article>
            </div>
        }
        else
        {
            <div class="hm-grid">
                <section class="hm-card hm-panel" style="--d: 60ms">
                    <div class="hm-panel__top">
                        <h2>@L["Home details"]</h2>
                        @if (HomeRules.CanEditDetails(_home.MyRole))
                        {
                            <button type="button" class="hm-mini" @onclick="OpenEditDetails">@L["Edit details"]</button>
                        }
                    </div>
                    <dl class="hm-details">
                        <div><dt>@L["Name"]</dt><dd>@_home.Name</dd></div>
                        <div><dt>@L["Join code"]</dt><dd class="hm-code">@_home.JoinCode</dd></div>
                        <div class="hm-details__wide"><dt>@L["Location"]</dt><dd>@_home.AddressLine, @_home.AreaName, @_home.Division</dd></div>
                        <div><dt>@L["Coordinates"]</dt><dd>@_home.Latitude.ToString("0.0000"), @_home.Longitude.ToString("0.0000")</dd></div>
                        <div><dt>@L["Maximum occupants"]</dt><dd>@_home.MaxOccupants</dd></div>
                        <div><dt>@L["Living here now"]</dt><dd>@_home.Members.Count</dd></div>
                        <div><dt>@L["Free seats"]</dt><dd>@_home.FreeSeats</dd></div>
                    </dl>
                    <a class="hm-maplink" target="_blank" rel="noopener"
                       href="@($"https://www.openstreetmap.org/?mlat={_home.Latitude}&mlon={_home.Longitude}#map=17/{_home.Latitude}/{_home.Longitude}")">
                        @L["Open on map"] &rarr;
                    </a>
                </section>

                <section class="hm-card hm-panel" style="--d: 130ms">
                    <h2>@L["Your role"]</h2>
                    <p class="hm-note">@L["You are {0} of this home.", L[RoleLabel(_home.MyRole)].Value]</p>
                    <div class="hm-panel__buttons">
                        <button type="button" class="hm-btn" @onclick="() => _showRoles = true">@L["What can I do?"]</button>
                        <button type="button" class="hm-btn hm-btn--danger" @onclick="OpenLeave"
                                disabled="@(!HomeRules.CanLeave(_home.MyRole))">
                            @L["Leave home"]
                        </button>
                    </div>
                    @if (!HomeRules.CanLeave(_home.MyRole))
                    {
                        <p class="hm-note">@L["Transfer the manager role to someone else first."]</p>
                    }
                </section>

                @if (HomeRules.CanReviewRequests(_home.MyRole))
                {
                    <section class="hm-card hm-panel hm-panel--wide" style="--d: 170ms">
                        <div class="hm-panel__top">
                            <h2>@L["Join requests ({0})", _home.PendingRequests.Count]</h2>
                        </div>

                        @if (_home.PendingRequests.Count == 0)
                        {
                            <p class="hm-note">@L["Nobody is waiting to join right now."]</p>
                        }
                        else
                        {
                            <ul class="hm-members">
                                @foreach (var request in _home.PendingRequests)
                                {
                                    <li class="hm-member">
                                        <span class="hm-avatar">
                                            <img src="@request.ProfilePictureUrl" alt="@request.Name" />
                                        </span>
                                        <div class="hm-member__id">
                                            <b>@request.Name</b>
                                            <small>@request.Email</small>
                                        </div>
                                        <span class="hm-tag">
                                            @L["Asked {0}", request.RequestedAtUtc.ToLocalTime().ToString("d MMM")]
                                        </span>
                                        <div class="hm-request__actions">
                                            <button type="button" class="hm-btn hm-btn--solid"
                                                    @onclick="() => ApproveRequest(request)">@L["Approve"]</button>
                                            <button type="button" class="hm-btn hm-btn--danger"
                                                    @onclick="() => RejectRequest(request)">@L["Reject"]</button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                <section class="hm-card hm-panel hm-panel--wide" style="--d: 200ms">
                    <div class="hm-panel__top">
                            <h2>@L["Members ({0})", _home.Members.Count]</h2>
                        @if (HomeRules.CanAddMembers(_home.MyRole))
                        {
                            <button type="button" class="hm-btn hm-btn--solid" @onclick="OpenAdd">@L["Add member"]</button>
                        }
                    </div>

                    <ul class="hm-members">
                        @foreach (var member in Ordered(_home.Members))
                        {
                            <li class="hm-member @(_openMenuId == member.Id ? "is-menu-open" : "")">
                                <span class="hm-avatar">
                                    <img src="@member.ProfilePictureUrl" alt="@member.Name" />
                                </span>
                                <div class="hm-member__id">
                                    <b>@member.Name @(member.IsMe ? $"({L["You"]})" : "")</b>
                                    <small>@member.Email</small>
                                </div>
                                <span class="hm-tag hm-role--@member.Role.ToString().ToLowerInvariant()">
                                    @L[RoleLabel(member.Role)]
                                </span>
                                <div class="hm-member__actions">
                                    @if (HasActions(member))
                                    {
                                        <button type="button" class="hm-kebab @(_openMenuId == member.Id ? "is-on" : "")"
                                                title='@L["Member actions"]' aria-label='@L["Member actions"]'
                                                aria-expanded="@((_openMenuId == member.Id).ToString().ToLowerInvariant())"
                                                @onclick="() => ToggleMenu(member)">
                                            &#8942;
                                        </button>

                                        @if (_openMenuId == member.Id)
                                        {
                                            <div class="hm-menu" role="menu">
                                                @if (HomeRules.CanPromote(_home.MyRole, member))
                                                {
                                                    <button type="button" role="menuitem" @onclick="() => Promote(member)">@L["Make co-manager"]</button>
                                                }
                                                @if (HomeRules.CanDemote(_home.MyRole, member))
                                                {
                                                    <button type="button" role="menuitem" @onclick="() => Demote(member)">@L["Make member"]</button>
                                                }
                                                @if (HomeRules.CanTransferManager(_home.MyRole, member))
                                                {
                                                    <button type="button" role="menuitem" @onclick="() => OpenTransfer(member)">@L["Transfer manager"]</button>
                                                }
                                                @if (HomeRules.CanRemove(_home.MyRole, member))
                                                {
                                                    <button type="button" role="menuitem" class="hm-menu__danger" @onclick="() => Remove(member)">@L["Remove from home"]</button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>

            </div>
        }
    </div>
</section>

@* Keep the fixed assistant outside the animated page/grid containers. Fixed
   overlays inside those containers can be positioned against the container
   instead of the viewport in some browser layouts. *@
@if (_home is not null)
{
    <NestifyAssistant Home="_home" />
}

@if (_openMenuId is not null)
{
    <div class="hm-scrim" @onclick="CloseMenu"></div>
}

@if (_showCreate)
{
    <div class="hm-overlay" @onclick="CancelCreate">
        <div class="hm-modal" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Create a home"]</h2>
                <button type="button" class="hm-modal__close" @onclick="CancelCreate" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body">
                <div class="hm-field hm-field--wide">
                    <label for="ch-name">@L["Home name"]</label>
                    <input id="ch-name" @bind="_create.Name" placeholder="Mirpur Boys Nest" />
                </div>
                <div class="hm-field hm-field--wide">
                    <label for="ch-address">@L["Address"]</label>
                    <input id="ch-address" @bind="_create.AddressLine" placeholder="House 24, Road 7" />
                </div>
                <div class="hm-field">
                    <label for="ch-area">@L["Area"]</label>
                    <input id="ch-area" @bind="_create.AreaName" placeholder="Mirpur" />
                </div>
                <div class="hm-field">
                    <label for="ch-division">@L["Division"]</label>
                    <input id="ch-division" @bind="_create.Division" />
                </div>
                <div class="hm-field">
                    <label for="ch-max">@L["Maximum occupants"]</label>
                    <input id="ch-max" type="number" min="1" @bind="_create.MaxOccupants" />
                    <p class="hm-note">@L["Set the maximum number of people who may live here. Available seats are calculated from the current members."]</p>
                </div>
                <div class="hm-field hm-field--wide">
                    <label>@L["Location on map"]</label>
                    <div id="create-map" class="hm-map"></div>
                    <p class="hm-note">@L["Click the map or drag the pin to set the coordinates."]</p>
                    <p class="hm-coords">@_create.Latitude.ToString("0.0000"), @_create.Longitude.ToString("0.0000")</p>
                </div>
                @if (_formError is not null)
                {
                    <p class="hm-msg hm-msg--bad hm-field--wide">@_formError</p>
                }
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="CancelCreate">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--solid" @onclick="CreateHome">@L["Create home"]</button>
            </footer>
        </div>
    </div>
}

@if (_showJoin)
{
    <div class="hm-overlay" @onclick="() => _showJoin = false">
        <div class="hm-modal hm-modal--sm" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Join a home"]</h2>
                <button type="button" class="hm-modal__close" @onclick="() => _showJoin = false" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body hm-modal__body--stack">
                <div class="hm-field">
                    <label for="jn-code">@L["Join code"]</label>
                    <input id="jn-code" @bind="_joinCode" placeholder="NST-4821" />
                </div>
                <p class="hm-note">@L["Enter the join code provided by a manager or co-manager of the home."]</p>
                @if (_formError is not null)
                {
                    <p class="hm-msg hm-msg--bad">@_formError</p>
                }
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="() => _showJoin = false">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--solid" @onclick="JoinHome">@L["Send join request"]</button>
            </footer>
        </div>
    </div>
}

@if (_showEditDetails)
{
    <div class="hm-overlay" @onclick="CancelEditDetails">
        <div class="hm-modal" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Edit home details"]</h2>
                <button type="button" class="hm-modal__close" @onclick="CancelEditDetails" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body">
                <div class="hm-field hm-field--wide">
                    <label for="eh-name">@L["Home name"]</label>
                    <input id="eh-name" @bind="_edit.Name" />
                </div>
                <div class="hm-field hm-field--wide">
                    <label for="eh-address">@L["Address"]</label>
                    <input id="eh-address" @bind="_edit.AddressLine" />
                </div>
                <div class="hm-field">
                    <label for="eh-area">@L["Area"]</label>
                    <input id="eh-area" @bind="_edit.AreaName" />
                </div>
                <div class="hm-field">
                    <label for="eh-division">@L["Division"]</label>
                    <input id="eh-division" @bind="_edit.Division" />
                </div>
                <div class="hm-field">
                    <label for="eh-max">@L["Maximum occupants"]</label>
                    <input id="eh-max" type="number" min="1" @bind="_edit.MaxOccupants" />
                    <p class="hm-note">@L["Set the maximum number of people who may live here. Available seats are calculated from the current members."]</p>
                </div>
                <div class="hm-field hm-field--wide">
                    <label>@L["Location on map"]</label>
                    <div id="edit-map" class="hm-map"></div>
                    <p class="hm-note">@L["Click the map or drag the pin to set the coordinates."]</p>
                    <p class="hm-coords">@_edit.Latitude.ToString("0.0000"), @_edit.Longitude.ToString("0.0000")</p>
                </div>
                @if (_formError is not null)
                {
                    <p class="hm-msg hm-msg--bad hm-field--wide">@_formError</p>
                }
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="CancelEditDetails">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--solid" @onclick="SaveDetails">@L["Save changes"]</button>
            </footer>
        </div>
    </div>
}

@if (_showAdd)
{
    <div class="hm-overlay" @onclick="() => _showAdd = false">
        <div class="hm-modal hm-modal--sm" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Add member"]</h2>
                <button type="button" class="hm-modal__close" @onclick="() => _showAdd = false" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body hm-modal__body--stack">
                <div class="hm-field">
                    <label for="am-name">@L["Name"]</label>
                    <input id="am-name" @bind="_newMemberName" />
                </div>
                <div class="hm-field">
                    <label for="am-email">@L["Email"]</label>
                    <input id="am-email" @bind="_newMemberEmail" />
                </div>
                @if (_formError is not null)
                {
                    <p class="hm-msg hm-msg--bad">@_formError</p>
                }
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="() => _showAdd = false">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--solid" @onclick="AddMember">@L["Add member"]</button>
            </footer>
        </div>
    </div>
}

@if (_transferTarget is not null)
{
    <div class="hm-overlay" @onclick="() => _transferTarget = null">
        <div class="hm-modal hm-modal--sm" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Transfer manager role"]</h2>
                <button type="button" class="hm-modal__close" @onclick="() => _transferTarget = null" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body hm-modal__body--stack">
                <p>@L["{0} will become the manager of this home. You will remain a co-manager and may leave afterward.", _transferTarget.Name]</p>
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="() => _transferTarget = null">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--solid" @onclick="ConfirmTransfer">@L["Transfer"]</button>
            </footer>
        </div>
    </div>
}

@if (_showRoles)
{
    <div class="hm-overlay" @onclick="() => _showRoles = false">
        <div class="hm-modal" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["What each role can do"]</h2>
                <button type="button" class="hm-modal__close" @onclick="() => _showRoles = false" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body hm-modal__body--stack">
                @foreach (var role in new[] { HomeRole.Manager, HomeRole.CoManager, HomeRole.Member })
                {
                    <div class="hm-rolecard @(_home?.MyRole == role ? "is-mine" : "")">
                        <div class="hm-rolecard__top">
                            <b>@L[RoleLabel(role)]</b>
                            @if (_home?.MyRole == role)
                            {
                                <span class="hm-tag hm-role--@role.ToString().ToLowerInvariant()">@L["You"]</span>
                            }
                        </div>
                        <ul>
                            @foreach (var line in RoleAbilities(role))
                            {
                                <li>@L[line]</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn hm-btn--solid" @onclick="() => _showRoles = false">@L["Got it"]</button>
            </footer>
        </div>
    </div>
}

@if (_showLeave)
{
    <div class="hm-overlay" @onclick="() => _showLeave = false">
        <div class="hm-modal hm-modal--sm" @onclick:stopPropagation="true">
            <header class="hm-modal__head">
                <h2>@L["Leave this home"]</h2>
                <button type="button" class="hm-modal__close" @onclick="() => _showLeave = false" aria-label='@L["Close"]'>&times;</button>
            </header>
            <div class="hm-modal__body hm-modal__body--stack">
                <p>@L["You will lose access to this home's members, meals, and expenses. You can request to join again with its code."]</p>
            </div>
            <footer class="hm-modal__foot">
                <button type="button" class="hm-btn" @onclick="() => _showLeave = false">@L["Cancel"]</button>
                <button type="button" class="hm-btn hm-btn--danger" @onclick="ConfirmLeave">@L["Leave home"]</button>
            </footer>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private HomeView? _home;
    private MyJoinRequestView? _myRequest;
    private string? _loadError;

    private string _myName = "You";
    private string _myEmail = "you@example.com";

    private bool _showCreate;
    private bool _showJoin;
    private bool _showAdd;
    private bool _showEditDetails;
    private bool _showRoles;
    private string? _openMenuId;
    private bool _showLeave;
    private HomeMemberView? _transferTarget;

    private HomeDetailsRequest _create = new();
    private HomeDetailsRequest _edit = new();
    private string _joinCode = string.Empty;
    private string _newMemberName = string.Empty;
    private string _newMemberEmail = string.Empty;

    private DotNetObjectReference<MyHome>? _selfRef;
    private string? _pendingMap;

    private string? _formError;
    private string? _message;
    private bool _messageOk;

    // The map lives in a modal, so it is created after the modal renders and torn
      // down when it closes. _pendingMap names the container waiting for a map.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingMap is null)
        {
            return;
        }

        var target = _pendingMap;
        _pendingMap = null;
        _selfRef ??= DotNetObjectReference.Create(this);

        var draft = target == "create-map" ? _create : _edit;
        await JS.InvokeVoidAsync("nestifyMapPicker.init", target, draft.Latitude, draft.Longitude, _selfRef);
    }

    [JSInvokable]
    public void OnMapPicked(double latitude, double longitude)
    {
        var draft = _showCreate ? _create : _edit;
        draft.Latitude = Math.Round(latitude, 6);
        draft.Longitude = Math.Round(longitude, 6);
        StateHasChanged();
    }

    private async Task CloseMap(string elementId)
    {
        await JS.InvokeVoidAsync("nestifyMapPicker.destroy", elementId);
    }

    private static string[] RoleAbilities(HomeRole role) => role switch
    {
        HomeRole.Manager => new[]
        {
            "Edit the home details",
            "Add members",
            "Promote a member to co-manager, or change a co-manager back to member",
            "Remove members from the home",
            "Transfer the manager role to someone else",
            "Transfer the manager role before leaving"
        },
        HomeRole.CoManager => new[]
        {
            "Edit the home details",
            "Add members",
            "Promote a member to co-manager",
            "Remove regular members",
            "Leave the home at any time"
        },
        _ => new[]
        {
            "View the home details and its members",
            "Leave the home at any time"
        }
    };

    public void Dispose() => _selfRef?.Dispose();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _myName = Claim(user, ClaimTypes.Name, "name") ?? _myName;
        _myEmail = Claim(user, ClaimTypes.Email, "email") ?? _myEmail;

        await ReloadAsync();
        _loading = false;
    }

    // The two go together: with no home the page still has to know whether a
    // request of the caller is waiting somewhere.
    private async Task ReloadAsync()
    {
        try
        {
            _home = await HomeService.GetMyHomeAsync();
            _myRequest = _home is null ? await HomeService.GetMyJoinRequestAsync() : null;
            _loadError = null;
        }
        catch (ApplicationException ex) when (ex.Message == "Your session has ended. Please sign in again.")
        {
            Navigation.NavigateTo("/auth", replace: true);
        }
        catch (Exception ex)
        {
            // Never fall through to the create/join screen on a failed load - the
            // user may well be in a house already.
            _home = null;
            _myRequest = null;
            _loadError = LocalizeMessage(ex.Message);
        }
    }

    private async Task Retry()
    {
        _loading = true;
        await ReloadAsync();
        _loading = false;
    }

