    private async Task SaveDetails()
    {
        if (string.IsNullOrWhiteSpace(_edit.Name) || string.IsNullOrWhiteSpace(_edit.AddressLine))
        {
            _formError = L["Home name and address are required."];
            return;
        }
        if (_edit.MaxOccupants < _home!.Members.Count)
        {
            _formError = L["Maximum occupants cannot be lower than the {0} people already living here.", _home.Members.Count];
            return;
        }

        var result = await HomeService.UpdateHomeDetailsAsync(_edit);
        if (!result.Ok)
        {
            _formError = LocalizeMessage(result.Message);
            return;
        }

        await ReloadAsync();
        _showEditDetails = false;
        await CloseMap("edit-map");
        Report(true, LocalizeMessage(result.Message));
    }

