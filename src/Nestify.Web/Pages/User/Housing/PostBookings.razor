@page "/housing/{Id}/bookings"
@attribute [Authorize(Roles = "User")]
@inject IHousingService Housing
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject NavigationManager Navigation

<PageTitle>Booking requests — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap hs-wrap--narrow">
        <nav class="hs-crumbs" aria-label="Breadcrumb">
            <a href="housing">Housing</a>
            <span class="hs-crumbs__sep">/</span>
            <a href="housing/mine">My listings</a>
            <span class="hs-crumbs__sep">/</span>
            <span>Booking requests</span>
        </nav>

        @if (_loading)
        {
            <div class="hs-skeleton hs-skeleton--detail"></div>
        }
        else
        {
            <header class="hs-page__header hs-booking-head">
                <h1>Booking requests</h1>
                <p class="hs-booking-head__lead">Manage requests for <strong>@(_post?.Title ?? "this listing")</strong> and keep applicants informed.</p>
                @if (_requesters.Count > 0)
                {
                    <div class="hs-booking-filters" role="group" aria-label="Filter booking requests">
                        <button type="button" class="hs-booking-filter @(_statusFilter is null ? "is-active" : null)" aria-pressed="@(_statusFilter is null)" @onclick="() => _statusFilter = null">
                            <span>All</span><b>@_requesters.Count</b>
                        </button>
                        <button type="button" class="hs-booking-filter @(_statusFilter == BookingStatus.Pending ? "is-active" : null)" aria-pressed="@(_statusFilter == BookingStatus.Pending)" @onclick="() => _statusFilter = BookingStatus.Pending">
                            <span>Pending</span><b>@_requesters.Count(r => r.Status == BookingStatus.Pending)</b>
                        </button>
                        <button type="button" class="hs-booking-filter @(_statusFilter == BookingStatus.Accepted ? "is-active" : null)" aria-pressed="@(_statusFilter == BookingStatus.Accepted)" @onclick="() => _statusFilter = BookingStatus.Accepted">
                            <span>Accepted</span><b>@_requesters.Count(r => r.Status == BookingStatus.Accepted)</b>
                        </button>
                        <button type="button" class="hs-booking-filter @(_statusFilter == BookingStatus.Rejected ? "is-active" : null)" aria-pressed="@(_statusFilter == BookingStatus.Rejected)" @onclick="() => _statusFilter = BookingStatus.Rejected">
                            <span>Rejected</span><b>@_requesters.Count(r => r.Status == BookingStatus.Rejected)</b>
                        </button>
                    </div>
                }
            </header>

            @if (_requesters.Count == 0)
            {
                <div class="hs-empty hs-empty--section">
                    <h2>No booking requests yet</h2>
                    <p>When someone requests to book your listing, their request will appear here.</p>
                    <a class="nx-btn nx-btn--primary" href="housing/mine">Back to My listings</a>
                </div>
            }
            else
            {
                @if (!VisibleRequesters.Any())
                {
                    <div class="hs-empty hs-empty--section"><p>No requests match this filter.</p></div>
                }
                else
                {
                <div class="hs-requesters-list">
                    @foreach (var requester in VisibleRequesters)
                    {
                        <article class="hs-requester-card hs-requester-card--@HousingView.StatusModifier(requester.Status)">
                            <header class="hs-requester-card__header">
                                <div class="hs-requester-card__title-section">
                                    <h3>@requester.RequesterName</h3>
                                    <span class="hs-badge hs-badge--@HousingView.StatusModifier(requester.Status)">
                                        @HousingView.Label(requester.Status)
                                    </span>
                                </div>
                                <div class="hs-requester-card__meta">
                                    <time>@HousingView.RelativeTime(requester.RequestedAtUtc)</time>
                                </div>
                            </header>

                            @if (!string.IsNullOrEmpty(requester.Message))
                            {
                                <div class="hs-requester-card__message">
                                    <span class="hs-requester-card__message-label">Applicant message</span>
                                    <p>@requester.Message</p>
                                </div>
                            }

                            @if (requester.Status == BookingStatus.Accepted)
                            {
                                <ContactDisclosureCard Contact="_contacts.GetValueOrDefault(requester.BookingId)" />
                                <div class="hs-requester-card__actions">
                                    <button class="nx-btn nx-btn--ghost hs-danger-btn" @onclick="() => OpenReleaseModal(requester.BookingId)" disabled="@_processingId == requester.BookingId">
                                        Release reservation
                                    </button>
                                </div>
                            }

                            @if (requester.Status == BookingStatus.Pending)
                            {
                                <div class="hs-requester-card__actions">
                                    <button class="nx-btn nx-btn--success" @onclick="() => AcceptRequest(requester.BookingId)" disabled="@_processingId == requester.BookingId">
                                        @(_processingId == requester.BookingId ? "Accepting..." : "Accept")
                                    </button>
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => OpenRejectModal(requester.BookingId)" disabled="@_processingId == requester.BookingId">
                                        Reject
                                    </button>
                                </div>
                            }
                        </article>
                    }
                </div>
                }
            }
        }
    </div>
</section>

@if (_showRejectModal)
{
    <div class="hs-modal-overlay" @onclick="CloseRejectModal">
        <div class="hs-modal hs-modal--booking" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="reject-booking-title">
            <header class="hs-modal__header">
                <h2 id="reject-booking-title">@(_releaseReservation ? "Release reservation" : "Reject booking request")</h2>
                <button type="button" class="hs-modal__close" @onclick="CloseRejectModal" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" 
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </header>

            <div class="hs-modal__body">
                <p class="hs-booking-modal__intro">@(_releaseReservation
                    ? "This releases the seat for another applicant. A short, respectful note gives the applicant useful closure."
                    : "A short, respectful note gives the applicant useful closure. This message is optional.")</p>
                <div class="field">
                    <label for="reject-message" class="field__label">Message (optional)</label>
                    <textarea id="reject-message" class="field__textarea" 
                              @bind="_rejectMessage" @bind:event="oninput"
                              placeholder="Thank you for your interest, but..."
                              rows="4" maxlength="500" aria-describedby="reject-message-help"
                              disabled="@_processingId == _rejectingBookingId"></textarea>
                    <p id="reject-message-help" class="field__helper">@_rejectMessage.Length / 500 characters</p>
                </div>
            </div>

            <footer class="hs-modal__footer">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseRejectModal" disabled="@(_processingId == _rejectingBookingId)">
                    Cancel
                </button>
                <button type="button" class="nx-btn nx-btn--danger" @onclick="SubmitReject" disabled="@(_processingId == _rejectingBookingId)">
                    @(_processingId == _rejectingBookingId ? (_releaseReservation ? "Releasing..." : "Rejecting...") : (_releaseReservation ? "Release reservation" : "Reject"))
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private HousingPostDetailDto? _post;
    private List<BookingRequesterDto> _requesters = new();
    private Dictionary<string, ContactDisclosureDto?> _contacts = new();
    private bool _loading = true;
    
    // Reject modal state
    private bool _showRejectModal = false;
    private string _rejectingBookingId = string.Empty;
    private string _rejectMessage = string.Empty;
    private bool _releaseReservation;
    
    // Processing state
    private string? _processingId = null;
    private BookingStatus? _statusFilter;
    private IEnumerable<BookingRequesterDto> VisibleRequesters => _statusFilter is null
        ? _requesters
        : _requesters.Where(r => r.Status == _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _post = await Housing.GetPostAsync(Id);

            // Load requesters for this post
            _requesters = (await Housing.GetRequestersAsync(Id)).ToList();
            
            // Pre-load contact info for accepted bookings
            foreach (var requester in _requesters.Where(r => r.Status == BookingStatus.Accepted))
            {
                var contact = await Housing.GetBookingContactAsync(requester.BookingId);
                _contacts[requester.BookingId] = contact;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load booking requests: {ex.Message}", "Error");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenRejectModal(string bookingId)
    {
        _rejectingBookingId = bookingId;
        _rejectMessage = string.Empty;
        _releaseReservation = false;
        _showRejectModal = true;
    }

    private void OpenReleaseModal(string bookingId)
    {
        _rejectingBookingId = bookingId;
        _rejectMessage = string.Empty;
        _releaseReservation = true;
        _showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        _showRejectModal = false;
        _rejectingBookingId = string.Empty;
        _rejectMessage = string.Empty;
        _releaseReservation = false;
    }

    private async Task AcceptRequest(string bookingId)
    {
        _processingId = bookingId;
        try
        {
            var result = await Housing.AcceptBookingAsync(bookingId);
            
            if (result.Ok)
            {
                Toast.ShowSuccess(result.Message, "Request accepted");
                
                // Update the requester status
                var requester = _requesters.FirstOrDefault(r => r.BookingId == bookingId);
                if (requester is not null)
                {
                    requester.Status = BookingStatus.Accepted;
                    // Load contact info for the accepted booking
                    var contact = await Housing.GetBookingContactAsync(bookingId);
                    _contacts[bookingId] = contact;
                }
            }
            else
            {
                Toast.ShowError(result.Message, "Request not accepted");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error accepting booking: {ex.Message}", "Error");
        }
        finally
        {
            _processingId = null;
        }
    }

    private async Task SubmitReject()
    {
        _processingId = _rejectingBookingId;
        try
        {
            var request = new RejectBookingRequestDto { Message = _rejectMessage };
            var result = _releaseReservation
                ? await Housing.ReleaseBookingAsync(_rejectingBookingId, request)
                : await Housing.RejectBookingAsync(_rejectingBookingId, request);
            
            if (result.Ok)
            {
                Toast.ShowSuccess(result.Message, _releaseReservation ? "Reservation released" : "Request rejected");
                
                // Update the requester status
                var requester = _requesters.FirstOrDefault(r => r.BookingId == _rejectingBookingId);
                if (requester is not null)
                {
                    requester.Status = BookingStatus.Rejected;
                }
                
                _showRejectModal = false;
                _rejectingBookingId = string.Empty;
                _rejectMessage = string.Empty;
                _releaseReservation = false;
            }
            else
            {
                Toast.ShowError(result.Message, _releaseReservation ? "Reservation not released" : "Request not rejected");
            }
        }
        catch
        {
            Toast.ShowError(_releaseReservation ? "Could not release the reservation." : "Could not reject the booking.", "Error");
        }
        finally
        {
            _processingId = null;
        }
    }
}
