@page "/housing/{Id}"
@attribute [Authorize(Roles = "User")]
@inject IHousingService Housing
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>@(_post?.Title ?? "Housing") — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap hs-wrap--detail">
        <nav class="hs-crumbs" aria-label="Breadcrumb">
            <a href="housing">Housing</a>
            <span class="hs-crumbs__sep">/</span>
            <span>@(_post?.Title ?? "Listing")</span>
        </nav>

        @if (_loading)
        {
            <div class="hs-skeleton hs-skeleton--detail"></div>
        }
        else if (_post is null)
        {
            @* Not-found covers both a bad id and an id the viewer isn't eligible for (§5.3).
               Never render "you don't match this post" — this is the only state either way. *@
            <div class="hs-empty hs-empty--page">
                <h2>This post is not available</h2>
                <p>It may have been closed, removed, or the link may be out of date.</p>
                <a class="nx-btn nx-btn--primary" href="housing">Back to Housing</a>
            </div>
        }
        else
        {
            <article class="hs-detail">
              <div class="hs-detail__main">
                <header class="hs-detail__head">
                    <div class="hs-detail__badges">
                        <span class="hs-chip hs-chip--type">@HousingView.Label(_post.ListingType)</span>
                        <span class="hs-badge hs-badge--@HousingView.StatusModifier(_post.Status)">
                            @HousingView.Label(_post.Status)
                        </span>
                    </div>
                    <h1>@_post.Title</h1>
                    <div class="hs-detail__meta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        <span>@_post.AreaName, @_post.Division</span>
                        <span class="hs-dot"></span>
                        <span>Posted @HousingView.RelativeTime(_post.CreatedAtUtc)</span>
                    </div>
                </header>

                @if (_post.ImageUrls.Count > 0)
                {
                    <div class="hs-gallery">
                        @for (var i = 0; i < _post.ImageUrls.Count; i++)
                        {
                            var idx = i;
                            <button type="button" class="hs-gallery__thumb" @onclick="() => OpenLightbox(idx)"
                                    aria-label="View photo @(idx + 1)">
                                <img src="@_post.ImageUrls[idx]" alt="House photo @(idx + 1)" />
                            </button>
                        }
                    </div>
                }

                <div class="hs-detail__stats">
                    <div class="hs-stat">
                        <span class="hs-stat__value">@Money.Format(_post.MonthlyRent)</span>
                        <span class="hs-stat__label">per month</span>
                    </div>
                    <div class="hs-stat">
                        <span class="hs-stat__value">@_post.SeatsAvailable</span>
                        <span class="hs-stat__label">@(_post.SeatsAvailable == 1 ? "seat available" : "seats available")</span>
                    </div>
                </div>

                <section class="hs-detail__section">
                    <h2>About this listing</h2>
                    @* Plain text only — never MarkupString (§11.5.2). *@
                    <p class="hs-detail__description">@_post.Description</p>
                </section>

                @if (!_post.Eligibility.IsEmpty)
                {
                    <section class="hs-detail__section">
                        <h2>Who can apply</h2>
                        <div class="hs-chips">
                            @foreach (var chip in HousingView.EligibilityChips(_post.Eligibility))
                            {
                                <span class="hs-chip">@chip</span>
                            }
                        </div>
                    </section>
                }

              </div>

              @* Price and the booking action ride along beside the story on a
                 wide screen, and drop under it on a phone. *@
              <aside class="hs-detail__rail">
                <div class="hs-actionbox">
                    <div class="hs-actionbox__price">
                        <span class="hs-price hs-price--lg">@Money.Format(_post.MonthlyRent)</span>
                        <span class="hs-price__unit">per month</span>
                    </div>
                    <p class="hs-actionbox__seats">
                        @_post.SeatsAvailable @(_post.SeatsAvailable == 1 ? "seat available" : "seats available")
                    </p>

                    <div class="hs-detail__actions">
                        <button class="nx-btn nx-btn--primary" disabled="@(!CanBook || _bookingSubmitting)" @onclick="OpenBookingModal">
                            @BookLabel
                        </button>
                        @if (BookingUnavailableMessage is not null)
                        {
                            <p class="field__helper">@BookingUnavailableMessage</p>
                        }
                        @if (_requestSent)
                        {
                            <a class="nx-btn nx-btn--ghost" href="bookings/mine">View my requests</a>
                        }
                        @if (_post.IsMine)
                        {
                            <a class="nx-btn nx-btn--ghost" href="housing/@_post.Id/edit">Edit listing</a>
                        }
                        @if (!_post.IsMine)
                        {
                            <button class="nx-btn nx-btn--ghost" @onclick="() => _showReport = !_showReport">
                                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 9v4M12 17h.01M10.3 3.9 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                                </svg>
                                Report
                            </button>
                        }
                    </div>

                    @if (_showReport)
                    {
                        <div class="hs-actionbox__report">
                            <label class="field__label" for="hs-report-reason">Reason</label>
                            <select id="hs-report-reason" class="field__input" @bind="_reportReason">
                                @foreach (var reason in ReportReasons)
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                            <textarea class="field__input" rows="2" maxlength="300" placeholder="Add any detail (optional)"
                                      @bind="_reportDetail"></textarea>
                            <div class="hs-detail__actions">
                                <button class="nx-btn nx-btn--primary" disabled="@_reportSubmitting" @onclick="SubmitReport">Submit report</button>
                                <button class="nx-btn nx-btn--ghost" @onclick="() => _showReport = false">Cancel</button>
                            </div>
                        </div>
                    }

                    <p class="hs-actionbox__safe">
                        Contact details are shared only after the manager accepts your request.
                    </p>
                </div>
              </aside>
            </article>
        }
    </div>
</section>

@if (_showBookingModal)
{
    <div class="hs-modal-overlay" @onclick="CloseBookingModal">
        <div class="hs-modal" @onclick:stopPropagation="true">
            <header class="hs-modal__header">
                <h2>Send booking request</h2>
                <button type="button" class="hs-modal__close" @onclick="CloseBookingModal" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </header>
            <div class="hs-modal__body">
                <p>Tell the manager a bit about yourself. They can see your note before deciding.</p>
                <div class="field">
                    <label for="booking-message" class="field__label">Your message (optional)</label>
                    <textarea id="booking-message" class="field__textarea" @bind="_bookingMessage" @bind:event="oninput"
                              placeholder="Tell the manager about yourself..." rows="4"
                              maxlength="500" aria-describedby="booking-message-help"
                              disabled="@_bookingSubmitting"></textarea>
                    <p id="booking-message-help" class="field__helper">@_bookingMessage.Length / 500 characters</p>
                    @if (!string.IsNullOrWhiteSpace(_bookingError))
                    {
                        <p class="field__helper" role="alert">@_bookingError</p>
                    }
                </div>
            </div>
            <footer class="hs-modal__footer">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseBookingModal" disabled="@_bookingSubmitting">Cancel</button>
                <button type="button" class="nx-btn nx-btn--primary" @onclick="SubmitBookingRequest" disabled="@_bookingSubmitting">
                    @(_bookingSubmitting ? "Sending..." : "Send request")
                </button>
            </footer>
        </div>
    </div>
}

@if (_showLightbox && _post is not null)
{
    <PhotoLightbox Images="_post.ImageUrls" StartIndex="_lightboxIndex"
                   Caption="@_post.Title" OnClose="CloseLightbox" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private HousingPostDetailDto? _post;
    private bool _loading = true;
    private bool _showBookingModal = false;
    private string _bookingMessage = string.Empty;
    private bool _bookingSubmitting = false;
    private string? _bookingError;
    private bool _requestSent;
    private string? _loadedPostId;

    // Lightbox
    private bool _showLightbox;
    private int _lightboxIndex;

    private bool CanBook => _post is
    {
        Status: PostStatus.Active,
        IsMine: false,
        ViewerHasHome: false,
        SeatsAvailable: > 0
    } && !_requestSent;

    private string BookLabel => _requestSent ? "Request sent" : _post?.Status switch
    {
        PostStatus.Closed => "Listing closed",
        PostStatus.Filled => "House is full",
        _ when _post?.IsMine == true => "Your listing",
        _ when _post?.ViewerHasHome == true => "Already in a home",
        _ when _post?.SeatsAvailable <= 0 => "No seats available",
        _ => "Book this listing"
    };

    private string? BookingUnavailableMessage => _post switch
    {
        { IsMine: true } => "This is one of your listings.",
        { ViewerHasHome: true } => "You already live in a home, so you can't book a seat here.",
        { Status: PostStatus.Active, SeatsAvailable: <= 0 } => "All available seats have been taken.",
        { Status: PostStatus.Closed } => "This listing is closed to new requests.",
        { Status: PostStatus.Filled } => "This home is full right now.",
        _ => null
    };

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // A component instance can be reused when the route id changes. Keep a
        // successful request state for this post, but never carry it to another one.
        if (!string.Equals(_loadedPostId, Id, StringComparison.Ordinal))
        {
            _loadedPostId = Id;
            _requestSent = false;
            _showBookingModal = false;
            _bookingError = null;
        }

        _loading = true;
        try
        {
            _post = await Housing.GetPostAsync(Id);
        }
        catch
        {
            _post = null;
            Toast.ShowError("Could not load this listing. Please try again.", "Housing unavailable");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenLightbox(int index)
    {
        _lightboxIndex = index;
        _showLightbox = true;
    }

    private void CloseLightbox() => _showLightbox = false;

    private void OpenBookingModal()
    {
        _bookingMessage = string.Empty;
        _bookingError = null;
        _showBookingModal = true;
    }

    private void CloseBookingModal()
    {
        _showBookingModal = false;
        _bookingMessage = string.Empty;
        _bookingError = null;
    }

    private async Task SubmitBookingRequest()
    {
        if (_post is null)
            return;

        _bookingSubmitting = true;
        try
        {
            var result = await Housing.RequestBookingAsync(_post.Id, _bookingMessage);
            if (result.Ok)
            {
                _requestSent = true;
                Toast.ShowSuccess(result.Message, "Request sent");
                CloseBookingModal();
                await LoadAsync();
            }
            else
            {
                _bookingError = result.Message;
                Toast.ShowWarning(result.Message, "Request not sent");
            }
        }
        catch
        {
            _bookingError = "Could not send your request right now. Please try again.";
            Toast.ShowError(_bookingError, "Request not sent");
        }
        finally
        {
            _bookingSubmitting = false;
        }
    }

    // Same names as housing_report_reasons in Admin.sql.
    private static readonly string[] ReportReasons =
    {
        "Fake listing",
        "Misleading photos or rent",
        "Duplicate post",
        "Abusive or improper content",
        "Scam or advance payment demand",
        "Wrong rent",
        "Other"
    };

    private bool _showReport;
    private bool _reportSubmitting;
    private string _reportReason = ReportReasons[0];
    private string _reportDetail = string.Empty;

    private async Task SubmitReport()
    {
        if (_post is null) return;

        _reportSubmitting = true;
        var (ok, message) = await Housing.ReportPostAsync(_post.Id, _reportReason, _reportDetail);
        _reportSubmitting = false;

        if (ok)
        {
            _showReport = false;
            _reportDetail = string.Empty;
            Toast.ShowInfo("Thanks — our team will review this post.", "Report submitted");
        }
        else
        {
            Toast.ShowWarning(message, "Report not sent");
        }
    }
}
