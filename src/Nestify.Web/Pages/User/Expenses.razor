@page "/expenses"
@attribute [Authorize(Roles = "User")]
@using System.ComponentModel.DataAnnotations
@inject ToastService ToastService
@inject MoneyFormatterService MoneyFormatterService
@inject SettlementWorkspaceService SettlementWorkspace

<PageTitle>Expenses — Nestify</PageTitle>

<section class="nx-section expenses-page">
    <div class="nx-container expenses-page__wrap">
        <header class="expenses-page__header">
            <div>
                <p class="nx-eyebrow">Shared expenses</p>
                <h1>September 2026 expenses</h1>
            </div>
            <div class="expenses-page__actions">
                <button type="button" class="nx-btn nx-btn--ghost">Export CSV</button>
                @if (!SettlementWorkspace.IsFinalized)
                {
                    <a class="nx-btn nx-btn--primary" href="#expense-form">Add expense</a>
                }
            </div>
        </header>

        <div class="expenses-page__banner @(SettlementWorkspace.IsFinalized ? "expenses-page__banner--locked" : "")">
            @if (SettlementWorkspace.IsFinalized)
            {
                <strong>Finalized period</strong>
                <span>This month is locked. Every write control is hidden behind the finalization guard.</span>
            }
            else
            {
                <strong>Editing enabled</strong>
                <span>Use a correct entry to preserve the ledger instead of mutating the original expense.</span>
            }
        </div>

        <div class="expenses-page__grid">
            <section class="nx-card expenses-page__panel">
                <div class="expenses-page__panel-head">
                    <h2>Expense ledger</h2>
                    <span class="nx-tag">@SettlementWorkspace.Expenses.Count entries</span>
                </div>

                <div class="expenses-page__table-wrap">
                    <table class="expenses-page__table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Paid by</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in SettlementWorkspace.Expenses)
                            {
                                <tr>
                                    <td><DateDisplay DateTime="item.DateUtc" Format="date" /></td>
                                    <td>@item.Description</td>
                                    <td>@item.PaidBy</td>
                                    <td><span class="expenses-page__chip">@item.Category</span></td>
                                    <td><MoneyDisplay Amount="item.Amount" /></td>
                                    <td>
                                        @if (!SettlementWorkspace.IsFinalized)
                                        {
                                            <button type="button" class="nx-btn nx-btn--ghost expenses-page__correct-btn" @onclick="() => HandleCorrect(item)">
                                                Correct
                                            </button>
                                        }
                                        else
                                        {
                                            <span>Locked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @if (!SettlementWorkspace.IsFinalized)
            {
            <aside class="nx-card expenses-page__panel expenses-page__panel--form" id="expense-form">
                <div class="expenses-page__panel-head">
                    <h2>Add expense</h2>
                    <span class="nx-tag">Append-only</span>
                </div>

                <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="expenses-page__form">
                    <DataAnnotationsValidator />

                    <TextInput @bind-Value="_model.Description"
                               Label="Description"
                               Placeholder="Gas cylinder refill"
                               For="@(() => _model.Description)" />

                    <div class="field-row">
                        <MoneyInput @bind-Value="_model.Amount"
                                    Label="Amount"
                                    For="@(() => _model.Amount)" />

                        <DateInput @bind-Value="_model.Date"
                                   Label="Date"
                                   For="@(() => _model.Date)" />
                    </div>

                    <div class="field">
                        <label for="expense-category">Category</label>
                        <select id="expense-category" @bind="_model.Category" class="field__input">
                            <option value="Equal split">Equal split</option>
                            <option value="Meal based">Meal based</option>
                            <option value="Utilities">Utilities</option>
                            <option value="Household">Household</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="expense-paid-by">Paid by</label>
                        <select id="expense-paid-by" @bind="_model.PaidBy" class="field__input">
                            @foreach (var member in SettlementWorkspace.MemberNames)
                            {
                                <option value="@member">@member</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="nx-btn nx-btn--primary nx-btn--block">
                        Save expense
                    </button>
                </EditForm>
            </aside>
            }
        </div>
    </div>
</section>

@code {
    private class ExpenseFormModel
    {
        [Required(ErrorMessage = "Description is required.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Amount is required.")]
        [Range(0.01, 1000000, ErrorMessage = "Amount must be greater than ৳0.00.")]
        public decimal Amount { get; set; }

        [Required(ErrorMessage = "Date is required.")]
        public DateTime Date { get; set; } = SettlementWorkspaceService.GetDefaultFormDate();

        public string Category { get; set; } = "Equal split";
        public string PaidBy { get; set; } = "Rafi";
    }

    private readonly ExpenseFormModel _model = new();

    private void HandleSubmit()
    {
        SettlementWorkspace.AddExpense(
            _model.Description,
            _model.Amount,
            _model.PaidBy,
            _model.Category,
            _model.Date);

        ToastService.ShowSuccess($"Saved {MoneyFormatterService.Format(_model.Amount)} for {_model.Description}.", "Expense added");
        _model.Description = string.Empty;
        _model.Amount = 0m;
        _model.Date = SettlementWorkspaceService.GetDefaultFormDate();
        _model.PaidBy = "Rafi";
        _model.Category = "Equal split";
    }

    private void HandleCorrect(SettlementWorkspaceService.ExpenseEntry item)
    {
        ToastService.ShowInfo($"Correcting {item.Description}. This creates a new append-only ledger entry instead of mutating the original record.", "Correcting expense");
    }
}
