@page "/settlement"
@attribute [Authorize(Roles = "User")]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject ToastService ToastService
@inject MoneyFormatterService MoneyFormatterService
@inject ISettlementService SettlementApi

<PageTitle>Settlement — Nestify</PageTitle>

<section class="nx-section stl">
    <div class="nx-container stl__wrap">

        <header class="stl__header" style="--delay: 0ms">
            <div class="stl__headline">
                <p class="nx-eyebrow">Shared house account</p>
                <h1>Settlement</h1>
                <p class="nx-lead">
                    Track meals, split the monthly bills, log what everyone has paid, and see exactly
                    who owes the house and who the house owes.
                </p>
            </div>

            @if (!_loading && _ws is not null)
            {
            <div class="stl__header-side">
                <div class="stl__period">
                    <button type="button"
                            class="stl__period-nav"
                            disabled="@(!HasPreviousMonth || _busy)"
                            title="Previous month"
                            aria-label="Previous month"
                            @onclick="GoToPreviousMonth">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                    </button>

                    <span class="stl__period-label" aria-live="polite">
                        @if (IsOpen)
                        {
                            <span class="stl__period-dot" title="Open book"></span>
                        }
                        @PeriodLabel
                    </span>

                    <button type="button"
                            class="stl__period-nav"
                            disabled="@(!HasNextMonth || _busy)"
                            title="Next month"
                            aria-label="Next month"
                            @onclick="GoToNextMonth">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </button>
                </div>
                @if (_ws is not null && _ws.CanManage && IsOpen)
                {
                    <button type="button"
                            class="nx-btn nx-btn--ghost"
                            disabled="@_busy"
                            aria-expanded="@_showAddMember"
                            @onclick="() => _showAddMember = !_showAddMember">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0" /><path d="M19 8v6" /><path d="M16 11h6" /></svg>
                        Add member
                    </button>
                    <button type="button"
                            class="nx-btn nx-btn--primary"
                            disabled="@_busy"
                            @onclick="FinalizePeriod">
                        Finalize month
                    </button>
                }
                else if (IsFinalized)
                {
                    <button type="button" class="nx-btn nx-btn--ghost" disabled>Month locked</button>
                }
            </div>
            }
        </header>

        @if (_loading)
        {
            <p class="stl__empty">Loading the book…</p>
        }
        else if (_loadError is not null)
        {
            <div class="stl__nobook" style="--delay: 40ms">
                <svg class="nx-icon stl__nobook-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6" />
                    <path d="M12 17h.01" />
                </svg>
                <h2>Could not load settlement</h2>
                <p>@_loadError</p>
                <button type="button" class="nx-btn nx-btn--primary" @onclick="RetryLoad">Try again</button>
            </div>
        }
        else if (_ws is null)
        {
            <div class="stl__nobook" style="--delay: 40ms">
                <svg class="nx-icon stl__nobook-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                    <path d="M9 21v-7h6v7" />
                </svg>
                <h2>You are not in a home yet</h2>
                <p>
                    The settlement book belongs to the home you live in. Join a home with an invite code,
                    or create one and invite your flatmates, and the book will show up here.
                </p>
                <a class="nx-btn nx-btn--primary" href="home">Go to my home</a>
            </div>
        }
        else if (!HasBook)
        {
            <div class="stl__nobook" style="--delay: 40ms">
                <h2>No book for @PeriodLabel</h2>
                @if (_ws.CanManage)
                {
                    <p>
                        Opening the book takes a snapshot of everyone living in the home right now
                        (@_ws.AddableMembers.Count members). Meals, bills and payments all start at zero.
                    </p>
                    <button type="button" class="nx-btn nx-btn--primary" disabled="@_busy" @onclick="OpenBook">
                        Open book for @PeriodLabel
                    </button>
                }
                else
                {
                    <p>The manager has not opened this month's book yet.</p>
                }
            </div>
        }
        else
        {
            @if (IsFinalized)
            {
                <div class="stl__locked" role="status" style="--delay: 40ms">
                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4" y="10" width="16" height="11" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <div>
                        <strong>@PeriodLabel is finalized</strong>
                        <span>Meals, bills, and payments are read-only now. The statement below is the final word.</span>
                    </div>
                </div>
            }

            @if (_showAddMember && CanManageOpen)
            {
                <section class="stl__card stl__add-member" style="--delay: 40ms">
                    <div class="stl__card-head">
                        <div>
                            <h2>Add a member to this book</h2>
                            <p>
                                People who joined the home after the book was opened are not in it yet.
                                Add them here so they get a meal column and a share of the bills.
                            </p>
                        </div>
                        <button type="button" class="stl__bill-remove" title="Close" @onclick="() => _showAddMember = false">×</button>
                    </div>

                    @if (_ws.AddableMembers.Count == 0)
                    {
                        <p class="stl__empty">Everyone living in the home is already in this month's book.</p>
                    }
                    else
                    {
                        <ul class="stl__add-list">
                            @foreach (var (member, index) in _ws.AddableMembers.Select((m, i) => (m, i)))
                            {
                                <li class="stl__add-row" @key="member.UserId">
                                    <span class="stl__avatar stl__avatar--@(index % 4)">@member.Name[0]</span>
                                    <span class="stl__member-name">@member.Name</span>
                                    <button type="button"
                                            class="nx-btn nx-btn--primary"
                                            disabled="@_busy"
                                            @onclick="() => AddMember(member.UserId)">
                                        Add to book
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <div class="stl__metrics">
                <article class="stl__metric stl__metric--bills" style="--delay: 60ms">
                    <span class="stl__metric-label">Monthly bills</span>
                    <strong class="stl__metric-value"><MoneyDisplay Amount="_ws.BillsTotal" /></strong>
                    <span class="stl__metric-foot">@_ws.BillShare.ToString("N2") each · @_ws.Bills.Count bills</span>
                </article>

                <article class="stl__metric stl__metric--meals" style="--delay: 120ms">
                    <span class="stl__metric-label">Meal fund</span>
                    <strong class="stl__metric-value"><MoneyDisplay Amount="_ws.MealFundTotal" /></strong>
                    <span class="stl__metric-foot">@_ws.TotalMeals.ToString("0.#") meals eaten</span>
                </article>

                <article class="stl__metric stl__metric--rate" style="--delay: 180ms">
                    <span class="stl__metric-label">Cost per meal</span>
                    <strong class="stl__metric-value">৳@_ws.PerMealRate.ToString("0.00")</strong>
                    <span class="stl__metric-foot">meal fund ÷ total meals</span>
                </article>

                <article class="stl__metric @(_ws.OutstandingBills > 0 ? "stl__metric--due" : "stl__metric--clear")" style="--delay: 240ms">
                    <span class="stl__metric-label">Still to collect</span>
                    <strong class="stl__metric-value"><MoneyDisplay Amount="Math.Max(0m, _ws.OutstandingBills)" /></strong>
                    <span class="stl__metric-foot">
                        @(_ws.OutstandingBills > 0 ? "bill money not yet paid in" : "all bill money is in")
                    </span>
                </article>
            </div>

            <nav class="stl__tabs" style="--tab-index: @((int)_tab)" role="tablist" aria-label="Settlement sections">
                <span class="stl__tab-pill" aria-hidden="true"></span>
                @foreach (var tab in Tabs)
                {
                    <button type="button"
                            role="tab"
                            class="stl__tab @(_tab == tab.Key ? "is-active" : null)"
                            aria-selected="@(_tab == tab.Key)"
                            @onclick="() => _tab = tab.Key">
                        @((MarkupString)tab.Icon)
                        <span>@tab.Label</span>
                    </button>
                }
            </nav>

            <div class="stl__panel" @key="(_tab, _year, _month)">
                @switch (_tab)
                {
                    case Tab.Meals:
                        @RenderMealSheet
                        break;
                    case Tab.Bills:
                        @RenderBills
                        break;
                    case Tab.Payments:
                        @RenderPayments
                        break;
                    default:
                        @RenderStatement
                        break;
                }
            </div>
        }
    </div>
</section>

@* ===================== member strip ===================== *@

@code {
    private RenderFragment RenderMemberStrip => @<div class="stl__stack">
        <div class="stl__member-strip">
            @foreach (var (member, index) in Members.Select((m, i) => (m, i)))
            {
                <article class="stl__member-chip" style="--delay: @(index * 60)ms">
                    <span class="stl__avatar stl__avatar--@(index % 4)">@member.Name[0]</span>
                    <div>
                        <span class="stl__member-name">
                            @member.Name
                            @if (!member.IsActive)
                            {
                                <span class="stl__left-tag">left</span>
                            }
                        </span>
                        <strong>@_sheet.MemberTotal(member.UserId).ToString("0.#") meals</strong>
                    </div>
                </article>
            }
        </div>
    </div>;
}

@* ===================== meal sheet ===================== *@

@code {
    private RenderFragment RenderMealSheet => @<div class="stl__stack">
        @RenderMemberStrip

        <section class="stl__card" style="--delay: 240ms">
            <div class="stl__card-head">
                <div>
                    <h2>Meal sheet</h2>
                    @if (!_ws!.CanManage && IsOpen)
                    {
                        <p>You can fill in your own column. The manager fills in everyone else's.</p>
                    }
                </div>
                <div class="stl__card-actions">
                    <div class="stl__view-toggle" role="radiogroup" aria-label="Which columns to show">
                        <button type="button"
                                role="radio"
                                aria-checked="@_onlyMyColumn"
                                class="stl__view-btn @(_onlyMyColumn ? "is-active" : null)"
                                @onclick="() => _onlyMyColumn = true">
                            Only me
                        </button>
                        <button type="button"
                                role="radio"
                                aria-checked="@(!_onlyMyColumn)"
                                class="stl__view-btn @(!_onlyMyColumn ? "is-active" : null)"
                                @onclick="() => _onlyMyColumn = false">
                            Everyone
                        </button>
                    </div>
                    <span class="stl__tag">@_sheet.Total.ToString("0.#") total</span>
                    @if (IsOpen)
                    {
                        <button type="button"
                                class="nx-btn nx-btn--primary stl__save"
                                disabled="@(!_sheet.HasUnsaved || _busy)"
                                @onclick="SaveMeals">
                            @(_sheet.HasUnsaved ? "Save changes" : "All saved")
                        </button>
                    }
                </div>
            </div>

            <div class="stl__sheet-scroll @(_onlyMyColumn ? "stl__sheet-scroll--narrow" : null)">
                <table class="stl__sheet">
                    <thead>
                        <tr>
                            <th class="stl__sheet-date">Date</th>
                            @foreach (var member in VisibleMembers)
                            {
                                <th>
                                    <span class="stl__sheet-member">@member.Name</span>
                                    <span class="stl__slot-legend">
                                        <i title="Breakfast">B</i>
                                        <i title="Lunch">L</i>
                                        <i title="Dinner">D</i>
                                    </span>
                                </th>
                            }
                            @if (!_onlyMyColumn)
                            {
                                <th class="stl__sheet-total">Day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Days)
                        {
                            <tr class="@(day.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday ? "is-weekend" : null)">
                                <th class="stl__sheet-date">
                                    <span class="stl__day-num">@day.Day.ToString("00")</span>
                                    <span class="stl__day-name">@day.ToString("ddd")</span>
                                </th>
                                @foreach (var member in VisibleMembers)
                                {
                                    var key = new MealSheetState.CellKey(day, member.UserId);
                                    var cell = _sheet.Get(key);
                                    var locked = !CanEditColumn(member);
                                    <td>
                                        <div class="stl__slots @(cell.IsDirty ? "is-dirty" : null)">
                                            @foreach (var slot in MealSlots)
                                            {
                                                @if (slot != MealSheetState.Slot.Breakfast)
                                                {
                                                    <span class="stl__slot-sep" aria-hidden="true">+</span>
                                                }
                                                <input class="stl__slot @(cell[slot] == 0m ? "is-zero" : null)"
                                                       type="number"
                                                       min="0"
                                                       max="10"
                                                       step="0.5"
                                                       value="@cell[slot].ToString("0.##", CultureInfo.InvariantCulture)"
                                                       disabled="@locked"
                                                       aria-label="@($"{member.Name} {slot.ToString().ToLowerInvariant()} on {day:dd MMM}")"
                                                       @onchange="args => ChangeMealSlot(key, slot, args.Value?.ToString())" />
                                            }
                                            <span class="stl__slot-sum" aria-hidden="true">@cell.Total.ToString("0.##")</span>
                                        </div>
                                    </td>
                                }
                                @if (!_onlyMyColumn)
                                {
                                    <td class="stl__sheet-total">@_sheet.DayTotal(day).ToString("0.#")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="stl__sheet-date">Total</th>
                            @foreach (var member in VisibleMembers)
                            {
                                <th>
                                    <span class="stl__slot-totals">
                                        @foreach (var slot in MealSlots)
                                        {
                                            @if (slot != MealSheetState.Slot.Breakfast)
                                            {
                                                <span class="stl__slot-sep" aria-hidden="true">+</span>
                                            }
                                            <i>@_sheet.MemberSlotTotal(member.UserId, slot).ToString("0.##")</i>
                                        }
                                    </span>
                                    <span class="stl__slot-grand">@_sheet.MemberTotal(member.UserId).ToString("0.##")</span>
                                </th>
                            }
                            @if (!_onlyMyColumn)
                            {
                                <th class="stl__sheet-total">@_sheet.Total.ToString("0.#")</th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (_mealCostHistory.Count > 0)
            {
                <section class="stl__member-costs" aria-labelledby="member-cost-heading">
                    <div class="stl__member-costs-head">
                        <div>
                            <p class="stl__eyebrow">Monthly view</p>
                            <h3 id="member-cost-heading">Meal cost by member</h3>
                            <p>See how each person's meal cost has changed across the house books.</p>
                        </div>
                        <span class="stl__tag">@MemberHistory.Count() members</span>
                    </div>
                    <div class="stl__member-tabs" role="tablist" aria-label="Member meal cost charts">
                        @foreach (var member in MemberHistory)
                        {
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(member.UserId == SelectedHistoryUserId)"
                                    class="stl__member-tab @(member.UserId == SelectedHistoryUserId ? "is-active" : null)"
                                    @onclick="() => _selectedHistoryUserId = member.UserId">
                                <span class="stl__avatar stl__avatar--@(Math.Abs(member.UserId.GetHashCode()) % 4)">@member.MemberName[0]</span>
                                @member.MemberName
                            </button>
                        }
                    </div>
                    @if (SelectedMemberHistory.Count() > 0)
                    {
                        <div class="stl__member-chart" role="tabpanel">
                            <div class="stl__member-chart-top">
                                <strong>@SelectedMemberName</strong>
                                <span>@SelectedMemberHistory.Sum(item => item.MealCount).ToString("0.#") meals · @SelectedMemberHistory.Sum(item => item.MealCost).ToString("C2", CultureInfo.GetCultureInfo("en-BD")) total cost</span>
                            </div>
                            <div class="stl__line-chart" aria-label="Monthly meals and meal cost line chart">
                                <div class="stl__chart-axis-labels">
                                    <span>Meals: 0 - @MealsAxisMax.ToString("0.#")</span>
                                    <span>Cost: ৳0 - ৳@CostAxisMax.ToString("0")</span>
                                </div>
                                <svg class="stl__line-svg" viewBox="0 0 760 280" role="img" aria-labelledby="meal-chart-title meal-chart-desc" preserveAspectRatio="none">
                                    <title id="meal-chart-title">@SelectedMemberName monthly meals and meal cost</title>
                                    <desc id="meal-chart-desc">Red line shows total meals. Blue line shows total meal cost in taka.</desc>
                                    @foreach (var grid in new[] { 0, 1, 2, 3, 4 })
                                    {
                                        var y = 30 + grid * 48;
                                        <line class="stl__chart-grid" x1="42" y1="@y" x2="730" y2="@y" />
                                        <text class="stl__chart-y-label stl__chart-y-label--left" x="36" y="@(y + 4)" text-anchor="end">@AxisTick(MealsAxisMax, grid)</text>
                                        <text class="stl__chart-y-label stl__chart-y-label--right" x="736" y="@(y + 4)">@CostAxisTick(grid)</text>
                                    }
                                    <polyline class="stl__line stl__line--meals" points="@MealLinePoints" />
                                    <polyline class="stl__line stl__line--cost" points="@CostLinePoints" />
                                    @foreach (var (item, index) in SelectedMemberHistory.Select((item, index) => (item, index)))
                                    {
                                        var x = ChartX(index);
                                        <g class="stl__chart-point">
                                            <title>@ChartTooltip(item)</title>
                                            <circle class="stl__point stl__point--meals" cx="@x" cy="@MealsY(item.MealCount)" r="6" />
                                            <circle class="stl__point stl__point--cost" cx="@x" cy="@CostY(item.MealCost)" r="6" />
                                            <text class="stl__chart-month" x="@x" y="270" text-anchor="middle">@MonthShort(item.Year, item.Month)</text>
                                        </g>
                                    }
                                </svg>
                                <div class="stl__chart-legend">
                                    <span><i class="stl__legend-dot stl__legend-dot--meals"></i>Total meals</span>
                                    <span><i class="stl__legend-dot stl__legend-dot--cost"></i>Total meal cost</span>
                                </div>
                            </div>
                            <div class="stl__chart-footnote">
                                Hover a point for the exact monthly total. Each metric uses its own scale.
                            </div>
                            <div class="stl__chart-data">
                                @foreach (var item in SelectedMemberHistory)
                                {
                                    <span>@MonthShort(item.Year, item.Month): @item.MealCount.ToString("0.#") meals, ৳@item.MealCost.ToString("0.00")</span>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        </section>
    </div>;
}

@* ===================== bills ===================== *@

@code {
    private RenderFragment RenderBills => @<div class="stl__stack">
        <section class="stl__card" style="--delay: 60ms">
            <div class="stl__card-head">
                <div>
                    <h2>Monthly bills</h2>
                    <p>Everything here is split equally between all @Members.Count members in this book.</p>
                </div>
                <span class="stl__tag stl__tag--strong">
                    <MoneyDisplay Amount="_ws!.BillShare" /> per person
                </span>
            </div>

            @if (_ws.Bills.Count == 0)
            {
                <p class="stl__empty">No bills in this book.</p>
            }
            else
            {
                <ul class="stl__bills">
                    @foreach (var (bill, index) in _ws.Bills.Select((b, i) => (b, i)))
                    {
                        var icon = BillIconKey(bill.Description);
                        <li class="stl__bill" style="--delay: @(120 + index * 55)ms" @key="bill.Id">
                            <span class="stl__bill-icon stl__bill-icon--@icon">@((MarkupString)BillIcon(icon))</span>

                            <div class="stl__bill-body">
                                <span class="stl__bill-name">@bill.Description</span>
                                <span class="stl__bill-split">
                                    <MoneyDisplay Amount="@(Members.Count == 0 ? 0m : Math.Round(bill.Amount / Members.Count, 2))" />
                                    each
                                </span>
                            </div>

                            <div class="stl__bill-amount">
                                <span class="stl__bill-currency">৳</span>
                                <input type="number"
                                       min="0"
                                       step="10"
                                       class="stl__bill-input"
                                       value="@bill.Amount.ToString("0.##", CultureInfo.InvariantCulture)"
                                       disabled="@(!CanManageOpen)"
                                       aria-label="@($"{bill.Description} amount")"
                                       @onchange="args => ChangeBillAmount(bill, args.Value?.ToString())" />
                            </div>

                            @if (CanManageOpen)
                            {
                                <button type="button" class="stl__bill-remove" title="Remove bill" disabled="@_busy" @onclick="() => RemoveBill(bill)">×</button>
                            }
                            else
                            {
                                <span class="stl__bill-remove stl__bill-remove--empty"></span>
                            }
                        </li>
                    }
                </ul>
            }

            <div class="stl__bills-foot">
                <span>Total for @PeriodLabel</span>
                <strong><MoneyDisplay Amount="_ws.BillsTotal" /></strong>
            </div>
        </section>

        @if (CanManageOpen)
        {
            <section class="stl__card stl__card--form" style="--delay: 200ms">
                <div class="stl__card-head">
                    <div>
                        <h2>Add another bill</h2>
                        <p>Anything else the house pays for together — it gets split equally too.</p>
                    </div>
                </div>

                <EditForm Model="_billModel" OnValidSubmit="AddBill" class="stl__form stl__form--inline">
                    <DataAnnotationsValidator />

                    <TextInput @bind-Value="_billModel.Name"
                               Label="Bill name"
                               Placeholder="Building service charge"
                               For="@(() => _billModel.Name)" />

                    <MoneyInput @bind-Value="_billModel.Amount"
                                Label="Amount"
                                For="@(() => _billModel.Amount)" />

                    <button type="submit" class="nx-btn nx-btn--primary" disabled="@_busy">Add bill</button>
                </EditForm>
            </section>
        }
    </div>;
}

@* ===================== payments ===================== *@

@code {
    private RenderFragment RenderPayments => @<div class="stl__stack">
        <div class="stl__member-strip stl__member-strip--wide">
            @foreach (var (member, index) in Members.Select((m, i) => (m, i)))
            {
                <article class="stl__paid-card" style="--delay: @(index * 60)ms">
                    <div class="stl__paid-head">
                        <span class="stl__avatar stl__avatar--@(index % 4)">@member.Name[0]</span>
                        <span class="stl__member-name">
                            @member.Name
                            @if (!member.IsActive)
                            {
                                <span class="stl__left-tag">left</span>
                            }
                        </span>
                    </div>
                    <strong class="stl__paid-total"><MoneyDisplay Amount="PaidTotal(member.UserId)" /></strong>
                    <div class="stl__paid-split">
                        <span class="stl__paid-pill stl__paid-pill--meal">
                            Meals <b>@MoneyText(PaidTotal(member.UserId, FundMeal))</b>
                        </span>
                        <span class="stl__paid-pill stl__paid-pill--shared">
                            Bills <b>@MoneyText(PaidTotal(member.UserId, FundShared))</b>
                        </span>
                    </div>
                </article>
            }
        </div>

        <div class="stl__two-col">
            <section class="stl__card" style="--delay: 240ms">
                <div class="stl__card-head">
                    <div>
                        <h2>What everyone has paid</h2>
                        <p>Each payment is either money for meals or money toward the shared bills.</p>
                    </div>
                    <span class="stl__tag">@_ws!.Payments.Count entries</span>
                </div>

                @if (_ws.Payments.Count == 0)
                {
                    <p class="stl__empty">No payments logged for this month yet.</p>
                }
                else
                {
                    <ul class="stl__ledger">
                        @foreach (var (payment, index) in _ws.Payments.Select((p, i) => (p, i)))
                        {
                            <li class="stl__ledger-row" style="--delay: @(index * 40)ms" @key="payment.Id">
                                <span class="stl__ledger-kind stl__ledger-kind--@(payment.FundType == FundMeal ? "meal" : "shared")">
                                    @(payment.FundType == FundMeal ? "Meal fund" : "Shared bills")
                                </span>
                                <div class="stl__ledger-body">
                                    <strong>@payment.MemberName</strong>
                                    <span>@payment.Note · <DateDisplay DateTime="payment.PaidOn" Format="date" /></span>
                                </div>
                                <span class="stl__ledger-amount"><MoneyDisplay Amount="payment.Amount" /></span>
                                @if (CanManageOpen)
                                {
                                    <button type="button" class="stl__bill-remove" title="Remove payment" disabled="@_busy" @onclick="() => RemovePayment(payment)">×</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (CanManageOpen)
            {
                <aside class="stl__card stl__card--form" style="--delay: 300ms">
                    <div class="stl__card-head">
                        <div>
                            <h2>Log a payment</h2>
                            <p>Record money a member handed over this month.</p>
                        </div>
                    </div>

                    <EditForm Model="_paymentModel" OnValidSubmit="AddPayment" class="stl__form">
                        <DataAnnotationsValidator />

                        <div class="field">
                            <label for="payment-member">Who paid</label>
                            <select id="payment-member" class="field__input" @bind="_paymentModel.UserId">
                                @foreach (var member in Members)
                                {
                                    <option value="@member.UserId">@member.Name</option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label>What was it for</label>
                            <div class="stl__segment" role="radiogroup" aria-label="Payment purpose">
                                <button type="button"
                                        role="radio"
                                        aria-checked="@(_paymentModel.FundType == FundMeal)"
                                        class="stl__segment-btn @(_paymentModel.FundType == FundMeal ? "is-active" : null)"
                                        @onclick="() => _paymentModel.FundType = FundMeal">
                                    Meal related
                                    <small>groceries, bazar</small>
                                </button>
                                <button type="button"
                                        role="radio"
                                        aria-checked="@(_paymentModel.FundType == FundShared)"
                                        class="stl__segment-btn @(_paymentModel.FundType == FundShared ? "is-active" : null)"
                                        @onclick="() => _paymentModel.FundType = FundShared">
                                    Shared bills
                                    <small>rent, utilities</small>
                                </button>
                            </div>
                        </div>

                        <MoneyInput @bind-Value="_paymentModel.Amount"
                                    Label="Amount"
                                    For="@(() => _paymentModel.Amount)" />

                        <DateInput @bind-Value="_paymentModel.PaidOn"
                                   Label="Paid on"
                                   For="@(() => _paymentModel.PaidOn)" />

                        <TextInput @bind-Value="_paymentModel.Note"
                                   Label="Note"
                                   Placeholder="Groceries for the week"
                                   For="@(() => _paymentModel.Note)" />

                        <button type="submit" class="nx-btn nx-btn--primary nx-btn--block" disabled="@_busy">Save payment</button>
                    </EditForm>
                </aside>
            }
        </div>
    </div>;
}

@* ===================== statement ===================== *@

@code {
    private RenderFragment RenderStatement => @<div class="stl__stack">
        <section class="stl__summary" style="--delay: 40ms">
            <div class="stl__summary-item">
                <span>Meal fund</span>
                <strong><MoneyDisplay Amount="Result.MealFund" /></strong>
            </div>
            <div class="stl__summary-item">
                <span>Bills</span>
                <strong><MoneyDisplay Amount="Result.BillsTotal" /></strong>
            </div>
            <div class="stl__summary-item">
                <span>Total meals</span>
                <strong>@Result.TotalMeals.ToString("0.#")</strong>
            </div>
            <div class="stl__summary-item">
                <span>Per meal</span>
                <strong>৳@Result.PerMealRate.ToString("0.00")</strong>
            </div>
            <div class="stl__summary-item">
                <span>Bill share each</span>
                <strong><MoneyDisplay Amount="Result.BillShare" /></strong>
            </div>
        </section>

        <section class="stl__card stl__finance-chart" style="--delay: 100ms">
            <div class="stl__card-head">
                <div>
                    <h2>House financial summary</h2>
                    <p>See what the house needs, what members have paid, and what remains.</p>
                </div>
                <span class="stl__tag">@PeriodLabel</span>
            </div>

            <div class="stl__chart-highlights">
                <div class="stl__chart-highlight">
                    <span>Total costs</span>
                    <strong>@MoneyText(Result.BillsTotal + Result.MealFund)</strong>
                </div>
                <div class="stl__chart-highlight stl__chart-highlight--collected">
                    <span>Collected</span>
                    <strong>@MoneyText(TotalPaid)</strong>
                </div>
                <div class="stl__chart-highlight stl__chart-highlight--due">
                    <span>Collection rate</span>
                    <strong>@CollectionRate%</strong>
                </div>
            </div>

            <div class="stl__chart" role="img" aria-label="House financial summary for @PeriodLabel">
                @foreach (var item in FinancialBars)
                {
                    <div class="stl__chart-row">
                        <div class="stl__chart-label">
                            <span class="stl__chart-swatch stl__chart-swatch--@item.ClassName"></span>
                            <span>@item.Label</span>
                        </div>
                        <div class="stl__chart-track">
                            <span class="stl__chart-fill stl__chart-fill--@item.ClassName"
                                  style="--chart-width: @ChartWidth(item.Amount)%"></span>
                        </div>
                        <strong class="stl__chart-value">
                            @MoneyText(item.Amount)
                            <small>@ChartPercent(item.Amount)%</small>
                        </strong>
                    </div>
                }
            </div>

            <div class="stl__chart-foot">
                <span><i class="stl__chart-dot stl__chart-dot--cost"></i>Cost</span>
                <span><i class="stl__chart-dot stl__chart-dot--collected"></i>Collected</span>
                <span><i class="stl__chart-dot stl__chart-dot--due"></i>Still due</span>
                <span class="stl__chart-help">Bars are scaled to the largest amount.</span>
            </div>
        </section>

        <div class="stl__statements">
            @foreach (var (line, index) in Result.Lines.Select((l, i) => (l, i)))
            {
                var totalOwed = line.MealCost + line.EqualShare;
                <article class="stl__statement @(line.NetAmount > 0m ? "is-credit" : "is-debit")" style="--delay: @(120 + index * 90)ms" @key="line.UserId">
                    <header class="stl__statement-head">
                        <span class="stl__avatar stl__avatar--@(index % 4)">@line.MemberName[0]</span>
                        <div>
                            <span class="stl__member-name">@line.MemberName</span>
                            <span class="stl__statement-sub">@line.Meals.ToString("0.#") meals this month</span>
                        </div>
                    </header>

                    <dl class="stl__statement-rows">
                        <div>
                            <dt>Meal cost</dt>
                            <dd><MoneyDisplay Amount="line.MealCost" /></dd>
                        </div>
                        <div>
                            <dt>Bill share</dt>
                            <dd><MoneyDisplay Amount="line.EqualShare" /></dd>
                        </div>
                        <div class="stl__statement-rows-sum">
                            <dt>Total owed</dt>
                            <dd><MoneyDisplay Amount="totalOwed" /></dd>
                        </div>
                        <div>
                            <dt>Contributed</dt>
                            <dd class="stl__statement-paid"><MoneyDisplay Amount="line.Contributions" /></dd>
                        </div>
                    </dl>

                    <div class="stl__meter" aria-hidden="true">
                        <span class="stl__meter-fill" style="--fill: @MeterWidth(line.Contributions, totalOwed)%"></span>
                    </div>

                    <footer class="stl__statement-foot">
                        <span class="stl__statement-verdict">
                            @(line.NetAmount > 0m ? "The house owes " + line.MemberName : line.NetAmount == 0m ? "Settled up" : line.MemberName + " owes the house")
                        </span>
                        <strong class="stl__statement-net">@MoneyText(Math.Abs(line.NetAmount))</strong>
                    </footer>
                </article>
            }
        </div>

        <section class="stl__card" style="--delay: 520ms">
            <div class="stl__card-head">
                <div>
                    <h2>House balance</h2>
                    <p>How the month adds up across everyone.</p>
                </div>
            </div>

            <ul class="stl__balance">
                <li>
                    <span>Collected for bills</span>
                    <strong><MoneyDisplay Amount="_ws!.SharedFundTotal" /></strong>
                </li>
                <li>
                    <span>Bills to pay</span>
                    <strong><MoneyDisplay Amount="Result.BillsTotal" /></strong>
                </li>
                <li class="@(_ws.OutstandingBills > 0 ? "is-warning" : "is-good")">
                    <span>
                        @(_ws.OutstandingBills > 0 ? "Still to collect"
                            : _ws.OutstandingBills < 0 ? "Surplus held"
                            : "Fully collected")
                    </span>
                    <strong>@MoneyText(Math.Abs(_ws.OutstandingBills))</strong>
                </li>
            </ul>

            @if (ResidualLine is not null)
            {
                <p class="stl__note">
                    The @MoneyText(Math.Abs(ResidualLine.RoundingAdjustment)) rounding difference goes to
                    @ResidualLine.MemberName, who has the largest meal cost.
                </p>
            }

            @if (IsOpen && Result.NetTotal != 0m)
            {
                <p class="stl__note">
                    Payments and costs differ by @MoneyText(Math.Abs(Result.NetTotal)). The book can be finalized once they match.
                </p>
            }
        </section>

        @if (Result.Transfers.Count > 0)
        {
            <section class="stl__card" style="--delay: 600ms">
                <div class="stl__card-head">
                    <div>
                        <h2>Who pays whom</h2>
                        <p>The fewest hand-overs that settle everyone up.</p>
                    </div>
                </div>
                <ul class="stl__transfers">
                    @foreach (var transfer in Result.Transfers)
                    {
                        <li>
                            <span><strong>@transfer.FromMemberName</strong> pays <strong>@transfer.ToMemberName</strong></span>
                            <strong>@MoneyText(transfer.Amount)</strong>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>;
}

@* ===================== state & handlers ===================== *@

@code {
    private const short FundMeal = 1;
    private const short FundShared = 2;
    private const short BookOpen = 1;
    private const short BookFinalized = 2;

    private enum Tab { Meals, Bills, Payments, Statement }

    private sealed record TabDef(Tab Key, string Label, string Icon);

    private static readonly TabDef[] Tabs =
    [
        new(Tab.Meals, "Meal sheet", """<svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 2v7a3 3 0 0 0 3 3 3 3 0 0 0 3-3V2"/><path d="M6 2v20"/><path d="M18 2c-1.7 1.3-2.5 3.5-2.5 6.5S16.3 14 18 15v7"/></svg>"""),
        new(Tab.Bills, "Bills", """<svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16v18l-2.7-1.6L14.6 21 12 19.4 9.4 21l-2.7-1.6L4 21Z"/><path d="M8 8h8"/><path d="M8 12h8"/></svg>"""),
        new(Tab.Payments, "Payments", """<svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>"""),
        new(Tab.Statement, "Statement", """<svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 14 3.5-4 3 3L20 6"/></svg>""")
    ];

    private static readonly MealSheetState.Slot[] MealSlots =
    [
        MealSheetState.Slot.Breakfast,
        MealSheetState.Slot.Lunch,
        MealSheetState.Slot.Dinner
    ];

    private Tab _tab = Tab.Meals;
    private bool _onlyMyColumn;
    private bool _loading = true;
    private bool _busy;
    private string? _loadError;

    private List<SettlementBookDto> _books = [];
    private List<MonthlyMemberMealCostDto> _mealCostHistory = [];
    private long _selectedHistoryUserId;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private SettlementWorkspaceDto? _ws;
    private readonly MealSheetState _sheet = new();
    private bool _showAddMember;

    private readonly BillFormModel _billModel = new();
    private readonly PaymentFormModel _paymentModel = new();

    // ---- derived state ----

    private bool HasBook => _ws is { BookStatus: > 0 };
    private bool IsOpen => _ws is { BookStatus: BookOpen };
    private bool IsFinalized => _ws is { BookStatus: BookFinalized };
    private bool CanManageOpen => _ws is { CanManage: true } && IsOpen;

    private List<SettlementMemberDto> Members => _ws?.Members ?? [];
    private IEnumerable<MonthlyMemberMealCostDto> MemberHistory =>
        _mealCostHistory.GroupBy(item => new { item.UserId, item.MemberName }).Select(group => group.First());
    private long SelectedHistoryUserId => _selectedHistoryUserId != 0
        ? _selectedHistoryUserId
        : MemberHistory.FirstOrDefault()?.UserId ?? 0;
    private IEnumerable<MonthlyMemberMealCostDto> SelectedMemberHistory =>
        _mealCostHistory.Where(item => item.UserId == SelectedHistoryUserId);
    private string SelectedMemberName => SelectedMemberHistory.FirstOrDefault()?.MemberName ?? "Member";
    private SettlementResultDto Result => _ws?.Result ?? new SettlementResultDto();

    private string PeriodLabel => new DateTime(_year, _month, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private IEnumerable<DateOnly> Days =>
        Enumerable.Range(1, DateTime.DaysInMonth(_year, _month)).Select(d => new DateOnly(_year, _month, d));

    private IEnumerable<SettlementMemberDto> VisibleMembers => _onlyMyColumn
        ? Members.Where(m => m.IsMe)
        : Members;

    private bool CanEditColumn(SettlementMemberDto member) =>
        IsOpen && (_ws!.CanManage || member.IsMe);

    // Months you can step through: from the earliest book (or today) up to today, or
    // one month past the latest finalized book so the manager can open the next one.
    private (int Year, int Month) MinMonth
    {
        get
        {
            var today = (DateTime.Today.Year, DateTime.Today.Month);
            return _books.Count == 0 ? today : Min(today, (_books[0].Year, _books[0].Month));
        }
    }

    private (int Year, int Month) MaxMonth
    {
        get
        {
            var today = (DateTime.Today.Year, DateTime.Today.Month);
            if (_books.Count == 0)
            {
                return today;
            }

            var last = _books[^1];
            var lastMonth = (last.Year, last.Month);
            var limit = last.Status == BookFinalized ? Shift(lastMonth, 1) : lastMonth;
            return Max(today, limit);
        }
    }

    private bool HasPreviousMonth => Compare((_year, _month), MinMonth) > 0;
    private bool HasNextMonth => Compare((_year, _month), MaxMonth) < 0;

    private decimal TotalPaid => _ws?.Payments.Sum(p => p.Amount) ?? 0m;

    private decimal PaidTotal(long userId, short? fundType = null) =>
        _ws?.Payments.Where(p => p.UserId == userId && (fundType is null || p.FundType == fundType)).Sum(p => p.Amount) ?? 0m;

    private SettlementLineDto? ResidualLine =>
        Result.Lines.FirstOrDefault(line => line.RoundingAdjustment != 0m);

    private IEnumerable<FinancialBar> FinancialBars =>
    [
        new("Monthly bills", Result.BillsTotal, "bills"),
        new("Meal fund", Result.MealFund, "meals"),
        new("Shared bills collected", _ws?.SharedFundTotal ?? 0m, "collected"),
        new("Still to collect", Math.Max(0m, _ws?.OutstandingBills ?? 0m), "due")
    ];

    private decimal ChartMaximum => Math.Max(1m, FinancialBars.Max(item => item.Amount));

    private string ChartWidth(decimal amount) =>
        Math.Clamp(amount / ChartMaximum * 100m, 0m, 100m).ToString("0.##", CultureInfo.InvariantCulture);

    private string ChartPercent(decimal amount) =>
        Math.Clamp(amount / ChartMaximum * 100m, 0m, 100m).ToString("0", CultureInfo.InvariantCulture);

    private string CollectionRate
    {
        get
        {
            var totalCosts = Result.BillsTotal + Result.MealFund;
            return totalCosts <= 0m
                ? "0"
                : Math.Clamp(TotalPaid / totalCosts * 100m, 0m, 100m)
                    .ToString("0", CultureInfo.InvariantCulture);
        }
    }

    // ---- loading ----

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialAsync();
    }

    private async Task LoadInitialAsync()
    {
        try
        {
            _loadError = null;
            var books = await SettlementApi.GetBooksAsync();
            if (books is null)
            {
                _ws = null;
                return;
            }

            _books = books.ToList();
            _mealCostHistory = (await SettlementApi.GetMealCostHistoryAsync())?.ToList() ?? [];
            var open = _books.FirstOrDefault(b => b.Status == BookOpen);
            var start = open ?? _books.LastOrDefault();
            (_year, _month) = start is null
                ? (DateTime.Today.Year, DateTime.Today.Month)
                : (start.Year, start.Month);

            await LoadMonthAsync();
        }
        catch (Exception ex)
        {
            _ws = null;
            _loadError = ex.Message;
            ToastService.ShowError(ex.Message, "Could not load the settlement book");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryLoad()
    {
        _loading = true;
        await LoadInitialAsync();
    }

    private async Task LoadMonthAsync()
    {
        _ws = await SettlementApi.GetAsync(_year, _month);
        _sheet.Load(_ws?.Meals ?? []);
        ResetForms();
    }

    private async Task ReloadAsync()
    {
        _books = (await SettlementApi.GetBooksAsync())?.ToList() ?? [];
        _mealCostHistory = (await SettlementApi.GetMealCostHistoryAsync())?.ToList() ?? [];
        await LoadMonthAsync();
    }

    private IReadOnlyList<MonthlyMemberMealCostDto> SelectedHistoryItems => SelectedMemberHistory.ToList();

    private string MealLinePoints => string.Join(" ", SelectedHistoryItems.Select((item, index) => $"{ChartX(index)},{MealsY(item.MealCount)}"));

    private string CostLinePoints => string.Join(" ", SelectedHistoryItems.Select((item, index) => $"{ChartX(index)},{CostY(item.MealCost)}"));

    private decimal MealsAxisMax => Math.Max(1m, SelectedHistoryItems.Max(item => item.MealCount));
    private decimal CostAxisMax => Math.Max(1m, SelectedHistoryItems.Max(item => item.MealCost));

    private decimal ChartX(int index)
    {
        var count = Math.Max(1, SelectedHistoryItems.Count - 1);
        return 42m + index * (688m / count);
    }

    private decimal MealsY(decimal amount)
    {
        return 222m - amount / MealsAxisMax * 192m;
    }

    private decimal CostY(decimal amount)
    {
        return 222m - amount / CostAxisMax * 192m;
    }

    private static string AxisTick(decimal maximum, int grid) =>
        (maximum * (4 - grid) / 4m).ToString("0.#", CultureInfo.InvariantCulture);

    private string CostAxisTick(int grid) =>
        $"৳{(CostAxisMax * (4 - grid) / 4m):0}";

    private static string MonthShort(int year, int month) =>
        new DateTime(year, month, 1).ToString("MMM yy", CultureInfo.InvariantCulture);

    private static string ChartTooltip(MonthlyMemberMealCostDto item) =>
        $"{MonthShort(item.Year, item.Month)}: ৳{item.MealCost:0.00} ({item.MealCount:0.#} meals at ৳{item.PerMealRate:0.00})";

    private async Task GoToPreviousMonth()
    {
        (_year, _month) = Shift((_year, _month), -1);
        await SwitchMonthAsync();
    }

    private async Task GoToNextMonth()
    {
        (_year, _month) = Shift((_year, _month), 1);
        await SwitchMonthAsync();
    }

    private async Task SwitchMonthAsync()
    {
        _busy = true;
        try
        {
            await LoadMonthAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message, "Could not load that month");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetForms()
    {
        _billModel.Name = string.Empty;
        _billModel.Amount = 0m;

        _paymentModel.UserId = Members.FirstOrDefault(m => m.IsMe)?.UserId ?? Members.FirstOrDefault()?.UserId ?? 0;
        _paymentModel.Amount = 0m;
        _paymentModel.Note = string.Empty;
        _paymentModel.PaidOn = DefaultFormDate();
    }

    private DateTime DefaultFormDate()
    {
        var today = DateTime.Today;
        return today.Year == _year && today.Month == _month ? today : new DateTime(_year, _month, 1);
    }

    // ---- actions ----

    private Task OpenBook() => RunAsync(
        () => SettlementApi.OpenBookAsync(_year, _month),
        $"The book for {PeriodLabel} is open.", "Book opened");

    private Task AddMember(long userId) => RunAsync(
        () => SettlementApi.AddMemberAsync(_year, _month, userId),
        "They are now part of this month's book.", "Member added");

    private async Task SaveMeals()
    {
        var entries = _sheet.DirtyEntries();
        if (entries.Count == 0)
        {
            return;
        }

        await RunAsync(
            () => SettlementApi.SaveMealsAsync(_year, _month, new SaveSettlementMealsRequest { Entries = entries }),
            "The meal sheet is up to date.", "Meals saved");
    }

    private void ChangeMealSlot(MealSheetState.CellKey key, MealSheetState.Slot slot, string? rawValue)
    {
        if (decimal.TryParse(rawValue, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            _sheet.Set(key, slot, value);
        }
    }

    private async Task ChangeBillAmount(SettlementBillDto bill, string? rawValue)
    {
        if (!decimal.TryParse(rawValue, NumberStyles.Number, CultureInfo.InvariantCulture, out var value) || value == bill.Amount)
        {
            return;
        }

        await RunAsync(
            () => SettlementApi.UpdateBillAsync(_year, _month, bill.Id, value),
            $"{bill.Description} is now {MoneyText(value)}.", "Bill updated");
    }

    private async Task AddBill()
    {
        _busy = true;
        try
        {
            var (data, error) = await SettlementApi.AddBillAsync(_year, _month, new CreateSettlementBillRequest
            {
                Description = _billModel.Name,
                Amount = _billModel.Amount,
                SpentOn = DefaultFormDate()
            });

            if (data is null)
            {
                ToastService.ShowError(error ?? "Could not add the bill.", "Bill not added");
                return;
            }

            ToastService.ShowSuccess($"{data.Description} will be split equally.", "Bill added");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message, "Bill not added");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RemoveBill(SettlementBillDto bill) => RunAsync(
        () => SettlementApi.DeleteBillAsync(_year, _month, bill.Id),
        $"{bill.Description} was removed from this month.", "Bill removed");

    private async Task AddPayment()
    {
        _busy = true;
        try
        {
            var (data, error) = await SettlementApi.AddPaymentAsync(_year, _month, new CreateSettlementPaymentRequest
            {
                UserId = _paymentModel.UserId,
                Amount = _paymentModel.Amount,
                FundType = _paymentModel.FundType,
                Note = _paymentModel.Note,
                PaidOn = _paymentModel.PaidOn
            });

            if (data is null)
            {
                ToastService.ShowError(error ?? "Could not record the payment.", "Payment not saved");
                return;
            }

            ToastService.ShowSuccess(
                $"{MoneyFormatterService.Format(data.Amount)} recorded for {data.MemberName}.",
                "Payment saved");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message, "Payment not saved");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RemovePayment(SettlementPaymentDto payment) => RunAsync(
        () => SettlementApi.DeletePaymentAsync(_year, _month, payment.Id),
        $"Removed {MoneyText(payment.Amount)} from {payment.MemberName}.", "Payment removed");

    private Task FinalizePeriod() => RunAsync(
        () => SettlementApi.FinalizeAsync(_year, _month),
        $"{PeriodLabel} is now locked.", "Month finalized");

    // Runs one API call, toasts the outcome and reloads the book on success.
    private async Task RunAsync(Func<Task<(bool Ok, string Message)>> action, string successText, string successTitle)
    {
        _busy = true;
        try
        {
            var (ok, message) = await action();
            if (!ok)
            {
                ToastService.ShowError(message, "Not done");
                return;
            }

            ToastService.ShowSuccess(successText, successTitle);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message, "Not done");
        }
        finally
        {
            _busy = false;
        }
    }

