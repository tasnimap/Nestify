    private sealed record FinancialBar(string Label, decimal Amount, string ClassName);

    private sealed class BillFormModel
    {
        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementBillNameRequired))]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPaymentAmountRequired))]
        [Range(0.01, 1000000, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPaymentAmountRequired))]
        public decimal? Amount { get; set; }
    }

    private sealed class PaymentFormModel
    {
        [Range(1, long.MaxValue, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPayerRequired))]
        public long UserId { get; set; }

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPaymentAmountRequired))]
        [Range(0.01, 1000000, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPaymentAmountRequired))]
        public decimal? Amount { get; set; }

        [Required]
        public DateTime PaidOn { get; set; }

        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.SettlementPaymentNoteRequired))]
        public string Note { get; set; } = string.Empty;

        public short FundType { get; set; } = FundMeal;
    }

    private string MoneyText(decimal amount) => MoneyFormatterService.Format(amount);

    private static string MeterWidth(decimal paid, decimal owed)
    {
        if (owed <= 0m)
        {
            return paid > 0m ? "100" : "0";
        }

        return Math.Clamp(paid / owed * 100m, 0m, 100m).ToString("0.#", CultureInfo.InvariantCulture);
    }

    private static (int Year, int Month) Shift((int Year, int Month) value, int months)
    {
        var date = new DateTime(value.Year, value.Month, 1).AddMonths(months);
        return (date.Year, date.Month);
    }

    private static int Compare((int Year, int Month) a, (int Year, int Month) b) =>
        a.Year != b.Year ? a.Year.CompareTo(b.Year) : a.Month.CompareTo(b.Month);

    private static (int Year, int Month) Min((int Year, int Month) a, (int Year, int Month) b) => Compare(a, b) <= 0 ? a : b;
    private static (int Year, int Month) Max((int Year, int Month) a, (int Year, int Month) b) => Compare(a, b) >= 0 ? a : b;

    private static string BillIconKey(string description)
    {
        var name = description.ToLowerInvariant();
        if (name.Contains("rent")) return "rent";
        if (name.Contains("electric") || name.Contains("current")) return "electricity";
        if (name.Contains("water")) return "water";
        if (name.Contains("internet") || name.Contains("wifi")) return "internet";
        if (name.Contains("gas")) return "gas";
        if (name.Contains("garbage") || name.Contains("clean")) return "garbage";
        return "other";
    }

    private static bool IsFixedBill(SettlementBillDto bill) =>
        bill.Description.Equals("Rent", StringComparison.OrdinalIgnoreCase)
        || bill.Description.Equals("Electricity", StringComparison.OrdinalIgnoreCase)
        || bill.Description.Equals("Water", StringComparison.OrdinalIgnoreCase)
        || bill.Description.Equals("Gas", StringComparison.OrdinalIgnoreCase)
        || bill.Description.Equals("Internet", StringComparison.OrdinalIgnoreCase);

