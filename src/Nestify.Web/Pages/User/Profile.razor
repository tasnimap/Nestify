        _showPassword = true;
    }

    private void ClosePassword() => _showPassword = false;

    private async Task SavePassword()
    {
        _passwordDone = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordError = L["Enter your current password."];
            return;
        }

        if (_newPassword.Length < 8)
        {
            _passwordError = L["New password must be at least 8 characters."];
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordError = L["New password and confirmation do not match."];
            return;
        }

        if (_newPassword == _currentPassword)
        {
            _passwordError = L["New password must be different from the current one."];
            return;
        }

        _passwordError = null;
        _savingPassword = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
            _passwordDone = L["Password updated."];
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
        }
        catch
        {
            _passwordError = L["Password could not be updated. Please try again."].Value;
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private static string Or(string? value, string fallback) =>
