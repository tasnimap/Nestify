    private string DisplayDateOfBirth => _profile?.DateOfBirth is { } dob
        ? L["{0} ({1} yrs)", dob.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentCulture), CalculateAge(dob)]
        : L["Not set"].Value;

    private static int CalculateAge(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age)) age--;
        return age;
    }

