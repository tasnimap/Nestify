@page "/profile"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Profile
@using Nestify.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IUserProfileService ProfileService

<PageTitle>My Profile - Nestify</PageTitle>

@if (_loading)
{
    <p class="up-msg">Loading your profile...</p>
}
else if (_profile is null)
{
    <p class="up-msg up-msg--bad">@(_loadError ?? "We could not load your profile.")</p>
}
else
{
    <section class="up">
        <div class="up-cover">
            <span class="up-orb up-orb--a"></span>
            <span class="up-orb up-orb--b"></span>
            <span class="up-orb up-orb--c"></span>
        </div>

        <div class="up-shell">
            <header class="up-card up-head" style="--d: 0ms">
                <div class="up-photo-wrap">
                    <button type="button" class="up-photo" @onclick="OpenPhoto" title="View photo"
                            aria-label="View profile photo">
                        <img src="@PhotoUrl" alt="Profile photo of @_profile.FullName" />
                        <span class="up-photo__ring"></span>
                        <span class="up-photo__dot" title="Online"></span>
                        <span class="up-photo__hint">View</span>
                    </button>

                    <label class="up-photo__change">
                        <InputFile OnChange="PickPicture" accept="image/*" class="up-photo__file" disabled="@_uploading" />
                        <span>@(_uploading ? "Uploading..." : "Change photo")</span>
                    </label>

                    @if (_photoError is not null)
                    {
                        <p class="up-msg up-msg--bad">@_photoError</p>
                    }
                </div>

                <div class="up-head__text">
                    <p class="up-kicker">Bachelor account</p>
                    <h1>@_profile.FullName</h1>
                    <p class="up-head__meta">@DisplayOccupation &middot; @DisplayAddress</p>
                    <div class="up-chips">
                        @if (_profile.VerificationState == VerificationState.Verified)
                        { <span class="up-chip up-chip--verified">Verified</span> }
                        else if (_profile.VerificationState == VerificationState.Pending)
                        {
                            <span class="up-chip up-chip--wait">Verification pending</span>
                            <button type="button" class="up-chip up-chip--cancel" disabled="@_cancellingVerification" @onclick="CancelVerification">
                                @(_cancellingVerification ? "Cancelling..." : "Cancel application")
                            </button>
                        }
                        else
                        { <button type="button" class="up-chip up-chip--apply" @onclick="OpenVerification">Apply for verification</button> }
                        <span class="up-chip">House member</span>
                        <span class="up-chip">Joined @JoinedOn</span>
                    </div>
                </div>

                <div class="up-head__actions">
                    <button type="button" class="up-btn up-btn--solid" @onclick="OpenEdit">Edit profile</button>
                    <button type="button" class="up-btn" @onclick="OpenPassword">Change password</button>
                </div>
            </header>

            <div class="up-stats">
                @foreach (var (stat, i) in Stats.Select((s, i) => (s, i)))
                {
                    <article class="up-card up-stat" style="--d: @(120 + i * 70)ms">
                        <strong>@stat.Value</strong>
                        <span>@stat.Label</span>
                        <em class="up-stat__trend">@stat.Trend</em>
                    </article>
                }
            </div>

            <div class="up-grid">
                <section class="up-card up-panel" style="--d: 400ms">
                    <h2>Personal details</h2>
                    <dl class="up-details">
                        <div><dt>Full name</dt><dd>@_profile.FullName</dd></div>
                        <div><dt>Email</dt><dd>@_profile.Email</dd></div>
                        <div><dt>Phone</dt><dd>@_profile.PhoneNumber</dd></div>
                        <div><dt>WhatsApp</dt><dd>@Or(_profile.WhatsappNumber, "Not added")</dd></div>
                        <div><dt>Gender</dt><dd>@DisplayGender</dd></div>
                        <div><dt>Date of birth</dt><dd>@DisplayDateOfBirth</dd></div>
                        <div><dt>Occupation</dt><dd>@PersonalOccupation</dd></div>
                        @if (!string.IsNullOrWhiteSpace(_profile.OrganizationName))
                        { <div><dt>@(_profile.Occupation == "Job holder" ? "Workplace" : "School / university")</dt><dd>@_profile.OrganizationName</dd></div> }
                        <div><dt>Smoking</dt><dd>@DisplaySmoker</dd></div>
                        <div><dt>Drinking</dt><dd>@DisplayDrinker</dd></div>
                        <div class="up-details__wide"><dt>Address</dt><dd>@DisplayAddress</dd></div>
                    </dl>
                </section>

                <section class="up-card up-panel" style="--d: 470ms">
                    <h2>Reach me</h2>
                    <div class="up-socials">
                        @foreach (var (link, i) in Socials.Select((s, i) => (s, i)))
                        {
                            <a class="up-social up-social--@link.Key" href="@link.Href" target="_blank" rel="noopener"
                               style="--d: @(520 + i * 60)ms">
                                <span class="up-social__icon">@((MarkupString)link.Icon)</span>
                                <span class="up-social__text">
                                    <b>@link.Name</b>
                                    <small>@link.Handle</small>
                                </span>
                                <span class="up-social__go">&rarr;</span>
                            </a>
                        }
                    </div>
                </section>

                <section class="up-card up-panel up-panel--wide" style="--d: 630ms">
                    <h2>This month at a glance</h2>
                    <div class="up-bars">
                        @foreach (var (bar, i) in Monthly.Select((b, i) => (b, i)))
                        {
                            <div class="up-bar" style="--d: @(700 + i * 90)ms">
                                <div class="up-bar__head"><span>@bar.Label</span><b>@bar.Display</b></div>
                                <div class="up-bar__track">
                                    <span class="up-bar__fill" style="--w: @bar.Percent%"></span>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </section>

    @if (_showPhoto)
    {
        <div class="up-overlay up-overlay--dark" @onclick="ClosePhoto">
            <figure class="up-lightbox" @onclick:stopPropagation="true">
                <img src="@PhotoUrl" alt="Profile photo of @_profile.FullName" />
                <figcaption>@_profile.FullName</figcaption>
                <button type="button" class="up-lightbox__close" @onclick="ClosePhoto" aria-label="Close">&times;</button>
            </figure>
        </div>
    }

    @if (_showEdit)
    {
        <div class="up-overlay" @onclick="CloseEdit">
            <div class="up-modal" @onclick:stopPropagation="true">
                <header class="up-modal__head">
                    <h2>Edit profile</h2>
                    <button type="button" class="up-modal__close" @onclick="CloseEdit" aria-label="Close">&times;</button>
                </header>

                <div class="up-modal__body">
                    <div class="up-field">
                        <label for="ed-fullname">Full name</label>
                        <input id="ed-fullname" @bind="_draft.FullName" placeholder="Your full name" />
                    </div>
                    <div class="up-field">
                        <label for="ed-phone">Phone number</label>
                        <input id="ed-phone" @bind="_draft.PhoneNumber" placeholder="e.g. 01712345678" />
                    </div>
                    <div class="up-field">
                        <label for="ed-occupation">Occupation</label>
                        <select id="ed-occupation" @bind="_draft.Occupation">
                            <option value="">Select your occupation</option>
                            @if (!string.IsNullOrWhiteSpace(_draft.Occupation) && !IsStandardOccupation(_draft.Occupation))
                            {
                                <option value="@_draft.Occupation">@_draft.Occupation</option>
                            }
                            <option value="Student — High school">Student — High school</option>
                            <option value="Student — College">Student — College</option>
                            <option value="Student — University">Student — University</option>
                            <option value="Unemployed">Unemployed</option>
                            <option value="Job holder">Job holder</option>
                        </select>
                    </div>
                    <div class="up-field">
                        <label for="ed-gender">Gender</label>
                        <select id="ed-gender" @bind="GenderSelection">
                            <option value="">Prefer not to say</option>
                            <option value="@ProfileGender.Male">Male</option>
                            <option value="@ProfileGender.Female">Female</option>
                        </select>
                    </div>
                    <div class="up-field">
                        <label for="ed-dob">Date of birth</label>
                        <input id="ed-dob" type="date" @bind="_draft.DateOfBirth" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                    </div>
                    @if (NeedsOrganization)
                    {
                        <div class="up-field">
                            <label for="ed-organization">@OrganizationLabel</label>
                            <input id="ed-organization" @bind="_draft.OrganizationName" placeholder="@OrganizationPlaceholder" />
                        </div>
                    }
                    <div class="up-field">
                        <label for="ed-wa">WhatsApp number</label>
                        <input id="ed-wa" @bind="_draft.WhatsappNumber" />
                    </div>
                    <div class="up-field up-field--wide">
                        <label for="ed-address">Address</label>
                        <input id="ed-address" @bind="_draft.Address" />
                    </div>
                    <div class="up-field">
                        <label for="ed-smoker">Smoking</label>
                        <select id="ed-smoker" @bind="SmokerSelection">
                            <option value="false">Non-smoker</option>
                            <option value="true">Smoker</option>
                        </select>
                    </div>
                    <div class="up-field">
                        <label for="ed-drinker">Drinking</label>
                        <select id="ed-drinker" @bind="DrinkerSelection">
                            <option value="false">Non-drinker</option>
                            <option value="true">Drinker</option>
                        </select>
                    </div>
                    <div class="up-field">
                        <label for="ed-fb">Facebook profile link</label>
                        <input id="ed-fb" @bind="_draft.FacebookUrl" />
                    </div>
                    <div class="up-field">
                        <label for="ed-x">X profile link</label>
                        <input id="ed-x" @bind="_draft.XUrl" />
                    </div>
                    <div class="up-field">
                        <label for="ed-ig">Instagram profile link</label>
                        <input id="ed-ig" @bind="_draft.InstagramUrl" />
                    </div>

                    @if (_editError is not null)
                    {
                        <p class="up-msg up-msg--bad up-field--wide">@_editError</p>
                    }
                </div>

                <footer class="up-modal__foot">
                    <button type="button" class="up-btn" @onclick="CloseEdit">Cancel</button>
                    <button type="button" class="up-btn up-btn--solid" disabled="@_saving" @onclick="SaveEdit">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                </footer>
            </div>
        </div>
    }

    @if (_showVerification)
    {
        <div class="up-overlay" @onclick="CloseVerification">
            <div class="up-modal up-modal--sm" @onclick:stopPropagation="true">
                @if (_verificationStep == VerificationStep.Documents)
                {
                    <header class="up-modal__head"><h2>Verify your account</h2><button type="button" class="up-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button></header>
                    <div class="up-modal__body up-modal__body--stack">
                        <p class="up-verification-copy">Upload a clear photo of your NID or birth certificate. @SecondDocumentCopy An admin will review the documents before the verified badge is added to your account.</p>
                        <div class="up-field">
                            <label for="verification-document">Identity document</label>
                            <select id="verification-document" @bind="_identityDocumentType">
                                <option value="">Choose a document</option>
                                <option value="National ID (NID)">National ID (NID)</option>
                                <option value="Birth certificate">Birth certificate</option>
                            </select>
                        </div>
                        <div class="up-field">
                            <label for="verification-file">@(string.IsNullOrWhiteSpace(_identityDocumentType) ? "Identity document photo" : $"{_identityDocumentType} photo")</label>
                            <div class="up-document-picker">
                                <InputFile id="verification-file" OnChange="PickIdentityDocument" accept="image/*" class="up-document-picker__input" />
                                @if (_identityPreviewUrl is not null)
                                {
                                    <div class="up-document-preview">
                                        <img src="@_identityPreviewUrl" alt="Selected identity document preview" />
                                        <div>
                                            <span class="up-document-preview__status">Photo selected</span>
                                            <small class="up-file-name">@_identityFile?.Name</small>
                                            <label for="verification-file" class="up-document-preview__change"><span>Replace photo</span></label>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <label for="verification-file" class="up-document-picker__choose"><span>Choose a clear document photo</span></label>
                                }
                            </div>
                        </div>
                        @if (SecondDocumentLabel is not null)
                        {
                            <div class="up-field">
                                <label for="verification-second-file">@SecondDocumentLabel photo</label>
                                <p class="up-verification-hint">@SecondDocumentHint</p>
                                <div class="up-document-picker">
                                    <InputFile id="verification-second-file" OnChange="PickOccupationDocument" accept="image/*" class="up-document-picker__input" />
                                    @if (_occupationPreviewUrl is not null)
                                    {
                                        <div class="up-document-preview">
                                            <img src="@_occupationPreviewUrl" alt="Selected @SecondDocumentLabel preview" />
                                            <div>
                                                <span class="up-document-preview__status">Photo selected</span>
                                                <small class="up-file-name">@_occupationFile?.Name</small>
                                                <label for="verification-second-file" class="up-document-preview__change"><span>Replace photo</span></label>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <label for="verification-second-file" class="up-document-picker__choose"><span>Choose a clear @SecondDocumentLabel photo</span></label>
                                    }
                                </div>
                            </div>
                        }
                        @if (_verificationError is not null) { <p class="up-msg up-msg--bad">@_verificationError</p> }
                    </div>
                    <footer class="up-modal__foot">
                        <button type="button" class="up-btn" @onclick="CloseVerification">Cancel</button>
                        <button type="button" class="up-btn up-btn--solid" @onclick="GoToPayment">Continue to payment</button>
                    </footer>
                }
                else if (_verificationStep == VerificationStep.Payment)
                {
                    <header class="up-modal__head up-bkash__head">
                        <div class="up-bkash__brand"><span class="up-bkash__logo">bKash</span><span>Payment</span></div>
                        <button type="button" class="up-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button>
                    </header>
                    <div class="up-modal__body up-modal__body--stack">
                        <div class="up-bkash__summary">
                            <div><span>Merchant</span><b>Nestify</b></div>
                            <div><span>Purpose</span><b>Account verification fee</b></div>
                            <div><span>Amount</span><b class="up-bkash__amount">৳@_verificationFee.ToString("N0")</b></div>
                        </div>
                        <div class="up-field">
                            <label for="bkash-number">Your bKash account number</label>
                            <input id="bkash-number" inputmode="numeric" placeholder="01XXXXXXXXX" maxlength="14" @bind="_bkashNumber" />
                        </div>
                        <div class="up-field">
                            <label for="bkash-pin">bKash PIN</label>
                            <input id="bkash-pin" type="password" inputmode="numeric" placeholder="4 or 5 digits" maxlength="5" @bind="_bkashPin" />
                        </div>
                        <p class="up-verification-copy">This is a practice payment portal. Any Bangladeshi mobile number and any 4-5 digit PIN will be accepted.</p>
                        @if (_verificationError is not null) { <p class="up-msg up-msg--bad">@_verificationError</p> }
                    </div>
                    <footer class="up-modal__foot">
                        <button type="button" class="up-btn" disabled="@_paying" @onclick="BackToDocuments">Back</button>
                        <button type="button" class="up-btn up-btn--bkash" disabled="@_paying" @onclick="PayAndSubmit">@(_paying ? "Processing..." : $"Pay ৳{_verificationFee:N0}")</button>
                    </footer>
                }
                else
                {
                    var payment = _payment!;
                    <header class="up-modal__head"><h2>Payment successful</h2><button type="button" class="up-modal__close" @onclick="CloseVerification" aria-label="Close">&times;</button></header>
                    <div class="up-modal__body up-modal__body--stack">
                        <div class="up-bkash__done">
                            <span class="up-bkash__tick" aria-hidden="true">&#10003;</span>
                            <p class="up-bkash__done-title">৳@payment.AmountBdt.ToString("N0") paid from @payment.BkashNumber</p>
                            <p class="up-verification-copy">Transaction ID <b>@payment.TransactionId</b> &middot; @payment.PaidAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p>
                        </div>
                        @if (_applicationSent)
                        {
                            <p class="up-msg up-msg--good">Your verification application has been sent. An admin will review it soon.</p>
                        }
                        else if (_submittingVerification)
                        {
                            <p class="up-verification-copy">Sending your application...</p>
                        }
                        else if (_verificationError is not null)
                        {
                            <p class="up-msg up-msg--bad">@_verificationError</p>
                        }
                    </div>
                    <footer class="up-modal__foot">
                        @if (_applicationSent)
                        {
                            <button type="button" class="up-btn up-btn--solid" @onclick="CloseVerification">Done</button>
                        }
                        else
                        {
                            <button type="button" class="up-btn" @onclick="CloseVerification">Close</button>
                            <button type="button" class="up-btn up-btn--solid" disabled="@_submittingVerification" @onclick="SendApplication">@(_submittingVerification ? "Sending..." : "Send application again")</button>
                        }
                    </footer>
                }
            </div>
        </div>
    }

    @if (_showPassword)
    {
        <div class="up-overlay" @onclick="ClosePassword">
            <div class="up-modal up-modal--sm" @onclick:stopPropagation="true">
                <header class="up-modal__head">
                    <h2>Change password</h2>
                    <button type="button" class="up-modal__close" @onclick="ClosePassword" aria-label="Close">&times;</button>
                </header>

                <div class="up-modal__body up-modal__body--stack">
                    <div class="up-field">
                        <label for="pw-current">Current password</label>
                        <div class="up-pw">
                            <input id="pw-current" type="@PasswordType(_showCurrent)" @bind="_currentPassword" />
                            <button type="button" class="up-pw__toggle" @onclick="() => _showCurrent = !_showCurrent"
                                    aria-label="@(_showCurrent ? "Hide" : "Show") password">
                                @(_showCurrent ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>
                    <div class="up-field">
                        <label for="pw-new">New password</label>
                        <div class="up-pw">
                            <input id="pw-new" type="@PasswordType(_showNew)" @bind="_newPassword" />
                            <button type="button" class="up-pw__toggle" @onclick="() => _showNew = !_showNew"
                                    aria-label="@(_showNew ? "Hide" : "Show") password">
                                @(_showNew ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>
                    <div class="up-field">
                        <label for="pw-confirm">Confirm new password</label>
                        <div class="up-pw">
                            <input id="pw-confirm" type="@PasswordType(_showConfirm)" @bind="_confirmPassword" />
                            <button type="button" class="up-pw__toggle" @onclick="() => _showConfirm = !_showConfirm"
                                    aria-label="@(_showConfirm ? "Hide" : "Show") password">
                                @(_showConfirm ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>

                    @if (_passwordError is not null)
                    {
                        <p class="up-msg up-msg--bad">@_passwordError</p>
                    }
                    @if (_passwordDone is not null)
                    {
                        <p class="up-msg up-msg--good">@_passwordDone</p>
                    }
                </div>

                <footer class="up-modal__foot">
                    <button type="button" class="up-btn" @onclick="ClosePassword">Cancel</button>
                    <button type="button" class="up-btn up-btn--solid" @onclick="SavePassword">Update password</button>
                </footer>
            </div>
        </div>
    }
}

@code {
    private const long MaxPictureBytes = 5 * 1024 * 1024;

    private bool _loading = true;
    private string? _loadError;
    private UserProfileDto? _profile;

    private bool _showVerification;
    private bool _submittingVerification;
    private bool _cancellingVerification;
    private bool _showPhoto;
    private bool _showEdit;
    private bool _showPassword;
    private bool _saving;
    private bool _uploading;
    private string? _photoError;
    private enum VerificationStep { Documents, Payment, Done }

    private VerificationStep _verificationStep;
    private string _identityDocumentType = string.Empty;
    private IBrowserFile? _identityFile;
    private string? _identityPreviewUrl;
    private IBrowserFile? _occupationFile;
    private string? _occupationPreviewUrl;
    private string? _verificationError;
    private decimal _verificationFee;
    private string _bkashNumber = string.Empty;
    private string _bkashPin = string.Empty;
    private bool _paying;
    private VerificationPaymentDto? _payment;
    private bool _applicationSent;
    // Byte buffers read BEFORE the InputFile elements are unmounted on step change
    private byte[]? _identityBytes;
    private string? _identityContentType;
    private string? _identityName;
    private byte[]? _occupationBytes;
    private string? _occupationContentType;
    private string? _occupationName;

    private UpdateUserProfileDto _draft = new();
    private string? _editError;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private string? _passwordDone;

    // One Show/Hide toggle per password box.
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;

    private static string PasswordType(bool visible) => visible ? "text" : "password";

    private string PhotoUrl => string.IsNullOrWhiteSpace(_profile?.ProfilePictureUrl)
        ? UserProfileDto.DefaultPictureUrl
        : _profile!.ProfilePictureUrl;

    private string JoinedOn => _profile?.CreatedAtUtc.ToString("MMM yyyy") ?? string.Empty;

    private string DisplayOccupation
    {
        get
        {
            var occupation = _profile?.Occupation;
            if (occupation?.StartsWith("Student", StringComparison.Ordinal) == true &&
                !string.IsNullOrWhiteSpace(_profile?.OrganizationName))
            {
                return $"Student — {_profile.OrganizationName}";
            }

            return Or(occupation, "Occupation not set");
        }
    }
    private string PersonalOccupation => _profile?.Occupation?.StartsWith("Student", StringComparison.Ordinal) == true
        ? "Student"
        : DisplayOccupation;
    private bool NeedsOrganization =>
        _draft.Occupation?.StartsWith("Student", StringComparison.Ordinal) == true ||
        _draft.Occupation == "Job holder" ||
        !string.IsNullOrWhiteSpace(_draft.OrganizationName);
    private static bool IsStandardOccupation(string? occ) =>
        occ is "Student — High school" or "Student — College" or "Student — University" or "Unemployed" or "Job holder";
    private string OrganizationLabel => _draft.Occupation == "Job holder" ? "Workplace name" : "School, college or university name";
    private string OrganizationPlaceholder => _draft.Occupation == "Job holder" ? "Where do you work?" : "Where do you study?";
    // Which extra document the application needs, decided by the profile's occupation.
    private bool IsStudent => _profile?.Occupation?.StartsWith("Student", StringComparison.Ordinal) == true;
    private bool IsJobHolder => _profile?.Occupation == "Job holder";
    private string? SecondDocumentLabel => IsStudent ? "Student ID" : IsJobHolder ? "Employee ID" : null;
    private string SecondDocumentCopy => IsStudent
        ? "Because you are a student, your student ID is needed too."
        : IsJobHolder ? "Because you are a job holder, your employee ID is needed too." : string.Empty;
    private string SecondDocumentHint => IsStudent
        ? "Upload the front of your current school, college or university ID."
        : "Upload your employee ID or a workplace ID that shows your name.";

    private string DisplayAddress => Or(_profile?.Address, "Address not set");

    private string DisplayGender => _profile?.Gender switch
    {
        ProfileGender.Male => "Male",
        ProfileGender.Female => "Female",
        _ => "Not specified"
    };

    private string DisplayDateOfBirth => _profile?.DateOfBirth is { } dob
        ? $"{dob:dd MMM yyyy} ({CalculateAge(dob)} yrs)"
        : "Not set";

    private static int CalculateAge(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age)) age--;
        return age;
    }

    private string DisplaySmoker => _profile?.IsSmoker == true ? "Smoker" : "Non-smoker";

    private string DisplayDrinker => _profile?.IsDrinker == true ? "Drinker" : "Non-drinker";

    private string GenderSelection
    {
        get => _draft.Gender switch
        {
            ProfileGender.Male => "Male",
            ProfileGender.Female => "Female",
            _ => ""
        };
        set => _draft.Gender = value switch
        {
            "Male" => ProfileGender.Male,
            "Female" => ProfileGender.Female,
            _ => null
        };
    }

