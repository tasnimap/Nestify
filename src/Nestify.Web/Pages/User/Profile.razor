    private static async Task<string?> PreviewOf(IBrowserFile file)
    {
        try
        {
            var preview = await file.RequestImageFileAsync("image/jpeg", 320, 320);
            await using var stream = preview.OpenReadStream(MaxPictureBytes);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            return $"data:image/jpeg;base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch
        {
            // The submission endpoint gives the user a specific error if the
            // chosen file cannot be used. Keeping the picker available lets
            // them choose another image here.
            return null;
        }
    }

    private async Task GoToPayment()
    {
        if (string.IsNullOrWhiteSpace(_identityDocumentType) || _identityFile is null)
        {
            _verificationError = L["Choose your identity document and its photo to continue."];
            return;
        }

        if (SecondDocumentLabel is not null && _occupationFile is null)
        {
            _verificationError = L["Add a photo of your {0} to continue.", SecondDocumentLabel];
            return;
        }

        _verificationError = null;
        try
        {
            _verificationFee = await ProfileService.GetVerificationFeeAsync();

            // Read both files into memory NOW while the <InputFile> elements are
            // still mounted in the DOM. Once _verificationStep changes to Payment,
            // Blazor unmounts the InputFile elements and IBrowserFile references become invalid.
            await using (var ms = new MemoryStream())
            {
                await using var s = _identityFile.OpenReadStream(MaxPictureBytes);
                await s.CopyToAsync(ms);
                _identityBytes = ms.ToArray();
            }
            _identityContentType = _identityFile.ContentType;
            _identityName = _identityFile.Name;

            if (_occupationFile is not null)
            {
                await using (var ms = new MemoryStream())
                {
                    await using var s = _occupationFile.OpenReadStream(MaxPictureBytes);
                    await s.CopyToAsync(ms);
                    _occupationBytes = ms.ToArray();
                }
                _occupationContentType = _occupationFile.ContentType;
                _occupationName = _occupationFile.Name;
            }
            else
            {
                _occupationBytes = null;
                _occupationContentType = null;
                _occupationName = null;
            }
        }
        catch
        {
            _verificationError = L["Could not prepare the documents. Please choose the files again."].Value;
            return;
        }

        _verificationStep = VerificationStep.Payment;
    }

    private void BackToDocuments()
    {
        _verificationError = null;
