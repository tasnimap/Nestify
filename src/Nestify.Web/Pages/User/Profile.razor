    // The API does the Cloudinary upload and saves the link it returns.
    private async Task PickPicture(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _photoError = null;
        _uploading = true;

        try
        {
            using var stream = file.OpenReadStream(MaxPictureBytes);
            var updated = await ProfileService.UploadPictureAsync(stream, file.Name, file.ContentType);
            if (updated is not null)
            {
                _profile = updated;
            }
        }
        catch (Exception ex)
        {
            _photoError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

