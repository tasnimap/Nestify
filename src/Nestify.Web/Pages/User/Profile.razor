    private IReadOnlyList<Stat> Stats =>
    [
        new((_profile?.Activity.ActiveBookingCount ?? 0).ToString("N0", System.Globalization.CultureInfo.CurrentCulture), L["Active bookings"], BookingTrend),
        new((_profile?.Activity.CurrentMonthMeals ?? 0).ToString("0.#", System.Globalization.CultureInfo.CurrentCulture), L["Meals logged"], L["this month"]),
        new(Money.Format(_profile?.Activity.CurrentMonthSettlementPaid ?? 0), L["Settlement paid"], SettlementTrend),
        new((_profile?.Activity.ActiveMarketplaceInterestCount ?? 0).ToString("N0", System.Globalization.CultureInfo.CurrentCulture), L["Market interests"], InterestTrend)
    ];

    private string BookingTrend => _profile?.Activity.PendingBookingCount is > 0
        ? L["{0} pending", _profile.Activity.PendingBookingCount]
        : L["None pending"].Value;
    private string SettlementTrend => _profile?.Activity.HasCurrentSettlement == true ? L["this month"] : L["No active settlement"];
    private string InterestTrend => _profile?.Activity.PendingMarketplaceInterestCount is > 0
        ? L["{0} pending", _profile.Activity.PendingMarketplaceInterestCount]
        : L["None pending"].Value;

    // Only the links the user has actually filled in are shown.
    private List<Social> Socials
    {
        get
        {
            var links = new List<Social>();
            if (_profile is null)
            {
                return links;
            }

            links.Add(new Social("mail", L["Email"].Value, _profile.Email, $"mailto:{_profile.Email}", IconMail));

            if (!string.IsNullOrWhiteSpace(_profile.WhatsappNumber))
            {
                var digits = new string(_profile.WhatsappNumber.Where(char.IsDigit).ToArray());
                links.Add(new Social("wa", "WhatsApp", _profile.WhatsappNumber, $"https://wa.me/{digits}", IconWhatsApp));
            }

            if (!string.IsNullOrWhiteSpace(_profile.FacebookUrl))
            {
                links.Add(new Social("fb", "Facebook", Handle(_profile.FacebookUrl), _profile.FacebookUrl, IconFacebook));
            }

            if (!string.IsNullOrWhiteSpace(_profile.XUrl))
            {
                links.Add(new Social("x", "X", Handle(_profile.XUrl), _profile.XUrl, IconX));
            }

            if (!string.IsNullOrWhiteSpace(_profile.InstagramUrl))
            {
                links.Add(new Social("ig", "Instagram", Handle(_profile.InstagramUrl), _profile.InstagramUrl, IconInstagram));
            }

            return links;
        }
    }

    private IReadOnlyList<Bar> Monthly
    {
        get
        {
            var activity = _profile?.Activity;
            var daysElapsed = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
            daysElapsed = Math.Min(daysElapsed, DateTime.Today.Day);
            var hasSettlement = activity?.HasCurrentSettlement == true;
            var mealPercent = hasSettlement && daysElapsed > 0
                ? Math.Clamp((int)Math.Round(activity!.CurrentMonthMealDays * 100d / daysElapsed), 0, 100)
                : 0;
            var settlementPercent = hasSettlement && activity!.CurrentMonthSettlementDue > 0
                ? Math.Clamp((int)Math.Round(activity.CurrentMonthSettlementPaid * 100m / activity.CurrentMonthSettlementDue), 0, 100)
                : 0;

            return
            [
                new(L["Meal participation"], hasSettlement ? L["{0} / {1} days", activity!.CurrentMonthMealDays, daysElapsed] : L["No active settlement"], mealPercent),
                new(L["Settlement contribution"], hasSettlement ? $"{Money.Format(activity!.CurrentMonthSettlementPaid)} / {Money.Format(activity.CurrentMonthSettlementDue)}" : L["No active settlement"].Value, settlementPercent),
                new(L["Profile completeness"], $"{(activity?.CompletenessPercent ?? 0).ToString("N0", System.Globalization.CultureInfo.CurrentCulture)}%", activity?.CompletenessPercent ?? 0)
            ];
        }
    }

