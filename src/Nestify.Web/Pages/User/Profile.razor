@page "/profile"
@attribute [Authorize(Roles = "User")]
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Bachelor User Profile - Nestify</PageTitle>

@if (!_loading)
{
    <section class="nx-section profile-page">
        <div class="nx-container profile-wrap">
            <header class="profile-head">
                <div>
                    <p class="nx-eyebrow">My Profile</p>
                    <h1>Bachelor User Profile</h1>
                    <p class="profile-head__lead">
                        A verified bachelor account for students or job holders who need housing,
                        meal-cost sharing, helper hiring, and marketplace access.
                    </p>
                </div>
                <div class="profile-route-note">User account</div>
            </header>

            <div class="profile-hero">
                <div class="profile-identity">
                    <div class="profile-avatar">@DisplayInitials</div>
                    <div>
                        <p class="profile-kicker">User</p>
                        <h2>@DisplayName</h2>
                        <p>Mirpur, Dhaka</p>
                    </div>
                </div>
                <div class="profile-badges" aria-label="Status">
                    <span>Verified</span>
                    <span>Student</span>
                    <span>House member</span>
                </div>
            </div>

            <div class="profile-grid">
                <section class="profile-panel profile-panel--wide">
                    <h3>Identity</h3>
                    <div class="profile-fields">
                        <div class="profile-field"><span>Full name</span><strong>@DisplayName</strong></div>
                        <div class="profile-field"><span>Email</span><strong>@DisplayEmail</strong></div>
                        <div class="profile-field"><span>Date of birth</span><strong>2002-04-18</strong></div>
                        <div class="profile-field"><span>Gender</span><strong>Male</strong></div>
                        <div class="profile-field"><span>Occupation</span><strong>Student</strong></div>
                        <div class="profile-field"><span>Profile area</span><strong>Mirpur</strong></div>
                    </div>
                </section>

                <section class="profile-panel">
                    <h3>Contact</h3>
                    <div class="profile-contact">
                        <p><span>Phone</span><strong>@DisplayPhone</strong></p>
                        <p><span>WhatsApp</span><strong>@DisplayPhone</strong></p>
                        <p><span>Facebook</span><strong>rafi.hasan</strong></p>
                    </div>
                </section>

                <section class="profile-panel">
                    <h3>Permissions</h3>
                    <ul class="profile-list">
                        <li>Browse eligible housing posts</li>
                        <li>Create booking requests after verification</li>
                        <li>Join house expense and meal workflows</li>
                        <li>Post and manage marketplace listings</li>
                    </ul>
                </section>

                <section class="profile-panel profile-panel--wide">
                    <h3>Activity</h3>
                    <div class="profile-metrics">
                        <div class="profile-metric"><strong>2</strong><span>Active bookings</span></div>
                        <div class="profile-metric"><strong>1</strong><span>House membership</span></div>
                        <div class="profile-metric"><strong>18</strong><span>Meals this month</span></div>
                        <div class="profile-metric"><strong>3</strong><span>Marketplace interests</span></div>
                    </div>
                </section>

                <section class="profile-panel">
                    <h3>Plan Guardrails</h3>
                    <ul class="profile-list">
                        <li>Contact details are shown only after an approved disclosure transition.</li>
                        <li>The user cannot self-verify because profile update DTOs omit verification flags.</li>
                        <li>House roles come from house memberships, not global Identity roles.</li>
                    </ul>
                </section>
            </div>
        </div>
    </section>
}

@code {
    private bool _loading = true;
    private ClaimsPrincipal? _user;

    private string DisplayName => GetClaimValue(ClaimTypes.Name, "name") ?? "Rafi Hasan";
    private string DisplayEmail => GetClaimValue(ClaimTypes.Email, "email") ?? "rafi.hasan@example.com";
    private string DisplayPhone => GetClaimValue("phone_number", ClaimTypes.MobilePhone, ClaimTypes.HomePhone) ?? "+880 1711-000000";
    private string DisplayInitials => CreateInitials(DisplayName);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
        _loading = false;
    }

    private string? GetClaimValue(params string[] claimTypes) =>
        _user?.Claims.FirstOrDefault(c => claimTypes.Any(t => string.Equals(c.Type, t, StringComparison.OrdinalIgnoreCase)))?.Value;

    private static string CreateInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 0 ? "U" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
