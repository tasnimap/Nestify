    private static async Task<string?> PreviewOf(IBrowserFile file)
    {
        try
        {
            var preview = await file.RequestImageFileAsync("image/jpeg", 320, 320);
            await using var stream = preview.OpenReadStream(MaxPictureBytes);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            return $"data:image/jpeg;base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch
        {
            // The submission endpoint gives the user a specific error if the
            // chosen file cannot be used. Keeping the picker available lets
            // them choose another image here.
            return null;
        }
    }

    private async Task GoToPayment()
    {
        if (string.IsNullOrWhiteSpace(_identityDocumentType) || _identityFile is null)
        {
            _verificationError = "Choose your identity document and its photo to continue.";
            return;
        }

        if (SecondDocumentLabel is not null && _occupationFile is null)
        {
            _verificationError = $"Add a photo of your {SecondDocumentLabel} to continue.";
            return;
        }

        _verificationError = null;
        try
        {
            _verificationFee = await ProfileService.GetVerificationFeeAsync();

            // Read both files into memory NOW while the <InputFile> elements are
            // still mounted in the DOM. Once _verificationStep changes to Payment,
            // Blazor unmounts the InputFile elements and IBrowserFile references become invalid.
            await using (var ms = new MemoryStream())
            {
                await using var s = _identityFile.OpenReadStream(MaxPictureBytes);
                await s.CopyToAsync(ms);
                _identityBytes = ms.ToArray();
            }
            _identityContentType = _identityFile.ContentType;
            _identityName = _identityFile.Name;

            if (_occupationFile is not null)
            {
                await using (var ms = new MemoryStream())
                {
                    await using var s = _occupationFile.OpenReadStream(MaxPictureBytes);
                    await s.CopyToAsync(ms);
                    _occupationBytes = ms.ToArray();
                }
                _occupationContentType = _occupationFile.ContentType;
                _occupationName = _occupationFile.Name;
            }
            else
            {
                _occupationBytes = null;
                _occupationContentType = null;
                _occupationName = null;
            }
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            return;
        }

        _verificationStep = VerificationStep.Payment;
    }

    private void BackToDocuments()
    {
        _verificationError = null;
        _verificationStep = VerificationStep.Documents;
    }

    private static bool LooksLikeBangladeshiNumber(string number)
    {
        var digits = new string(number.Where(char.IsDigit).ToArray());
        if (digits.Length == 13 && digits.StartsWith("88")) digits = digits[2..];
        return digits.Length == 11 && digits.StartsWith("01") && digits[2] is >= '3' and <= '9';
    }

    // The payment is recorded first; the application is sent right after with
    // the payment id, so the receipt and the request stay linked.
    private async Task PayAndSubmit()
    {
        var number = _bkashNumber.Trim();
        if (!LooksLikeBangladeshiNumber(number))
        {
            _verificationError = "Enter a valid number like 01712345678.";
            return;
        }

        if (_bkashPin.Length is < 4 or > 5 || !_bkashPin.All(char.IsDigit))
        {
            _verificationError = "The bKash PIN must be 4 or 5 digits.";
            return;
        }

        _verificationError = null;
        _paying = true;
        try
        {
            _payment = await ProfileService.PayVerificationFeeAsync(number, _bkashPin);
            _bkashPin = string.Empty;
            _verificationStep = VerificationStep.Done;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            return;
        }
        finally
        {
            _paying = false;
        }

        await SendApplication();
    }

    private async Task SendApplication()
    {
        if (_payment is null || _identityBytes is null) return;

        _verificationError = null;
        _submittingVerification = true;
        try
        {
            using var identityStream = new MemoryStream(_identityBytes);
            using var occupationStream = _occupationBytes is not null ? new MemoryStream(_occupationBytes) : null;

            var updated = await ProfileService.SubmitVerificationAsync(
                _identityDocumentType,
                new VerificationUpload(identityStream, _identityName ?? "identity.jpg", _identityContentType ?? "image/jpeg"),
                occupationStream is null ? null : new VerificationUpload(occupationStream, _occupationName ?? "occupation.jpg", _occupationContentType ?? "image/jpeg"),
                _payment.PaymentId);
            if (updated is not null) _profile = updated;
            _applicationSent = true;
        }
        catch (Exception ex) { _verificationError = ex.Message; }
        finally { _submittingVerification = false; }
    }

    private async Task CancelVerification()
    {
        _cancellingVerification = true;
        try
        {
            var updated = await ProfileService.CancelVerificationAsync();
            if (updated is not null) _profile = updated;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
        }
        finally
        {
            _cancellingVerification = false;
        }
    }

