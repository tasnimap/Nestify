        _showPassword = true;
    }

    private void ClosePassword() => _showPassword = false;

    private void SavePassword()
    {
        _passwordDone = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordError = "Enter your current password.";
            return;
        }

        if (_newPassword.Length < 6)
        {
            _passwordError = "New password must be at least 6 characters.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordError = "New password and confirmation do not match.";
            return;
        }

        if (_newPassword == _currentPassword)
        {
            _passwordError = "New password must be different from the current one.";
            return;
        }

        _passwordError = null;
        _passwordDone = "Password updated.";
        _currentPassword = _newPassword = _confirmPassword = string.Empty;
    }

    private static string Or(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    // Shows the last part of a profile link, so "facebook.com/rafi.hasan" reads as "rafi.hasan".
    private static string Handle(string url) =>
        url.TrimEnd('/').Split('/').LastOrDefault() is { Length: > 0 } last ? last : url;

