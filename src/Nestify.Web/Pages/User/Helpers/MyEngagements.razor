@page "/engagements/mine"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>My Engagements — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner dh__inner--narrow">
        <header class="dh-head dh-rise">
            <p class="dh-kicker">Domestic Help</p>
            <h1>My engagements</h1>
            <p>Helpers your home has asked for, and every helper who worked at a home while you lived there. Anyone who took her service can review her.</p>
        </header>

        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar"></div>
                <div class="dh-skeleton__bar"></div>
            </div>
        }
        else if (_engagements.Count == 0)
        {
            <div class="dh-panel dh-rise" style="--d:80ms">
                <div class="dh-empty">
                    <span class="dh-empty__art" aria-hidden="true">
                        <svg class="nx-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </span>
                    <h3>No engagements yet</h3>
                    <p>Find a helper near you and pick the hours you need.</p>
                    <a class="nx-btn nx-btn--accent" href="helpers">Browse helpers</a>
                </div>
            </div>
        }
        else
        {
            <div class="dh-list">
                @{ var delay = 60; }
                @foreach (var e in _engagements)
                {
                    <article class="dh-panel dh-engagement dh-rise" style="--d:@(delay)ms" @key="e.Id">
                        <div class="dh-engagement__head">
                            <a href="helpers/@e.HelperId"><img class="dh-engagement__photo" src="@e.HelperPhotoUrl" alt="" /></a>
                            <div class="dh-engagement__who">
                                <strong><a href="helpers/@e.HelperId">@e.HelperName</a></strong>
                                <span>@string.Join(", ", e.Services.Select(ServiceTypes.Label)) · @Money.Format(e.MonthlyRate)/mo · @e.Slots.Count h/week</span>
                                <span>@e.HomeName · asked by @(e.IsRequester ? "you" : e.RequesterName)@StintLine(e)</span>
                            </div>
                            <span class="dh-status dh-status--@e.Status.ToString().ToLowerInvariant()">@StatusLabel(e)</span>
                        </div>

                        <div class="md-slots">
                            <ul class="md-slots__list">
                                @foreach (var day in AvailabilityGrid.Week)
                                {
                                    var picks = e.Slots.Where(s => s.DayOfWeek == (int)day).OrderBy(s => s.Hour).ToList();
                                    if (picks.Count == 0) continue;
                                    <li>
                                        <span class="md-slots__day">@day</span>
                                        @foreach (var s in picks)
                                        {
                                            <span class="md-slots__chip">@AvailabilityGrid.HourLabel(s.Hour)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>

                        @if (e.Status == EngagementStatus.Declined && !string.IsNullOrWhiteSpace(e.DeclineReason))
                        {
                            <p class="dh-note">@e.HelperName said: “@e.DeclineReason”</p>
                        }
                        @if (e.HelperPhone is not null)
                        {
                            <p class="dh-note">Phone: <a href="tel:@e.HelperPhone">@e.HelperPhone</a>@(e.StartDate is { } start ? $" · since {start:d MMM yyyy}" : "")</p>
                        }

                        <div class="dh-engagement__actions">
                            @if (e.Status == EngagementStatus.Requested)
                            {
                                <span class="dh-muted">Sent @e.RequestedAtUtc.ToLocalTime().ToString("d MMM"), waiting for her answer.</span>
                                @if (e.IsRequester)
                                {
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => Cancel(e)">Withdraw request</button>
                                }
                            }

                            @if (e.Status == EngagementStatus.Active && e.CanManage)
                            {
                                <button class="nx-btn nx-btn--ghost" style="color:var(--nx-danger);border-color:var(--nx-danger);" @onclick="() => PromptRelease(e)">
                                    Release helper
                                </button>
                                @if (e.ClientMarkedComplete)
                                {
                                    <p class="dh-note">You marked this complete — waiting for @e.HelperName to confirm.</p>
                                }
                                else if (e.HelperMarkedComplete)
                                {
                                    <p class="dh-note">@e.HelperName marked this complete. Confirm to close it.</p>
                                    <button class="nx-btn nx-btn--accent" @onclick="() => MarkComplete(e)">Confirm complete</button>
                                }
                                else
                                {
                                    <button class="nx-btn nx-btn--ghost" @onclick="() => MarkComplete(e)">Mark complete</button>
                                }
                            }

                            @if (e.CanReview)
                            {
                                <button class="nx-btn nx-btn--accent" @onclick="() => OpenReview(e)">Leave a review</button>
                            }
                            else if (e.HasReview)
                            {
                                <span class="dh-muted">You reviewed this engagement.</span>
                            }
                        </div>
                    </article>
                    delay += 60;
                }
            </div>
        }

        @if (_reviewTarget is not null)
        {
            <section class="dh-panel dh-review-box dh-rise">
                <div class="dh-panel__head"><h2>Review @_reviewTarget.HelperName</h2></div>
                <p class="dh-muted">You lived at @_reviewTarget.HomeName while she worked there, so you can rate her service. It goes on her public profile.</p>
                <RatingStars Value="_reviewRating" ReadOnly="false" ShowCount="false" ValueChanged="v => _reviewRating = v" />
                <textarea @bind="_reviewComment" maxlength="1000" placeholder="How was your experience?"></textarea>
                @if (_reviewError is not null)
                {
                    <p class="md-msg md-msg--bad">@_reviewError</p>
                }
                <div class="dh-engagement__actions">
                    <button class="nx-btn nx-btn--accent" disabled="@_busy" @onclick="SubmitReview">Submit review</button>
                    <button class="nx-btn nx-btn--ghost" @onclick="() => _reviewTarget = null">Cancel</button>
                </div>
            </section>
        }

        @if (_releaseTarget is not null)
        {
            <div class="md-overlay" @onclick="() => _releaseTarget = null">
                <div class="md-modal md-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                    <header class="md-modal__head">
                        <h2>Release @_releaseTarget.HelperName?</h2>
                        <button type="button" class="md-modal__close" @onclick="() => _releaseTarget = null" aria-label="Close">&times;</button>
                    </header>
                    <div class="md-modal__body">
                        <p>Are you sure you want to release <strong>@_releaseTarget.HelperName</strong> from <strong>@_releaseTarget.HomeName</strong>?</p>
                        <p class="dh-muted">This will end her engagement immediately, free up her weekly hours for other homes, and allow home members to leave a review.</p>
                    </div>
                    <footer class="md-modal__foot">
                        <button type="button" class="nx-btn nx-btn--ghost" @onclick="() => _releaseTarget = null" disabled="@_busy">Cancel</button>
                        <button type="button" class="nx-btn nx-btn--accent" style="background:#dc2626;border-color:#dc2626;" @onclick="ConfirmRelease" disabled="@_busy">
                            @(_busy ? "Releasing…" : "Release helper")
                        </button>
                    </footer>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<EngagementDto> _engagements = new();
    private bool _loading = true;
    private bool _busy;

    private EngagementDto? _releaseTarget;
    private EngagementDto? _reviewTarget;
    private int _reviewRating = 5;
    private string _reviewComment = string.Empty;
    private string? _reviewError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _engagements = await Helpers.GetMyEngagementsAsync();
        _loading = false;
    }

    private static string StintLine(EngagementDto e) =>
        e.JoinedOn is not { } joined ? string.Empty
        : e.LeftOn is { } left ? $" · worked there {joined:d MMM yyyy} – {left:d MMM yyyy}"
        : $" · with the home since {joined:d MMM yyyy}";

    private static string StatusLabel(EngagementDto e) => e.Status switch
    {
        EngagementStatus.Requested => "Waiting",
        EngagementStatus.Active => "Working for you",
        EngagementStatus.Completed => "Completed",
        EngagementStatus.Declined => "Declined",
        EngagementStatus.Cancelled => "Withdrawn",
        _ => e.Status.ToString()
    };

    private async Task Cancel(EngagementDto e)
    {
        await Run(() => Helpers.CancelRequestAsync(e.Id), "Request withdrawn.");
    }

    private async Task MarkComplete(EngagementDto e)
    {
        await Run(() => Helpers.MarkCompleteAsync(e.Id), "Marked complete.");
    }

    private void PromptRelease(EngagementDto e) => _releaseTarget = e;

    private async Task ConfirmRelease()
    {
        if (_releaseTarget is null) return;
        var helperName = _releaseTarget.HelperName;
        var id = _releaseTarget.Id;
        _releaseTarget = null;
        await Run(() => Helpers.ReleaseEngagementAsync(id), $"{helperName} has been released.");
    }

    private async Task Run(Func<Task> action, string done)
    {
        _busy = true;
        try
        {
            await action();
            Toast.ShowInfo(done, "Engagements");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowWarning(ex.Message, "Engagements");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenReview(EngagementDto e)
    {
        _reviewTarget = e;
        _reviewRating = 5;
        _reviewComment = string.Empty;
        _reviewError = null;
    }

    private async Task SubmitReview()
    {
        if (_reviewTarget is null) return;
        if (string.IsNullOrWhiteSpace(_reviewComment))
        {
            _reviewError = "Write a line or two about how it went.";
            return;
        }

        _busy = true;
        try
        {
            await Helpers.SubmitReviewAsync(_reviewTarget.Id, _reviewRating, _reviewComment);
            Toast.ShowSuccess("Review posted on her profile.", "Thanks!");
            _reviewTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
