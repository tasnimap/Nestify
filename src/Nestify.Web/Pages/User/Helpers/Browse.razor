@using Nestify.Web.Components.Helper
@page "/helpers"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Area
@using Nestify.Shared.Dtos.Helpers
@inject IHelperService Helpers

<PageTitle>Domestic Help — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner">
        <header class="dh-banner dh-rise">
            <div>
                <p class="dh-kicker">M2 · Domestic Help</p>
                <h1>Trusted khala &amp; bua, <span class="nx-display-accent">near where you already live.</span></h1>
                <p class="dh-banner__lead">
                    Browse helpers registered on Nestify, rated by real engagements. Exact location is shown
                    only after a helper confirms your request.
                </p>
            </div>
            <div class="dh-banner__actions">
                <a class="nx-btn nx-btn--ghost" href="engagements/mine">My engagements</a>
            </div>
        </header>

        <div class="dh-browse">
            <details class="dh-lens dh-rise" style="--d:80ms" open aria-label="Filter helpers">
                <summary class="dh-lens__summary">Filters</summary>

                <div class="dh-lens__body">
                    <div class="dh-lens__row">
                        <span class="dh-field__label">Area</span>
                        <AreaCascade Selection="_areaSelection" SelectionChanged="OnAreaChanged" Filter="true" />
                    </div>

                    <div class="dh-lens__row">
                        <span class="dh-field__label">Service</span>
                        <div class="dh-chips">
                            <button type="button" class="dh-chip @(_filter.ServiceType is null ? "dh-chip--on" : null)"
                                    @onclick="() => SetServiceType(null)">Any</button>
                            @foreach (var s in _serviceTypes)
                            {
                                <button type="button" class="dh-chip @(_filter.ServiceType == s ? "dh-chip--on" : null)"
                                        @onclick="() => SetServiceType(s)">@s</button>
                            }
                        </div>
                    </div>

                    <div class="dh-lens__row">
                        <label class="dh-field__label" for="hp-max-rate">Max rate (৳/mo)</label>
                        <input id="hp-max-rate" type="number" min="0" step="500" placeholder="No limit" inputmode="numeric"
                               value="@_filter.MaxMonthlyRate" @onchange="OnMaxRate" />
                    </div>

                    <div class="dh-lens__row">
                        <label class="dh-field__label" for="hp-sort">Sort</label>
                        <select id="hp-sort" value="@_filter.Sort" @onchange="OnSortChanged">
                            <option value="@HelperSortOption.RatingDesc">Rating</option>
                            <option value="@HelperSortOption.RateAsc">Rate: Low to High</option>
                            <option value="@HelperSortOption.RateDesc">Rate: High to Low</option>
                            <option value="@HelperSortOption.DistanceAsc">Nearest</option>
                        </select>
                    </div>

                    @if (HasActiveFilters)
                    {
                        <button type="button" class="dh-lens__clear" @onclick="ClearFilters">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M6 18 18 6" /></svg>
                            Clear all filters
                        </button>
                    }
                </div>
            </details>

            <div class="dh-results">
                <p class="dh-results__bar">
                    @if (_loading)
                    {
                        <span>Loading helpers…</span>
                    }
                    else if (_page is not null)
                    {
                        <span><strong>@_page.TotalCount</strong> @(_page.TotalCount == 1 ? "helper" : "helpers")</span>
                    }
                </p>

                @if (_loading)
                {
                    <div class="dh-cards">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="dh-skeleton__bar"></div>
                        }
                    </div>
                }
                else if (_error)
                {
                    <div class="dh-panel">
                        <div class="dh-empty">
                            <span class="dh-empty__art" aria-hidden="true">
                                <svg class="nx-icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01" /><circle cx="12" cy="12" r="9" /></svg>
                            </span>
                            <h3>Couldn't load helpers</h3>
                            <p>Something went wrong. Try again in a moment.</p>
                            <button class="nx-btn nx-btn--accent" @onclick="LoadAsync">Retry</button>
                        </div>
                    </div>
                }
                else if (_page is null || _page.Items.Count == 0)
                {
                    <div class="dh-panel">
                        <div class="dh-empty">
                            <span class="dh-empty__art" aria-hidden="true">
                                <svg class="nx-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                            </span>
                            <h3>No helpers match those filters</h3>
                            <p>Try a different area, service, or widen the rate range.</p>
                            @if (HasActiveFilters)
                            {
                                <button class="nx-btn nx-btn--ghost" @onclick="ClearFilters">Clear filters</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="dh-cards">
                        @{ var delay = 0; }
                        @foreach (var helper in _page.Items)
                        {
                            <HelperCard Helper="helper" Delay="delay" />
                            delay += 50;
                        }
                    </div>

                    @if (_page.TotalPages > 1)
                    {
                        <nav class="dh-pager" aria-label="Pagination">
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasPrevious)" @onclick="PrevPage">Previous</button>
                            <span>Page @_page.Page of @_page.TotalPages</span>
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasNext)" @onclick="NextPage">Next</button>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ServiceType[] _serviceTypes = Enum.GetValues<ServiceType>();

    private AreaSelectionDto _areaSelection = new();
    private HelperFilterDto _filter = new();
    private HelperPageDto<HelperSummaryDto>? _page;
    private bool _loading = true;
    private bool _error;

    private bool HasActiveFilters =>
        _filter.ServiceType is not null || _filter.MaxMonthlyRate is not null ||
        _filter.DivisionId is not null || _filter.DistrictId is not null || _filter.UpazilaId is not null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            _page = await Helpers.BrowseAsync(_filter);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyAsync()
    {
        _filter.Page = 1;
        return LoadAsync();
    }

    private Task OnAreaChanged(AreaSelectionDto selection)
    {
        _filter.DivisionId = selection.DivisionId;
        _filter.DistrictId = selection.DistrictId;
        _filter.UpazilaId = selection.UpazilaId;
        return ApplyAsync();
    }

    private Task SetServiceType(ServiceType? t)
    {
        _filter.ServiceType = t;
        return ApplyAsync();
    }

    private Task OnMaxRate(ChangeEventArgs e)
    {
        _filter.MaxMonthlyRate = decimal.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
        return ApplyAsync();
    }

    private Task OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<HelperSortOption>(e.Value?.ToString(), out var sort))
        {
            _filter.Sort = sort;
        }
        return ApplyAsync();
    }

    private Task ClearFilters()
    {
        _areaSelection = new AreaSelectionDto();
        _filter = new HelperFilterDto();
        return LoadAsync();
    }

    private Task PrevPage()
    {
        if (_page?.HasPrevious == true) { _filter.Page--; return LoadAsync(); }
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        if (_page?.HasNext == true) { _filter.Page++; return LoadAsync(); }
        return Task.CompletedTask;
    }
}
