@page "/helpers/{Id:long}"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>@(_helper?.Name ?? "Helper") — Nestify</PageTitle>

<div class="dh">
    <div class="dh__inner">
        <nav class="dh-crumbs" aria-label="Breadcrumb">
            <a href="helpers">Domestic Help</a>
            <span class="dh-crumbs__sep">/</span>
            <span>@(_helper?.Name ?? "Profile")</span>
        </nav>

        @if (_loading)
        {
            <div class="dh-skeleton">
                <div class="dh-skeleton__bar dh-skeleton__bar--tall"></div>
                <div class="dh-skeleton__bar"></div>
            </div>
        }
        else if (_helper is null)
        {
            <div class="dh-panel dh-rise">
                <div class="dh-empty">
                    <span class="dh-empty__art" aria-hidden="true">
                        <svg class="nx-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
                    </span>
                    <h2>This profile is not available</h2>
                    <p>It may have been removed, or the link may be out of date.</p>
                    <a class="nx-btn nx-btn--accent" href="helpers">Back to Domestic Help</a>
                </div>
            </div>
        }
        else
        {
            <article class="dh-detail dh-detail--split">
                <header class="dh-profile dh-rise">
                    <div class="dh-profile__glow" aria-hidden="true"></div>
                    <img class="dh-portrait" src="@_helper.PhotoUrl" alt="Photo of @_helper.Name" />
                    <div class="dh-profile__body">
                        <h1>
                            @_helper.Name
                            @if (_helper.IsVerified)
                            {
                                <span class="dh-verified" title="Verified by Nestify">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                                    Verified
                                </span>
                            }
                        </h1>
                        @if (!string.IsNullOrWhiteSpace(_helper.Headline))
                        {
                            <p class="dh-profile__headline">@_helper.Headline</p>
                        }
                        <div class="dh-profile__meta">
                            <RatingStars Value="_helper.RatingAverage" Count="_helper.RatingCount" />
                            <span class="dh-profile__dot" aria-hidden="true"></span>
                            <span class="dh-profile__where">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                                @_helper.AreaName@(string.IsNullOrWhiteSpace(_helper.DistrictName) ? "" : $", {_helper.DistrictName}")
                            </span>
                        </div>
                        <div class="dh-tags">
                            @foreach (var s in _helper.Services)
                            {
                                <span class="dh-tag">@ServiceTypes.Label(s)</span>
                            }
                        </div>
                    </div>
                </header>

                <div class="dh-detail__main">
                    <section class="dh-panel dh-rise" style="--d:120ms">
                        <div class="dh-panel__head"><h2>About @FirstName</h2></div>
                        <p class="dh-bio">@(string.IsNullOrWhiteSpace(_helper.Bio) ? $"{FirstName} has not written a bio yet." : _helper.Bio)</p>
                        <div class="dh-facts">
                            <div class="dh-fact"><span>Experience</span><strong>@_helper.ExperienceYears year(s)</strong></div>
                            <div class="dh-fact"><span>Languages</span><strong>@_helper.Languages</strong></div>
                            <div class="dh-fact"><span>On Nestify since</span><strong>@_helper.MemberSinceUtc.ToLocalTime().ToString("MMM yyyy")</strong></div>
                        </div>
                    </section>

                    <section class="dh-panel dh-rise" style="--d:160ms">
                        <div class="dh-panel__head">
                            <h2>Weekly hours</h2>
                            @if (_slots.Count > 0)
                            {
                                <span class="dh-count">@_slots.Count picked</span>
                            }
                        </div>
                        <AvailabilityGrid Slots="_helper.Availability" Selectable="@(!_helper.IsMine && !_helper.IsWorkingForMyHome && _helper.IsAcceptingBookings)"
                                          Selection="_slots" SelectionChanged="OnSlotsChanged" />
                    </section>

                    <section class="dh-panel dh-rise" style="--d:220ms">
                        <div class="dh-panel__head">
                            <h2>Reviews</h2>
                            @if (_reviews is not null && _reviews.TotalCount > 0)
                            {
                                <span class="dh-count">@_reviews.TotalCount</span>
                            }
                        </div>
                        @if (_reviews is null || _reviews.Items.Count == 0)
                        {
                            <p class="dh-muted">No reviews yet. Only bachelors who lived in a home while @FirstName worked there can leave one.</p>
                        }
                        else
                        {
                            <div class="dh-list">
                                @foreach (var r in _reviews.Items)
                                {
                                    <div class="dh-review">
                                        <div class="dh-review__head">
                                            <strong>@r.ReviewerName</strong>
                                            <RatingStars Value="r.Rating" ShowCount="false" />
                                        </div>
                                        <p class="dh-muted">@string.Join(", ", r.Services) · @r.HomeName · @r.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</p>
                                        <p>@r.Comment</p>
                                        @if (!string.IsNullOrWhiteSpace(r.Reply))
                                        {
                                            <p class="dh-review__reply"><strong>@FirstName replied:</strong> @r.Reply</p>
                                        }
                                    </div>
                                }
                            </div>
                            @if (_reviews.HasNext)
                            {
                                <button class="nx-btn nx-btn--ghost" @onclick="MoreReviews">Show more reviews</button>
                            }
                        }
                    </section>
                </div>

                <aside class="dh-book dh-rise" style="--d:100ms" aria-label="Booking">
                    <p class="dh-book__price">
                        @Money.Format(_helper.MonthlyRate)<span>/month</span>
                    </p>

                    <dl class="dh-book__facts">
                        <div>
                            <dt>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                Open hours
                            </dt>
                            <dd>@_helper.Availability.Count(s => s.IsOpen && !s.IsBooked) free a week</dd>
                        </div>
                        <div>
                            <dt>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                                Area
                            </dt>
                            <dd>@_helper.AreaName</dd>
                        </div>
                        <div>
                            <dt>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 14.5 9h6l-5 4 2 6-5.5-4-5.5 4 2-6-5-4h6Z" /></svg>
                                Rating
                            </dt>
                            <dd>@_helper.RatingAverage.ToString("0.0") · @_helper.RatingCount review(s)</dd>
                        </div>
                    </dl>

                    @if (_helper.IsWorkingForMyHome)
                    {
                        <div class="dh-book__picks">
                            <p class="dh-book__hint dh-book__hint--on" style="background:rgba(34,197,94,0.1);color:#16a34a;border:1px solid rgba(34,197,94,0.25);border-radius:12px;padding:.75rem;">
                                <strong>@FirstName is currently working for your home.</strong>
                            </p>
                        </div>

                        @if (_helper.CanManageEngagement)
                        {
                            <button class="nx-btn nx-btn--block" style="background:#dc2626;color:#fff;border-color:#dc2626;font-weight:600;" @onclick="OpenReleaseModal">
                                Release @FirstName
                            </button>
                        }

                        <p class="dh-book__note"><a href="engagements/mine" style="text-decoration:underline;">View in My engagements &rarr;</a></p>
                    }
                    else
                    {
                        <div class="dh-book__picks">
                            @if (!_helper.IsAcceptingBookings)
                            {
                                <p class="dh-book__hint">@FirstName is not taking new bookings right now.</p>
                            }
                            else if (_slots.Count == 0)
                            {
                                <p class="dh-book__hint">Pick the hours you need each week on the board — up to 3 a day.</p>
                            }
                            else
                            {
                                <p class="dh-book__hint dh-book__hint--on">
                                    <strong>@_slots.Count</strong> @(_slots.Count == 1 ? "hour" : "hours") a week across
                                    @_slots.Select(s => s.DayOfWeek).Distinct().Count() day(s)
                                </p>
                            }
                        </div>

                        <button class="nx-btn nx-btn--accent nx-btn--block" disabled="@(_helper.IsMine || !_helper.IsAcceptingBookings || _slots.Count == 0)" @onclick="OpenRequest">
                            @(_slots.Count == 0 ? "Request engagement" : $"Request {_slots.Count} {(_slots.Count == 1 ? "hour" : "hours")} a week")
                        </button>

                        <p class="dh-book__note">@FirstName's phone number is shared only after she accepts.</p>
                    }
                </aside>
            </article>
        }
    </div>
</div>

@if (_showRequest && _helper is not null)
{
    <div class="md-overlay" @onclick="CloseRequest">
        <div class="md-modal md-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="md-modal__head">
                <h2>Request @FirstName</h2>
                <button type="button" class="md-modal__close" @onclick="CloseRequest" aria-label="Close">&times;</button>
            </header>
            <div class="md-modal__body md-modal__body--stack">
                <p class="dh-muted">@_slots.Count hour(s) a week at @Money.Format(_helper.MonthlyRate)/month, booked for your home. Only a home's manager or co-manager can send this; she sees your name, the home's area and this note.</p>

                <div class="md-field">
                    <span class="md-field__label">What do you need?</span>
                    <div class="dh-chips">
                        @foreach (var s in _helper.Services)
                        {
                            var t = s;
                            var on = _request.Services.Contains(t);
                            <button type="button" class="dh-chip @(on ? "dh-chip--on" : null)" aria-pressed="@on.ToString().ToLowerInvariant()" @onclick="() => ToggleService(t)">
                                @ServiceTypes.Label(t)
                            </button>
                        }
                    </div>
                </div>

                <div class="md-field">
                    <label for="req-message">A note for @FirstName</label>
                    <textarea id="req-message" rows="4" maxlength="1000" @bind="_request.Message" placeholder="How many of you live there, what you eat, anything she should know."></textarea>
                </div>

                <div class="md-slots">
                    <span class="md-slots__label">Weekly hours · @_slots.Count</span>
                    <ul class="md-slots__list">
                        @foreach (var day in AvailabilityGrid.Week)
                        {
                            var picks = _slots.Where(s => s.DayOfWeek == (int)day).OrderBy(s => s.Hour).ToList();
                            if (picks.Count == 0) continue;
                            <li>
                                <span class="md-slots__day">@day</span>
                                @foreach (var s in picks)
                                {
                                    <span class="md-slots__chip">@AvailabilityGrid.HourLabel(s.Hour)</span>
                                }
                            </li>
                        }
                    </ul>
                </div>

                @if (_requestError is not null)
                {
                    <p class="md-msg md-msg--bad">@_requestError</p>
                }
            </div>
            <footer class="md-modal__foot">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseRequest" disabled="@_requesting">Cancel</button>
                <button type="button" class="nx-btn nx-btn--accent" @onclick="SendRequest" disabled="@_requesting">@(_requesting ? "Sending…" : "Send request")</button>
            </footer>
        </div>
    </div>
}

@if (_showRelease && _helper is not null && _helper.ActiveEngagementId is not null)
{
    <div class="md-overlay" @onclick="CloseReleaseModal">
        <div class="md-modal md-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="md-modal__head">
                <h2>Release @FirstName?</h2>
                <button type="button" class="md-modal__close" @onclick="CloseReleaseModal" aria-label="Close">&times;</button>
            </header>
            <div class="md-modal__body md-modal__body--stack">
                <p>Are you sure you want to release <strong>@FirstName</strong> from your home?</p>
                <p class="dh-muted">This will end her engagement immediately, free up her weekly hours for other homes, and allow home members to leave a review.</p>
                @if (_releaseError is not null)
                {
                    <p class="md-msg md-msg--bad">@_releaseError</p>
                }
            </div>
            <footer class="md-modal__foot">
                <button type="button" class="nx-btn nx-btn--ghost" @onclick="CloseReleaseModal" disabled="@_releasing">Cancel</button>
                <button type="button" class="nx-btn nx-btn--accent" style="background:#dc2626;border-color:#dc2626;" @onclick="ConfirmReleaseAsync" disabled="@_releasing">
                    @(_releasing ? "Releasing…" : "Release helper")
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private HelperDetailDto? _helper;
    private HelperPageDto<ReviewDto>? _reviews;
    private List<EngagementSlotDto> _slots = new();
    private bool _loading = true;

    private bool _showRequest;
    private bool _requesting;
    private string? _requestError;
    private EngagementRequestDto _request = new();

    private bool _showRelease;
    private bool _releasing;
    private string? _releaseError;

    private string FirstName =>
        _helper?.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "the helper";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _slots = new List<EngagementSlotDto>();
        try
        {
            _helper = await Helpers.GetHelperAsync(Id.ToString());
            if (_helper is not null)
            {
                try
                {
                    _reviews = await Helpers.GetReviewsAsync(Id.ToString());
                }
                catch
                {
                    _reviews = new HelperPageDto<ReviewDto>();
                }
            }
        }
        catch
        {
            _helper = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task MoreReviews()
    {
        if (_reviews is null) return;
        var next = await Helpers.GetReviewsAsync(Id.ToString(), _reviews.Page + 1);
        next.Items = _reviews.Items.Concat(next.Items).ToList();
        _reviews = next;
    }

    private void OnSlotsChanged(List<EngagementSlotDto> slots) => _slots = slots;

    private void OpenRequest()
    {
        if (_helper is null) return;
        _request = new EngagementRequestDto { Services = _helper.Services.Take(1).ToList() };
        _requestError = null;
        _showRequest = true;
    }

    private void CloseRequest()
    {
        if (_requesting) return;
        _showRequest = false;
    }

    private void ToggleService(ServiceType type)
    {
        if (!_request.Services.Remove(type)) _request.Services.Add(type);
    }

    private async Task SendRequest()
    {
        if (_request.Services.Count == 0)
        {
            _requestError = "Pick at least one service.";
            return;
        }

        _request.Slots = _slots.ToList();
        _requestError = null;
        _requesting = true;
        try
        {
            await Helpers.RequestEngagementAsync(Id.ToString(), _request);
            _showRequest = false;
            Toast.ShowSuccess($"Your request was sent to {FirstName}. You will see her answer under My engagements.", "Requested");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _requestError = ex.Message;
        }
        finally
        {
            _requesting = false;
        }
    }

    private void OpenReleaseModal()
    {
        _releaseError = null;
        _showRelease = true;
    }

    private void CloseReleaseModal()
    {
        if (_releasing) return;
        _showRelease = false;
    }

    private async Task ConfirmReleaseAsync()
    {
        if (_helper?.ActiveEngagementId is null) return;
        _releasing = true;
        _releaseError = null;
        try
        {
            await Helpers.ReleaseEngagementAsync(_helper.ActiveEngagementId);
            _showRelease = false;
            Toast.ShowSuccess($"{FirstName} has been released from your home.", "Released");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _releaseError = ex.Message;
        }
        finally
        {
            _releasing = false;
        }
    }
}
