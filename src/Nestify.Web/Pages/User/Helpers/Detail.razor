@page "/helpers/{Id}"
@attribute [Authorize(Roles = "User")]
@using Nestify.Shared.Dtos.Helpers
@using Nestify.Web.Components
@using Nestify.Web.Components.Helper
@inject IHelperService Helpers
@inject Nestify.Web.Services.ToastService Toast
@inject Nestify.Web.Services.MoneyFormatterService Money

<PageTitle>@(_helper?.Name ?? "Helper") — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap hs-wrap--narrow">
        <nav class="hs-crumbs" aria-label="Breadcrumb">
            <a href="helpers">Domestic Help</a>
            <span class="hs-crumbs__sep">/</span>
            <span>@(_helper?.Name ?? "Profile")</span>
        </nav>

        @if (_loading)
        {
            <div class="hs-skeleton hs-skeleton--detail"></div>
        }
        else if (_helper is null)
        {
            <div class="hs-empty hs-empty--page">
                <h2>This profile is not available</h2>
                <p>It may have been removed, or the link may be out of date.</p>
                <a class="nx-btn nx-btn--primary" href="helpers">Back to Domestic Help</a>
            </div>
        }
        else
        {
            <article class="hs-detail">
                <header class="hs-detail__head">
                    <div class="hs-detail__badges">
                        @foreach (var s in _helper.Services)
                        {
                            <span class="hs-chip hs-chip--type">@s</span>
                        }
                    </div>
                    <div class="hs-detail__person">
                        <img class="hs-ava hs-ava--lg" src="@HelperView.PhotoUrl(_helper.Name)"
                             alt="Photo of @_helper.Name" />
                        <div>
                            <h1>@_helper.Name</h1>
                            <div class="hs-detail__meta">
                                <RatingStars Value="_helper.RatingAverage" Count="_helper.RatingCount" />
                                <span class="hs-dot"></span>
                                <span>@_helper.AreaName@(_helper.Distance is not null ? $" · {DistanceLabel(_helper.Distance.Value)}" : "")</span>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="hs-detail__stats">
                    <div class="hs-stat">
                        <span class="hs-stat__value">@Money.Format(_helper.MonthlyRate)</span>
                        <span class="hs-stat__label">per month</span>
                    </div>
                    <div class="hs-stat">
                        <span class="hs-stat__value">@_helper.AvailabilityWindow</span>
                        <span class="hs-stat__label">availability</span>
                    </div>
                </div>

                <div class="hs-detail__actions">
                    <button class="nx-btn nx-btn--primary" disabled="@_helper.IsMine" @onclick="HandleRequest">
                        Request engagement
                    </button>
                    <button class="nx-btn nx-btn--ghost" @onclick="HandleReport">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 9v4M12 17h.01M10.3 3.9 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                        </svg>
                        Report
                    </button>
                </div>

                <section class="hs-detail__section">
                    <h2>Reviews</h2>
                    @if (_reviews is null || _reviews.Items.Count == 0)
                    {
                        <p>No reviews yet.</p>
                    }
                    else
                    {
                        @foreach (var r in _reviews.Items)
                        {
                            <div class="hs-review">
                                <div class="hs-review__head">
                                    <strong>@r.ReviewerName</strong>
                                    <RatingStars Value="r.Rating" ShowCount="false" />
                                </div>
                                <p>@r.Comment</p>
                            </div>
                        }
                    }
                </section>
            </article>
        }
    </div>
</section>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private HelperDetailDto? _helper;
    private HelperPageDto<ReviewDto>? _reviews;
    private bool _loading = true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _helper = await Helpers.GetHelperAsync(Id);
        if (_helper is not null)
        {
            _reviews = await Helpers.GetReviewsAsync(Id);
        }
        _loading = false;
    }

    private async Task HandleRequest()
    {
        await Helpers.RequestEngagementAsync(Id);
        Toast.ShowInfo("Engagement request sent.", "Requested");
    }

    private void HandleReport()
    {
        Toast.ShowInfo("Reporting will be wired up once the shared ReportDialog lands.", "Coming soon");
    }

    private static string DistanceLabel(DistanceBand band) => band switch
    {
        DistanceBand.Within1Km => "within 1 km",
        DistanceBand.Within2Km => "within 2 km",
        DistanceBand.Within5Km => "within 5 km",
        _ => "over 5 km"
    };
}