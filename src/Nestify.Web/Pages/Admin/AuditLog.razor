@page "/admin/audit"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService Admin

<PageTitle>Audit log — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Accountability</p>
        <h1>Audit log</h1>
        <p>Every decision an admin makes lands here with a name and a timestamp. Nothing in this list can be edited or deleted.</p>
    </div>
    <div class="adm-head__actions">
        <span class="adm-badge adm-badge--info">@_entries.Count entries</span>
    </div>
</header>

<div class="adm-toolbar adm-rise" style="--d:.08s">
    <div class="adm-tabs">
        <button class="adm-tab @(_admin is null ? "adm-tab--on" : null)" type="button" @onclick="() => _admin = null">
            All admins
        </button>
        @foreach (var name in _entries.Select(a => a.Admin).Distinct())
        {
            var current = name;
            <button class="adm-tab @(_admin == current ? "adm-tab--on" : null)" type="button" @onclick="() => _admin = current">
                @current
            </button>
        }
    </div>
    <label class="adm-search adm-toolbar__grow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="Search action, target or note" @bind="_query" @bind:event="oninput" />
    </label>
</div>

@if (_loading)
{
    <EmptyState Title="Loading" Message="Fetching the log." />
}
else if (Filtered.Count == 0)
{
    <EmptyState Title="No entries" Message="Nothing matches this filter yet." />
}
else
{
    <div class="adm-grid adm-grid--2">
        <section class="adm-card adm-rise">
            <div class="adm-card__head">
                <div>
                    <h2>Timeline</h2>
                    <p>Newest first.</p>
                </div>
            </div>
            <div class="adm-timeline">
                @foreach (var entry in Filtered.Take(14))
                {
                    <div class="adm-tl">
                        <div class="adm-tl__rail">
                            <span class="adm-tl__dot @DotClass(entry.Kind)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                            </span>
                        </div>
                        <div class="adm-tl__body">
                            <p class="adm-tl__title">@entry.Action — @entry.Target</p>
                            <p class="adm-tl__meta">@entry.Admin · @AdminConsoleService.Ago(entry.AtUtc)</p>
                            @if (entry.Note is not null)
                            {
                                <p class="adm-row__note">@entry.Note</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="adm-card adm-rise" style="--d:.1s">
            <div class="adm-card__head">
                <div>
                    <h2>Full record</h2>
                    <p>Every entry, exactly as stored.</p>
                </div>
            </div>
            <div class="adm-table__scroll">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Admin</th>
                            <th>Action</th>
                            <th>Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Filtered)
                        {
                            var at = entry.AtUtc.ToLocalTime();
                            <tr>
                                <td>
                                    <div>@at.ToString("d MMM")</div>
                                    <div class="adm-table__sub">@at.ToString("h:mm tt")</div>
                                </td>
                                <td>@entry.Admin</td>
                                <td>
                                    <span class="adm-badge @BadgeClass(entry.Kind)">@entry.Action</span>
                                </td>
                                <td>
                                    <div class="adm-table__strong">@entry.Target</div>
                                    @if (entry.Note is not null)
                                    {
                                        <div class="adm-table__sub">@entry.Note</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private List<AdminAuditEntryDto> _entries = new();
    private bool _loading = true;
    private string? _admin;
    private string _query = "";

    protected override async Task OnInitializedAsync()
    {
        _entries = await Admin.GetAuditAsync(1000);
        _loading = false;
    }

    private List<AdminAuditEntryDto> Filtered =>
        _entries
            .Where(a => _admin is null || a.Admin == _admin)
            .Where(a => string.IsNullOrWhiteSpace(_query) ||
                        (a.Action + a.Target + a.Note).Contains(_query, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private static string DotClass(string kind) => kind switch
    {
        "ok" => "adm-tl__dot--ok",
        "danger" => "adm-tl__dot--danger",
        _ => ""
    };

    private static string BadgeClass(string kind) => kind switch
    {
        "ok" => "adm-badge--ok",
        "danger" => "adm-badge--danger",
        _ => "adm-badge--info"
    };
}
