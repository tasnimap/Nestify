@page "/admin/pricing"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject AdminConsoleService Store

<PageTitle>Fees and plans — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Money</p>
        <h1>Fees &amp; posting plans</h1>
        <p>Set what a verification costs and how many posts a package buys. Changes apply to new purchases only.</p>
    </div>
    <div class="adm-head__actions">
        <button class="adm-btn adm-btn--primary" type="button" @onclick="() => NewPlan(PlanScope.Housing)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            New plan
        </button>
    </div>
</header>

<section class="adm-card adm-rise" style="--d:.06s;margin-bottom:1rem;">
    <div class="adm-card__head">
        <div>
            <h2>Verification fees</h2>
            <p>One-off charges taken when someone applies to be verified.</p>
        </div>
    </div>

    <div class="adm-grid adm-grid--2">
        @foreach (var fee in Store.Fees)
        {
            var current = fee;
            <div class="adm-row" style="box-shadow:none;">
                <div class="adm-row__main">
                    <p class="adm-row__title">@current.Label</p>
                    <p class="adm-row__meta">@current.Description</p>
                </div>
                <div class="adm-row__side">
                    <div class="adm-field" style="width:120px;">
                        <input class="adm-input" type="number" min="0" step="10"
                               value="@_amounts[current.Id]"
                               @onchange="e => _amounts[current.Id] = ToInt(e.Value, current.Amount)" />
                    </div>
                    <button class="adm-btn adm-btn--primary adm-btn--sm" type="button"
                            disabled="@(_amounts[current.Id] == current.Amount)"
                            @onclick="() => Store.SaveFee(current.Id, _amounts[current.Id])">
                        Save
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<div class="adm-grid adm-grid--2">
    @foreach (var scope in new[] { PlanScope.Housing, PlanScope.Marketplace })
    {
        var group = scope;
        <section class="adm-card adm-rise" style="--d:.12s">
            <div class="adm-card__head">
                <div>
                    <h2>@AdminConsoleService.ScopeLabel(group) plans</h2>
                    <p>
                        @(group == PlanScope.Housing
                            ? "Bought by landlords and people subletting a room."
                            : "Bought by students selling their own things.")
                    </p>
                </div>
                <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => NewPlan(group)">Add plan</button>
            </div>

            <div class="adm-rows">
                @foreach (var plan in Store.Plans.Where(p => p.Scope == group))
                {
                    var current = plan;
                    <article class="adm-row" style="box-shadow:none;">
                        <span class="adm-thumb @(group == PlanScope.Marketplace ? "adm-thumb--teal" : null)" aria-hidden="true">
                            @current.Posts
                        </span>
                        <div class="adm-row__main">
                            <p class="adm-row__title">
                                @current.Name
                                @if (!current.IsActive)
                                {
                                    <span class="adm-badge adm-badge--muted" style="margin-left:.4rem;">off</span>
                                }
                            </p>
                            <p class="adm-row__meta">
                                @current.Posts posts for @AdminConsoleService.Taka(current.Price)
                                · valid @current.ValidDays days · @current.Subscribers.ToString("N0") buyers
                            </p>
                        </div>
                        <div class="adm-row__side">
                            <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => EditPlan(current)">Edit</button>
                            <button class="adm-btn @(current.IsActive ? "adm-btn--danger" : "adm-btn--ok") adm-btn--sm"
                                    type="button" @onclick="() => Store.TogglePlan(current.Id)">
                                @(current.IsActive ? "Disable" : "Enable")
                            </button>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@if (_draft is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box">
            <div class="adm-modal__head">
                <div>
                    <h2>@(_isNew ? "New plan" : "Edit plan")</h2>
                    <p>A plan is a bundle of posts someone buys once.</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="() => _draft = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <div class="adm-form">
                <div class="adm-field">
                    <label for="plan-name">Plan name</label>
                    <input id="plan-name" class="adm-input" @bind="_draft.Name" placeholder="Starter" />
                </div>
                <div class="adm-field">
                    <label for="plan-scope">Used for</label>
                    <select id="plan-scope" class="adm-select" @bind="_draft.Scope">
                        <option value="@PlanScope.Housing">Housing posts</option>
                        <option value="@PlanScope.Marketplace">Marketplace posts</option>
                    </select>
                </div>
                <div class="adm-grid adm-grid--3">
                    <div class="adm-field">
                        <label for="plan-posts">Posts</label>
                        <input id="plan-posts" class="adm-input" type="number" min="1" @bind="_draft.Posts" />
                    </div>
                    <div class="adm-field">
                        <label for="plan-price">Price (৳)</label>
                        <input id="plan-price" class="adm-input" type="number" min="0" @bind="_draft.Price" />
                    </div>
                    <div class="adm-field">
                        <label for="plan-days">Valid days</label>
                        <input id="plan-days" class="adm-input" type="number" min="1" @bind="_draft.ValidDays" />
                    </div>
                </div>
                <p class="adm-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
                    Example: 10 posts for ৳20, valid 30 days. People who already bought an older plan keep it until it expires.
                </p>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="() => _draft = null">Cancel</button>
                <button class="adm-btn adm-btn--primary" type="button" @onclick="SavePlan">Save plan</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly Dictionary<string, int> _amounts = new();
    private PostPlan? _draft;
    private bool _isNew;

    protected override void OnInitialized()
    {
        foreach (var fee in Store.Fees)
        {
            _amounts[fee.Id] = fee.Amount;
        }
    }

    private void NewPlan(PlanScope scope)
    {
        _isNew = true;
        _draft = new PostPlan { Scope = scope, Posts = 10, Price = 20, ValidDays = 30, Name = "" };
    }

    private void EditPlan(PostPlan plan)
    {
        _isNew = false;
        _draft = new PostPlan
        {
            Id = plan.Id,
            Name = plan.Name,
            Scope = plan.Scope,
            Posts = plan.Posts,
            Price = plan.Price,
            ValidDays = plan.ValidDays
        };
    }

    private void SavePlan()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.Name)) return;

        Store.SavePlan(_draft);
        _draft = null;
    }

    private static int ToInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;
}
