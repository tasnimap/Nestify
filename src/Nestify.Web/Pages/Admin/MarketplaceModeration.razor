@page "/admin/marketplace"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject AdminConsoleService Store

<PageTitle>Marketplace posts — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Moderation</p>
        <h1>Marketplace posts</h1>
        <p>Reported second-hand listings and every item currently on sale. A struck down item leaves the grid immediately, the seller keeps their account.</p>
    </div>
    <div class="adm-head__actions">
        <span class="adm-badge adm-badge--pending">@OpenReports open reports</span>
        <span class="adm-badge adm-badge--ok">@LiveCount live items</span>
    </div>
</header>

<div class="adm-toolbar adm-rise" style="--d:.08s">
    <div class="adm-tabs">
        <button class="adm-tab @(_tab == 0 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(0)">
            Reports<span class="adm-tab__count">@OpenReports</span>
        </button>
        <button class="adm-tab @(_tab == 1 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(1)">
            Live items<span class="adm-tab__count">@LiveCount</span>
        </button>
        <button class="adm-tab @(_tab == 2 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(2)">
            Taken down<span class="adm-tab__count">@Store.Market.Count(p => p.State == PostState.Removed)</span>
        </button>
    </div>
    <label class="adm-search adm-toolbar__grow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="Search item, category, area or seller" @bind="Query" @bind:event="oninput" />
    </label>
    <div class="adm-tabs">
        <button class="adm-tab @(_category is null ? "adm-tab--on" : null)" type="button" @onclick="() => SetCategory(null)">All</button>
        @foreach (var category in Categories)
        {
            var current = category;
            <button class="adm-tab @(_category == current ? "adm-tab--on" : null)" type="button" @onclick="() => SetCategory(current)">@current</button>
        }
    </div>
</div>

@if (_tab == 0)
{
    var reports = Store.Reports
        .Where(r => r.Scope == PlanScope.Marketplace && Matches(r.PostTitle + r.Reason + r.ReportedBy))
        .OrderBy(r => r.State).ThenByDescending(r => r.RaisedOn)
        .ToList();

    var reportPage = ClampPage(reports.Count);

    if (reports.Count == 0)
    {
        <EmptyState Title="No reports here" Message="Nothing has been reported in the marketplace yet." />
    }
    else
    {
        <div class="adm-rows">
            @foreach (var report in reports.Skip((reportPage - 1) * PageSize).Take(PageSize))
            {
                var item = Store.Market.FirstOrDefault(p => p.Id == report.PostId);
                <article class="adm-row adm-rise">
                    @if (item is not null)
                    {
                        <span class="adm-shot-wrap">
                            <img class="adm-shot" src="@item.Cover" alt="" loading="lazy" />
                            @if (item.Photos.Count > 1)
                            {
                                <span class="adm-shot-wrap__count">@item.Photos.Count photos</span>
                            }
                        </span>
                    }
                    <div class="adm-row__main">
                        <p class="adm-row__title">@report.PostTitle</p>
                        <p class="adm-row__meta">
                            Reported for <strong>@report.Reason</strong> by @report.ReportedBy · @AdminConsoleService.Ago(report.RaisedOn)
                        </p>
                        <p class="adm-row__note">@report.Details</p>
                        @if (item is not null)
                        {
                            <div class="adm-row__facts">
                                <span class="adm-fact adm-fact--price">@AdminConsoleService.Taka(item.Price)</span>
                                <span class="adm-fact">@item.Category · @item.Condition</span>
                                <span class="adm-fact">@item.Area</span>
                                <span class="adm-fact">@item.Seller</span>
                                @if (item.State == PostState.Removed)
                                {
                                    <span class="adm-fact">already taken down</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="adm-row__side">
                        @if (item is not null)
                        {
                            <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => _preview = item">View item</button>
                        }
                        @if (report.State == ReportState.Open)
                        {
                            @if (item is not null && item.State == PostState.Live)
                            {
                                <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" @onclick="() => AskRemove(item, report)">Strike down</button>
                            }
                            <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => Store.DismissReport(report.Id)">Dismiss</button>
                        }
                        else
                        {
                            <span class="adm-badge @(report.State == ReportState.Resolved ? "adm-badge--ok" : "adm-badge--muted")">@report.State</span>
                        }
                    </div>
                </article>
            }
        </div>

        <Pager Page="reportPage" PageSize="PageSize" Total="reports.Count" PageChanged="p => _page = p" />
    }
}
else
{
    var wanted = _tab == 1 ? PostState.Live : PostState.Removed;
    var items = Store.Market
        .Where(p => p.State == wanted && (_category is null || p.Category == _category))
        .Where(p => Matches(p.Title + p.Category + p.Area + p.Seller))
        .OrderByDescending(p => p.PostedOn)
        .ToList();

    var itemPage = ClampPage(items.Count);

    if (items.Count == 0)
    {
        <EmptyState Title="Nothing to show" Message="No item matches this filter right now." />
    }
    else
    {
        <div class="adm-rows">
            @foreach (var item in items.Skip((itemPage - 1) * PageSize).Take(PageSize))
            {
                <article class="adm-row adm-rise">
                    <span class="adm-shot-wrap">
                        <img class="adm-shot" src="@item.Cover" alt="" loading="lazy" />
                        @if (item.Photos.Count > 1)
                        {
                            <span class="adm-shot-wrap__count">@item.Photos.Count photos</span>
                        }
                    </span>
                    <div class="adm-row__main">
                        <p class="adm-row__title">@item.Title</p>
                        <p class="adm-row__meta">
                            @item.Seller
                            @if (item.SellerVerified)
                            {
                                <span class="adm-verified">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                                    verified
                                </span>
                            }
                            · posted @AdminConsoleService.Ago(item.PostedOn)
                        </p>
                        <p class="adm-desc">@item.Description</p>
                        <div class="adm-row__facts">
                            <span class="adm-fact adm-fact--price">@AdminConsoleService.Taka(item.Price)</span>
                            <span class="adm-fact">@item.Category</span>
                            <span class="adm-fact">@item.Condition</span>
                            <span class="adm-fact">@item.Area</span>
                            @if (item.ReportCount > 0)
                            {
                                <span class="adm-badge adm-badge--pending">@item.ReportCount report@(item.ReportCount == 1 ? "" : "s")</span>
                            }
                        </div>
                        @if (item.State == PostState.Removed && item.RemovalReason is not null)
                        {
                            <p class="adm-row__note">Taken down — @item.RemovalReason</p>
                        }
                    </div>
                    <div class="adm-row__side">
                        <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => _preview = item">View item</button>
                        @if (item.State == PostState.Live)
                        {
                            <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" @onclick="() => AskRemove(item, null)">Strike down</button>
                        }
                        else
                        {
                            <button class="adm-btn adm-btn--ok adm-btn--sm" type="button" @onclick="() => Store.RestoreMarketItem(item.Id)">Put back</button>
                        }
                    </div>
                </article>
            }
        </div>

        <Pager Page="itemPage" PageSize="PageSize" Total="items.Count" PageChanged="p => _page = p" />
    }
}

@if (_preview is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box adm-modal__box--wide">
            <div class="adm-modal__head">
                <div>
                    <h2>@_preview.Title</h2>
                    <p>The listing exactly as a buyer sees it.</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="() => _preview = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <PhotoGallery Photos="_preview.Photos" />
            <p class="adm-desc" style="-webkit-line-clamp:none;margin-bottom:1rem;">@_preview.Description</p>

            <div class="adm-kv">
                <div class="adm-kv__row"><span>Price</span><strong>@AdminConsoleService.Taka(_preview.Price)</strong></div>
                <div class="adm-kv__row"><span>Category</span><strong>@_preview.Category</strong></div>
                <div class="adm-kv__row"><span>Condition</span><strong>@_preview.Condition</strong></div>
                <div class="adm-kv__row"><span>Handover area</span><strong>@_preview.Area</strong></div>
                <div class="adm-kv__row"><span>Seller</span><strong>@_preview.Seller @(_preview.SellerVerified ? "(verified)" : "(not verified)")</strong></div>
                <div class="adm-kv__row"><span>Posted</span><strong>@_preview.PostedOn.ToString("d MMM yyyy, h:mm tt")</strong></div>
                <div class="adm-kv__row"><span>Photos</span><strong>@_preview.Photos.Count</strong></div>
                <div class="adm-kv__row"><span>Reports</span><strong>@ReportsFor(_preview.Id)</strong></div>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="() => _preview = null">Close</button>
                @if (_preview.State == PostState.Live)
                {
                    <button class="adm-btn adm-btn--danger" type="button" @onclick="() => AskRemove(_preview, null)">Strike down item</button>
                }
                else
                {
                    <button class="adm-btn adm-btn--ok" type="button" @onclick="() => PutBack(_preview)">Put back</button>
                }
            </div>
        </div>
    </div>
}

@if (_target is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box">
            <div class="adm-modal__head">
                <div>
                    <h2>Strike down this item</h2>
                    <p>@_target.Title</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="Cancel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <div class="adm-form">
                <div class="adm-field">
                    <label for="mreason">Reason</label>
                    <select id="mreason" class="adm-select" @bind="_reason">
                        @foreach (var reason in Reasons)
                        {
                            <option value="@reason">@reason</option>
                        }
                    </select>
                </div>
                <div class="adm-field">
                    <label for="mnote">Note for the audit log</label>
                    <textarea id="mnote" class="adm-textarea" @bind="_note" placeholder="What is wrong with the listing?"></textarea>
                </div>
                <p class="adm-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
                    Only this listing comes down. Buyers who already showed interest stop seeing it, and the strike is recorded in the audit log.
                </p>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="Cancel">Cancel</button>
                <button class="adm-btn adm-btn--danger" type="button" @onclick="ConfirmRemove">Strike down item</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Reasons =
    {
        "Scam",
        "Counterfeit or stolen item",
        "Misleading photos",
        "Prohibited item",
        "Already sold",
        "Other policy breach"
    };

    private const int PageSize = 10;

    private int _tab;
    private int _page = 1;
    private string _query = "";
    private string? _category;
    private MarketItem? _target;
    private MarketItem? _preview;
    private PostReport? _linkedReport;
    private string _reason = Reasons[0];
    private string _note = "";

    private string Query
    {
        get => _query;
        set { _query = value; _page = 1; }
    }

    private void SetTab(int tab)
    {
        _tab = tab;
        _page = 1;
    }

    private void SetCategory(string? category)
    {
        _category = category;
        _page = 1;
    }

    // Keeps the page in range when a strike shortens the list under the reader.
    private int ClampPage(int total)
    {
        var pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        _page = Math.Clamp(_page, 1, pageCount);
        return _page;
    }

    private List<string> Categories => Store.Market.Select(i => i.Category).Distinct().OrderBy(c => c).ToList();

    private int OpenReports => Store.Reports.Count(r => r.Scope == PlanScope.Marketplace && r.State == ReportState.Open);

    private int LiveCount => Store.Market.Count(p => p.State == PostState.Live);

    private int ReportsFor(string itemId) => Store.Reports.Count(r => r.PostId == itemId);

    private bool Matches(string haystack) =>
        string.IsNullOrWhiteSpace(_query) ||
        haystack.Contains(_query, StringComparison.OrdinalIgnoreCase);

    private void AskRemove(MarketItem? item, PostReport? report)
    {
        if (item is null) return;
        _preview = null;
        _target = item;
        _linkedReport = report;
        _reason = Reasons.Contains(report?.Reason) ? report!.Reason : Reasons[0];
        _note = "";
    }

    private void PutBack(MarketItem item)
    {
        Store.RestoreMarketItem(item.Id);
        _preview = null;
    }

    private void Cancel()
    {
        _target = null;
        _linkedReport = null;
    }

    private void ConfirmRemove()
    {
        if (_target is null) return;

        var reason = string.IsNullOrWhiteSpace(_note) ? _reason : $"{_reason} — {_note}";
        Store.RemoveMarketItem(_target.Id, reason);

        if (_linkedReport is not null)
        {
            Store.ResolveReport(_linkedReport.Id, "Item struck down");
        }

        Cancel();
    }
}
