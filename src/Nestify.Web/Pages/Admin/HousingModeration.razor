@page "/admin/housing"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService Admin
@inject ToastService Toast

<PageTitle>Housing posts — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Moderation</p>
        <h1>Housing posts</h1>
        <p>What users reported sits on the first tab. The other tabs hold every seat, sublet and whole-house listing the browse page is serving right now.</p>
    </div>
    <div class="adm-head__actions">
        <span class="adm-badge adm-badge--pending">@OpenReports open reports</span>
        <span class="adm-badge adm-badge--ok">@LiveCount live posts</span>
    </div>
</header>

<div class="adm-toolbar adm-rise" style="--d:.08s">
    <div class="adm-tabs">
        <button class="adm-tab @(_tab == 0 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(0)">
            Reports<span class="adm-tab__count">@OpenReports</span>
        </button>
        <button class="adm-tab @(_tab == 1 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(1)">
            Live posts<span class="adm-tab__count">@LiveCount</span>
        </button>
        <button class="adm-tab @(_tab == 2 ? "adm-tab--on" : null)" type="button" @onclick="() => SetTab(2)">
            Taken down<span class="adm-tab__count">@_posts.Count(p => p.State == ModeratedPostState.Removed)</span>
        </button>
    </div>
    <label class="adm-search adm-toolbar__grow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="Search title, area or owner" @bind="Query" @bind:event="oninput" />
    </label>
</div>

@if (_loading)
{
    <EmptyState Title="Loading" Message="Fetching posts and reports." />
}
else if (_tab == 0)
{
    var reports = _reports
        .Where(r => Matches(r.PostTitle + r.Reason + r.ReportedBy))
        .OrderBy(r => r.State).ThenByDescending(r => r.RaisedAtUtc)
        .ToList();

    var reportPage = ClampPage(reports.Count);

    if (reports.Count == 0)
    {
        <EmptyState Title="No reports here" Message="Nothing has been reported on a housing post yet." />
    }
    else
    {
        <div class="adm-rows">
            @foreach (var report in reports.Skip((reportPage - 1) * PageSize).Take(PageSize))
            {
                var post = _posts.FirstOrDefault(p => p.Id == report.PostId);
                <article class="adm-row adm-rise">
                    @if (post is not null && post.Photos.Count > 0)
                    {
                        <span class="adm-shot-wrap">
                            <img class="adm-shot" src="@post.Cover" alt="" loading="lazy" />
                            @if (post.Photos.Count > 1)
                            {
                                <span class="adm-shot-wrap__count">@post.Photos.Count photos</span>
                            }
                        </span>
                    }
                    <div class="adm-row__main">
                        <p class="adm-row__title">@report.PostTitle</p>
                        <p class="adm-row__meta">
                            Reported for <strong>@report.Reason</strong> by @report.ReportedBy · @AdminConsoleService.Ago(report.RaisedAtUtc)
                        </p>
                        @if (!string.IsNullOrWhiteSpace(report.Details))
                        {
                            <p class="adm-row__note">@report.Details</p>
                        }
                        @if (post is not null)
                        {
                            <div class="adm-row__facts">
                                <span class="adm-fact adm-fact--price">@AdminConsoleService.Taka(post.Rent) / month</span>
                                <span class="adm-fact">@post.ListingType</span>
                                <span class="adm-fact">@post.FullArea</span>
                                <span class="adm-fact">@post.Owner</span>
                                @if (post.State == ModeratedPostState.Removed)
                                {
                                    <span class="adm-fact">already taken down</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="adm-row__side">
                        @if (post is not null)
                        {
                            <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => _preview = post">View post</button>
                        }
                        @if (report.State == ModerationReportState.Open)
                        {
                            @if (post is not null && post.State == ModeratedPostState.Live)
                            {
                                <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" @onclick="() => AskRemove(post, report)">Strike down</button>
                            }
                            <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" disabled="@_busy" @onclick="() => Dismiss(report)">Dismiss</button>
                        }
                        else
                        {
                            <span class="adm-badge @(report.State == ModerationReportState.Resolved ? "adm-badge--ok" : "adm-badge--muted")">@report.State</span>
                        }
                    </div>
                </article>
            }
        </div>

        <Pager Page="reportPage" PageSize="PageSize" Total="reports.Count" PageChanged="p => _page = p" />
    }
}
else
{
    var wanted = _tab == 1 ? ModeratedPostState.Live : ModeratedPostState.Removed;
    var posts = _posts
        .Where(p => p.State == wanted && Matches(p.Title + p.Area + p.Division + p.Owner))
        .OrderByDescending(p => p.PostedAtUtc)
        .ToList();

    var postPage = ClampPage(posts.Count);

    if (posts.Count == 0)
    {
        <EmptyState Title="Nothing to show" Message="No post matches this filter right now." />
    }
    else
    {
        <div class="adm-rows">
            @foreach (var post in posts.Skip((postPage - 1) * PageSize).Take(PageSize))
            {
                <article class="adm-row adm-rise">
                    @if (post.Photos.Count > 0)
                    {
                        <span class="adm-shot-wrap">
                            <img class="adm-shot" src="@post.Cover" alt="" loading="lazy" />
                            @if (post.Photos.Count > 1)
                            {
                                <span class="adm-shot-wrap__count">@post.Photos.Count photos</span>
                            }
                        </span>
                    }
                    <div class="adm-row__main">
                        <p class="adm-row__title">@post.Title</p>
                        <p class="adm-row__meta">
                            @post.Owner
                            @if (post.OwnerVerified)
                            {
                                <span class="adm-verified">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                                    verified
                                </span>
                            }
                            · posted @AdminConsoleService.Ago(post.PostedAtUtc)
                        </p>
                        <p class="adm-desc">@post.Description</p>
                        <div class="adm-row__facts">
                            <span class="adm-fact adm-fact--price">@AdminConsoleService.Taka(post.Rent) / month</span>
                            <span class="adm-fact">@post.ListingType · @post.Seats seat@(post.Seats == 1 ? "" : "s")</span>
                            <span class="adm-fact">@post.FullArea</span>
                            <span class="adm-fact">@post.Eligibility</span>
                            @if (post.ReportCount > 0)
                            {
                                <span class="adm-badge adm-badge--pending">@post.ReportCount report@(post.ReportCount == 1 ? "" : "s")</span>
                            }
                        </div>
                        @if (post.State == ModeratedPostState.Removed && post.RemovalReason is not null)
                        {
                            <p class="adm-row__note">Taken down — @post.RemovalReason</p>
                        }
                    </div>
                    <div class="adm-row__side">
                        <button class="adm-btn adm-btn--ghost adm-btn--sm" type="button" @onclick="() => _preview = post">View post</button>
                        @if (post.State == ModeratedPostState.Live)
                        {
                            <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" @onclick="() => AskRemove(post, null)">Strike down</button>
                        }
                        else
                        {
                            <button class="adm-btn adm-btn--ok adm-btn--sm" type="button" disabled="@_busy" @onclick="() => PutBack(post)">Put back</button>
                        }
                    </div>
                </article>
            }
        </div>

        <Pager Page="postPage" PageSize="PageSize" Total="posts.Count" PageChanged="p => _page = p" />
    }
}

@if (_preview is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box adm-modal__box--wide">
            <div class="adm-modal__head">
                <div>
                    <h2>@_preview.Title</h2>
                    <p>The post exactly as a seeker sees it.</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="() => _preview = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <PhotoGallery Photos="_preview.Photos" />
            <p class="adm-desc" style="-webkit-line-clamp:none;margin-bottom:1rem;">@_preview.Description</p>

            <div class="adm-kv">
                <div class="adm-kv__row"><span>Rent</span><strong>@AdminConsoleService.Taka(_preview.Rent) / month</strong></div>
                <div class="adm-kv__row"><span>Listing type</span><strong>@_preview.ListingType · @_preview.Seats seat@(_preview.Seats == 1 ? "" : "s")</strong></div>
                <div class="adm-kv__row"><span>Area</span><strong>@_preview.FullArea</strong></div>
                <div class="adm-kv__row"><span>Who can apply</span><strong>@_preview.Eligibility</strong></div>
                <div class="adm-kv__row"><span>Posted by</span><strong>@_preview.Owner @(_preview.OwnerVerified ? "(verified)" : "(not verified)")</strong></div>
                <div class="adm-kv__row"><span>Posted</span><strong>@_preview.PostedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</strong></div>
                <div class="adm-kv__row"><span>Photos</span><strong>@_preview.Photos.Count</strong></div>
                <div class="adm-kv__row"><span>Reports</span><strong>@_preview.ReportCount</strong></div>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="() => _preview = null">Close</button>
                @if (_preview.State == ModeratedPostState.Live)
                {
                    <button class="adm-btn adm-btn--danger" type="button" @onclick="() => AskRemove(_preview, null)">Strike down post</button>
                }
                else
                {
                    <button class="adm-btn adm-btn--ok" type="button" disabled="@_busy" @onclick="() => PutBack(_preview)">Put back</button>
                }
            </div>
        </div>
    </div>
}

@if (_target is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box">
            <div class="adm-modal__head">
                <div>
                    <h2>Strike down this post</h2>
                    <p>@_target.Title</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="Cancel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <div class="adm-form">
                <div class="adm-field">
                    <label for="reason">Reason</label>
                    <select id="reason" class="adm-select" @bind="_reason">
                        @foreach (var reason in Reasons)
                        {
                            <option value="@reason">@reason</option>
                        }
                    </select>
                </div>
                <div class="adm-field">
                    <label for="note">Note for the audit log</label>
                    <textarea id="note" class="adm-textarea" @bind="_note" placeholder="What did you see on the post?"></textarea>
                </div>
                <p class="adm-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
                    The post leaves browse and search straight away, and the action is written to the audit log under your name.
                </p>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="Cancel">Cancel</button>
                <button class="adm-btn adm-btn--danger" type="button" disabled="@_busy" @onclick="ConfirmRemove">Strike down post</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Reasons =
    {
        "Fake listing",
        "Misleading photos or rent",
        "Duplicate post",
        "Abusive or improper content",
        "Scam or advance payment demand",
        "Wrong rent",
        "Other policy breach"
    };

    private const int PageSize = 10;

    private List<AdminHousingPostDto> _posts = new();
    private List<AdminReportDto> _reports = new();
    private bool _loading = true;
    private bool _busy;

    private int _tab;
    private int _page = 1;
    private string _query = "";
    private AdminHousingPostDto? _target;
    private AdminHousingPostDto? _preview;
    private AdminReportDto? _linkedReport;
    private string _reason = Reasons[0];
    private string _note = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var posts = Admin.GetHousingPostsAsync();
        var reports = Admin.GetHousingReportsAsync();
        _posts = await posts;
        _reports = await reports;
        _loading = false;
    }

    private string Query
    {
        get => _query;
        set { _query = value; _page = 1; }
    }

    private void SetTab(int tab)
    {
        _tab = tab;
        _page = 1;
    }

    // Keeps the page in range when a strike shortens the list under the reader.
    private int ClampPage(int total)
    {
        var pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        _page = Math.Clamp(_page, 1, pageCount);
        return _page;
    }

    private int OpenReports => _reports.Count(r => r.State == ModerationReportState.Open);

    private int LiveCount => _posts.Count(p => p.State == ModeratedPostState.Live);

    private bool Matches(string haystack) =>
        string.IsNullOrWhiteSpace(_query) ||
        haystack.Contains(_query, StringComparison.OrdinalIgnoreCase);

    private void AskRemove(AdminHousingPostDto? post, AdminReportDto? report)
    {
        if (post is null) return;
        _preview = null;
        _target = post;
        _linkedReport = report;
        _reason = Reasons.Contains(report?.Reason) ? report!.Reason : Reasons[0];
        _note = "";
    }

    private async Task PutBack(AdminHousingPostDto post)
    {
        _busy = true;
        var (ok, message) = await Admin.RestoreHousingPostAsync(post.Id);
        _busy = false;
        if (!ok)
        {
            Toast.ShowError(message);
            return;
        }

        _preview = null;
        await LoadAsync();
    }

    private async Task Dismiss(AdminReportDto report)
    {
        _busy = true;
        var ok = await Admin.DismissReportAsync(ModerationScope.Housing, report.Id);
        _busy = false;
        if (!ok)
        {
            Toast.ShowError("Could not dismiss the report.");
            return;
        }

        await LoadAsync();
    }

    private void Cancel()
    {
        _target = null;
        _linkedReport = null;
    }

    private async Task ConfirmRemove()
    {
        if (_target is null) return;

        var reason = string.IsNullOrWhiteSpace(_note) ? _reason : $"{_reason} — {_note.Trim()}";
        _busy = true;
        var (ok, message) = await Admin.TakeDownHousingPostAsync(_target.Id, reason, _linkedReport?.Id);
        _busy = false;
        if (!ok)
        {
            Toast.ShowError(message);
            return;
        }

        Cancel();
        await LoadAsync();
    }
}
