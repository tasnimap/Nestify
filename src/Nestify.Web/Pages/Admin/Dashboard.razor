@page "/admin"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService Admin

<PageTitle>Dashboard — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Control room</p>
        <h1>Dashboard</h1>
        <p>Platform revenue, live activity, and the moderation work in progress.</p>
    </div>
    <div class="adm-head__actions">
        <a class="adm-btn adm-btn--ghost" href="admin/audit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 8v5l3 2" /><circle cx="12" cy="12" r="9" /></svg>
            Audit log
        </a>
        <a class="adm-btn adm-btn--primary" href="admin/verifications">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
            @_summary.PendingVerifications waiting
        </a>
    </div>
</header>

<div class="adm-grid adm-grid--4" style="margin-bottom:1rem;">
    <article class="adm-kpi adm-rise" style="--d:.04s">
        <div class="adm-kpi__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2v20" /><path d="M17 6.5c0-1.9-2.2-3-5-3s-5 1.1-5 3 2.2 2.8 5 3.3 5 1.4 5 3.4-2.2 3.3-5 3.3-5-1.2-5-3" /></svg>
        </div>
        <p class="adm-kpi__label">Revenue this month</p>
        <p class="adm-kpi__value"><CountUp Value="MonthRevenue" Prefix="৳" /></p>
        <p class="adm-kpi__foot">
            <span class="adm-trend adm-trend--up">▲ @GrowthPercent%</span> vs last month
        </p>
    </article>

    <article class="adm-kpi adm-kpi--sky adm-rise" style="--d:.1s">
        <div class="adm-kpi__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9.5" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /></svg>
        </div>
        <p class="adm-kpi__label">Registered users</p>
        <p class="adm-kpi__value"><CountUp Value="Stats.TotalUsers" /></p>
        <p class="adm-kpi__foot">@Stats.NewUsersThisMonth.ToString("N0") joined this month</p>
    </article>

    <article class="adm-kpi adm-kpi--teal adm-rise" style="--d:.16s">
        <div class="adm-kpi__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M9 21v-7h6v7" /></svg>
        </div>
        <p class="adm-kpi__label">Homes created</p>
        <p class="adm-kpi__value"><CountUp Value="Stats.HomesCreated" /></p>
        <p class="adm-kpi__foot">created on Nestify</p>
    </article>

    <article class="adm-kpi adm-kpi--rose adm-rise" style="--d:.22s">
        <div class="adm-kpi__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></svg>
        </div>
        <p class="adm-kpi__label">Fake posts removed</p>
        <p class="adm-kpi__value"><CountUp Value="_summary.PostsTakenDown" /></p>
        <p class="adm-kpi__foot">@(_summary.OpenHousingReports + _summary.OpenMarketReports) reports still open</p>
    </article>
</div>

<div class="adm-grid adm-grid--2" style="margin-bottom:1rem;">
    <section class="adm-card adm-rise adm-span-2" style="--d:.28s">
        <div class="adm-card__head">
            <div>
                <h2>@RevenueChartTitle</h2>
                <p>@RevenueChartDescription</p>
            </div>
            <div class="adm-card__actions">
                <div class="adm-tabs" role="tablist" aria-label="Revenue view">
                    <button type="button" role="tab" aria-selected="@(_revenueTab == RevenueChartTab.All)"
                            class="adm-tab @RevenueTabClass(RevenueChartTab.All)" @onclick="() => _revenueTab = RevenueChartTab.All">Overall</button>
                    <button type="button" role="tab" aria-selected="@(_revenueTab == RevenueChartTab.Verification)"
                            class="adm-tab @RevenueTabClass(RevenueChartTab.Verification)" @onclick="() => _revenueTab = RevenueChartTab.Verification">Verification</button>
                    <button type="button" role="tab" aria-selected="@(_revenueTab == RevenueChartTab.Marketplace)"
                            class="adm-tab @RevenueTabClass(RevenueChartTab.Marketplace)" @onclick="() => _revenueTab = RevenueChartTab.Marketplace">Marketplace</button>
                </div>
                <div class="adm-chips">
                    <span class="adm-chip">Year total @AdminConsoleService.Taka(SelectedYearRevenue)</span>
                </div>
            </div>
        </div>
        <AdminLineChart Title="@RevenueChartTitle" Prefix="৳" Labels="Months" Series="RevenueSeries" />
    </section>

    <section class="adm-card adm-rise" style="--d:.34s">
        <div class="adm-card__head">
            <div>
                <h2>Revenue split</h2>
                <p>This month's share of verification and marketplace revenue.</p>
            </div>
        </div>
        <AdminDonut Title="Revenue split" Slices="RevenueSplit"
                    Center="@AdminConsoleService.Taka(MonthRevenue)" CenterLabel="This month" ValuePrefix="৳" />
    </section>

    <section class="adm-card adm-rise" style="--d:.4s">
        <div class="adm-card__head">
            <div>
                <h2>People on Nestify</h2>
                <p>People who joined Nestify, with monthly registrations over the last six months.</p>
            </div>
        </div>
        <div class="adm-people-summary" aria-label="People joining summary">
            <div>
                <span>Total people joined</span>
                <strong><CountUp Value="Stats.TotalUsers" /></strong>
            </div>
            <div>
                <span>Joined this month</span>
                <strong>@Stats.NewUsersThisMonth.ToString("N0")</strong>
            </div>
        </div>
        @if (Growth.Count == 0)
        {
            <EmptyState Title="No registration data yet" Message="Monthly joins will appear here once people start creating accounts." />
        }
        else
        {
            <div class="adm-bars" role="img" aria-label="Bar chart showing people who joined Nestify each month">
                @for (var i = 0; i < Growth.Count; i++)
                {
                    var point = Growth[i];
                    var height = Math.Round(100.0 * point.Users / MaxGrowth, 1);
                    var month = point.MonthUtc.ToLocalTime().ToString("MMMM yyyy");
                    <div class="adm-bar" title="@($"{point.Users:N0} people joined in {month}")">
                        <div class="adm-bar__track">
                            <div class="adm-bar__fill" style="height:@Css(height)%;--d:@Css(i * 0.08)s"></div>
                        </div>
                        <span class="adm-bar__cap">@point.Users.ToString("N0")</span>
                        <span class="adm-bar__label">@point.MonthUtc.ToLocalTime().ToString("MMM")</span>
                    </div>
                }
            </div>
        }
        <div class="adm-chips" style="margin-top:1rem;">
            <span class="adm-chip">@Stats.TotalUsers.ToString("N0") people</span>
            <span class="adm-chip">@Stats.TotalHelpers.ToString("N0") domestic helpers</span>
            <span class="adm-chip">@_summary.ActiveAdmins admins</span>
            <span class="adm-chip">@Stats.VerifiedAccounts.ToString("N0") verified</span>
        </div>
    </section>
</div>

<div class="adm-grid adm-grid--2">
    <section class="adm-card adm-rise" style="--d:.46s">
        <div class="adm-card__head">
            <div>
                <h2>What Nestify did for people</h2>
                <p>Live totals counted since launch.</p>
            </div>
        </div>
        <div class="adm-meter">
            @for (var i = 0; i < Outcomes.Count; i++)
            {
                var outcome = Outcomes[i];
                var index = i;
                <div class="adm-meter__row">
                    <div class="adm-meter__top">
                        <span>@outcome.Label</span>
                        <strong>@outcome.Value.ToString("N0")</strong>
                    </div>
                    <div class="adm-meter__track">
                        <div class="adm-meter__fill"
                             style="width:@Css(Math.Round(100.0 * outcome.Value / MaxOutcome, 1))%;--d:@Css(index * 0.1)s"></div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="adm-card adm-rise" style="--d:.52s">
        <div class="adm-card__head">
            <div>
                <h2>Latest admin actions</h2>
                <p>The five most recent entries in the audit log.</p>
            </div>
            <a class="adm-btn adm-btn--ghost adm-btn--sm" href="admin/audit">See all</a>
        </div>
        @if (_audit.Count == 0)
        {
            <EmptyState Title="Nothing yet" Message="Admin actions will show up here as they happen." />
        }
        else
        {
            <div class="adm-timeline">
                @foreach (var entry in _audit)
                {
                    <div class="adm-tl">
                        <div class="adm-tl__rail">
                            <span class="adm-tl__dot @DotClass(entry.Kind)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                            </span>
                        </div>
                        <div class="adm-tl__body">
                            <p class="adm-tl__title">@entry.Action — @entry.Target</p>
                            <p class="adm-tl__meta">@entry.Admin · @AdminConsoleService.Ago(entry.AtUtc)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="adm-card adm-rise adm-span-2" style="--d:.58s">
        <div class="adm-card__head">
            <div>
                <h2>Marketplace and housing at a glance</h2>
                <p>Live content the moderation pages are working on right now.</p>
            </div>
        </div>
        <div class="adm-grid adm-grid--4">
            <div class="adm-kpi adm-kpi--sky">
                <p class="adm-kpi__label">Live housing posts</p>
                <p class="adm-kpi__value">@_summary.LiveHousingPosts</p>
                <p class="adm-kpi__foot"><a href="admin/housing">Open moderation</a></p>
            </div>
            <div class="adm-kpi adm-kpi--teal">
                <p class="adm-kpi__label">Live market posts</p>
                <p class="adm-kpi__value">@_summary.LiveMarketItems</p>
                <p class="adm-kpi__foot"><a href="admin/marketplace">Open moderation</a></p>
            </div>
            <div class="adm-kpi adm-kpi--amber">
                <p class="adm-kpi__label">Items sold</p>
                <p class="adm-kpi__value">@Stats.ItemsSold.ToString("N0")</p>
                <p class="adm-kpi__foot">of @Stats.ItemsListed.ToString("N0") total listings</p>
            </div>
            <div class="adm-kpi">
                <p class="adm-kpi__label">Helpers hired</p>
                <p class="adm-kpi__value">@Stats.HelpersHired</p>
                <p class="adm-kpi__foot">domestic help arranged</p>
            </div>
        </div>
    </section>
</div>

@code {
    private AdminSummaryDto _summary = new();
    private AdminDashboardStatsDto _stats = new();
    private List<AdminRevenuePointDto> _revenue = new();
    private List<AdminGrowthPointDto> _growth = new();
    private List<AdminAuditEntryDto> _audit = new();

    private AdminDashboardStatsDto Stats => _stats;
    private List<AdminGrowthPointDto> Growth => _growth;

    protected override async Task OnInitializedAsync()
    {
        var dashboard = Admin.GetDashboardAsync();
        var audit = Admin.GetAuditAsync(5);
        var data = await dashboard;
        _summary = data.Summary;
        _stats = data.Stats;
        _revenue = data.Revenue;
        _growth = data.Growth;
        _audit = await audit;
        _outcomes = null;
    }

    private List<string> Months => _revenue.Select(r => r.MonthUtc.ToLocalTime().ToString("MMM")).ToList();

    private RevenueChartTab _revenueTab = RevenueChartTab.All;

    private List<ChartSeries> RevenueSeries => _revenueTab switch
    {
        RevenueChartTab.Verification => new()
        {
            new ChartSeries { Name = "Verification revenue", Color = "#7c3aed", Values = _revenue.Select(r => (int)r.Verification).ToList() }
        },
        RevenueChartTab.Marketplace => new()
        {
            new ChartSeries { Name = "Marketplace revenue", Color = "#0d9488", Values = _revenue.Select(r => (int)(r.MarketplacePostingPlans + r.MarketplacePins)).ToList() }
        },
        _ => new()
        {
            new ChartSeries { Name = "Total revenue", Color = "#6d28d9", Values = _revenue.Select(r => (int)TotalRevenue(r)).ToList() }
        }
    };

    private string RevenueChartTitle => _revenueTab switch
    {
        RevenueChartTab.Verification => "Verification revenue",
        RevenueChartTab.Marketplace => "Marketplace revenue",
        _ => "Revenue overview"
    };

    private string RevenueChartDescription => _revenueTab switch
    {
        RevenueChartTab.Verification => "Verification-fee payments received over the last 12 months.",
        RevenueChartTab.Marketplace => "Total marketplace revenue from posting-plan purchases and post-pinning payments over the last 12 months.",
        _ => "Combined verification and marketplace revenue over the last 12 months."
    };

    private int SelectedYearRevenue => _revenueTab switch
    {
        RevenueChartTab.Verification => (int)_revenue.Sum(r => r.Verification),
        RevenueChartTab.Marketplace => (int)_revenue.Sum(r => r.MarketplacePostingPlans + r.MarketplacePins),
        _ => YearRevenue
    };

    private string RevenueTabClass(RevenueChartTab tab) => _revenueTab == tab ? "adm-tab--on" : string.Empty;

    private List<DonutSlice> RevenueSplit => new()
    {
        new DonutSlice { Name = "Verification", Value = CurrentVerificationRevenue, Color = "#7c3aed" },
        new DonutSlice { Name = "Marketplace", Value = CurrentMarketplaceRevenue, Color = "#0d9488" }
    };

    private List<(string Label, int Value)> Outcomes => _outcomes ??= new()
    {
        ("Homes created", Stats.HomesCreated),
        ("Domestic helpers hired", Stats.HelpersHired),
        ("Items bought and sold", Stats.ItemsSold),
        ("Accounts verified", Stats.VerifiedAccounts),
        ("Fake posts taken down", _summary.PostsTakenDown)
    };

    private List<(string Label, int Value)>? _outcomes;

    private int MaxOutcome => Math.Max(1, Outcomes.Max(o => o.Value));

    private int MaxGrowth => Math.Max(1, Growth.Count == 0 ? 0 : Growth.Max(g => g.Users));

    private static decimal TotalRevenue(AdminRevenuePointDto point) =>
        point.Verification + point.MarketplacePostingPlans + point.MarketplacePins;

    private int MonthRevenue => _revenue.Count == 0 ? 0 : (int)TotalRevenue(_revenue[^1]);

    private int CurrentVerificationRevenue => _revenue.Count == 0 ? 0 : (int)_revenue[^1].Verification;

    private int CurrentMarketplaceRevenue => _revenue.Count == 0
        ? 0
        : (int)(_revenue[^1].MarketplacePostingPlans + _revenue[^1].MarketplacePins);

    private int LastMonthRevenue => _revenue.Count < 2 ? 0 : (int)TotalRevenue(_revenue[^2]);

    private int YearRevenue => (int)_revenue.Sum(TotalRevenue);

    private string GrowthPercent =>
        LastMonthRevenue == 0
            ? "0"
            : (100.0 * (MonthRevenue - LastMonthRevenue) / LastMonthRevenue).ToString("0.#");

    private static string DotClass(string kind) => kind switch
    {
        "ok" => "adm-tl__dot--ok",
        "danger" => "adm-tl__dot--danger",
        _ => ""
    };

    private static string Css(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private enum RevenueChartTab
    {
        All,
        Verification,
        Marketplace
    }
}
