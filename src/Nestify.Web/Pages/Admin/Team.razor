@page "/admin/team"
@layout AdminShell
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService Admin
@inject ToastService Toast

<PageTitle>Admin accounts — Nestify Admin</PageTitle>

<header class="adm-head adm-rise">
    <div>
        <p class="adm-eyebrow">Team</p>
        <h1>Admin accounts</h1>
        <p>Admins are created here, never through public sign-up. Give a new admin their own account instead of sharing yours.</p>
    </div>
    <div class="adm-head__actions">
        <button class="adm-btn adm-btn--primary" type="button" @onclick="StartNew">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Add an admin
        </button>
    </div>
</header>

<div class="adm-grid adm-grid--3" style="margin-bottom:1.15rem;">
    <article class="adm-kpi adm-rise" style="--d:.04s">
        <p class="adm-kpi__label">Active admins</p>
        <p class="adm-kpi__value">@_admins.Count(a => a.IsActive)</p>
        <p class="adm-kpi__foot">can sign in right now</p>
    </article>
    <article class="adm-kpi adm-kpi--amber adm-rise" style="--d:.1s">
        <p class="adm-kpi__label">Suspended</p>
        <p class="adm-kpi__value">@_admins.Count(a => !a.IsActive)</p>
        <p class="adm-kpi__foot">kept for the audit trail</p>
    </article>
    <article class="adm-kpi adm-kpi--sky adm-rise" style="--d:.16s">
        <p class="adm-kpi__label">Actions logged</p>
        <p class="adm-kpi__value">@_auditCount</p>
        <p class="adm-kpi__foot">across the whole team</p>
    </article>
</div>

<section class="adm-card adm-rise" style="--d:.22s">
    <div class="adm-card__head">
        <div>
            <h2>Everyone with console access</h2>
            <p>Suspending an admin blocks sign-in but keeps their past actions in the log.</p>
        </div>
    </div>

    @if (_loading)
    {
        <EmptyState Title="Loading" Message="Fetching admin accounts." />
    }
    else
    {
        <div class="adm-table__scroll">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Admin</th>
                        <th>Scope</th>
                        <th>Added</th>
                        <th>Last active</th>
                        <th>Status</th>
                        <th class="adm-table__right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in _admins)
                    {
                        var current = admin;
                        <tr>
                            <td>
                                <div class="adm-table__strong">@current.FullName</div>
                                <div class="adm-table__sub">@current.Email · @current.Phone</div>
                            </td>
                            <td>@current.Scope</td>
                            <td>@current.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td>@AdminConsoleService.Ago(current.LastActiveUtc)</td>
                            <td>
                                <span class="adm-badge @(current.IsActive ? "adm-badge--ok" : "adm-badge--muted")">
                                    @(current.IsActive ? "Active" : "Suspended")
                                </span>
                            </td>
                            <td class="adm-table__right">
                                <div class="adm-table__actions">
                                    <button class="adm-btn @(current.IsActive ? "adm-btn--danger" : "adm-btn--ok") adm-btn--sm"
                                            type="button" disabled="@_busy" @onclick="() => Toggle(current)">
                                        @(current.IsActive ? "Suspend" : "Restore")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (_draft is not null)
{
    <div class="adm-modal" role="dialog" aria-modal="true">
        <div class="adm-modal__box">
            <div class="adm-modal__head">
                <div>
                    <h2>Create an admin account</h2>
                    <p>They sign in with this email and the temporary password you set.</p>
                </div>
                <button class="adm-icon-btn" type="button" aria-label="Close" @onclick="() => _draft = null">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <div class="adm-form">
                <div class="adm-field">
                    <label for="admin-name">Full name</label>
                    <input id="admin-name" class="adm-input" @bind="_draft.FullName" placeholder="Rezwana Karim" />
                </div>
                <div class="adm-field">
                    <label for="admin-email">Email</label>
                    <input id="admin-email" class="adm-input" type="email" @bind="_draft.Email" placeholder="name@nestify.com" />
                </div>
                <div class="adm-grid adm-grid--2">
                    <div class="adm-field">
                        <label for="admin-phone">Phone</label>
                        <input id="admin-phone" class="adm-input" @bind="_draft.Phone" placeholder="017xx-xxxxxx" />
                    </div>
                    <div class="adm-field">
                        <label for="admin-scope">Scope</label>
                        <select id="admin-scope" class="adm-select" @bind="_draft.Scope">
                            <option>Full access</option>
                            <option>Verification</option>
                            <option>Moderation</option>
                            <option>Finance</option>
                        </select>
                    </div>
                </div>
                <div class="adm-field">
                    <label for="admin-pass">Temporary password</label>
                    <input id="admin-pass" class="adm-input" type="text" @bind="_draft.Password" placeholder="At least 8 characters" />
                </div>

                @if (_error is not null)
                {
                    <p class="adm-badge adm-badge--danger">@_error</p>
                }

                <p class="adm-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
                    Creating an admin is itself an audited action, so the log shows who added whom.
                </p>
            </div>

            <div class="adm-modal__foot">
                <button class="adm-btn adm-btn--ghost" type="button" @onclick="() => _draft = null">Cancel</button>
                <button class="adm-btn adm-btn--primary" type="button" disabled="@_busy" @onclick="Create">Create account</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminAccountDto> _admins = new();
    private int _auditCount;
    private bool _loading = true;
    private bool _busy;

    private CreateAdminDto? _draft;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var admins = Admin.GetAdminsAsync();
        var audit = Admin.GetAuditAsync(1000);
        _admins = await admins;
        _auditCount = (await audit).Count;
        _loading = false;
    }

    private void StartNew()
    {
        _draft = new CreateAdminDto { Scope = "Moderation" };
        _error = null;
    }

    private async Task Create()
    {
        if (_draft is null) return;

        if (string.IsNullOrWhiteSpace(_draft.FullName) ||
            string.IsNullOrWhiteSpace(_draft.Email) ||
            _draft.Password.Length < 8)
        {
            _error = "Name, email and an 8+ character temporary password are needed.";
            return;
        }

        _busy = true;
        var (ok, message) = await Admin.CreateAdminAsync(_draft);
        _busy = false;

        if (!ok)
        {
            _error = message;
            return;
        }

        _draft = null;
        _error = null;
        await LoadAsync();
    }

    private async Task Toggle(AdminAccountDto admin)
    {
        _busy = true;
        var (ok, message) = await Admin.ToggleAdminAsync(admin.Id);
        _busy = false;
        if (!ok)
        {
            Toast.ShowError(message);
            return;
        }

        await LoadAsync();
    }
}
