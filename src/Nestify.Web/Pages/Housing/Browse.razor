@page "/housing"
@using Nestify.Shared.Dtos.Area
@inject IHousingService Housing

<PageTitle>Housing — Nestify</PageTitle>

<section class="nx-section hs-page">
    <div class="nx-container hs-wrap">
        <header class="hs-head">
            <div class="hs-head__titles">
                <p class="nx-eyebrow">M1 · Housing</p>
                <h1>A seat or a house, <span class="nx-display-accent">near where you already live your life.</span></h1>
                <p class="hs-head__lead">
                    Browse open seats and houses posted by managers on Nestify. Every listing you see already
                    matches your profile — there is nothing to filter out yourself.
                </p>
            </div>
            
            <div class="hs-head__actions">
                <a class="nx-btn nx-btn--ghost" href="housing/mine">My posts</a>
                <a class="nx-btn nx-btn--ghost" href="bookings/mine">My bookings</a>
                <a class="nx-btn nx-btn--primary" href="housing/new">
                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    Post a listing
                </a>
            </div>
        </header>

        <div class="hs-browse">
            <aside class="hs-lens" aria-label="Filter listings">
                <div class="hs-lens__row">
                    <span class="hs-lens__label">Area</span>
                    <AreaCascade Selection="_areaSelection" SelectionChanged="OnAreaChanged" />
                </div>

                <div class="hs-lens__row">
                    <span class="hs-lens__label">Listing type</span>
                    <div class="hs-seg hs-seg--wrap">
                        <button type="button" class="hs-seg__opt @(_filter.ListingType is null ? "hs-seg__opt--active" : null)"
                                @onclick="() => SetListingType(null)">Any</button>
                        @foreach (var t in _listingTypes)
                        {
                            <button type="button" class="hs-seg__opt @(_filter.ListingType == t ? "hs-seg__opt--active" : null)"
                                    @onclick="() => SetListingType(t)">@HousingView.ShortLabel(t)</button>
                        }
                    </div>
                </div>

                <div class="hs-lens__row">
                    <label class="hs-lens__label" for="hs-max-rent">Max rent (৳/mo)</label>
                    <input id="hs-max-rent" type="number" min="0" step="500" placeholder="No limit" inputmode="numeric"
                           value="@_filter.MaxRent" @onchange="OnMaxRent" />
                </div>

                @if (HasActiveFilters)
                {
                    <button type="button" class="hs-lens__clear" @onclick="ClearFilters">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M6 18 18 6" /></svg>
                        Clear all filters
                    </button>
                }
            </aside>

            <div class="hs-results">
                <p class="hs-results__count">
                    @if (_loading)
                    {
                        <span>Loading listings…</span>
                    }
                    else if (_page is not null)
                    {
                        <span><strong>@_page.TotalCount</strong> @(_page.TotalCount == 1 ? "listing" : "listings")</span>
                    }
                </p>

                @if (_loading)
                {
                    <div class="hs-grid">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="hs-skeleton hs-skeleton--card"></div>
                        }
                    </div>
                }
                else if (_error)
                {
                    <div class="hs-empty">
                        <h3>Couldn't load listings</h3>
                        <p>Something went wrong reaching housing. Try again in a moment.</p>
                        <button class="nx-btn nx-btn--primary" @onclick="LoadAsync">Retry</button>
                    </div>
                }
                else if (_page is null || _page.Items.Count == 0)
                {
                    <div class="hs-empty">
                        <h3>Nothing matches those filters</h3>
                        <p>No active listing fits this combination yet. Try a different area or widen the rent range.</p>
                        @if (HasActiveFilters)
                        {
                            <button class="nx-btn nx-btn--ghost" @onclick="ClearFilters">Clear filters</button>
                        }
                    </div>
                }
                else
                {
                    <div class="hs-grid">
                        @foreach (var post in _page.Items)
                        {
                            <HousingPostCard Post="post" />
                        }
                    </div>

                    @if (_page.TotalPages > 1)
                    {
                        <nav class="hs-pager" aria-label="Pagination">
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasPrevious)" @onclick="PrevPage">Previous</button>
                            <span class="hs-pager__pages">Page @_page.Page of @_page.TotalPages</span>
                            <button class="nx-btn nx-btn--ghost" disabled="@(!_page.HasNext)" @onclick="NextPage">Next</button>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private readonly ListingType[] _listingTypes = Enum.GetValues<ListingType>();

    private AreaSelectionDto _areaSelection = new();
    private HousingPostFilterDto _filter = new();
    private HousingPageDto<HousingPostSummaryDto>? _page;
    private bool _loading = true;
    private bool _error;

    private bool HasActiveFilters =>
        _filter.ListingType is not null || _filter.MaxRent is not null ||
        _filter.DivisionId is not null || _filter.DistrictId is not null || _filter.UpazilaId is not null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            _page = await Housing.BrowseAsync(_filter);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyAsync()
    {
        _filter.Page = 1;
        return LoadAsync();
    }

    private Task OnAreaChanged(AreaSelectionDto selection)
    {
        _filter.DivisionId = selection.DivisionId;
        _filter.DistrictId = selection.DistrictId;
        _filter.UpazilaId = selection.UpazilaId;
        return ApplyAsync();
    }

    private Task SetListingType(ListingType? t)
    {
        _filter.ListingType = t;
        return ApplyAsync();
    }

    private Task OnMaxRent(ChangeEventArgs e)
    {
        _filter.MaxRent = decimal.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
        return ApplyAsync();
    }

    private Task ClearFilters()
    {
        _areaSelection = new AreaSelectionDto();
        _filter = new HousingPostFilterDto();
        return LoadAsync();
    }

    private Task PrevPage()
    {
        if (_page?.HasPrevious == true) { _filter.Page--; return LoadAsync(); }
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        if (_page?.HasNext == true) { _filter.Page++; return LoadAsync(); }
        return Task.CompletedTask;
    }
}