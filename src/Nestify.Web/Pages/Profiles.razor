@page "/profiles"
@page "/profiles/{Kind}"

<PageTitle>@ActiveProfile.Title - Nestify</PageTitle>

<section class="nx-section profile-page">
    <div class="nx-container profile-wrap">
        <header class="profile-head">
            <div>
                <p class="nx-eyebrow">Profiles</p>
                <h1>@ActiveProfile.Title</h1>
                <p class="profile-head__lead">@ActiveProfile.Summary</p>
            </div>
            <nav class="profile-tabs" aria-label="Profile types">
                @foreach (var profile in ProfileTypes)
                {
                    <a class="profile-tab @(profile.Key == ActiveKey ? "profile-tab--active" : null)"
                       href="@($"profiles/{profile.Key}")">
                        @profile.ShortLabel
                    </a>
                }
            </nav>
        </header>

        <div class="profile-hero profile-hero--@ActiveProfile.Key">
            <div class="profile-identity">
                <div class="profile-avatar">@ActiveProfile.Initials</div>
                <div>
                    <p class="profile-kicker">@ActiveProfile.RoleLabel</p>
                    <h2>@ActiveProfile.Name</h2>
                    <p>@ActiveProfile.Location</p>
                </div>
            </div>
            <div class="profile-badges" aria-label="Status">
                @foreach (var badge in ActiveProfile.Badges)
                {
                    <span>@badge</span>
                }
            </div>
        </div>

        <div class="profile-grid">
            <section class="profile-panel profile-panel--wide">
                <h3>@ActiveProfile.PrimarySectionTitle</h3>
                <div class="profile-fields">
                    @foreach (var field in ActiveProfile.Fields)
                    {
                        <div class="profile-field">
                            <span>@field.Label</span>
                            <strong>@field.Value</strong>
                        </div>
                    }
                </div>
            </section>

            <section class="profile-panel">
                <h3>Contact</h3>
                <div class="profile-contact">
                    @foreach (var item in ActiveProfile.Contact)
                    {
                        <p>
                            <span>@item.Label</span>
                            <strong>@item.Value</strong>
                        </p>
                    }
                </div>
            </section>

            <section class="profile-panel">
                <h3>Permissions</h3>
                <ul class="profile-list">
                    @foreach (var permission in ActiveProfile.Permissions)
                    {
                        <li>@permission</li>
                    }
                </ul>
            </section>

            <section class="profile-panel profile-panel--wide">
                <h3>Activity</h3>
                <div class="profile-metrics">
                    @foreach (var metric in ActiveProfile.Metrics)
                    {
                        <div class="profile-metric">
                            <strong>@metric.Value</strong>
                            <span>@metric.Label</span>
                        </div>
                    }
                </div>
            </section>

            <section class="profile-panel">
                <h3>Plan Guardrails</h3>
                <ul class="profile-list">
                    @foreach (var rule in ActiveProfile.Guardrails)
                    {
                        <li>@rule</li>
                    }
                </ul>
            </section>
        </div>
    </div>
</section>

