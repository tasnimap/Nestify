@page "/register"
@using System.ComponentModel.DataAnnotations
@using Nestify.Shared.Dtos.Auth
@using Nestify.Web.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Create your account — Nestify</PageTitle>

<section class="auth">
    <aside class="auth__aside auth__aside--register">
        <a class="auth__brand" href="">
            <span class="auth__mark" aria-hidden="true">N</span>
            <span>Nestify</span>
        </a>
        <div class="auth__aside-copy">
            <p class="nx-eyebrow auth__eyebrow">Join Nestify</p>
            <h1>One verified account for four everyday problems.</h1>
            <p class="auth__aside-lead">
                Register once and use the same identity across housing, domestic help,
                shared-expense settlement and the second-hand marketplace.
            </p>
        </div>
        <ul class="auth__points">
            <li>
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Verify your identity a single time
            </li>
            <li>
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Built around Bangladesh's areas and Taka pricing
            </li>
            <li>
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Immutable, auditable expense records
            </li>
        </ul>
    </aside>

    <div class="auth__main">
        <div class="auth__card">
            <header class="auth__head">
                <h2>Create your account</h2>
                <p>It takes about a minute.</p>
            </header>

            <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" class="auth__form" novalidate>
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="name">Full name</label>
                    <InputText id="name" @bind-Value="_model.Name" class="field__input"
                               autocomplete="name" placeholder="e.g. Rafiul Karim" />
                    <ValidationMessage For="@(() => _model.Name)" class="field__error" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="email">Email address</label>
                        <InputText id="email" @bind-Value="_model.Email" class="field__input"
                                   type="email" autocomplete="email" placeholder="you@example.com" />
                        <ValidationMessage For="@(() => _model.Email)" class="field__error" />
                    </div>

                    <div class="field">
                        <label for="phone">Phone number</label>
                        <InputText id="phone" @bind-Value="_model.Phone" class="field__input"
                                   type="tel" autocomplete="tel" placeholder="01XXXXXXXXX" />
                        <ValidationMessage For="@(() => _model.Phone)" class="field__error" />
                    </div>
                </div>

                <div class="field">
                    <label for="studentId">Student / National ID</label>
                    <InputText id="studentId" @bind-Value="_model.StudentId" class="field__input"
                               placeholder="Used for verification" />
                    <ValidationMessage For="@(() => _model.StudentId)" class="field__error" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="field__control">
                            <InputText id="password" @bind-Value="_model.Password" class="field__input"
                                       type="@(_showPassword ? "text" : "password")"
                                       autocomplete="new-password" placeholder="At least 8 characters" />
                            <button type="button" class="field__toggle"
                                    aria-pressed="@_showPassword.ToString().ToLowerInvariant()"
                                    aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                    @onclick="() => _showPassword = !_showPassword">
                                @(_showPassword ? "Hide" : "Show")
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _model.Password)" class="field__error" />
                    </div>

                    <div class="field">
                        <label for="confirm">Confirm password</label>
                        <InputText id="confirm" @bind-Value="_model.ConfirmPassword" class="field__input"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="new-password" placeholder="Re-enter your password" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" class="field__error" />
                    </div>
                </div>

                <label class="field__check">
                    <input type="checkbox" @bind="_model.AcceptTerms" />
                    <span>I agree to Nestify's terms of use and privacy policy.</span>
                </label>
                <ValidationMessage For="@(() => _model.AcceptTerms)" class="field__error" />

                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="auth__alert @(_isError ? null : "auth__alert--ok")" role="alert">@_message</p>
                }

                <button class="nx-btn nx-btn--primary nx-btn--lg nx-btn--block" type="submit" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="auth__spinner" aria-hidden="true"></span>
                        <span>Creating your account…</span>
                    }
                    else
                    {
                        <span>Create account</span>
                    }
                </button>
            </EditForm>

            <p class="auth__switch">
                Already have an account?
                <a href="login">Log in here</a>
            </p>
        </div>
    </div>
</section>

@code {
    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Enter your full name.")]
        [StringLength(120, MinimumLength = 2, ErrorMessage = "Name must be 2–120 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "That doesn't look like a valid email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your phone number.")]
        [RegularExpression(@"^01[0-9]{9}$", ErrorMessage = "Enter an 11-digit number starting with 01.")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your student or national ID.")]
        [StringLength(40, MinimumLength = 4, ErrorMessage = "ID must be 4–40 characters.")]
        public string StudentId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Choose a password.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Re-enter your password.")]
        [Compare(nameof(Password), ErrorMessage = "The two passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "You need to accept the terms to continue.")]
        public bool AcceptTerms { get; set; }
    }

    private readonly RegisterModel _model = new();
    private bool _showPassword;
    private bool _isSubmitting;
    private bool _isError = true;
    private string? _message;

    private async Task HandleRegisterAsync()
    {
        _isSubmitting = true;
        _message = null;

        try
        {
            var request = new RegisterRequestDto
            {
                Name = _model.Name,
                Email = _model.Email,
                Phone = _model.Phone,
                Password = _model.Password,
                StudentId = _model.StudentId,
            };

            var result = await AuthService.RegisterAsync(request);

            if (result is null)
            {
                _isError = true;
                _message = "We couldn't create your account with those details.";
                return;
            }

            _isError = false;
            _message = "Account created. Taking you to your dashboard…";
            Navigation.NavigateTo("/");
        }
        catch
        {
            _isError = true;
            _message = "We couldn't reach Nestify right now. Please try again in a moment.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
