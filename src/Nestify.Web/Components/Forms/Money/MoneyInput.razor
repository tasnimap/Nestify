@* src/Nestify.Web/Components/Forms/Money/MoneyInput.razor *@
@typeparam TValue
@inherits InputBase<TValue>
@inject MoneyFormatterService MoneyFormatter

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="field__label">@Label</label>
    }

    @if (HelperContent != null)
    {
        <div class="field__helper">
            @HelperContent
        </div>
    }

    <div class="field__control @(HasError ? "field__control--error" : "") money-input__control">
        <span class="money-input__prefix" aria-hidden="true">৳</span>
        <input
            id="@Id"
            type="text"
            class="field__input money-input__field @CssClass"
            @attributes="AdditionalAttributes"
            @bind="FormattedValue"
            @bind:event="oninput"
            placeholder="@Placeholder"
            disabled="@Disabled"
            inputmode="decimal"
            pattern="[0-9,.]+" />
    </div>

    @if (HasError)
    {
        <div class="field__error" role="alert">
            @foreach (var message in ValidationMessages)
            {
                <div>@message</div>
            }
        </div>
    }
</div>

@code {
    private string _id = $"money-{Guid.NewGuid():N}";
    private string _formattedValue = string.Empty;
    private List<string> ValidationMessages { get; } = new();

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; } = "0.00";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? HelperContent { get; set; }

    public string Id
    {
        get => _id;
        set => _id = value;
    }

    private bool HasError => EditContext?.GetValidationMessages(FieldIdentifier).Any() ?? false;

    private string FormattedValue
    {
        get => _formattedValue;
        set
        {
            _formattedValue = value;
            
            if (MoneyFormatter.TryParse(value, out decimal parsedValue))
            {
                CurrentValue = (TValue)(object)parsedValue;
            }
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (EditContext != null)
        {
            ValidationMessages.Clear();
            ValidationMessages.AddRange(
                EditContext.GetValidationMessages(FieldIdentifier)
            );
        }

        // Format the current value for display
        if (CurrentValue is decimal decimalValue)
        {
            _formattedValue = MoneyFormatter.FormatNumber(decimalValue);
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (MoneyFormatter.TryParse(value ?? string.Empty, out decimal parsedValue))
        {
            result = (TValue)(object)parsedValue;
            validationErrorMessage = string.Empty;
            return true;
        }

        result = default!;
        validationErrorMessage = "Please enter a valid amount.";
        return false;
    }
}
