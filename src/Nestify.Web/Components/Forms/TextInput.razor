@* src/Nestify.Web/Components/Forms/TextInput.razor *@
@typeparam TValue
@inherits InputBase<TValue>

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="field__label">@Label</label>
    }
    
    @if (HelperContent != null)
    {
        <div class="field__helper">
            @HelperContent
        </div>
    }

    <div class="field__control @(HasError ? "field__control--error" : "")">
        <input
            id="@Id"
            type="@Type"
            class="field__input @CssClass"
            @attributes="AdditionalAttributes"
            @bind="CurrentValueAsString"
            placeholder="@Placeholder"
            disabled="@Disabled"
            autocomplete="@Autocomplete" />
        @if (!string.IsNullOrEmpty(ActionLabel))
        {
            <button type="button" class="field__action"
                    @onclick="OnAction"
                    aria-label="@ActionLabel">
                @ActionLabel
            </button>
        }
    </div>

    @if (HasError)
    {
        <div class="field__error" role="alert">
            @foreach (var message in ValidationMessages)
            {
                <div>@message</div>
            }
        </div>
    }
</div>

@code {
    private string _id = $"input-{Guid.NewGuid():N}";
    private List<string> ValidationMessages { get; } = new();

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? Autocomplete { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? HelperContent { get; set; }

    [Parameter]
    public string? ActionLabel { get; set; }

    [Parameter]
    public EventCallback OnAction { get; set; }

    public string Id
    {
        get => _id;
        set => _id = value;
    }

    private bool HasError => EditContext?.GetValidationMessages(FieldIdentifier).Any() ?? false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (EditContext != null)
        {
            ValidationMessages.Clear();
            ValidationMessages.AddRange(
                EditContext.GetValidationMessages(FieldIdentifier)
            );
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (typeof(TValue) == typeof(string))
        {
            result = (TValue)(object)(value ?? string.Empty);
            validationErrorMessage = string.Empty;
            return true;
        }

        result = default!;
        validationErrorMessage = $"{GetType()} does not support values of type {typeof(TValue)}.";
        return false;
    }
}
