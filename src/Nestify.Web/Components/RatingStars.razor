@inject IStringLocalizer<SharedResource> L

<div class="rt-stars" role="@(ReadOnly ? "img" : "radiogroup")" aria-label="@GroupLabel" @onmouseleave="ClearPreview">
    @for (var i = 1; i <= 5; i++)
    {
        var displayValue = ReadOnly && HalfStars ? RoundedHalfValue : DisplayValue;
        var full = i <= Math.Floor(displayValue);
        var half = !full && displayValue >= i - .5 && displayValue < i;
        var star = i;
        @if (ReadOnly)
        {
            <span class="rt-star @(full ? "rt-star--filled" : half ? "rt-star--half" : null)" aria-hidden="true">@(full ? "★" : "☆")</span>
        }
        else
        {
            <button type="button" class="rt-star rt-star--input @(full ? "rt-star--filled" : null)"
                    role="radio" aria-label='@L["{0} stars", star]' aria-checked="@(Value == star)"
                    tabindex="@(star == TabStopValue ? 0 : -1)"
                    @onmouseenter="() => _hoverValue = star"
                    @onkeydown="e => HandleKeyDown(e, star)"
                    @onclick="() => SetValue(star)">@(full ? "★" : "☆")</button>
        }
    }
    @if (ShowCount && Count is not null)
    {
        <span class="rt-count">(@Count)</span>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = true;
    [Parameter] public bool ShowCount { get; set; } = true;
    [Parameter] public bool HalfStars { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private int? _hoverValue;
    private int DisplayValue => Math.Clamp((int)Math.Round(ReadOnly ? Value : _hoverValue ?? Value, MidpointRounding.AwayFromZero), 0, 5);
    private double RoundedHalfValue => Math.Clamp(Math.Round(Value * 2, MidpointRounding.AwayFromZero) / 2, 0, 5);
    private int TabStopValue => Math.Clamp((int)Math.Round(Value, MidpointRounding.AwayFromZero), 1, 5);

    private string GroupLabel => ReadOnly ? AriaLabel : L["Rating"].Value;
    private string AriaLabel => Count is { } c
        ? L["{0} out of 5 stars, {1} reviews", Value.ToString("0.0"), c]
        : L["{0} out of 5 stars", Value.ToString("0.0")];

    private Task SetValue(int v)
    {
        Value = v;
        _hoverValue = null;
        return ValueChanged.InvokeAsync(v);
    }

    private Task HandleKeyDown(KeyboardEventArgs e, int currentValue) => e.Key switch
    {
        "ArrowRight" or "ArrowUp" => SetValue(Math.Min(5, currentValue + 1)),
        "ArrowLeft" or "ArrowDown" => SetValue(Math.Max(1, currentValue - 1)),
        "Home" => SetValue(1),
        "End" => SetValue(5),
        _ => Task.CompletedTask
    };

    private void ClearPreview() => _hoverValue = null;
}
