@inject Nestify.Web.Services.ToastService Toast

@* Frontend-phase image picker, shared by the housing and marketplace post forms.
   A picked file is shrunk in the browser and kept as a data URL so the listing
   preview shows the real picture; NOTHING is uploaded yet — the photos are
   validated and stored server-side in a later phase (§11.5.3). The limits shown
   here are UX guidance, never a guarantee. *@

<div class="mk-up">
    <label class="mk-up__zone @(_full ? "is-full" : null)">
        <InputFile OnChange="OnPick" multiple accept=".jpg,.jpeg,.png,.webp" disabled="@_full" />
        <span class="mk-up__zone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <path d="M17 8 12 3 7 8" />
                <path d="M12 3v13" />
            </svg>
        </span>
        <span class="mk-up__zone-text">
            <strong>@(_full ? "Photo limit reached" : "Add photos")</strong>
            <span class="mk-muted">JPG, PNG or WebP · up to @MaxSizeMb MB each · @MaxImages max</span>
        </span>
    </label>

    @if (_items.Count > 0)
    {
        <ul class="mk-up__list">
            @foreach (var entry in _items)
            {
                <li class="mk-up__item">
                    <MediaTile Seed="@entry.Seed" Label="@entry.Name" />
                    <span class="mk-up__name" title="@entry.Name">@entry.Name</span>
                    <span class="mk-up__size">@entry.SizeLabel</span>
                    <button type="button" class="mk-up__remove" @onclick="() => Remove(entry)"
                            aria-label="@($"Remove {entry.Name}")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M6 18 18 6" /></svg>
                    </button>
                </li>
            }
        </ul>
    }

    <p class="mk-up__note">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="nx-icon"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
        These checks are a preview. Your photos are checked again on our side when the listing goes live.
    </p>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Value { get; set; } = new List<string>();
    [Parameter] public EventCallback<IReadOnlyList<string>> ValueChanged { get; set; }

    [Parameter] public int MaxImages { get; set; } = 6;
    [Parameter] public int MaxSizeMb { get; set; } = 5;

    private sealed record Entry(string Seed, string Name, string SizeLabel);

    private readonly List<Entry> _items = new();
    private bool _full => _items.Count >= MaxImages;
    private long MaxBytes => MaxSizeMb * 1024L * 1024L;
    private static readonly string[] AllowedExt = { ".jpg", ".jpeg", ".png", ".webp" };

    protected override void OnInitialized()
    {
        // Photos already on the listing (the edit form) show as saved rows. A data
        // URL has no readable name, so number them instead.
        for (var i = 0; i < Value.Count; i++)
        {
            var seed = Value[i];
            var name = seed.StartsWith("tile:") ? seed[5..].Replace('-', ' ') : $"Photo {i + 1}";
            _items.Add(new Entry(seed, name, "saved"));
        }
    }

    private async Task OnPick(InputFileChangeEventArgs e)
    {
        var room = MaxImages - _items.Count;
        if (room <= 0) return;

        var rejected = 0;
        foreach (var file in e.GetMultipleFiles(Math.Min(room, e.FileCount)))
        {
            var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
            if (Array.IndexOf(AllowedExt, ext) < 0 || file.Size > MaxBytes)
            {
                rejected++;
                continue;
            }

            _items.Add(new Entry(await ToPreviewAsync(file), file.Name, FormatSize(file.Size)));
        }

        if (rejected > 0)
        {
            Toast.ShowWarning($"{rejected} file(s) skipped — wrong type or over {MaxSizeMb} MB.", "Some photos not added");
        }

        await PushAsync();
    }

    // Shrink in the browser and keep the bytes as a data URL. A file that will not
    // decode (a renamed non-image, say) falls back to a generated tile.
    private async Task<string> ToPreviewAsync(IBrowserFile file)
    {
        try
        {
            var resized = await file.RequestImageFileAsync("image/jpeg", 900, 900);
            using var buffer = new MemoryStream();
            await using (var stream = resized.OpenReadStream(MaxBytes))
            {
                await stream.CopyToAsync(buffer);
            }
            return "data:image/jpeg;base64," + Convert.ToBase64String(buffer.ToArray());
        }
        catch
        {
            return $"tile:{System.IO.Path.GetFileNameWithoutExtension(file.Name)}-{Guid.NewGuid().ToString("N")[..4]}";
        }
    }

    private async Task Remove(Entry entry)
    {
        _items.Remove(entry);
        await PushAsync();
    }

    private Task PushAsync()
    {
        Value = _items.Select(i => i.Seed).ToList();
        return ValueChanged.InvokeAsync(Value);
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0} KB",
        _ => $"{bytes} B"
    };
}
