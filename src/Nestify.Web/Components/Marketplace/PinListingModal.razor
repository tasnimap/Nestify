@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast

<div class="mk-modal-overlay" @onclick="Cancel">
    <div class="mk-modal mk-pin-modal" @onclick:stopPropagation="true">
        <header class="mk-modal__header mk-pin-modal__head">
            <div class="mk-pin-modal__brand">
                <span class="mk-pin-modal__bkash-tag">bKash</span>
                <h2>@(IsCurrentlyPinned ? "Extend Pinned Listing" : "Pin Listing to Top")</h2>
            </div>
            <button type="button" class="mk-modal__close" @onclick="Cancel" aria-label="Close" disabled="@_busy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </header>

        <div class="mk-modal__body">
            @if (_receipt is not null)
            {
                <div class="mk-pin-receipt">
                    <div class="mk-pin-receipt__tick" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>

                    <h3 class="mk-pin-receipt__title">Listing Pinned Successfully!</h3>
                    <p class="mk-pin-receipt__subtitle">
                        Your item is featured with priority ranking at the top of Marketplace browse results.
                    </p>

                    <div class="mk-pin-receipt__card">
                        <div class="mk-pin-receipt__row">
                            <span>Item</span>
                            <strong>@ListingTitle</strong>
                        </div>
                        <div class="mk-pin-receipt__row">
                            <span>Amount Paid</span>
                            <strong class="mk-pin-receipt__amount">৳@_receipt.AmountBdt.ToString("N0") BDT</strong>
                        </div>
                        <div class="mk-pin-receipt__row">
                            <span>bKash Number</span>
                            <span>@_receipt.BkashNumber</span>
                        </div>
                        <div class="mk-pin-receipt__row">
                            <span>Transaction ID</span>
                            <span class="mk-pin-receipt__mono">@_receipt.TransactionId</span>
                        </div>
                        <div class="mk-pin-receipt__row">
                            <span>Pinned Until</span>
                            <strong class="mk-pin-receipt__highlight">@_receipt.PinnedUntilUtc.ToLocalTime().ToString("d MMMM yyyy, h:mm tt")</strong>
                        </div>
                    </div>

                    <div class="mk-pin-receipt__actions">
                        <button type="button" class="nx-btn nx-btn--primary nx-btn--block" @onclick="CloseReceipt">
                            Done
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="mk-pin-info">
                    <div class="mk-pin-info__item">
                        <div class="mk-pin-info__thumb">
                            <MediaTile Seed="@CoverImage" Label="@ListingTitle" />
                        </div>
                        <div class="mk-pin-info__item-body">
                            <span class="mk-pin-info__title">@ListingTitle</span>
                            <span class="mk-pin-info__price">@Money.Format(PriceBdt)</span>
                            @if (IsCurrentlyPinned && CurrentPinnedUntilUtc is { } curExpiry)
                            {
                                <span class="mk-pin-info__status">Currently active until @curExpiry.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                            }
                        </div>
                    </div>

                    <div class="mk-pin-perks">
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">📌</div>
                            <div>
                                <strong>Top of Browse & Search</strong>
                                <p>Appears first before standard listings for maximum buyer discovery.</p>
                            </div>
                        </div>
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">✨</div>
                            <div>
                                <strong>Golden Pinned Badge</strong>
                                <p>Distinctive badge highlights your item across all category feeds.</p>
                            </div>
                        </div>
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">⚡</div>
                            <div>
                                <strong>@_fee.Days Days Boost</strong>
                                <p>Accelerates buyer inquiries and helps close sales up to 3x faster.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mk-pin-pricing">
                        <div class="mk-pin-pricing__head">
                            <span>Promotion Fee</span>
                            <strong class="mk-pin-pricing__amount">৳@_fee.AmountBdt.ToString("N0") <small>BDT</small></strong>
                        </div>
                        <span class="mk-pin-pricing__detail">Duration: @_fee.Days days priority spotlight</span>
                    </div>

                    <form class="mk-bkash-checkout" @onsubmit="SubmitPayment" @onsubmit:preventDefault="true">
                        <div class="mk-bkash-checkout__banner">
                            <div class="mk-bkash-checkout__logo">
                                <span class="mk-bkash-logo-text">bKash</span>
                                <span class="mk-bkash-sub">Payment Gateway</span>
                            </div>
                            <span class="mk-bkash-secure">🔒 Secure Demo</span>
                        </div>

                        <div class="mk-bkash-form">
                            <div class="mk-bkash-field">
                                <label for="mk-bkash-phone">bKash Account Number</label>
                                <div class="mk-bkash-input-wrap">
                                    <input id="mk-bkash-phone" type="tel" placeholder="01712345678"
                                           @bind="_bkashNumber" @bind:event="oninput"
                                           disabled="@_busy" maxlength="14" />
                                </div>
                            </div>

                            <div class="mk-bkash-field">
                                <label for="mk-bkash-pin">bKash PIN</label>
                                <div class="mk-bkash-input-wrap">
                                    <input id="mk-bkash-pin" type="password" inputmode="numeric"
                                           placeholder="••••" maxlength="5"
                                           @bind="_bkashPin" @bind:event="oninput"
                                           disabled="@_busy" />
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_error))
                            {
                                <div class="mk-bkash-error" role="alert">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                                    </svg>
                                    <span>@_error</span>
                                </div>
                            }

                            <div class="mk-bkash-actions">
                                <button type="button" class="nx-btn nx-btn--ghost" @onclick="Cancel" disabled="@_busy">
                                    Cancel
                                </button>
                                <button type="submit" class="nx-btn mk-btn--bkash" disabled="@(_busy || string.IsNullOrWhiteSpace(_bkashNumber) || string.IsNullOrWhiteSpace(_bkashPin))">
                                    @if (_busy)
                                    {
                                        <span class="mk-spinner" aria-hidden="true"></span>
                                        <span>Processing…</span>
                                    }
                                    else
                                    {
                                        <span>Confirm ৳@_fee.AmountBdt.ToString("N0") bKash Pay</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ListingId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ListingTitle { get; set; } = string.Empty;
    [Parameter] public decimal PriceBdt { get; set; }
    [Parameter] public string CoverImage { get; set; } = string.Empty;
    [Parameter] public bool IsCurrentlyPinned { get; set; }
    [Parameter] public DateTime? CurrentPinnedUntilUtc { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<MarketplacePinResultDto> OnPinned { get; set; }

    private MarketplacePinFeeDto _fee = new();
    private string _bkashNumber = string.Empty;
    private string _bkashPin = string.Empty;
    private bool _busy;
    private string? _error;
    private MarketplacePinResultDto? _receipt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fee = await Marketplace.GetPinFeeAsync();
        }
        catch
        {
            _fee = new MarketplacePinFeeDto { AmountBdt = 50m, Days = 7 };
        }
    }

    private async Task SubmitPayment()
    {
        _error = null;
        var cleanNumber = new string((_bkashNumber ?? string.Empty).Where(c => !char.IsWhiteSpace(c) && c != '-').ToArray());
        if (string.IsNullOrWhiteSpace(cleanNumber) || cleanNumber.Length < 11)
        {
            _error = "Enter a valid 11-digit Bangladeshi bKash phone number (e.g. 01712345678).";
            return;
        }

        if (string.IsNullOrWhiteSpace(_bkashPin) || _bkashPin.Length < 4)
        {
            _error = "Enter your 4 or 5 digit bKash PIN.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Marketplace.PinListingAsync(ListingId, new PinMarketplaceItemDto
            {
                BkashNumber = cleanNumber,
                Pin = _bkashPin,
                Days = _fee.Days
            });

            _receipt = result;
            Toast.ShowSuccess($"Listing pinned for {_fee.Days} days! Transaction ID: {result.TransactionId}", "Post Pinned");
            await OnPinned.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Cancel() => _busy ? Task.CompletedTask : OnClose.InvokeAsync();

    private async Task CloseReceipt()
    {
        await OnClose.InvokeAsync();
    }
}
