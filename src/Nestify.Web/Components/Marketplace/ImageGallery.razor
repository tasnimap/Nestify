@* Detail-page gallery: one large frame + a thumbnail strip. Frontend phase shows
   generated tiles; the same markup renders real <img> once photos exist. *@

<div class="mk-gallery">
    <div class="mk-gallery__main">
        <MediaTile Seed="@Current" Label="@Title"
                   Alt="@($"{Title} — photo {_index + 1} of {_count}")"
                   CssClass="mk-gallery__frame" />

        @if (_count > 1)
        {
            <button type="button" class="mk-gallery__nav mk-gallery__nav--prev"
                    @onclick="Prev" aria-label="Previous photo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button type="button" class="mk-gallery__nav mk-gallery__nav--next"
                    @onclick="Next" aria-label="Next photo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </button>
            <span class="mk-gallery__count">@(_index + 1) / @_count</span>
        }
    </div>

    @if (_count > 1)
    {
        <div class="mk-gallery__strip">
            @for (var i = 0; i < _count; i++)
            {
                var idx = i;
                <button type="button"
                        class="mk-gallery__thumb @(idx == _index ? "is-active" : null)"
                        @onclick="() => _index = idx"
                        aria-label="@($"Show photo {idx + 1}")"
                        aria-current="@(idx == _index ? "true" : null)">
                    <MediaTile Seed="@Images[idx]" Label="@Title" />
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Images { get; set; } = new List<string>();
    [Parameter] public string Title { get; set; } = string.Empty;

    private int _index;
    private int _count => Images.Count == 0 ? 1 : Images.Count;
    private string Current => Images.Count == 0 ? "tile:empty" : Images[Math.Clamp(_index, 0, Images.Count - 1)];

    protected override void OnParametersSet() => _index = Math.Clamp(_index, 0, Math.Max(0, Images.Count - 1));

    private void Prev() => _index = (_index - 1 + _count) % _count;
    private void Next() => _index = (_index + 1) % _count;
}
