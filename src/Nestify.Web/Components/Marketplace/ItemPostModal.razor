@* "Post an item" without leaving the page you are on. It hosts the same form
   the /marketplace/sell page uses, so the two stay in step. *@
@inject IMarketplaceService Marketplace
@inject Nestify.Web.Services.ToastService Toast

<div class="mk-modal-overlay" @onclick="Cancel">
    <div class="mk-modal" @onclick:stopPropagation="true">
        <header class="mk-modal__header">
            <h2>Post an item for sale</h2>
            <button type="button" class="mk-modal__close" @onclick="Cancel" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </header>

        <div class="mk-modal__body">
            <ItemForm Model="_model" Busy="_busy" SubmitLabel="Publish listing"
                      OnValidSubmit="Submit" OnCancel="Cancel" />
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Fired with the new listing id once it is published.</summary>
    [Parameter] public EventCallback<string> OnCreated { get; set; }

    private readonly MarketplaceItemFormModel _model = new();
    private bool _busy;

    private async Task Submit()
    {
        _busy = true;
        try
        {
            var id = await Marketplace.CreateItemAsync(_model.ToCreateDto());
            Toast.ShowSuccess("Your item is live. Buyers can send you requests now.", "Listing published");
            await OnCreated.InvokeAsync(id);
        }
        catch
        {
            Toast.ShowError("Couldn't publish the listing. Please try again.", "Something went wrong");
            _busy = false;
        }
    }

    private Task Cancel() => _busy ? Task.CompletedTask : OnClose.InvokeAsync();
}
