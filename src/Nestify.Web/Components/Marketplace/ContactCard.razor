@* Rendered ONLY inside an Accepted branch. Before acceptance the DTO carries no
   contact at all, so this component is never even constructed (§11.4). *@

<div class="mk-contact">
    <div class="mk-contact__head">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16v16H4z" opacity="0" />
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8 11a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c1 .4 2 .6 2.9.8A2 2 0 0 1 22 16.9Z" />
        </svg>
        <span>@Heading</span>
    </div>

    <dl class="mk-contact__grid">
        <div>
            <dt>Name</dt>
            <dd>@Contact.DisplayName</dd>
        </div>
        <div>
            <dt>Phone</dt>
            <dd><a href="tel:@Contact.Phone">@Contact.Phone</a></dd>
        </div>
        @if (!string.IsNullOrWhiteSpace(Contact.PreferredHandoverArea))
        {
            <div class="mk-contact__wide">
                <dt>Preferred handover</dt>
                <dd>@Contact.PreferredHandoverArea</dd>
            </div>
        }
    </dl>

    <p class="mk-contact__foot">Arrange a public place and daytime handover. Nestify never handles payment.</p>
</div>

@code {
    [Parameter, EditorRequired] public MarketplaceContactDto Contact { get; set; } = new();
    [Parameter] public string Heading { get; set; } = "Contact details";
}
