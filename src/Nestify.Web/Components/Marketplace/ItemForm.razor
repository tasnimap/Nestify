@using Nestify.Shared.Dtos.Area
@inject IMarketplaceService Marketplace
@inject IAreaService Areas
@inject Nestify.Web.Services.MoneyFormatterService Money

@* Shared create/edit form for a marketplace listing. Hosts the ML price-
   suggestion slot (§10.8) and a live "buyer's view" preview. *@

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" class="mk-form">
    <DataAnnotationsValidator />

    <div class="mk-form__grid">
        <div class="mk-form__fields">
            <div class="field">
                <label for="mk-title" class="field__label--required">Title</label>
                <InputText id="mk-title" class="field__input" @bind-Value="Model.Title"
                           placeholder="Solid wood study table with drawer" />
                <ValidationMessage For="@(() => Model.Title)" />
            </div>

            <div class="field">
                <label for="mk-desc" class="field__label--required">Description</label>
                <InputTextArea id="mk-desc" class="field__input" @bind-Value="Model.Description" rows="6"
                               placeholder="What it is, how long you've used it, any wear, and what's included." />
                <ValidationMessage For="@(() => Model.Description)" />
                <p class="field__helper">Plain text only — links and formatting won't render.</p>
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="mk-category">Category</label>
                    <InputSelect id="mk-category" class="field__input" @bind-Value="Model.Category"
                                 @bind-Value:after="RefreshSuggestionAsync">
                        @foreach (var c in _categories)
                        {
                            <option value="@c">@MarketplaceView.Label(c)</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="mk-condition">Condition</label>
                    <InputSelect id="mk-condition" class="field__input" @bind-Value="Model.Condition"
                                 @bind-Value:after="RefreshSuggestionAsync">
                        @foreach (var c in _conditions)
                        {
                            <option value="@c">@MarketplaceView.Label(c)</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="field">
                <label for="mk-price" class="field__label--required">Price (৳)</label>
                <InputNumber id="mk-price" class="field__input mk-form__price" @bind-Value="Model.PriceBdt" step="50" />
                <ValidationMessage For="@(() => Model.PriceBdt)" />
            </div>

            @if (_loadingSuggestion)
            {
                <div class="mk-suggest mk-suggest--loading">Estimating a fair price…</div>
            }
            else if (_suggestion is not null)
            {
                <div class="mk-suggest">
                    <div class="mk-suggest__head">
                        <span class="mk-suggest__spark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
                            </svg>
                        </span>
                        <div>
                            <strong>Suggested price</strong>
                            <p class="mk-muted">@_suggestion.Basis</p>
                        </div>
                    </div>
                    <div class="mk-suggest__band">
                        <span class="mk-price mk-price--sm">@Money.Format(_suggestion.SuggestedLow)</span>
                        <span class="mk-suggest__track"><span class="mk-suggest__dot"></span></span>
                        <span class="mk-price mk-price--sm">@Money.Format(_suggestion.SuggestedHigh)</span>
                    </div>
                    <button type="button" class="mk-suggest__use" @onclick="UseSuggestion">
                        Use @Money.Format(_suggestion.SuggestedPoint)
                    </button>
                    <p class="mk-suggest__note">This is advice from recent listings. You set the final price.</p>
                </div>
            }

            <div class="field-row">
                <div class="field">
                    <label for="mk-division" class="field__label--required">Division</label>
                    <select id="mk-division" class="field__input"
                            value="@(_area.DivisionId?.ToString() ?? string.Empty)" @onchange="OnDivisionChanged">
                        <option value="">Select a division…</option>
                        @foreach (var d in _divisions)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => Model.Division)" />
                </div>
                <div class="field">
                    <label for="mk-district" class="field__label--required">District</label>
                    <select id="mk-district" class="field__input"
                            value="@(_area.DistrictId?.ToString() ?? string.Empty)" @onchange="OnDistrictChanged"
                            disabled="@(_area.DivisionId is null)">
                        <option value="">Select a district…</option>
                        @foreach (var d in _districts)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="mk-upazila" class="field__label--required">Upazila / thana</label>
                    <select id="mk-upazila" class="field__input"
                            value="@(_area.UpazilaId?.ToString() ?? string.Empty)" @onchange="OnUpazilaChanged"
                            disabled="@(_area.DistrictId is null)">
                        <option value="">Select an upazila…</option>
                        @foreach (var u in _upazilas)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => Model.AreaName)" />
                </div>
            </div>
            <p class="field__helper">
                Buyers see this as the collection area. City thanas such as Dhanmondi or Gulshan are
                listed with the upazilas of their district.
            </p>

            <div class="field">
                <label>Photos</label>
                <ImageUploader Value="Model.Images" ValueChanged="OnImagesChanged" />
            </div>
        </div>

        <aside class="mk-form__aside">
            <div class="mk-form__preview">
                <span class="mk-form__preview-tag">Buyer's view</span>
                <article class="mk-card mk-form__card">
                    <div class="mk-card__media">
                        <MediaTile Seed="@PreviewSeed" Label="@PreviewTitle"
                                   Tag="@MarketplaceView.CategoryTag(Model.Category)" />
                        <ConditionBadge Condition="Model.Condition" CssClass="mk-badge--on-media" />
                    </div>
                    <div class="mk-card__body">
                        <h3 class="mk-card__title"><span>@PreviewTitle</span></h3>
                        <div class="mk-card__meta">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
                            </svg>
                            <span>@(string.IsNullOrWhiteSpace(Model.AreaName) ? "Area" : Model.AreaName)</span>
                            <span class="mk-dot"></span>
                            <span class="mk-nowrap">just now</span>
                        </div>
                        <div class="mk-card__price-row">
                            <span class="mk-price mk-price--sm">@Money.Format(Model.PriceBdt)</span>
                        </div>
                        <div class="mk-card__foot">
                            <span class="mk-card__seller">
                                <span class="mk-ava">You</span><span>You</span>
                            </span>
                            <span class="mk-verified">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 2 4 5v6c0 5 3.4 8.9 8 10 4.6-1.1 8-5 8-10V5l-8-3Z" />
                                    <path d="m8.5 12 2.4 2.4L15.5 10" fill="none" stroke="#fff" stroke-width="2.2"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Verified</span>
                            </span>
                        </div>
                    </div>
                </article>
                <p class="mk-muted mk-form__preview-hint">Updates as you type.</p>
            </div>
        </aside>
    </div>

    <div class="mk-form__foot">
        <button type="button" class="nx-btn nx-btn--ghost" @onclick="OnCancel" disabled="@Busy">Cancel</button>
        <button type="submit" class="nx-btn nx-btn--primary" disabled="@Busy">
            @(Busy ? "Saving…" : SubmitLabel)
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public MarketplaceItemFormModel Model { get; set; } = new();
    [Parameter] public string SubmitLabel { get; set; } = "Publish listing";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly MarketplaceCategory[] _categories = Enum.GetValues<MarketplaceCategory>();
    private readonly ItemCondition[] _conditions = Enum.GetValues<ItemCondition>();
    // The picker holds ids; the listing itself stores the division name and the
    // "upazila, district" line, which is what buyers read on a card.
    private readonly AreaSelectionDto _area = new();
    private IReadOnlyList<DivisionDto> _divisions = Array.Empty<DivisionDto>();
    private IReadOnlyList<DistrictDto> _districts = Array.Empty<DistrictDto>();
    private IReadOnlyList<UpazilaDto> _upazilas = Array.Empty<UpazilaDto>();

    private PriceSuggestionDto? _suggestion;
    private bool _loadingSuggestion;

    private string PreviewTitle => string.IsNullOrWhiteSpace(Model.Title) ? "Your item title" : Model.Title;
    private string PreviewSeed => Model.Images.FirstOrDefault() ?? $"tile:{PreviewTitle}";

    protected override async Task OnInitializedAsync()
    {
        _divisions = await Areas.GetDivisionsAsync();
        await RestoreAreaAsync();
        await RefreshSuggestionAsync();
    }

    // The edit page hands us a saved listing, which keeps names rather than ids.
    // Walk the three levels back down so the selects open on the saved place.
    private async Task RestoreAreaAsync()
    {
        var division = _divisions.FirstOrDefault(d =>
            string.Equals(d.Name, Model.Division, StringComparison.OrdinalIgnoreCase));
        if (division is null)
        {
            return;
        }

        _area.DivisionId = division.Id;
        _districts = await Areas.GetDistrictsAsync(division.Id);

        var parts = Model.AreaName.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            return;
        }

        var district = _districts.FirstOrDefault(d =>
            string.Equals(d.Name, parts[1], StringComparison.OrdinalIgnoreCase));
        if (district is null)
        {
            return;
        }

        _area.DistrictId = district.Id;
        _upazilas = await Areas.GetUpazilasAsync(district.Id);
        _area.UpazilaId = _upazilas.FirstOrDefault(u =>
            string.Equals(u.Name, parts[0], StringComparison.OrdinalIgnoreCase))?.Id;
    }

    private async Task OnDivisionChanged(ChangeEventArgs e)
    {
        _area.DivisionId = ParseId(e.Value);
        _area.DistrictId = null;
        _area.UpazilaId = null;
        _districts = _area.DivisionId is int id ? await Areas.GetDistrictsAsync(id) : Array.Empty<DistrictDto>();
        _upazilas = Array.Empty<UpazilaDto>();
        ApplyArea();
    }

    private async Task OnDistrictChanged(ChangeEventArgs e)
    {
        _area.DistrictId = ParseId(e.Value);
        _area.UpazilaId = null;
        _upazilas = _area.DistrictId is int id ? await Areas.GetUpazilasAsync(id) : Array.Empty<UpazilaDto>();
        ApplyArea();
    }

    private void OnUpazilaChanged(ChangeEventArgs e)
    {
        _area.UpazilaId = ParseId(e.Value);
        ApplyArea();
    }

    private void ApplyArea()
    {
        Model.Division = _divisions.FirstOrDefault(d => d.Id == _area.DivisionId)?.Name ?? string.Empty;

        var district = _districts.FirstOrDefault(d => d.Id == _area.DistrictId);
        var upazila = _upazilas.FirstOrDefault(u => u.Id == _area.UpazilaId);
        Model.AreaName = upazila is null || district is null ? string.Empty : $"{upazila.Name}, {district.Name}";
    }

    private static int? ParseId(object? value) =>
        int.TryParse(value?.ToString(), out var id) ? id : null;

    private async Task RefreshSuggestionAsync()
    {
        _loadingSuggestion = true;
        try
        {
            _suggestion = await Marketplace.GetPriceSuggestionAsync(Model.Category, Model.Condition);
        }
        catch
        {
            _suggestion = null;
        }
        finally
        {
            _loadingSuggestion = false;
        }
    }

    private void UseSuggestion()
    {
        if (_suggestion is not null)
        {
            Model.PriceBdt = _suggestion.SuggestedPoint;
        }
    }

    private void OnImagesChanged(IReadOnlyList<string> images) => Model.Images = images.ToList();

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
