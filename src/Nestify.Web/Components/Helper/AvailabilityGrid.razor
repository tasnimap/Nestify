@* The helper's weekly board as a bachelor sees it: seven days, 18 hourly
   slots from 6:00 AM to 12:00 AM. Open hours can be picked, up to MaxPerDay
   on any one day; booked and off hours cannot. *@
@using Nestify.Shared.Dtos.Helpers

<div class="dh-sched">
    <div class="dh-sched__top">
        <div>
            <p class="dh-sched__range">Every week</p>
            <p class="dh-sched__lead">
                @if (Selectable)
                {
                    <span>Tap the hours you need each week — up to @MaxPerDay per day.</span>
                }
                else
                {
                    <span>18 hourly slots a day, 6:00 AM to 12:00 AM.</span>
                }
            </p>
        </div>
        <ul class="dh-legend">
            @if (Selectable)
            {
                <li><span class="dh-key dh-key--picked"></span>Picked (@Selection.Count)</li>
            }
            <li><span class="dh-key dh-key--free"></span>Available (@_freeCount)</li>
            <li><span class="dh-key dh-key--booked"></span>Booked (@_bookedCount)</li>
            <li><span class="dh-key dh-key--off"></span>Not available</li>
        </ul>
    </div>

    <div class="dh-sched__scroll">
        <table class="dh-sched__table">
            <thead>
                <tr>
                    <th scope="col" class="dh-sched__corner">Day</th>
                    @for (var hour = StartHour; hour < EndHour; hour++)
                    {
                        <th scope="col" class="dh-sched__hour">@HourLabel(hour)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Week)
                {
                    var picked = CountForDay(day);
                    var dayFull = picked >= MaxPerDay;
                    <tr>
                        <th scope="row" class="dh-sched__day">
                            <span class="dh-sched__dow">@day.ToString()[..3]</span>
                            @if (Selectable)
                            {
                                <span class="dh-sched__tally @(picked > 0 ? "dh-sched__tally--on" : null)">@picked/@MaxPerDay</span>
                            }
                        </th>
                        @for (var hour = StartHour; hour < EndHour; hour++)
                        {
                            var h = hour;
                            var state = StateOf(day, h);
                            var isPicked = IsPicked(day, h);
                            var canPick = Selectable && state == "free" && (isPicked || !dayFull);
                            var label = $"{day} · {RangeLabel(h)} — {(isPicked ? "Picked" : StateLabel(state))}";

                            <td class="dh-sched__cell">
                                @if (Selectable && state == "free")
                                {
                                    <button type="button"
                                            class="dh-slot dh-slot--free @(isPicked ? "dh-slot--picked" : null) @(!canPick ? "dh-slot--locked" : null)"
                                            title="@(canPick ? label : $"{day} — {MaxPerDay} hours already picked for this day")"
                                            disabled="@(!canPick)"
                                            aria-pressed="@isPicked.ToString().ToLowerInvariant()"
                                            @onclick="() => Toggle(day, h)">
                                        <span class="nx-sr-only">@label</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="dh-slot dh-slot--@state" title="@label">
                                        <span class="nx-sr-only">@label</span>
                                    </span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Selectable && Selection.Count > 0)
    {
        <div class="dh-picks">
            <p class="dh-picks__head">
                <strong>@Selection.Count</strong> @(Selection.Count == 1 ? "hour" : "hours") a week picked
                <button type="button" class="dh-picks__clear" @onclick="ClearAll">Clear</button>
            </p>
            <ul class="dh-picks__list">
                @foreach (var day in Week)
                {
                    var picks = Selection.Where(s => s.DayOfWeek == (int)day).OrderBy(s => s.Hour).ToList();
                    if (picks.Count == 0) continue;
                    <li>
                        <span class="dh-picks__day">@day</span>
                        @foreach (var s in picks)
                        {
                            <button type="button" class="dh-picks__chip" title="Remove @RangeLabel(s.Hour)" @onclick="() => Toggle(day, s.Hour)">
                                @RangeLabel(s.Hour)
                                <span aria-hidden="true">×</span>
                            </button>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <p class="dh-sched__note">Scroll sideways to see the whole day. The same hours repeat every week for as long as the engagement runs.</p>
</div>

@code {
    public const int StartHour = 6;
    public const int EndHour = 24;

    // Saturday first, the way the week is read here.
    public static readonly DayOfWeek[] Week =
    {
        DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
        DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
    };

    /// <summary>The helper's board from the API: open and booked hours.</summary>
    [Parameter, EditorRequired] public List<HelperAvailabilitySlotDto> Slots { get; set; } = new();

    /// <summary>False shows the board read only.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    [Parameter] public int MaxPerDay { get; set; } = 3;

    [Parameter] public List<EngagementSlotDto> Selection { get; set; } = new();

    [Parameter] public EventCallback<List<EngagementSlotDto>> SelectionChanged { get; set; }

    private int _freeCount;
    private int _bookedCount;

    protected override void OnParametersSet()
    {
        _freeCount = Slots.Count(s => s.IsOpen && !s.IsBooked);
        _bookedCount = Slots.Count(s => s.IsBooked);
    }

    private string StateOf(DayOfWeek day, int hour)
    {
        var slot = Slots.FirstOrDefault(s => s.DayOfWeek == (int)day && s.Hour == hour);
        if (slot is null || (!slot.IsOpen && !slot.IsBooked)) return "off";
        return slot.IsBooked ? "booked" : "free";
    }

    private bool IsPicked(DayOfWeek day, int hour) => Selection.Any(s => s.DayOfWeek == (int)day && s.Hour == hour);

    private int CountForDay(DayOfWeek day) => Selection.Count(s => s.DayOfWeek == (int)day);

    private async Task Toggle(DayOfWeek day, int hour)
    {
        var existing = Selection.FirstOrDefault(s => s.DayOfWeek == (int)day && s.Hour == hour);
        if (existing is not null)
        {
            Selection.Remove(existing);
        }
        else
        {
            if (CountForDay(day) >= MaxPerDay) return;
            Selection.Add(new EngagementSlotDto { DayOfWeek = (int)day, Hour = hour });
        }

        await SelectionChanged.InvokeAsync(Selection);
    }

    private async Task ClearAll()
    {
        Selection.Clear();
        await SelectionChanged.InvokeAsync(Selection);
    }

    public static string HourLabel(int hour) => hour switch
    {
        0 or 24 => "12 AM",
        12 => "12 PM",
        < 12 => $"{hour} AM",
        _ => $"{hour - 12} PM"
    };

    public static string RangeLabel(int hour) => $"{HourLabel(hour)} - {HourLabel(hour + 1)}";

    private static string StateLabel(string state) => state switch
    {
        "free" => "Available",
        "booked" => "Booked",
        _ => "Not available"
    };
}
