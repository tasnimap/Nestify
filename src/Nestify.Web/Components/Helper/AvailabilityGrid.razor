@* Seven day availability board: 18 hourly slots a day, 6:00 AM to 12:00 AM.
   Free slots can be picked, up to MaxPerDay on any one day. *@
@using Nestify.Shared.Dtos.Helpers

<div class="dh-sched">
    <div class="dh-sched__top">
        <div>
            <p class="dh-sched__range">@RangeCaption</p>
            <p class="dh-sched__lead">
                @if (Selectable)
                {
                    <span>Tap the hours you need — up to @MaxPerDay per day. Leaving it empty is fine.</span>
                }
                else
                {
                    <span>18 hourly slots a day, 6:00 AM to 12:00 AM.</span>
                }
            </p>
        </div>
        <ul class="dh-legend">
            @if (Selectable)
            {
                <li><span class="dh-key dh-key--picked"></span>Picked (@Selection.Count)</li>
            }
            <li><span class="dh-key dh-key--free"></span>Available (@_freeCount)</li>
            <li><span class="dh-key dh-key--booked"></span>Booked (@_bookedCount)</li>
            <li><span class="dh-key dh-key--off"></span>Not available (@_offCount)</li>
        </ul>
    </div>

    <div class="dh-sched__scroll">
        <table class="dh-sched__table">
            <thead>
                <tr>
                    <th scope="col" class="dh-sched__corner">Day</th>
                    @for (var hour = HelperScheduleView.StartHour; hour < HelperScheduleView.EndHour; hour++)
                    {
                        <th scope="col" class="dh-sched__hour">@HelperScheduleView.HourLabel(hour)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var day in _days)
                {
                    var picked = CountForDay(day.Date);
                    var dayFull = picked >= MaxPerDay;
                    <tr>
                        <th scope="row" class="dh-sched__day">
                            <span class="dh-sched__dow">@day.Date.ToString("ddd")</span>
                            <span class="dh-sched__date">@day.Date.ToString("d MMM")</span>
                            @if (Selectable)
                            {
                                <span class="dh-sched__tally @(picked > 0 ? "dh-sched__tally--on" : null)">@picked/@MaxPerDay</span>
                            }
                        </th>
                        @foreach (var slot in day.Slots)
                        {
                            var isPicked = IsPicked(day.Date, slot.Hour);
                            var canPick = Selectable && slot.State == SlotState.Free && (isPicked || !dayFull);
                            var label = $"{day.Date:ddd d MMM} · {HelperScheduleView.RangeLabel(slot.Hour)} — {(isPicked ? "Picked" : HelperScheduleView.StateLabel(slot.State))}";

                            <td class="dh-sched__cell">
                                @if (Selectable && slot.State == SlotState.Free)
                                {
                                    <button type="button"
                                            class="dh-slot dh-slot--free @(isPicked ? "dh-slot--picked" : null) @(!canPick ? "dh-slot--locked" : null)"
                                            title="@(canPick ? label : $"{day.Date:ddd d MMM} — {MaxPerDay} slots already picked for this day")"
                                            disabled="@(!canPick)"
                                            aria-pressed="@isPicked.ToString().ToLowerInvariant()"
                                            @onclick="() => Toggle(day.Date, slot.Hour)">
                                        <span class="nx-sr-only">@label</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="dh-slot dh-slot--@(slot.State.ToString().ToLowerInvariant())" title="@label">
                                        <span class="nx-sr-only">@label</span>
                                    </span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Selectable && Selection.Count > 0)
    {
        <div class="dh-picks">
            <p class="dh-picks__head">
                <strong>@Selection.Count</strong> @(Selection.Count == 1 ? "hour" : "hours") picked
                <button type="button" class="dh-picks__clear" @onclick="ClearAll">Clear</button>
            </p>
            <ul class="dh-picks__list">
                @foreach (var group in Selection.GroupBy(s => s.Date).OrderBy(g => g.Key))
                {
                    <li>
                        <span class="dh-picks__day">@group.Key.ToString("ddd d MMM")</span>
                        @foreach (var s in group.OrderBy(s => s.Hour))
                        {
                            <button type="button" class="dh-picks__chip"
                                    title="Remove @HelperScheduleView.RangeLabel(s.Hour)"
                                    @onclick="() => Toggle(s.Date, s.Hour)">
                                @HelperScheduleView.RangeLabel(s.Hour)
                                <span aria-hidden="true">×</span>
                            </button>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <p class="dh-sched__note">Scroll sideways to see the whole day. Hours outside @Window are not offered.</p>
</div>

@code {
    [Parameter, EditorRequired] public string HelperId { get; set; } = string.Empty;

    /// <summary>The helper's own availability text, e.g. "Sat-Thu, 8am-2pm".</summary>
    [Parameter] public string? AvailabilityWindow { get; set; }

    /// <summary>False shows the board read only, as on the helper's own profile.</summary>
    [Parameter] public bool Selectable { get; set; } = true;

    [Parameter] public int MaxPerDay { get; set; } = 3;

    [Parameter] public List<EngagementSlotDto> Selection { get; set; } = new();

    [Parameter] public EventCallback<List<EngagementSlotDto>> SelectionChanged { get; set; }

    private IReadOnlyList<ScheduleDay> _days = Array.Empty<ScheduleDay>();
    private int _freeCount;
    private int _bookedCount;
    private int _offCount;

    private string Window => string.IsNullOrWhiteSpace(AvailabilityWindow) ? "the working window" : AvailabilityWindow;

    private string RangeCaption =>
        _days.Count == 0 ? "Next 7 days" : $"{_days[0].Date:d MMM} – {_days[^1].Date:d MMM}";

    protected override void OnParametersSet()
    {
        _days = HelperScheduleView.Build(HelperId, AvailabilityWindow, DateTime.Today);

        var slots = _days.SelectMany(d => d.Slots).ToList();
        _freeCount = slots.Count(s => s.State == SlotState.Free);
        _bookedCount = slots.Count(s => s.State == SlotState.Booked);
        _offCount = slots.Count(s => s.State == SlotState.Off);
    }

    private bool IsPicked(DateTime date, int hour) =>
        Selection.Any(s => s.Date == date && s.Hour == hour);

    private int CountForDay(DateTime date) => Selection.Count(s => s.Date == date);

    private async Task Toggle(DateTime date, int hour)
    {
        var existing = Selection.FirstOrDefault(s => s.Date == date && s.Hour == hour);
        if (existing is not null)
        {
            Selection.Remove(existing);
        }
        else
        {
            // Three a day is the cap; the extra buttons are disabled, this is the backstop.
            if (CountForDay(date) >= MaxPerDay) return;
            Selection.Add(new EngagementSlotDto { Date = date, Hour = hour });
        }

        await SelectionChanged.InvokeAsync(Selection);
    }

    private async Task ClearAll()
    {
        Selection.Clear();
        await SelectionChanged.InvokeAsync(Selection);
    }
}
