@using Nestify.Shared.Dtos.Area
@using Nestify.Shared.Dtos.Helpers

<EditForm Model="Model" OnValidSubmit="HandleSubmit" class="dh-form">
    <div class="dh-field">
        <span class="dh-field__label">Services</span>

        <div class="dh-chips">
            @foreach (var service in _serviceTypes)
            {
                var selected = Model.Services.Contains(service);

                <button type="button"
                        class="dh-chip @(selected ? "dh-chip--on" : null)"
                        aria-pressed="@selected.ToString().ToLowerInvariant()"
                        @onclick="() => ToggleService(service)">
                    @service
                </button>
            }
        </div>
    </div>

    <div class="dh-field">
        <label class="dh-field__label" for="hf-availability">
            Availability window
        </label>

        <input id="hf-availability"
               type="text"
               placeholder="e.g. Sat-Thu, 8am-2pm"
               @bind="Model.AvailabilityWindow" />
    </div>

    <div class="dh-field">
        <label class="dh-field__label" for="hf-rate">
            Monthly rate (৳)
        </label>

        <input id="hf-rate"
               type="number"
               min="0"
               step="500"
               @bind="Model.MonthlyRate" />
    </div>

    @if (ShowArea)
    {
        <div class="dh-field">
            <span class="dh-field__label">Area</span>

            <AreaCascade Selection="_areaSelection"
                         SelectionChanged="OnAreaChanged" />
        </div>
    }

    <div class="dh-form__actions">
        <button type="submit"
                class="nx-btn nx-btn--accent"
                disabled="@_submitting">
            @(_submitting ? "Saving..." : SubmitLabel)
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public HelperRegistrationDto Model { get; set; } = default!;

    [Parameter]
    public string SubmitLabel { get; set; } = "Save";

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public bool ShowArea { get; set; } = true;

    private readonly ServiceType[] _serviceTypes =
        Enum.GetValues<ServiceType>();

    private AreaSelectionDto _areaSelection = new();
    private bool _submitting;

    private void ToggleService(ServiceType service)
    {
        if (!Model.Services.Remove(service))
        {
            Model.Services.Add(service);
        }
    }

    private void OnAreaChanged(AreaSelectionDto selection)
    {
        Model.DivisionId = selection.DivisionId;
        Model.DistrictId = selection.DistrictId;
        Model.UpazilaId = selection.UpazilaId;
    }

    private async Task HandleSubmit()
    {
        _submitting = true;

        try
        {
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            _submitting = false;
        }
    }
}