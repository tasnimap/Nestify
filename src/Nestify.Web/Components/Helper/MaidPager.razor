@* Numbered pager for the helper lists. Small screens only get prev / next plus the current page. *@

@if (Total > PageSize)
{
    <nav class="md-pager" aria-label="Pages">
        <span class="md-pager__note">@First–@Last of @Total</span>

        <div class="md-pager__steps">
            <button class="md-pager__btn" type="button" aria-label="Previous page"
                    disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>

            @for (var i = 1; i <= PageCount; i++)
            {
                var number = i;
                <button class="md-pager__btn md-pager__num @(number == Page ? "md-pager__btn--on" : null)"
                        type="button" aria-current="@(number == Page ? "page" : null)" @onclick="() => Go(number)">
                    @number
                </button>
            }

            <span class="md-pager__mobile">@Page / @PageCount</span>

            <button class="md-pager__btn" type="button" aria-label="Next page"
                    disabled="@(Page >= PageCount)" @onclick="() => Go(Page + 1)">
                <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
        </div>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));
    private int First => Total == 0 ? 0 : ((Page - 1) * PageSize) + 1;
    private int Last => Math.Min(Page * PageSize, Total);

    private Task Go(int page)
    {
        var wanted = Math.Clamp(page, 1, PageCount);
        return wanted == Page ? Task.CompletedTask : PageChanged.InvokeAsync(wanted);
    }
}
