@using Nestify.Web.Models
@using Microsoft.AspNetCore.Components

<div class="notification-item @(Notification.IsRead ? "read" : "unread")" style="padding: 0.5rem; border-bottom: 1px solid #e5e5e5;">
    <div class="d-flex justify-content-between align-items-center">
        <strong class="text-capitalize" style="color: var(--nx-primary);">@Notification.Type</strong>
        <small class="text-muted" style="font-size: 0.75rem;">@Notification.Timestamp.ToLocalTime().ToString("g")</small>
    </div>
    <p class="mb-1" style="margin-top: 0.25rem;">@Notification.Message</p>
    @if (!Notification.IsRead)
    {
        <button class="btn btn-sm btn-link p-0" @onclick="()=>OnMarkRead.InvokeAsync(Notification.Id)">Mark as read</button>
    }
</div>

@code {
    [Parameter] public Notification Notification { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnMarkRead { get; set; }
}
