@using Nestify.Shared.Dtos.Notifications
@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResource> L

<li class="notification-item @(Notification.IsRead ? "notification-item--read" : "notification-item--unread")">
    @if (!Notification.IsRead)
    {
        <span class="notification-item__dot" aria-label='@L["Unread"]'></span>
    }
    else
    {
        <span class="notification-item__dot notification-item__dot--hidden" aria-hidden="true"></span>
    }
    <div class="notification-item__main">
        <div class="notification-item__heading">
            <strong class="notification-item__title">@Notification.Title</strong>
            <time class="notification-item__time" datetime="@Notification.CreatedAtUtc.ToString("O")">
                @Notification.CreatedAtUtc.ToLocalTime().ToString("g")
            </time>
        </div>
        @if (!string.IsNullOrWhiteSpace(Notification.LinkPath) && Notification.LinkPath.StartsWith('/') && !Notification.LinkPath.StartsWith("//"))
        {
            <a href="@Notification.LinkPath" class="notification-item__body-link">
                <p class="notification-item__body">@Notification.Body</p>
            </a>
        }
        else
        {
            <p class="notification-item__body">@Notification.Body</p>
        }
        @if (!Notification.IsRead)
        {
            <button type="button" class="notification-item__mark-read" @onclick="() => OnMarkRead.InvokeAsync(Notification.Id)">@L["Mark as read"]</button>
        }
    </div>
</li>

@code {
    [Parameter] public NotificationDto Notification { get; set; } = default!;
    [Parameter] public EventCallback<long> OnMarkRead { get; set; }
}
