@using Nestify.Shared.Dtos.Notifications
@using Nestify.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Web
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<div class="notification-bell @(showDropdown ? "notification-bell--open" : null)"
     @onkeydown:document="HandleDocumentKeyDown"
     @onpointerdown:document="HandleDocumentPointerDown"
     @onpointerdown:stopPropagation="true">
    <button type="button" class="notification-bell__trigger"
            aria-label="@AccessibleLabel"
            aria-haspopup="dialog" aria-expanded="@showDropdown.ToString().ToLowerInvariant()"
            @onclick="ToggleDropdown">
        <svg class="notification-bell__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
        </svg>
        @if (UnreadCount > 0)
        {
            <span class="notification-bell__badge">@(UnreadCount > 9 ? "9+" : UnreadCount)</span>
        }
    </button>

    <NotificationDropdown Notifications="feed.Notifications" UnreadCount="UnreadCount" Show="showDropdown"
                          Loading="loading" Error="@error" OnMarkRead="MarkAsReadAsync"
                          OnMarkAllRead="MarkAllAsReadAsync" OnRetry="RefreshNotificationsAsync" />
</div>

@code {
    private NotificationFeedDto feed = new();
    private bool showDropdown = false;
    private bool loading;
    private string? error;
    private readonly CancellationTokenSource pollingStop = new();
    private int UnreadCount => feed.UnreadCount;
    private string AccessibleLabel => UnreadCount > 0
        ? $"{L["Notifications"].Value}, {L["{0} unread", UnreadCount].Value}"
        : L["Notifications"].Value;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshNotificationsAsync();
        _ = PollNotificationsAsync(pollingStop.Token);
    }

    private async Task RefreshNotificationsAsync()
    {
        loading = true;
        error = null;
        try
        {
            feed = await NotificationService.GetNotificationsAsync();
        }
        catch
        {
            error = L["Notifications could not be loaded. Please try again."];
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task PollNotificationsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(45));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(RefreshNotificationsAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // Normal when the layout is disposed.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(RefreshNotificationsAsync);

    private async Task MarkAsReadAsync(long id)
    {
        error = null;
        try
        {
            await NotificationService.MarkAsReadAsync(id);
            await RefreshNotificationsAsync();
        }
        catch
        {
            error = L["The notification could not be marked as read."];
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        error = null;
        try
        {
            await NotificationService.MarkAllAsReadAsync();
            await RefreshNotificationsAsync();
        }
        catch
        {
            error = L["Notifications could not be marked as read."];
        }
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private void HandleDocumentKeyDown(KeyboardEventArgs args)
    {
        if (showDropdown && args.Key == "Escape")
        {
            CloseDropdown();
        }
    }

    private void HandleDocumentPointerDown(PointerEventArgs args)
    {
        if (showDropdown)
        {
            CloseDropdown();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        pollingStop.Cancel();
        pollingStop.Dispose();
    }
}
