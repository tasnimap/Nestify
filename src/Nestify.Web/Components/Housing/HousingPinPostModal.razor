@inject IStringLocalizer<SharedResource> L
@using Nestify.Shared.Dtos.Housing
@inject IHousingService Housing
@inject Nestify.Web.Services.MoneyFormatterService Money
@inject Nestify.Web.Services.ToastService Toast
<div class="mk-modal-overlay" @onclick="Cancel">
    <div class="mk-modal mk-pin-modal hs-pin-modal" @onclick:stopPropagation="true">
        <header class="mk-modal__header mk-pin-modal__head">
            <div class="mk-pin-modal__brand">
                <span class="mk-pin-modal__bkash-tag">bKash</span>
                <h2>@(IsCurrentlyPinned ? L["Extend Pinned Listing"] : L["Pin Housing Listing to Top"])</h2>
            </div>
            <button type="button" class="mk-modal__close" @onclick="Cancel" aria-label="Close" disabled="@_busy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </header>

        <div class="mk-modal__body">
            @if (_receipt is not null)
            {
                <div class="mk-pin-receipt">
                    <div class="mk-pin-receipt__tick" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <h3 class="mk-pin-receipt__title">@L["Listing Pinned Successfully!"]</h3>
                    <p class="mk-pin-receipt__subtitle">
                        @L["Your Housing listing now appears ahead of standard listings in browse results."]
                    </p>
                    <div class="mk-pin-receipt__card">
                        <div class="mk-pin-receipt__row"><span>@L["Listing"]</span><strong>@ListingTitle</strong></div>
                        <div class="mk-pin-receipt__row">
                            <span>@L["Amount Paid"]</span>
                            <strong class="mk-pin-receipt__amount">৳@_receipt.AmountBdt.ToString("N0") BDT</strong>
                        </div>
                        <div class="mk-pin-receipt__row"><span>@L["bKash Number"]</span><span>@_receipt.BkashNumber</span></div>
                        <div class="mk-pin-receipt__row">
                            <span>@L["Transaction ID"]</span>
                            <span class="mk-pin-receipt__mono">@_receipt.TransactionId</span>
                        </div>
                        <div class="mk-pin-receipt__row">
                            <span>@L["Pinned Until"]</span>
                            <strong class="mk-pin-receipt__highlight">@_receipt.PinnedUntilUtc.ToLocalTime().ToString("d MMMM yyyy, h:mm tt")</strong>
                        </div>
                    </div>
                    <div class="mk-pin-receipt__actions">
                        <button type="button" class="nx-btn nx-btn--primary nx-btn--block" @onclick="CloseReceipt">@L["Done"]</button>
                    </div>
                </div>
            }
            else
            {
                <div class="mk-pin-info">
                    <div class="mk-pin-info__item">
                        <div class="mk-pin-info__thumb">
                            @if (!string.IsNullOrWhiteSpace(CoverImage))
                            {
                                <img src="@CoverImage" alt="" />
                            }
                            else
                            {
                                <span aria-hidden="true">🏠</span>
                            }
                        </div>
                        <div class="mk-pin-info__item-body">
                            <span class="mk-pin-info__title">@ListingTitle</span>
                            <span class="mk-pin-info__price">@Money.Format(MonthlyRent)<small>/mo</small></span>
                            @if (IsCurrentlyPinned && CurrentPinnedUntilUtc is { } expiry)
                            {
                                <span class="mk-pin-info__status">@L["Currently active until"] @expiry.ToLocalTime().ToString("g")</span>
                            }
                        </div>
                    </div>
                    <div class="mk-pin-perks">
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">📌</div>
                            <div><strong>@L["Top of Housing Browse"]</strong><p>@L["Your active post appears before standard listings."]</p></div>
                        </div>
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">✨</div>
                            <div><strong>@L["Pinned Badge"]</strong><p>@L["A clear badge helps your listing stand out to potential housemates."]</p></div>
                        </div>
                        <div class="mk-pin-perk">
                            <div class="mk-pin-perk__icon">⚡</div>
                            <div><strong>@L["{0} Days Boost", _fee.Days]</strong><p>@L["Extend an active pin by another {0} days.", _fee.Days]</p></div>
                        </div>
                    </div>
                    @if (_feeError is not null)
                    {
                        <p class="mk-bkash-error" role="alert">@_feeError</p>
                    }
                    else
                    {
                        <div class="mk-pin-pricing">
                            <div class="mk-pin-pricing__head">
                                <span>@L["Promotion Fee"]</span>
                                <strong class="mk-pin-pricing__amount">৳@_fee.AmountBdt.ToString("N0") <small>BDT</small></strong>
                            </div>
                            <span class="mk-pin-pricing__detail">Duration: @_fee.Days days priority spotlight</span>
                        </div>
                        <form class="mk-bkash-checkout" @onsubmit="SubmitPayment" @onsubmit:preventDefault="true">
                            <div class="mk-bkash-checkout__banner">
                                <div class="mk-bkash-checkout__logo">
                                    <span class="mk-bkash-logo-text">bKash</span>
                                    <span class="mk-bkash-sub">@L["Payment Gateway"]</span>
                                </div>
                            <span class="mk-bkash-secure">🔒 @L["Secure Demo"]</span>
                            </div>
                            <div class="mk-bkash-form">
                                <div class="mk-bkash-field">
                                    <label for="hs-bkash-phone">@L["bKash Account Number"]</label>
                                    <div class="mk-bkash-input-wrap">
                                        <input id="hs-bkash-phone" type="tel" placeholder="01712345678"
                                               @bind="_bkashNumber" @bind:event="oninput"
                                               disabled="@_busy" maxlength="14" />
                                    </div>
                                </div>
                                <div class="mk-bkash-field">
                                    <label for="hs-bkash-pin">@L["bKash PIN"]</label>
                                    <div class="mk-bkash-input-wrap">
                                        <input id="hs-bkash-pin" type="password" inputmode="numeric"
                                               placeholder="••••" maxlength="5"
                                               @bind="_bkashPin" @bind:event="oninput"
                                               disabled="@_busy" />
                                    </div>
                                </div>
                                @if (_error is not null)
                                {
                                    <div class="mk-bkash-error" role="alert">
                                        <span>@_error</span>
                                    </div>
                                }
                                <div class="mk-bkash-actions">
                                    <button type="button" class="nx-btn nx-btn--ghost" @onclick="Cancel" disabled="@_busy">@L["Cancel"]</button>
                                    <button type="submit" class="nx-btn mk-btn--bkash"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_bkashNumber) || string.IsNullOrWhiteSpace(_bkashPin))">
                                        @(_busy ? L["Processing…"] : L["Confirm ৳{0} bKash Pay", _fee.AmountBdt.ToString("N0")])
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string PostId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ListingTitle { get; set; } = string.Empty;
    [Parameter] public decimal MonthlyRent { get; set; }
    [Parameter] public string CoverImage { get; set; } = string.Empty;
    [Parameter] public bool IsCurrentlyPinned { get; set; }
    [Parameter] public DateTime? CurrentPinnedUntilUtc { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<HousingPinResultDto> OnPinned { get; set; }

    private HousingPinFeeDto _fee = new();
    private string _bkashNumber = string.Empty;
    private string _bkashPin = string.Empty;
    private string? _error;
    private string? _feeError;
    private bool _busy;
    private HousingPinResultDto? _receipt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fee = await Housing.GetPinFeeAsync();
        }
        catch (Exception ex)
        {
            _feeError = $"Could not load the pinning fee: {ex.Message}";
        }
    }

    private async Task SubmitPayment()
    {
        _error = null;
        var cleanNumber = new string(_bkashNumber.Where(c => !char.IsWhiteSpace(c) && c != '-').ToArray());
        if (cleanNumber.Length < 11)
        {
            _error = "Enter a valid Bangladeshi bKash phone number, like 01712345678.";
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_bkashPin, @"^\d{4,5}$"))
        {
            _error = "Enter your 4 or 5 digit bKash PIN.";
            return;
        }

        _busy = true;
        try
        {
            _receipt = await Housing.PinPostAsync(PostId, new PinHousingPostDto
            {
                BkashNumber = cleanNumber,
                Pin = _bkashPin
            });
            Toast.ShowSuccess($"Listing pinned for {_fee.Days} days! Transaction ID: {_receipt.TransactionId}", "Post Pinned");
            await OnPinned.InvokeAsync(_receipt);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Cancel() => _busy ? Task.CompletedTask : OnClose.InvokeAsync();
    private Task CloseReceipt() => OnClose.InvokeAsync();
}
