@* "Post a listing" without leaving the page you are on. It hosts the same form
   the /housing/new page uses, so the two stay in step. *@
@inject IHousingService Housing
@inject IHouseLookupService HouseLookup
@inject ToastService Toast

<div class="hs-modal-overlay" @onclick="Cancel">
    <div class="hs-modal hs-modal--wide" @onclick:stopPropagation="true">
        <header class="hs-modal__header">
            <h2>Post a seat or a house</h2>
            <button type="button" class="hs-modal__close" @onclick="Cancel" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </header>

        <div class="hs-modal__body">
            @if (_loadingHouses)
            {
                <div class="hs-skeleton" style="height: 18rem;"></div>
            }
            else if (_houses.Count == 0)
            {
                <div class="hs-empty">
                    <h3>You don't manage a house yet</h3>
                    <p>You need to be a Manager or CoManager of a house before you can post a listing.</p>
                    <a class="nx-btn nx-btn--primary" href="houses/new">Create a house</a>
                </div>
            }
            else
            {
                <HousingPostForm Model="_model" HouseOptions="_houses" SelectedHouseId="_selectedHouseId"
                                 SelectedHouseIdChanged="v => _selectedHouseId = v"
                                 Busy="_busy" SubmitLabel="Publish listing"
                                 OnValidSubmit="Submit" OnCancel="Cancel" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Fired with the new post id once it is published.</summary>
    [Parameter] public EventCallback<string> OnCreated { get; set; }

    private readonly HousingPostFormModel _model = new();
    private IReadOnlyList<HouseOptionDto> _houses = Array.Empty<HouseOptionDto>();
    private string _selectedHouseId = string.Empty;
    private bool _loadingHouses = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _houses = await HouseLookup.GetManageableHousesAsync();
        if (_houses.Count == 1)
        {
            _selectedHouseId = _houses[0].Id;
        }
        _loadingHouses = false;
    }

    private async Task Submit()
    {
        _busy = true;
        try
        {
            var id = await Housing.CreateAsync(_model.ToCreateDto(_selectedHouseId));
            Toast.ShowSuccess("Your listing is live.", "Post published");
            await OnCreated.InvokeAsync(id);
        }
        catch
        {
            Toast.ShowError("Couldn't publish the listing. Please try again.", "Something went wrong");
            _busy = false;
        }
    }

    private Task Cancel() => _busy ? Task.CompletedTask : OnClose.InvokeAsync();
}
