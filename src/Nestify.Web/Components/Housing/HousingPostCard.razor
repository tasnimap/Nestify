@* Browse-grid card. Shows area, rent, seats and listing type per §4 of the
   Project_Distribution. The whole title links to the detail page. *@
@inject Nestify.Web.Services.MoneyFormatterService Money

<article class="hs-card @(Post.Status == PostStatus.Closed ? "hs-card--closed" : null)">
    <div class="hs-card__top">
        <span class="hs-chip hs-chip--type">@HousingView.ShortLabel(Post.ListingType)</span>
        @if (Post.Status == PostStatus.Closed)
        {
            <span class="hs-chip hs-chip--closed">Closed</span>
        }
    </div>

    @if (Post.ImageUrls.Count > 0)
    {
        <div class="hs-card__image-container" @onclick="OpenPreviewModal" style="cursor: pointer; overflow: hidden; border-radius: 8px; margin: 12px 0; height: 160px; position: relative;">
            <img src="@Post.ImageUrls[0]" alt="House preview" style="width: 100%; height: 100%; object-fit: cover;" />
            @if (Post.ImageUrls.Count > 1)
            {
                <span style="position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.7); color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 500;">
                    +@(Post.ImageUrls.Count - 1) photos
                </span>
            }
        </div>
    }

    <h3 class="hs-card__title">
        <a href="housing/@Post.Id">@Post.Title</a>
    </h3>

    <div class="hs-card__meta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
        </svg>
        <span>@Post.AreaName, @Post.Division</span>
        <span class="hs-dot"></span>
        <span class="hs-nowrap">@HousingView.RelativeTime(Post.CreatedAtUtc)</span>
    </div>

    <div class="hs-card__foot">
        <span class="hs-price">@Money.Format(Post.MonthlyRent)<span class="hs-price__unit">/mo</span></span>
        <span class="hs-seats">
            @Post.SeatsAvailable @(Post.SeatsAvailable == 1 ? "seat" : "seats")
        </span>
    </div>
</article>

@if (_showPreviewModal)
{
    <div class="modal-backdrop" @onclick="ClosePreviewModal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); z-index: 9999; display: flex; justify-content: center; align-items: center;">
        <div class="modal-content" @onclick:stopPropagation style="background: #fff; padding: 24px; border-radius: 12px; max-width: 90%; max-height: 90vh; overflow-y: auto; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 1.25rem;">Photos for @Post.Title</h3>
                <button @onclick="ClosePreviewModal" class="nx-btn nx-btn--ghost" style="padding: 4px 8px;">Close</button>
            </div>
            <div style="display: flex; flex-direction: column; gap: 24px;">
                @foreach (var img in Post.ImageUrls)
                {
                    <img src="@img" alt="House photo" style="width: 100%; max-height: 70vh; object-fit: contain; border-radius: 8px;" />
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public HousingPostSummaryDto Post { get; set; } = new();
    
    private bool _showPreviewModal;

    private void OpenPreviewModal() => _showPreviewModal = true;
    private void ClosePreviewModal() => _showPreviewModal = false;
}