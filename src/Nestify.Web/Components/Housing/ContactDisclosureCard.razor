@namespace Nestify.Web.Components.Housing

@*
  ContactDisclosureCard — Displays contact information for an Accepted booking.
  Shared component for M1/M2/M4 (Prapty, Ishmam will reuse for their modules).
  
  Shows name, email, phone in a card format with icons.
  Only rendered when Status == Accepted (gated by caller).
  Used in:
  - MyPosts.razor (manager viewing requester contact)
  - MyBookings.razor (seeker viewing manager contact)
  - /housing/{id}/bookings (manager's requester list)
*@

<div class="hs-contact-card">
    <div class="hs-contact-card__header">
        <h3>Contact information</h3>
    </div>
    <div class="hs-contact-card__body">
        <div class="hs-contact-card__field">
            <svg class="hs-contact-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            <div class="hs-contact-card__value">@Contact?.Name</div>
        </div>
        <div class="hs-contact-card__field">
            <svg class="hs-contact-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <a href="mailto:@Contact?.Email" class="hs-contact-card__link">@Contact?.Email</a>
        </div>
        <div class="hs-contact-card__field">
            <svg class="hs-contact-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a href="tel:@Contact?.Phone" class="hs-contact-card__link">@Contact?.Phone</a>
        </div>
    </div>
</div>

@code {
    /// <summary>The contact information to display. If null, the component renders nothing.</summary>
    [Parameter] public ContactDisclosureDto? Contact { get; set; }
}
