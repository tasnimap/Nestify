@inject IStringLocalizer<SharedResource> L
@* Eligibility requirement builder for /housing/new and /housing/{id}/edit. Every
   field defaults to "no requirement" — the schema's nullable-means-unconstrained
   design (§2.5) is mirrored here field for field. *@

<div class="hs-elig">
    <p class="hs-elig__hint">
        @L["Leave anything below on No requirement to accept any applicant on that trait."]
    </p>

    <div class="field-row">
        <div class="field">
            <label for="hs-elig-gender">@L["Gender"]</label>
            <InputSelect id="hs-elig-gender" class="field__input" @bind-Value="Value.Gender">
                <option value="">@L["No requirement"]</option>
                <option value="@Gender.Male">@L["Male only"]</option>
                <option value="@Gender.Female">@L["Female only"]</option>
            </InputSelect>
        </div>

        <div class="field">
            <label for="hs-elig-occupation">@L["Occupation"]</label>
            <InputSelect id="hs-elig-occupation" class="field__input" @bind-Value="Value.Occupation">
                <option value="">@L["No requirement"]</option>
                <option value="@Occupation.Student">@L["Students only"]</option>
                <option value="@Occupation.Working">@L["Working professionals only"]</option>
            </InputSelect>
        </div>
    </div>

    <div class="field">
        <label>@L["Age range (optional)"]</label>
        <div class="hs-elig__age">
            <InputNumber class="field__input" @bind-Value="Value.MinAge" placeholder="Min" min="0" />
            <InputNumber class="field__input" @bind-Value="Value.MinAge" placeholder="Min" min="1" />
            <span>–</span>
            <InputNumber class="field__input" @bind-Value="Value.MaxAge" placeholder="Max" min="0" />
            <InputNumber class="field__input" @bind-Value="Value.MaxAge" placeholder="Max" min="1" />
        </div>
        <p class="field__helper">@L["Fill in only a minimum, only a maximum, both, or neither."]</p>
    </div>

    <label class="hs-elig__check">
        <InputCheckbox @bind-Value="Value.VerifiedOnly" />
        <span>@L["Verified accounts only"]</span>
    </label>

    <label class="hs-elig__check">
        <InputCheckbox @bind-Value="Value.NonSmokerOnly" />
        <span>@L["Non-smokers only"]</span>
    </label>

    <label class="hs-elig__check">
        <InputCheckbox @bind-Value="Value.NonDrinkerOnly" />
        <span>@L["Non-drinkers only"]</span>
    </label>
</div>

@code {
    [Parameter, EditorRequired] public EligibilityDto Value { get; set; } = new();
}
