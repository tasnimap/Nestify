@using Nestify.Web.Services.Interfaces

@if (_isOpen)
{
    <button type="button" class="hm-assistant__backdrop" aria-label="Close Nestify Assistant" @onclick="Close"></button>
    <section class="hm-assistant__popup" aria-labelledby="assistant-title" role="dialog" aria-modal="true">
        <header class="hm-assistant__head">
            <div class="hm-assistant__identity">
                <span class="hm-assistant__mini-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 9h8M8 13h5" /><rect x="3" y="4" width="18" height="15" rx="4" /><path d="m8 19-1 3 4-3" /></svg>
                </span>
                <div>
                    <h2 id="assistant-title">Nestify Assistant</h2>
                    <span class="hm-assistant__status"><i></i> Online</span>
                </div>
            </div>
            <button type="button" class="hm-assistant__close" title="Close assistant" aria-label="Close assistant" @onclick="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
        </header>

        <div class="hm-assistant__body">
            <p class="hm-assistant__welcome">Ask about your home, settlement, housing, or safe contact sharing.</p>
            <div class="hm-assistant__suggestions" aria-label="Suggested questions">
                @foreach (var suggestion in Suggestions)
                {
                    <button type="button" class="hm-assistant__suggestion" @onclick="() => Ask(suggestion)">@suggestion</button>
                }
            </div>
            <div class="hm-assistant__conversation" aria-live="polite">
                @foreach (var message in Messages)
                {
                    <div class="hm-assistant__message hm-assistant__message--@message.Kind">
                        @message.Text
                    </div>
                }
            </div>
        </div>

        <footer class="hm-assistant__composer">
            <label class="hm-assistant__sr-only" for="assistant-question">Ask Nestify Assistant</label>
            <input id="assistant-question" @bind="Question" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" placeholder="Ask Nestify..." />
            <button type="button" class="hm-assistant__send" title="Send message" aria-label="Send message" disabled="@string.IsNullOrWhiteSpace(Question)" @onclick="Submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7.2 18-3.8-8L2 9Z" /><path d="M21 3 10 13" /></svg>
            </button>
        </footer>
    </section>
}

<button type="button" class="hm-assistant__fab" title="Open Nestify Assistant" aria-label="Open Nestify Assistant" aria-expanded="@_isOpen" @onclick="Toggle">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 9h8M8 13h5" /><rect x="3" y="4" width="18" height="15" rx="4" /><path d="m8 19-1 3 4-3" /></svg>
</button>

@code {
    [Parameter, EditorRequired] public HomeView Home { get; set; } = new();

    private bool _isOpen;
    private string Question { get; set; } = string.Empty;
    private List<AssistantMessage> Messages { get; } =
    [
        new("assistant", "I can help you manage this home and understand Nestify's housing and settlement rules.")
    ];

    private static readonly string[] Suggestions =
    [
        "How is meal settlement calculated?",
        "How many seats are free?",
        "What can a manager do?",
        "How do I post housing safely?"
    ];

    private void Toggle() => _isOpen = !_isOpen;

    private void Close() => _isOpen = false;

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit();
        }
    }

    private void Ask(string question)
    {
        Question = question;
        Submit();
    }

    private void Submit()
    {
        var question = Question.Trim();
        if (question.Length == 0)
        {
            return;
        }

        Messages.Add(new AssistantMessage("user", question));
        Messages.Add(new AssistantMessage("assistant", Respond(question)));
        Question = string.Empty;
    }

    private string Respond(string question)
    {
        var text = question.ToLowerInvariant();

        if (text.Contains("meal") || text.Contains("settlement") || text.Contains("expense") || text.Contains("cost"))
        {
            return "Settlement uses: per-meal rate = total grocery spend / total consumed meals. Each member's net balance = out-of-pocket payments - (their meal cost + equal fixed share). Open Settlement to review the monthly member breakdown.";
        }

        if (text.Contains("seat") || text.Contains("occup") || text.Contains("free"))
        {
            return $"{Home.Name} has {Home.FreeSeats} free seat{(Home.FreeSeats == 1 ? "" : "s")} out of {Home.MaxOccupants}. Housing posts and searches must use the correct UpazilaId for the location.";
        }

        if (text.Contains("manager") || text.Contains("role") || text.Contains("permission"))
        {
            return HomeRules.RoleLabel(Home.MyRole) switch
            {
                "Manager" => "As manager, you can edit details, add or remove members, review join requests, promote members, and transfer management. Transfer the role before leaving.",
                "Co-manager" => "As co-manager, you can edit details, add members, review requests, promote members, remove plain members, and leave freely.",
                _ => "As a member, you can view the home and leave. Managers and co-managers handle changes and join requests."
            };
        }

        if (text.Contains("housing") || text.Contains("post") || text.Contains("rent") || text.Contains("eligib"))
        {
            return "For housing, select the correct Division, District, and Upazila / Metropolitan Thana. Eligibility must match gender, occupation, age, and verification requirements before a post is suggested. Keep contact details hidden until a booking is accepted.";
        }

        if (text.Contains("contact") || text.Contains("phone") || text.Contains("whatsapp") || text.Contains("facebook"))
        {
            return "Nestify keeps phone numbers, WhatsApp, and Facebook handles private. Contact information is shown only after an accepted booking, active service engagement, or accepted buy offer.";
        }

        return "I can help with meal settlement, home roles, available seats, housing eligibility, location selection, and privacy rules. Try one of the suggested questions above.";
    }

    private sealed record AssistantMessage(string Kind, string Text);
}
