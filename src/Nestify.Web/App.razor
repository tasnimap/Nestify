<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <Nestify.Web.Components.RoleRedirect />
                </NotAuthorized>
                <Authorizing>
                    <div class="nx-section" style="text-align:center;padding-block:5rem;">Loading…</div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <PageTitle>Page not found — Nestify</PageTitle>
                <section class="nx-section">
                    <div class="nx-container" style="text-align:center;max-width:34rem;margin-inline:auto;">
                        <p class="nx-eyebrow" style="justify-content:center;">Error 404</p>
                        <h1 style="font-size:clamp(1.8rem,5vw,2.6rem);">This page isn't available.</h1>
                        <p class="nx-lead" style="margin-inline:auto;">
                            The link may be broken, or the page may have moved.
                        </p>
                        <p style="margin-top:2rem;">
                            <a class="nx-btn nx-btn--primary nx-btn--lg" href="">Back to home</a>
                        </p>
                    </div>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
    <ToastContainer />
</CascadingAuthenticationState>