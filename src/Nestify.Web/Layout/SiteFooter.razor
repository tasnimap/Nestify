@inject IStringLocalizer<SharedResource> L

<footer class="site-footer">
    <div class="nx-container site-footer__inner">
        <div class="site-footer__brand">
            <NestifyLogo Class="nx-logo--footer" From="#8b5cf6" To="#4c1d95" />
            <div>
                <p class="site-footer__name">Nestify</p>
                <p class="site-footer__tag">@L["Bachelor life, unified."]</p>
            </div>
        </div>

        <nav class="site-footer__links" aria-label='@L["Footer"]'>
            <a href="">@L["Home"]</a>
            <a href="about">@L["About Us"]</a>
            <a href="terms">@L["Terms of Use"]</a>
            <a href="privacy">@L["Privacy Policy"]</a>
        </nav>

        <p class="site-footer__legal">
            &copy; @DateTime.Now.Year Nestify. @L["A student project for Bangladeshi bachelors and job holders."]
        </p>
    </div>
</footer>
