@implements IDisposable
@inject NavigationManager Navigation
@inject Nestify.Web.Services.Interfaces.IAuthService AuthService
@inject Nestify.Web.Services.Interfaces.IUserProfileService ProfileService
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> L

<header class="nav">
    <div class="nx-container nav__inner">
        <a class="nav__brand" href="" @onclick="Close">
            <NestifyLogo Class="nx-logo--nav" />
            <span class="nav__word">Nestify</span>
        </a>

        <button class="nav__toggle"
                type="button"
                aria-label="@L["Toggle navigation menu"]"
                aria-expanded="@_open.ToString().ToLowerInvariant()"
                aria-controls="primary-nav"
                @onclick="Toggle">
            <span class="nav__toggle-bar @(_open ? "is-open" : null)"></span>
        </button>

        <nav id="primary-nav" class="nav__panel @(_open ? "nav__panel--open" : null)" aria-label='@L["Primary"]'>
            <ul class="nav__links">
                <AuthorizeView>
                    <NotAuthorized>
                        <li><NavLink class="nav__link" href="" Match="NavLinkMatch.All" @onclick="Close">@L["Home"]</NavLink></li>
                        <li><NavLink class="nav__link" href="about" @onclick="Close">@L["About Us"]</NavLink></li>
                    </NotAuthorized>
                    <Authorized>
                        @* Helpers and admins can land here too, and none of the user modules are theirs. *@
                        <AuthorizeView Roles="User" Context="userCtx">
                            <li><NavLink class="nav__link" href="home" @onclick="Close">@L["My Home"]</NavLink></li>
                            <li><NavLink class="nav__link" href="housing" @onclick="Close">@L["Housing"]</NavLink></li>
                            <li><NavLink class="nav__link" href="helpers" @onclick="Close">@L["Domestic Help"]</NavLink></li>
                            <li><NavLink class="nav__link" href="marketplace" @onclick="Close">@L["Marketplace"]</NavLink></li>
                            <li><NavLink class="nav__link" href="settlement" @onclick="Close">@L["Settlement"]</NavLink></li>
                        </AuthorizeView>
                        <AuthorizeView Roles="DomesticHelper,DomesticHelp,Maid,Helper" Context="helperCtx">
                            <li><NavLink class="nav__link" href="helpers/dashboard" @onclick="Close">@L["My Dashboard"]</NavLink></li>
                            <li><NavLink class="nav__link" href="helpers/profile" @onclick="Close">@L["My profile"]</NavLink></li>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin" Context="adminCtx">
                            <li><NavLink class="nav__link" href="admin" @onclick="Close">@L["Admin Console"]</NavLink></li>
                            <li><NavLink class="nav__link" href="admin/verifications" @onclick="Close">@L["Verifications"]</NavLink></li>
                        </AuthorizeView>
                        <li><NotificationBell /></li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <ThemeToggle />
            <LanguageSwitcher />

            <AuthorizeView>
                <Authorized>
                    <div class="nav__account">
                        <button class="nav__account-trigger"
                                type="button"
                                aria-haspopup="true"
                                aria-expanded="@_menuOpen.ToString().ToLowerInvariant()"
                                @onclick="ToggleMenu">
                            <span class="nav__avatar" aria-hidden="true">
                                @if (PictureUrl is not null)
                                {
                                    <img src="@PictureUrl" alt="" />
                                }
                                else
                                {
                                    @Initials(context.User.Identity?.Name)
                                }
                            </span>
                            <span class="nav__account-name">@(context.User.Identity?.Name ?? L["Profile"].Value)</span>
                            <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        </button>

                        @if (_menuOpen)
                        {
                            <div class="role-menu" role="menu">
                                <p class="role-menu__name">@L["Signed in as {0}", context.User.Identity?.Name ?? L["User"].Value]</p>
                                <a role="menuitem" href="@RoleRoutes.ProfileFor(context.User)" @onclick="CloseAll">
                                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                    @L["View profile"]
                                </a>
                                <button role="menuitem" class="role-menu__danger" type="button" @onclick="HandleLogout">
                                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                                    @L["Log out"]
                                </button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="nx-btn nx-btn--primary nav__cta" href="login" @onclick="Close">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <path d="M10 17l5-5-5-5" />
                            <path d="M15 12H3" />
                        </svg>
                        @L["Log in"]
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private bool _open;
    private bool _menuOpen;

    private string? PictureUrl => ProfileService.Current?.ProfilePictureUrl;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        ProfileService.Changed += HandleProfileChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;

        await LoadPictureAsync();
    }

    // The profile is cached by the service, so this only hits the API once per session.
    private async Task LoadPictureAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            await ProfileService.GetMyProfileAsync();
        }
        catch
        {
            // No picture is not worth breaking the navbar over; the initials stay.
        }
    }

    private void HandleProfileChanged() => InvokeAsync(StateHasChanged);

    private void HandleAuthStateChanged(Task<AuthenticationState> task) =>
        InvokeAsync(LoadPictureAsync);

    private void Toggle() => _open = !_open;
    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void Close()
    {
        if (_open) _open = false;
    }

    private void CloseAll()
    {
        _open = false;
        _menuOpen = false;
    }

    private async Task HandleLogout()
    {
        CloseAll();
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open || _menuOpen)
        {
            _open = false;
            _menuOpen = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        ProfileService.Changed -= HandleProfileChanged;
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }
}
