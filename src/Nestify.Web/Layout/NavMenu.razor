@implements IDisposable
@inject NavigationManager Navigation
@inject Nestify.Web.Services.Interfaces.IAuthService AuthService

<header class="nav">
    <div class="nx-container nav__inner">
        <a class="nav__brand" href="" @onclick="Close">
            <span class="nav__mark" aria-hidden="true">N</span>
            <span class="nav__word">Nestify</span>
        </a>

        <button class="nav__toggle"
                type="button"
                aria-label="Toggle navigation menu"
                aria-expanded="@_open.ToString().ToLowerInvariant()"
                aria-controls="primary-nav"
                @onclick="Toggle">
            <span class="nav__toggle-bar @(_open ? "is-open" : null)"></span>
        </button>

        <nav id="primary-nav" class="nav__panel @(_open ? "nav__panel--open" : null)" aria-label="Primary">
            <ul class="nav__links">
                <AuthorizeView>
                    <NotAuthorized>
                        <li><NavLink class="nav__link" href="" Match="NavLinkMatch.All" @onclick="Close">Home</NavLink></li>
                        <li><NavLink class="nav__link" href="about" @onclick="Close">About Us</NavLink></li>
                    </NotAuthorized>
                    <Authorized>
                        <li><NavLink class="nav__link" href="housing" @onclick="Close">Housing</NavLink></li>
                        <li><NavLink class="nav__link" href="helpers" @onclick="Close">Domestic Help</NavLink></li>
                        <li><NavLink class="nav__link" href="marketplace" @onclick="Close">Marketplace</NavLink></li>
                        <li><NavLink class="nav__link" href="settlement" @onclick="Close">Settlement</NavLink></li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <AuthorizeView>
                <Authorized>
                    <div class="nav__account">
                        <button class="nav__account-trigger"
                                type="button"
                                aria-haspopup="true"
                                aria-expanded="@_menuOpen.ToString().ToLowerInvariant()"
                                @onclick="ToggleMenu">
                            <span class="nav__avatar" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                            <span class="nav__account-name">@(context.User.Identity?.Name ?? "Profile")</span>
                            <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        </button>

                        @if (_menuOpen)
                        {
                            <div class="role-menu" role="menu">
                                <p class="role-menu__name">Signed in as @(context.User.Identity?.Name ?? "User")</p>
                                <a role="menuitem" href="profile" @onclick="CloseAll">
                                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                    View profile
                                </a>
                                <button role="menuitem" class="role-menu__danger" type="button" @onclick="HandleLogout">
                                    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                                    Log out
                                </button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="nx-btn nx-btn--primary nav__cta" href="login" @onclick="Close">
                        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <path d="M10 17l5-5-5-5" />
                            <path d="M15 12H3" />
                        </svg>
                        Log in
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private bool _open;
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void Toggle() => _open = !_open;
    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void Close()
    {
        if (_open) _open = false;
    }

    private void CloseAll()
    {
        _open = false;
        _menuOpen = false;
    }

    private async Task HandleLogout()
    {
        CloseAll();
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open || _menuOpen)
        {
            _open = false;
            _menuOpen = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
