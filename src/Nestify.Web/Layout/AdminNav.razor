@inject NavigationManager Navigation
@inject Nestify.Web.Services.Interfaces.IAuthService AuthService

<nav class="anav @(Open ? "anav--open" : null)" aria-label="Admin">
    <a class="anav__brand" href="admin">
        <span class="anav__mark" aria-hidden="true">N</span>
        <span>Nestify</span>
    </a>
    <p class="anav__tag">Admin console</p>

    <NavLink class="anav__link" href="admin" Match="NavLinkMatch.All" @onclick="OnNavigate">
        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" /><rect x="14" y="3" width="7" height="5" /><rect x="14" y="12" width="7" height="9" /><rect x="3" y="16" width="7" height="5" /></svg>
        Dashboard
    </NavLink>
    <NavLink class="anav__link" href="admin/verifications" @onclick="OnNavigate">
        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4" /><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /></svg>
        Verifications
    </NavLink>
    <NavLink class="anav__link" href="admin/reports" @onclick="OnNavigate">
        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
        Reports
    </NavLink>
    <NavLink class="anav__link" href="admin/users" @onclick="OnNavigate">
        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        Users
    </NavLink>
    <NavLink class="anav__link" href="admin/audit" @onclick="OnNavigate">
        <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M8 13h8M8 17h8" /></svg>
        Audit log
    </NavLink>

    <span class="anav__spacer"></span>

    <div class="anav__foot">
        <p class="anav__name">Signed in as @(_name ?? "Admin")</p>
        <a href="admin/profile" @onclick="OnNavigate">
            <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 4-6 8-6s8 2 8 6" /></svg>
            View profile
        </a>
        <button type="button" @onclick="HandleLogout">
            <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
            Log out
        </button>
    </div>
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? _name;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _name = state.User.Identity?.Name;
        }
    }

    private async Task OnNavigate()
    {
        if (Open) await OnClose.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await OnNavigate();
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }
}
