@inject IJSRuntime JS

<button class="nav__theme-toggle"
        type="button"
        aria-label="Dark mode"
        aria-pressed="@_isDark.ToString().ToLowerInvariant()"
        title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
        @onclick="ToggleAsync">
    <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true">
        @if (_isDark)
        {
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
        }
        else
        {
            <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
        }
    </svg>
    <span>Dark mode</span>
    <span class="nav__theme-switch" aria-hidden="true"></span>
</button>

@code {
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isDark = await JS.InvokeAsync<bool>("nestifyTheme.isDark");
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        var nextTheme = !_isDark;
        await JS.InvokeVoidAsync("nestifyTheme.setDark", nextTheme);
        _isDark = nextTheme;
    }
}
