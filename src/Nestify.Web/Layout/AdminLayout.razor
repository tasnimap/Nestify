@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to main content</a>

<div class="ashell">
    <div class="ashell__bar">
        <button class="anav__toggle" type="button" aria-label="Open menu" @onclick="() => _open = true">
            <svg class="nx-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <span class="anav__mark" aria-hidden="true">N</span>
        <strong>Admin console</strong>
    </div>

    @if (_open)
    {
        <button class="anav__scrim" type="button" aria-label="Close menu" @onclick="() => _open = false"></button>
    }

    <AdminNav Open="_open" OnClose="() => _open = false" />

    <main id="main" class="ashell__main" tabindex="-1">
        @Body
    </main>
</div>

@code {
    private bool _open;
}
