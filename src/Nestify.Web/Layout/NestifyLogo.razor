<span class="nx-logo @Class" aria-hidden="true">
    <svg viewBox="0 0 48 48" role="img" focusable="false">
        <defs>
            <linearGradient id="@_gradientId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="@From" />
                <stop offset="1" stop-color="@To" />
            </linearGradient>
        </defs>
        <rect x="0" y="0" width="48" height="48" rx="13" ry="13" fill="url(#@_gradientId)" />
        <g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.5 24 L24 13 L35.5 24" />
            <path d="M13.5 26.5 C14.6 34.4 19.4 38 24 38 C28.6 38 33.4 34.4 34.5 26.5" />
        </g>
        <circle cx="24" cy="30.5" r="3.4" fill="#fff" />
    </svg>
</span>

@code {
    [Parameter] public string? Class { get; set; }

    // gradient ends, so the mark can sit on the purple shell or the green helper shell
    [Parameter] public string From { get; set; } = "#7c3aed";
    [Parameter] public string To { get; set; } = "#4c1d95";

    private readonly string _gradientId = $"nx-logo-{Guid.NewGuid():N}";
}
