@inherits LayoutComponentBase

<div class="layout">
    <a class="skip-link" href="#main">Skip to main content</a>

    <NavMenu />

    <main id="main" class="layout__body" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <div class="nx-container site-footer__inner">
            <div class="site-footer__brand">
                <span class="site-footer__mark" aria-hidden="true">N</span>
                <div>
                    <p class="site-footer__name">Nestify</p>
                    <p class="site-footer__tag">Bachelor life, unified.</p>
                </div>
            </div>

            <nav class="site-footer__links" aria-label="Footer">
                <a href="">Home</a>
                <a href="about">About Us</a>
                <a href="login">Log in</a>
                <a href="register">Register</a>
            </nav>

            <p class="site-footer__legal">
                &copy; @DateTime.Now.Year Nestify. A student project for Bangladeshi bachelors and job holders.
            </p>
        </div>
    </footer>
</div>
