# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored - never commit real credentials.
# The API loads this file on startup (searching the current folder and its parents).

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Nestify
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# --- JWT ---
# JWT_SECRET must be a long random string (32+ chars). Generate one with PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=nestify-api
JWT_AUDIENCE=nestify-web
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7
